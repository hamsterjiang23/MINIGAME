%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: DayDialogs_fr
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 1bdb57fba89c5124a83ad717d0443512, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 22080585977856
    m_Localized: 'Firefighter: Il fait vraiment trop chaud…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560768
    m_Localized: Comment vous sentez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560769
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560770
    m_Localized: 'Firefighter: On dirait que c''est encore pire que ce que je pensais. *tousse* Bon sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560771
    m_Localized: 'Firefighter: Je ne pense pas que je vais pouvoir tenir plus d''une semaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560772
    m_Localized: 'Firefighter: Cependant, je me sens un peu mieux depuis que vous avez décidé de me laisser entrer. Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560773
    m_Localized: 'Firefighter: Mais… pendant que les autres sont en train de mourir, je suis assis là…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560774
    m_Localized: 'Firefighter: J''aurais pu être avec eux. Puisque je n''ai rien à perdre de toute façon. Je vais mourir, après tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560775
    m_Localized: 'Firefighter: Il fait vraiment trop chaud…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560776
    m_Localized: Pourquoi n'êtes-vous pas rentré chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560777
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560778
    m_Localized: 'Firefighter: J''ai des enfants à la maison. Et je… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560779
    m_Localized: 'Firefighter: Je ne veux pas qu''ils aient peur de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560780
    m_Localized: 'Firefighter: Et je ne veux pas *tousse* qu''ils se souviennent de moi comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560781
    m_Localized: 'Firefighter: Qu''ils pensent que je suis déjà mort dans la forêt, en… *tousse tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560782
    m_Localized: 'Firefighter: … en éteignant des feux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560783
    m_Localized: 'Firefighter: *tousse* *tousse* Qu''ils gardent de moi le souvenir d''un goudron fait de patience commune et de labeur appliqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560784
    m_Localized: 'Firefighter: Il fait vraiment trop chaud…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560785
    m_Localized: Où est passé votre uniforme ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560786
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560787
    m_Localized: 'Firefighter: Mon patron l''a repris. *tousse* On n''a plus assez de matériel ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560788
    m_Localized: 'Firefighter: Il y a tellement de gens *tousse* qui meurent au boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560789
    m_Localized: 'Firefighter: On n''a même pas le temps d''extirper nos collègues. Le feu *tousse* finit toujours par mutiler les corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560790
    m_Localized: 'Firefighter: Et les supérieurs… Ils s''inquiètent surtout *tousse* des uniformes à la con…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560791
    m_Localized: 'Firefighter: Ils nous pondent de nouvelles politiques tous les quatre matins… Mais rien pour le peuple.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560792
    m_Localized: 'Firefighter: Il fait vraiment trop chaud…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560793
    m_Localized: Quelle est l'origine des feux de forêt ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560794
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560795
    m_Localized: 'Firefighter: La forêt est extrêmement sèche ces derniers temps. C''est pour ça qu''elle peut *tousse* vite s''enflammer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560796
    m_Localized: 'Firefighter: Les incendies ne sont qu''un *tousse* malheur parmi tous ceux qui nous ont frappés, comme ces Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560797
    m_Localized: 'Firefighter: Mais qui sait ? Le destin nous réserve peut-être encore d''autres surprises…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560798
    m_Localized: 'Firefighter: Peut-être qu''une mort paisible, c''est la meilleure solution… Après tout, c''est une cause perdue…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560799
    m_Localized: 'Firefighter: J''ai pensé à… *tousse* ramener un cadeau à la maison. Mais je vais plutôt vous le donner.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560800
    m_Localized: 'Firefighter: C''est un collier, il est noirci et sans grand intérêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560801
    m_Localized: 'Firefighter: Il est fait d''abeilles mortes… Celles qui ont transformé le miel en soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560802
    m_Localized: 'Firefighter: Il fait vraiment trop chaud…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560803
    m_Localized: Vous avez l'air vraiment mal en point.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560804
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560805
    m_Localized: 'Firefighter: Je crois… Je crois que mon heure est venue… *tousse* *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560806
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560807
    m_Localized: 'Firefighter: Pourquoi est-ce que je ne suis pas restée là-bas ? J''aurais peut-être pu sauver deux ou trois gars.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560808
    m_Localized: 'Firefighter: J''aurais dû rester… et travailler jusqu''à en tomber. Ils auraient pas dû envoyer les jeunes à l''abattoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560809
    m_Localized: 'Firefighter: PUTAINS DE PATRONS ! *TOUSSE* *TOUSSE*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560810
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560811
    m_Localized: 'Firefighter: C''est tellement… triste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560812
    m_Localized: 'Firefighter: Est-ce que vous auriez une clope ? La dernière…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560813
    m_Localized: 'Bien sûr ! (Lui donner une cigarette) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560814
    m_Localized: 'Firefighter: Vous auriez pas une blonde par hasard ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560815
    m_Localized: Non, désolé… (Ne pas lui donner de cigarette)
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560816
    m_Localized: 'Firefighter: Le dernier clou dans le cercueil, comme ils disent… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560817
    m_Localized: 'Firefighter: (Il sort un briquet de sa poche, allume sa cigarette et commence à fumer.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560818
    m_Localized: 'Firefighter: (Il tire longuement dessus avant de s''adosser au mur. Il reprend la parole après avoir marqué une pause.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560819
    m_Localized: 'Firefighter: Si seulement je pouvais être avec les gars à nouveau. Fumer, discuter de…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560820
    m_Localized: 'Firefighter: *TOUSSE* *TOUSSE*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560821
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560822
    m_Localized: 'Firefighter: Vous fumez pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560823
    m_Localized: 'Firefighter: Je sais, je sais… Un pompier qui fume, ça craint… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560824
    m_Localized: 'Firefighter: Ça ne change pas grand-chose maintenant, de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560825
    m_Localized: 'Firefighter: Je voudrais juste… *tousse* me détendre un peu avant de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560826
    m_Localized: 'Firefighter: (L''homme s''adosse au mur et parle en fixant le plafond.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560827
    m_Localized: 'Firefighter: Comment j''me suis retrouvé pompier… ? Ma mère m''avait pourtant dit d''aller travailler à l''usine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560828
    m_Localized: 'Firefighter: C''est pas un boulot pour un pomp-…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560829
    m_Localized: 'Firefighter: *TOUSSE* *TOUSSE*'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560830
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560831
    m_Localized: 'WheelChair: Qu''est-ce que j''aimerais gambader gaiement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560832
    m_Localized: Tu cherches qui ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560833
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560834
    m_Localized: 'WheelChair: Avec mon pote… on se connaît depuis qu''on est gamins.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560835
    m_Localized: 'WheelChair: Il a eu un accident.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560836
    m_Localized: 'WheelChair: Il a trouvé du travail pour aller creuser à la mine, là-bas dans les montagnes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080598560837
    m_Localized: 'WheelChair: Perso, j''ai jamais compris… Mais c''est pas mon problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755072
    m_Localized: 'WheelChair: MAIS APRÈS, IL S''EST PÉTÉ LE DOS.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755073
    m_Localized: 'WheelChair: Il a travaillé tellement dur dans les montagnes…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755074
    m_Localized: 'WheelChair: Que les mouettes ont pris son… dos… pour… euh…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755075
    m_Localized: 'WheelChair: D''accord, d''accord… En fait, c''était son cul… Elles ont pris son cul pour un nid.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755076
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755077
    m_Localized: 'WheelChair: HAHAHAHA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755078
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755079
    m_Localized: 'WheelChair: Excuse… C''est les voix dans ma tête…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755080
    m_Localized: 'WheelChair: Elles ont super bien raconté la blague.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755081
    m_Localized: 'WheelChair: Qu''est-ce que j''aimerais gambader gaiement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755082
    m_Localized: Euh… tout va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755083
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755084
    m_Localized: 'WheelChair: Ouais. J''attends juste que mes jambes repoussent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755085
    m_Localized: 'WheelChair: Tiens, regarde, celle de droite a déjà commencé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755086
    m_Localized: 'WheelChair: Si c''est comme ça, je vais rester ici un petit moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755087
    m_Localized: Je voulais parler des voix dans ta tête.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755088
    m_Localized: Eh bien… d'accord.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755089
    m_Localized: 'WheelChair: T''as pas compris ou quoi ? C''était une blague.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755090
    m_Localized: 'WheelChair: Je pensais que t''avais pigé direct.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755091
    m_Localized: 'WheelChair: Apparemment, elle est tombée à plat…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755092
    m_Localized: 'WheelChair: Tu me demandes comment je vais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755093
    m_Localized: 'WheelChair: Merci, c''est trop sympa !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755094
    m_Localized: 'WheelChair: Personne me demande jamais comment je me sens ou comment s''est passée ma journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755095
    m_Localized: 'WheelChair: Tout ça parce qu''à la place des jambes, j''ai des roues de BOLIDES…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755096
    m_Localized: 'WheelChair: Et puis personne répond sincèrement, c''est ça le pire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755097
    m_Localized: 'WheelChair: Ils bafouillent des trucs comme « Oh, je regardais à peine… ».'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755098
    m_Localized: 'WheelChair: Mais qu''ils matent en douce ou qu''ils restent figés, c''est pareil. Ça pique.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755099
    m_Localized: 'WheelChair: Faire comme si j''étais pas handicapé, c''est si con. Je veux dire, il est là mon handicap. On va pas s''voiler la face.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755100
    m_Localized: 'WheelChair: L''idéal, ce serait un minimum d''équilibre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755101
    m_Localized: 'WheelChair: Mais l''équilibre, dans cette ville, il a foutu le camp depuis longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755102
    m_Localized: 'WheelChair: Tu t''es déjà demandé comment tu marcherais si t''avais des roues à la place des jambes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755103
    m_Localized: 'WheelChair: Merde, c''est pas ce que je voulais dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755104
    m_Localized: 'WheelChair: Je veux dire… si t''avais pas de jambes du tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755105
    m_Localized: 'WheelChair: EXACTEMENT. Tu ne pourrais même pas sortir de chez toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755106
    m_Localized: 'WheelChair: Comment ferais-tu pour monter des escaliers ? Ou traverser la rue ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755107
    m_Localized: 'WheelChair: Ces putains de rebords de trottoirs sont complètement défoncés.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755108
    m_Localized: 'WheelChair: Chez toi, y a pas d''escaliers ni de dénivelés, alors je peux me déplacer facilement.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755109
    m_Localized: 'WheelChair: Tu sais… Moi, je n''ai qu''un seul souhait…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755110
    m_Localized: 'WheelChair: J''aimerais… que ta maison soit en pente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755111
    m_Localized: 'WheelChair: Ce serait tordant de circuler en fauteuil roulant dedans… Et de s''écraser contre un mur… Mais peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755112
    m_Localized: 'WheelChair: J''adore les courses de vitesse… Mais c''est impossible à réaliser…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755113
    m_Localized: 'WheelChair: Oh, j''allais oublier… Tu m''as demandé comment ça allait.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755114
    m_Localized: 'WheelChair: Pas trop mal. Merci de m''avoir demandé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755115
    m_Localized: 'WheelChair: Qu''est-ce que j''aimerais gambader gaiement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755116
    m_Localized: T'aurais pas attrapé une insolation ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755117
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755118
    m_Localized: 'WheelChair: Quoi ? C''est quoi le rapport avec tout ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755119
    m_Localized: 'WheelChair: Je suis pas chauve et mes cheveux sont pas cramés. Donc, tout va bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755120
    m_Localized: 'WheelChair: Sans jambes, je peux pas faire la course en fauteuil roulant. Tu vois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755121
    m_Localized: 'WheelChair: Si j''ai pas de jambes, comment est-ce que je pourrais freiner une fois lancé ? Ou même prendre un virage ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755122
    m_Localized: 'WheelChair: T''as pas de fauteuil roulant, toi… Comment veux-tu comprendre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755123
    m_Localized: Tu y crois ? Vraiment ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755124
    m_Localized: Pourquoi est-ce que tu crois que tes jambes vont repousser ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755125
    m_Localized: 'WheelChair: Bien sûr !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755126
    m_Localized: 'WheelChair: Tu sais ce qu''on dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755127
    m_Localized: 'WheelChair: La jambe droite fait de plus grandes enjambées. C''est pour ça qu''on tourne en rond.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755128
    m_Localized: 'WheelChair: Regarde, mes jambes en sont la preuve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755129
    m_Localized: 'WheelChair: C''est du pareil au même… Et pas moyen de sortir de ce cercle vicieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755130
    m_Localized: 'WheelChair: Cette journée se termine aujourd''hui, une nouvelle commencera demain. Mais à quand un nouveau jour ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755131
    m_Localized: 'WheelChair: C''est toujours la même chose. Je vis dans ce putain de cycle, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755132
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755133
    m_Localized: 'WheelChair: Alors, si on y réfléchit bien… Est-ce que tu es vraiment différent de moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755134
    m_Localized: 'WheelChair: Tu ne tournerais pas un peu en rond ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755135
    m_Localized: 'WheelChair: Écoute, on vit dans un monde de prodiges.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755136
    m_Localized: 'WheelChair: Ils sont surtout terribles jusqu''à présent. MAIS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755137
    m_Localized: 'WheelChair: Aussi terribles qu''ils soient, les prodiges finissent par disparaître. C''est là que les merveilles apparaissent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755138
    m_Localized: 'WheelChair: Dieu a déjà pardonné à tant de fidèles. Peut-être que ce qui nous attend est encore mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755139
    m_Localized: 'WheelChair: Qu''est-ce que j''aimerais gambader gaiement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755140
    m_Localized: Comment as-tu perdu tes jambes ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755141
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755142
    m_Localized: 'WheelChair: Tu connais mon ami qui vit dans les montagnes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755143
    m_Localized: 'WheelChair: Eh bien… Un jour, il a décidé de creuser une tranchée dans son jardin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755144
    m_Localized: 'WheelChair: Il était persuadé qu''un tunnel rempli de viande passait sous sa maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755145
    m_Localized: 'WheelChair: Il a commandé une foreuse manuelle ou un truc du genre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755146
    m_Localized: 'WheelChair: Et il s''est mis à creuser…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755147
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755148
    m_Localized: 'WheelChair: Bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755149
    m_Localized: 'WheelChair: C''est sans doute la dernière fois que je l''ai vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755150
    m_Localized: 'WheelChair: Qu''est-ce que j''aimerais gambader gaiement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755151
    m_Localized: Et qu'en est-il de tes jambes ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755152
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755153
    m_Localized: 'WheelChair: Au diable mes jambes. Je veux savoir s''il a creusé jusqu''à l''endroit où il voulait aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755154
    m_Localized: D'accord, laisse tomber.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755155
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755156
    m_Localized: 'WheelChair: Ouais, c''est ça. Après, je suis allé boire une bière, tout bêtement.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755157
    m_Localized: 'WheelChair: Mais je suis tombé et un chariot m''a coupé les jambes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755158
    m_Localized: 'WheelChair: Ou attends…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755159
    m_Localized: 'WheelChair: Non, ce n''est pas ce qui s''est passé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755160
    m_Localized: 'WheelChair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755161
    m_Localized: 'WheelChair: Pourquoi tu dis rien ? Ça t''intéresse pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755162
    m_Localized: 'WheelChair: Eh bien, je ne prendrai pas la peine de t''en parler. Je vais pas t''ennuyer avec ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755163
    m_Localized: 'Mother: On étouffe ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755164
    m_Localized: Vous aviez pas une petite fille avec vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755165
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755166
    m_Localized: 'Mother: Hein ? Elle est toujours avec moi. Elle est sûrement allée faire un tour quelque part.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755167
    m_Localized: 'Mother: J''ai besoin de savoir où sont passés les autres… Je me demande s''ils vont bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755168
    m_Localized: 'Mother: Vous avez un téléphone ? Je devrais peut-être appeler leur père pour éviter d''avoir à revoir sa sale tronche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755169
    m_Localized: 'Mother: On étouffe ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755170
    m_Localized: Alors ? Avez-vous appelé votre mari ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755171
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755172
    m_Localized: 'Mother: À quoi bon ? Selon lui, c''est pas ses oignons… Et les enfants, la maison, l''argent, c''est pas ses oignons non plus…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755173
    m_Localized: 'Mother: Parfois, je me dis qu''il me tolérait, et que moi aussi je le tolérais. Mais il m''a pas quittée.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755174
    m_Localized: 'Mother: Peut-être parce que c''était plus pratique comme ça. Ou alors, il a juste peur que je finisse par avoir sa peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755175
    m_Localized: 'Mother: Pétard… Que je suis fatiguée…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755176
    m_Localized: 'Mother: On étouffe ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755177
    m_Localized: Est-ce que vous êtes allée voir votre mari ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755178
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755179
    m_Localized: 'Mother: Hein ? J''arrive même plus à me lever. J''ai mal, j''suis vidée. J''survis par rancune, j''crois.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755180
    m_Localized: 'Mother: Les marmots, le mec, la maison… C''est moi qui gérais tout. Parfois, il aidait un peu, ça rendait la chose moins moche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755181
    m_Localized: 'Mother: On reparlera plus tard, d''accord ? Là j''ai besoin d''me poser. J''suis à bout.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755182
    m_Localized: 'Mother: On étouffe ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755183
    m_Localized: Qu'est-ce qu'il a fait au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755184
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755185
    m_Localized: 'Mother: Il y a bien eu cette histoire…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755186
    m_Localized: 'Mother: Il emmenait cette nana en caisse. Je savais… Au début j''ai rien dit, pis après, j''lui ai pris la tête tous les jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755187
    m_Localized: 'Mother: Je l''ai accusé de me tromper. Il a fini par changer de boulot pour plus la voir. On aurait dit qu''il m''aimait… Ou pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755188
    m_Localized: 'Mother: Mais j''ai peut-être tout inventé. Quoi qu''il en soit, il faut que j''me repose. On se parle plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755189
    m_Localized: 'Mother: On étouffe ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755190
    m_Localized: Vous ne vous faites pas de souci pour vos enfants ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755191
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755192
    m_Localized: 'Mother: Si un peu… Sans doute pas autant que je le devrais. Le premier môme… J''savais pas ce que j''faisais. J''ai tout gâché.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755193
    m_Localized: 'Mother: Je pensais rectifier le tir avec le deuxième. Mais il est devenu encore pire. Et y a eu le troisième, et le quatrième…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755194
    m_Localized: 'Mother: Les toubibs disaient que c''était mort, que j''en aurais plus. Et puis paf, un deuxième… Du coup, j''l''ai appelé Miracle !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755195
    m_Localized: 'Mother: Mais après… tout est devenu… c''était horrible…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755196
    m_Localized: 'Mother: Je… Je dois me reposer…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755197
    m_Localized: 'Mother: On étouffe ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755198
    m_Localized: Qu'est-ce qui était horrible ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755199
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755200
    m_Localized: 'Mother: Difficile d''en parler… J''les aime, mais… Ils me font perdre mon sang-froid. Je crie, je les tabasse même un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755201
    m_Localized: 'Mother: C''est atroce, je regrette tant… Mais, vous savez, c''est la première fois que les choses me paraissent simples.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755202
    m_Localized: 'Mother: Maintenant qu''ils sont plus là, je peux juste… respirer… Je déteste dire ça, mais je me sens finalement bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755203
    m_Localized: 'Anger: Putain de merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755204
    m_Localized: Alors ? Tu t'es calmé ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755205
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755206
    m_Localized: 'Anger: Ouais, je me calme vite. Mais dès que je repense à un truc comme ça, je recommence à m''énerver.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755207
    m_Localized: 'Anger: Avant, j''étais plus facile à vivre. Il fallait y aller pour me froisser ou pour me pousser à bout.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755208
    m_Localized: 'Anger: Maintenant, la moindre étincelle suffit pour me faire péter un câble.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755209
    m_Localized: 'Anger: Et pourquoi devrais-je rester calme, d''abord ? Peut-être que ma rage m''aide à garder la raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755210
    m_Localized: 'Anger: Au moins, je ne vénère pas le soleil comme un abruti fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755211
    m_Localized: 'Anger: Comment est-ce qu''ils peuvent croire que le soleil va nous sauver ? Il est en train de nous tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755212
    m_Localized: 'Anger: Tout ça va nous envoyer tout droit au royaume des morts.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755213
    m_Localized: 'Anger: Est-ce qu''ils y comprennent, ces idiots ? Non, non… Bon, tout va bien, je suis calme. J''ai fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755214
    m_Localized: 'Anger: Merci d''avoir écouté.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755215
    m_Localized: 'Anger: Putain de merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755216
    m_Localized: D'où elle vient, toute cette colère ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755217
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755218
    m_Localized: 'Anger: Même moi, j''en sais rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755219
    m_Localized: 'Anger: Tout ce qui est en train de se passer me met hors de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755220
    m_Localized: 'Anger: Et les cultistes, ces foutus menteurs. Ils aimeraient embobiner encore plus de gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755221
    m_Localized: 'Anger: Et les imbéciles continueront de les croire, putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755222
    m_Localized: 'Anger: Certains iraient jusqu''à priver leurs propres enfants, tant qu''ils peuvent offrir leur tribu à cette maudite secte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755223
    m_Localized: 'Anger: Pour apaiser leur sauveur de merde tout droit sorti des enfers.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755224
    m_Localized: 'Anger: Ces enfoirés sont tarés. Ils font des lavages de cerveau même aux gens normaux avec leurs délires… comme ma…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755225
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755226
    m_Localized: 'Anger: Quoi qu''il en soit, je me sens plutôt calme maintenant. Ça va mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755227
    m_Localized: 'Anger: Putain de merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755228
    m_Localized: Est-ce que les cultistes t'ont pris quelqu'un de proche ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755229
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755230
    m_Localized: 'Anger: Non… Et c''est bien là le problème. Elle y est allée d''elle-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755231
    m_Localized: 'Anger: Ma femme…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755232
    m_Localized: 'Anger: Avant toute cette merde, elle était profondément croyante.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755233
    m_Localized: 'Anger: Mais je l''aimais et je m''en suis accommodé. Ça n''a jamais été un obstacle à notre relation.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755234
    m_Localized: 'Anger: Et puis quand tout s''est effondré, elle a trouvé refuge dans une nouvelle foi, un nouveau sauveur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755235
    m_Localized: 'Anger: Le discours des cultistes lui a semblé cohérent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755236
    m_Localized: 'Anger: Chaque jour, je la voyais s''égarer un peu plus. Elle croyait à des choses que je ne pouvais pas cautionner.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755237
    m_Localized: 'Anger: Quand j''ai compris ce que j''avais fait, elle avait déjà pris la fuite, morte de trouille. C''était trop tard…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755238
    m_Localized: 'Anger: Putain de merde…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755239
    m_Localized: Qu'est-ce qui s'est passé entre ta femme et toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755240
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755241
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755242
    m_Localized: 'Anger: Un jour, ma femme m''a dit qu''elle allait rejoindre la secte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755243
    m_Localized: 'Anger: J''y croyais pas. La femme de ma vie… Elle était devenue quelqu''un de complètement différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755244
    m_Localized: 'Anger: Notre amour ne signifiait plus rien pour elle. J''étais fou de rage, plus en colère que jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755245
    m_Localized: 'Anger: J''me suis dit qu''elle ne m''avait jamais aimé et qu''elle cherchait juste à se tirer. Ça m''a rendu malade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755246
    m_Localized: 'Anger: Mes mains se sont serrées toutes seules, et j''ai fait quelque chose que je ne me pardonnerai jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755247
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755248
    m_Localized: 'Anger: Je l''ai frappée…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755249
    m_Localized: 'Anger: Plus rien ne pourra arranger les choses maintenant. Elle est dans sa secte, et je…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755250
    m_Localized: 'Anger: Je ne pourrai jamais faire la paix avec ce qui s''est passé…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755251
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755252
    m_Localized: 'Anger: PUTAIN, JE ME DÉTESTE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755253
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755254
    m_Localized: 'Anger: Il vaut mieux que je me fasse du mal à moi-même plutôt qu''à ceux qui m''entourent. C''est tout ce que je le mérite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755255
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755256
    m_Localized: 'Anger: Dégage. J''ai besoin d''être seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755257
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755258
    m_Localized: Comment pouvez-vous savoir tout ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755259
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755260
    m_Localized: 'FortuneTeller: Ha ! Vous êtes si drôle… Je ne suis pas celle qui sait. Ce sont les étoiles qui parlent à travers moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755261
    m_Localized: 'FortuneTeller: La lune est en Vénus dans votre sixième maison. C''est écrit sur votre visage, même si c''est indicible…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755262
    m_Localized: 'FortuneTeller: J''en ai connu un comme vous. Il écoutait toujours, mais ne parlait jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755263
    m_Localized: 'FortuneTeller: Vous connaissez l''adage… Si Jupiter est en huitième maison, mieux vaut se taire. Les portes sont fermées.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755264
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755265
    m_Localized: Que s'est-il passé pour eux ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755266
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755267
    m_Localized: 'FortuneTeller: Je lui ai dit : « Peu importe ce que vous faites, c''est ce que fait votre aura qui compte… » Il ne m''a pas crue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755268
    m_Localized: 'FortuneTeller: Et la vie lui est passée sous le nez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755269
    m_Localized: 'FortuneTeller: Mais un jour, j''ai fermé les yeux et j''ai fait un rêve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755270
    m_Localized: 'FortuneTeller: J''ai mis toute mon énergie dans ce rêve.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755271
    m_Localized: 'FortuneTeller: Si vous n''ouvrez pas votre cœur à l''énergie, à quoi bon vivre dans un corps ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755272
    m_Localized: 'FortuneTeller: Vous pouvez faire la même chose. Fermez les yeux…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755273
    m_Localized: 'FortuneTeller: Imaginez que vous avez déjà atteint votre objectif…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755274
    m_Localized: 'FortuneTeller: Regardez-le attentivement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755275
    m_Localized: 'FortuneTeller: Saviez-vous que si vous souffrez, c''est parce que vous n''avez pas encore compris que c''est la forme ultime du bonheur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755276
    m_Localized: 'FortuneTeller: Alors… Vous êtes prêt à franchir le pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755277
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755278
    m_Localized: De quel « pas » s'agit-il ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755279
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755280
    m_Localized: 'FortuneTeller: C''est se choisir soi-même. Est-ce que vous sentez l''odeur des désirs inassouvis ? Il est temps de les extérioriser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755281
    m_Localized: 'FortuneTeller: Quand j''étais au plus bas, sans lumière ni sens, mon guide m''a dit que je n''écoutais pas mon océan intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755282
    m_Localized: 'FortuneTeller: Au début, j''ai ri. L''océan ?! Mais j''ai fermé les yeux et je l''ai entendu. Il a toujours été là. Et le vôtre aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755283
    m_Localized: 'FortuneTeller: Mais le plus important, c''est de vous demander si vous êtes prêt à ne faire qu''un avec vous-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755284
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755285
    m_Localized: Qui était votre guide ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755286
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755287
    m_Localized: 'FortuneTeller: Une femme remarquable. Elle était un phare dans la tempête. Elle m''a appris à voir l''essence des choses.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755288
    m_Localized: 'FortuneTeller: Je n''oublierai jamais ses mots : « Les gens meurent, car ils n''apprennent pas à respirer leur lumière intérieure. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755289
    m_Localized: 'FortuneTeller: Elle m''a fait comprendre que je pouvais aider les gens à trouver leur mission de vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755290
    m_Localized: 'FortuneTeller: Le problème ? Elle avait peur d''aller plus loin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755291
    m_Localized: 'FortuneTeller: Elle n''arrivait pas à se recentrer. Et c''est important d''être centré, vous savez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755292
    m_Localized: 'FortuneTeller: Si vous n''êtes pas le centre de votre univers, qui êtes-vous ? Vous comprenez, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755293
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755294
    m_Localized: Comment avez-vous fini par vous en sortir ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755295
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755296
    m_Localized: 'FortuneTeller: Toutes vos erreurs ne sont que des codes dans votre univers que vous n''avez pas encore su décrypter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755297
    m_Localized: 'FortuneTeller: J''ai suivi un long chemin. Regardez autour de vous, puis jetez un œil en arrière. Cette maison, vous la voyez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755298
    m_Localized: 'FortuneTeller: Claire, spacieuse, en parfaite harmonie avec mon énergie. Il ne sert à rien de lutter contre cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755299
    m_Localized: 'FortuneTeller: Elle a déjà absorbé votre peur. Acceptez-la, ou bien les murs pleureront vos propres larmes. Vous comprenez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755300
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755301
    m_Localized: Qu'attendez-vous de moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755302
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755303
    m_Localized: 'FortuneTeller: Oh, mon brave… Vous pensez que je veux quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755304
    m_Localized: 'FortuneTeller: Le hic, c''est que si vous aviez vu la danse de votre ombre, vous auriez déjà compris où se cache votre destinée.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755305
    m_Localized: 'FortuneTeller: Il vous suffit de réciter des formules de bonheur. Vous sentez que tout change, non ? C''est plus facile de respirer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755306
    m_Localized: 'FortuneTeller: Mon énergie se combine à votre espace. N''y cherchez pas un sens. C''est une illusion pour ceux qui ont peur du chaos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755307
    m_Localized: 'FortuneTeller: Je vous demande d''intégrer cet espace. Répétez : « Je ne suis pas seulement un invité ici, je suis son créateur. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755308
    m_Localized: 'FortuneTeller: Vous voulez connaître les secrets de l''invisible ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755309
    m_Localized: Et si je n'ai pas envie d'être un créateur ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755310
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755311
    m_Localized: 'FortuneTeller: Vos murs ont longtemps voulu vous étreindre, mais vous les enfermez dans les chaînes de votre contrôle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755312
    m_Localized: 'FortuneTeller: Le silence qui règne en vous, c''est la voix du monde que vous étouffez avec votre peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755313
    m_Localized: 'FortuneTeller: Votre énergie se fige comme le miel en hiver. Vous devez la réchauffer avec votre souffle. Les miroirs ne mentent pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755314
    m_Localized: 'FortuneTeller: En vous voyant juste par vous-même, vous ne voyez rien du tout. Déplacez votre énergie de trois degrés vers la droite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755315
    m_Localized: 'FortuneTeller: Seulement alors, vous serez enfin heureux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755316
    m_Localized: 'Fanatic: Je suis tout ouïe, humain. Parlez !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755317
    m_Localized: Appartenez-vous à un groupe religieux ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755318
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755319
    m_Localized: 'Fanatic: OUI, HUMAIN ! Mais ma foi n''a rien à voir avec les religions traditionnelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755320
    m_Localized: 'Fanatic: Je vénère le SAINT SOLEIL, LE SEUL ! CAR IL NOUS PROTÈGE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755321
    m_Localized: 'Fanatic: Mais les idiots ne voient que le négatif. Ils pensent qu''il va tous nous embraser…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755322
    m_Localized: 'Fanatic: BALIVERNES ! Sa colère est dirigée contre les graines du mal et les hérétiques ! Car ce sont des pécheurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755323
    m_Localized: 'Fanatic: Et que ceux qui ne sont pas d''accord ne se retrouvent jamais sous son feu de justice ardente !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755324
    m_Localized: 'Fanatic: Ils jouent avec le feu et s''étonnent d''être brûlés.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755325
    m_Localized: Les graines du mal ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755326
    m_Localized: Les hérétiques ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755327
    m_Localized: 'Fanatic: Vous vous posez encore la question ? Vous ne savez pas QUI SONT LES EXTRATERRESTRES ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755328
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755329
    m_Localized: 'Fanatic: Très bien, humain. Je vais vous dire TOUTE LA VÉRITÉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755330
    m_Localized: 'Fanatic: CE SONT LES VISITEURS QUI SONT DES GRAINES DU MAL !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755331
    m_Localized: 'Fanatic: Ce sont les descendants d''extraterrestres qui ont échoué sur Terre quand le soleil était plus jeune et l''herbe verte !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755332
    m_Localized: 'Fanatic: De MAUDITS VASSAUX qui ont élu domicile sur Terre et qui se sont reproduits au fil des siècles !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755333
    m_Localized: 'Fanatic: Et maintenant, ils sortent de terre ! Ils cherchent à s''approprier nos terres comme si c''était les leurs !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755334
    m_Localized: 'Fanatic: Mais le SOLEIL a décidé de nous protéger, car C''EST NOTRE TERRE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755335
    m_Localized: 'Fanatic: Car le Soleil est sans pitié envers les Visiteurs ! Sinon, pourquoi se sont-ils terrés pendant tout ce temps ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755336
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755337
    m_Localized: 'Fanatic: Bon sang… Je repense à toi et… Pourquoi tu t''es saoulé à ce point cette nuit-là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755338
    m_Localized: 'Fanatic: T''avais pas besoin de boire à en perdre conscience. La colère justifiée du Soleil sacré, c''est…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755339
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755340
    m_Localized: 'Fanatic: Ô SAINT SOLEIL, pardonnez ses péchés, car il sait ce qu''il a fait !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755341
    m_Localized: 'Fanatic: Prenez-le dans vos bras. Et peut-être aussi, l''âme de ce ficus, qu''il ne pourra plus arroser…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755342
    m_Localized: 'Fanatic: Amen.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755343
    m_Localized: 'Fanatic: Oui, vous avez bien entendu, humain !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755344
    m_Localized: 'Fanatic: Les types de la FEMA ne sont que de maudits HÉRÉTIQUES !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080602755345
    m_Localized: 'Fanatic: Ils interfèrent dans des processus qui dépassent NOTRE compréhension : la POSSESSION des personnes lambda !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949376
    m_Localized: 'Fanatic: Ils fourrent leur nez là où il ne faut pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949377
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949378
    m_Localized: 'Fanatic: Que le soleil maudisse ces salopards qui ont poussé ma mère dans une flaque d''eau.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949379
    m_Localized: 'Fanatic: Je suis tout ouïe, humain. Parlez !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949380
    m_Localized: Eh bien… Le soleil a brûlé de nombreuses personnes dans une certaine mesure…
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949381
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949382
    m_Localized: 'Fanatic: Vous avez raison. Tous les humains qui sont des graines du mal !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949383
    m_Localized: 'Fanatic: Le soleil a décidé de les punir, TOUS, pour les péchés que l''humanité a commis pendant des MILLIERS D''ANNÉES !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949384
    m_Localized: 'Fanatic: ET LES VISITEURS, CES BÂTARDS SANS NOM… Ils ont commencé à s''exposer au SOLEIL !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949385
    m_Localized: 'Fanatic: Mais le SOLEIL n''est pas pour le peuple souterrain ! Il brille pour nous, pour les HUMAINS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949386
    m_Localized: 'Fanatic: C''EST LE NÔTRE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949387
    m_Localized: 'Fanatic: C''EST UNE PUTAIN DE BÉNÉDICTION POUR L''HUMANITÉ !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949388
    m_Localized: Et combien de personnes devront encore être brûlées pour apaiser le soleil ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949389
    m_Localized: Vous êtes en train de dire que la fin du monde, c'est le soleil qui rend justice ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949390
    m_Localized: 'Fanatic: Beaucoup.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949391
    m_Localized: 'Fanatic: Et croyez-moi, mon ami, c''est LOIN D''ÊTRE FINI.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949392
    m_Localized: 'Fanatic: CE N''EST QUE LE DÉBUT !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949393
    m_Localized: 'Fanatic: La balance n''est pas encore assez chargée pour compenser les FORCES DE L''UNIVERS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949394
    m_Localized: 'Fanatic: Il faut en brûler encore plus, dans les flammes de la JUSTICE SOLAIRE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949395
    m_Localized: 'Fanatic: Mais entendez bien… Ces morts ne seront pas vaines !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949396
    m_Localized: 'Fanatic: Un jour, le Soleil nous dévoilera ses véritables desseins…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949397
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949398
    m_Localized: 'Fanatic: Parfois, la nuit, je suis si triste que ma femme m''ait quitté…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949399
    m_Localized: 'Fanatic: C''était une sainte femme…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949400
    m_Localized: 'Fanatic: Mais aussi une sacrée garce…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949401
    m_Localized: 'Fanatic: La fin pour qui ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949402
    m_Localized: 'Fanatic: Pour nous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949403
    m_Localized: 'Fanatic: Ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949404
    m_Localized: 'Fanatic: Me faites pas rire. LE SOLEIL EST DE NOTRE CÔTÉ !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949405
    m_Localized: 'Fanatic: Il nous aide, vous ne le voyez donc pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949406
    m_Localized: 'Fanatic: Il essaie de faire rentrer les Visiteurs sous terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949407
    m_Localized: 'Fanatic: Il punit les personnes les plus abjectes pour les péchés de l''humanité…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949408
    m_Localized: 'Fanatic: Il fait tomber les masques de honte et dévoile les hérétiques en lambeaux tachés de pisse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949409
    m_Localized: 'Fanatic: Il faut remercier le soleil et non pas annoncer la fin du monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949410
    m_Localized: 'Fanatic: C''EST JUSTE LA FIN POUR TOUS LES ENNEMIS DU SOLEIL !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949411
    m_Localized: 'Fanatic: MORT AUX PROFITEURS ! MORT AUX HÉRÉTIQUES IMBIBÉS DE SOUILLURES ! MORT AUX GRAINES DU MAL !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949412
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949413
    m_Localized: 'Fanatic: Juste ciel… Ça fait une éternité que j''ai pas mangé de frites…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949414
    m_Localized: 'Fanatic: Je suis tout ouïe, humain. Parlez !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949415
    m_Localized: Vous pensez que ce qui se passe relève du sacré ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949416
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949417
    m_Localized: 'Fanatic: Humain ! Pourquoi vous ai-je expliqué tout cela ? Pourquoi vous ai-je nourri à la petite cuillère ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949418
    m_Localized: 'Fanatic: Pour que vous me posiez EXACTEMENT CETTE MÊME QUESTION !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949419
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949420
    m_Localized: 'Fanatic: On dirait que je me suis trompé sur votre compte, humain. Les raisons véritables de ces événements vous échappent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949421
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949422
    m_Localized: 'Fanatic: Bon sang… Je tuerais pour une bière fraîche…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949423
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949424
    m_Localized: 'Fanatic: Est-ce que vous pourriez me faire plaisir une dernière fois, humain ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949425
    m_Localized: 'Bien sûr, prenez ça ! (Lui donner une bière) '
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949426
    m_Localized: 'Fanatic: Vous n''avez pas de bière ? Vous êtes complètement cinglé, humain !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949427
    m_Localized: 'Fanatic: Je l''ai vu, DE MES YEUX VU !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949428
    m_Localized: 'Fanatic: Allez, humain… Boire autant de bière sans même PARTAGER !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949429
    m_Localized: Non. (Ne pas lui donner de bière)
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949430
    m_Localized: 'Fanatic: Ahh, bon…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949431
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949432
    m_Localized: 'Fanatic: Mmm, elle est bien bonne ! Une bière brune… Mes préférées…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949433
    m_Localized: 'Fanatic: Ça me rappelle les soirées au bar avec les copains.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949434
    m_Localized: 'Fanatic: De grandes conversations, des pintes fraîches, des cahuètes…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949435
    m_Localized: 'Fanatic: Et ce maigrichon et sa face renfrognée qui nous regardaient toujours d''un œil désapprobateur…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949436
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949437
    m_Localized: 'Fanatic: Enfin… Pas de quoi s''énerver… Vous êtes peut-être stupide, humain… Mais au moins vous êtes gentil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949438
    m_Localized: 'Fanatic: Laissez-moi vous donner un petit cadeau en guise de remerciement. Prenez ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949439
    m_Localized: 'Fanatic: Que le Saint Soleil sauve votre âme !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949440
    m_Localized: 'Fanatic: Salaud !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949441
    m_Localized: 'Fanatic: QUE L''ENFER VOUS EMPORTE, FILS DE CHIEN !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949442
    m_Localized: 'Fanatic: Quelle ingratitude ! Je lui ai expliqué les significations sacrées, la signification, et il…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949443
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949444
    m_Localized: 'Fanatic: Vous êtes un SALE TYPE ! UN IDIOT FINI !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949445
    m_Localized: 'Fanatic: Allez vous faire foutre. Restez donc terré dans votre foutue cahute ! Je vais trouver un meilleur endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949446
    m_Localized: 'Fanatic: Vous allez voir, ils vont me laisser retourner au bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949447
    m_Localized: 'Fanatic: Bonne route, sombre crétin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949448
    m_Localized: 'Anxiety: Héh h-héh. J''espère qu''on verra bientôt le bout de toute cette histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949449
    m_Localized: Comment avez-vous perdu votre maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949450
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949451
    m_Localized: 'Anxiety: Ahh… Je me souviens de ce jour comme si c''était hier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949452
    m_Localized: 'Anxiety: Je me suis fait virer… Je voulais juste rentrer chez moi, me mettre au lit et pleurer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949453
    m_Localized: 'Anxiety: En arrivant, j''ai vu un tas de bottes dans le couloir. Je me suis dit que ma colocataire avait invité des amis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949454
    m_Localized: 'Anxiety: Je suis allée dans sa chambre pour voir ce qu''elle faisait. J''ai entendu un bruit étrange devant sa porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949455
    m_Localized: 'Anxiety: Je me suis sentie mal à l''aise. J''ai décidé de jeter un coup d''œil discret pour voir ce qui se tramait.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949456
    m_Localized: 'Anxiety: J''ai juste eu le temps d''apercevoir ma colocataire allongée sur le lit, immobile, quand soudain…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949457
    m_Localized: 'Anxiety: Un gars m''a attrapé par-derrière et m''a dit : « Tu ne peux pas entrer là-dedans. Elle est… pas en forme. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949458
    m_Localized: 'Anxiety: « On ferait mieux d''aller dans la cuisine. » Il m''a prise par le bras et on s''est assis à la table de la cuisine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949459
    m_Localized: 'Anxiety: Je voulais partir, mais j''étais paralysée de peur… Et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949460
    m_Localized: 'Anxiety: Je… Il…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949461
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949462
    m_Localized: 'Anxiety: Il faut que je me repose. Mon estomac fait des saltos arrière à cause de mes crises d''angoisse. Arf…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949463
    m_Localized: 'Anxiety: Héh h-héh. J''espère qu''on verra bientôt le bout de toute cette histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949464
    m_Localized: Mais qu'est-ce qui s'est passé chez vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949465
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949466
    m_Localized: 'Anxiety: Arf…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949467
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949468
    m_Localized: 'Anxiety: Après que cet homme m''a fait asseoir, un énorme type est sorti de nulle part pour bloquer la sortie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949469
    m_Localized: 'Anxiety: Il a commencé à parler super fort au type qui m''avait pris par le bras.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949470
    m_Localized: 'Anxiety: C''est comme si je n''existais pas là. Et puis… ils ont commencé à me toucher !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949471
    m_Localized: 'Anxiety: Mes bras, mes épaules…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949472
    m_Localized: 'Anxiety: Et j''ai entendu des acclamations et un rire bruyant qui semblait venir de ma chambre…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949473
    m_Localized: 'Anxiety: On aurait dit qu''il y avait toute une bande de mecs là-dedans.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949474
    m_Localized: 'Anxiety: J''ai commencé à avoir du mal à respirer… comme si mon cœur allait sortir de ma poitrine…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949475
    m_Localized: 'Anxiety: Je voulais crier et appeler à l''aide, mais ma voix… La peur m''empêchait d''émettre le moindre son.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949476
    m_Localized: 'Anxiety: Je suis restée assise, immobile comme un ours en peluche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949477
    m_Localized: 'Anxiety: Mais quand l''armoire à glace a ouvert le frigo, j''ai compris que c''était ma chance…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949478
    m_Localized: 'Anxiety: J''ai foncé vers la sortie. C''était comme si la peur me donnait des ailes. Et j''ai couru, sans me retourner.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949479
    m_Localized: 'Anxiety: Jusqu''à ce que je sois à bout de souffle et que je m''écroule sur le sol…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949480
    m_Localized: Pourquoi n'êtes-vous pas brûlée par le soleil ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949481
    m_Localized: Que s'est-il passé ensuite ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949482
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949483
    m_Localized: 'Anxiety: Je ne me souviens pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949484
    m_Localized: 'Anxiety: J''ai dû passer toute la nuit sur place, et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949485
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949486
    m_Localized: 'Anxiety: C''est bizarre… Je pensais me souvenir de tout ce qui m''était arrivé…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949487
    m_Localized: 'Anxiety: Attendez, vous ne pensez pas que je…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949488
    m_Localized: 'Anxiety: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949489
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949490
    m_Localized: 'Anxiety: Et si j''étais un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949491
    m_Localized: 'Anxiety: Non, c''est pas possible. Je me souviens de ma vie. Mon enfance, ma mère et mon père. Non, non !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949492
    m_Localized: 'Anxiety: Je ne suis pas un Visiteur, hein ? Dites-moi que je ne suis pas un Visiteur !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949493
    m_Localized: Je n'en sais rien.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949494
    m_Localized: Vous n'êtes pas un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949495
    m_Localized: Vous avez tout l'air d'être un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949496
    m_Localized: 'Anxiety: J''étais allongée sur le sol, et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949497
    m_Localized: 'Anxiety: Puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949498
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949499
    m_Localized: 'Anxiety: J''étais tellement convaincue que je me souvenais de ce qui s''était passé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949500
    m_Localized: 'Anxiety: Attendez, vous ne pensez pas que je…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949501
    m_Localized: 'Anxiety: J…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949502
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949503
    m_Localized: 'Anxiety: Et si j''étais un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949504
    m_Localized: 'Anxiety: Non, c''est pas possible. Je me souviens de ma vie. Mon enfance, ma mère et mon père. Non, non !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949505
    m_Localized: 'Anxiety: Je ne suis pas un Visiteur, hein ? Dites-moi que je ne suis pas un Visiteur !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949506
    m_Localized: Je n'en sais rien.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949507
    m_Localized: Vous n'êtes pas un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949508
    m_Localized: Vous avez tout l'air d'être un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949509
    m_Localized: 'Anxiety: COMMENT POUVEZ-VOUS DIRE UNE CHOSE PAREILLE ?! Oh, bonté divine… J''ai peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949510
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949511
    m_Localized: 'Anxiety: Il faut que je me repose. Mon estomac recommence à faire des loopings. Argh…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949512
    m_Localized: 'Anxiety: Merci, je me sens mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949513
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949514
    m_Localized: 'Anxiety: Arf, il faut que je me repose. Mon estomac recommence à faire des loopings…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949515
    m_Localized: 'Anxiety: COMMENT POUVEZ-VOUS DIRE UNE CHOSE PAREILLE ?! Oh, j''ai tellement, tellement peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949516
    m_Localized: 'Anxiety: JE NE VEUX PAS MOURIR ! NON, NON !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949517
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949518
    m_Localized: 'Anxiety: On va tous mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949519
    m_Localized: 'Anxiety: Héh h-héh. J''espère qu''on verra bientôt le bout de toute cette histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949520
    m_Localized: Est-ce que ça va ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949521
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949522
    m_Localized: 'Anxiety: N''APPROCHEZ PAS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949523
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949524
    m_Localized: 'Anxiety: Désolée, j''ai cru que vous alliez me tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949525
    m_Localized: Qu'est-ce qui vous fait penser ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949526
    m_Localized: Si j'avais voulu vous tuer, vous seriez morte depuis longtemps
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949527
    m_Localized: 'Anxiety: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949528
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949529
    m_Localized: 'Anxiety: Je n''arrive pas à savoir qui est un Visiteur et qui ne l''est pas… Et si…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949530
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949531
    m_Localized: 'Anxiety: Et si vous, vous étiez un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949532
    m_Localized: 'Anxiety: Est-ce que vous me tuerez ? Me dépecer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949533
    m_Localized: 'Anxiety: PAR PITIÉ, NON ! TUEZ-MOI RAPIDEMENT, SANS ME FAIRE SOUFFRIR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949534
    m_Localized: 'Anxiety: JE NE VEUX PAS MOURIR DANS L''AGONIE. JE VOUS EN SUPPLIE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949535
    m_Localized: Du calme, je ne suis pas un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949536
    m_Localized: Je ne compte pas vous tuer.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949537
    m_Localized: 'Anxiety: Désolée, je suis vraiment à bout de nerfs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949538
    m_Localized: 'Anxiety: Je n''ai aucune idée de qui je peux croire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949539
    m_Localized: 'Anxiety: Et si…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949540
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949541
    m_Localized: 'Anxiety: Et si vous, vous étiez un Visiteur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949542
    m_Localized: 'Anxiety: Est-ce que vous me tuerez ? Me dépecer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949543
    m_Localized: 'Anxiety: PAR PITIÉ, NON ! TUEZ-MOI RAPIDEMENT, SANS ME FAIRE SOUFFRIR.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949544
    m_Localized: 'Anxiety: JE NE VEUX PAS MOURIR DANS L''AGONIE. JE VOUS EN SUPPLIE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949545
    m_Localized: Du calme, je ne suis pas un Visiteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949546
    m_Localized: Je ne compte pas vous tuer.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949547
    m_Localized: 'Anxiety: COMMENT PUIS-JE EN ÊTRE SÛRE ?! Je n''ai pas examiné vos dents ou vos yeux…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949548
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949549
    m_Localized: 'Anxiety: On va tous mourir. Soit à cause des Visiteurs, soit à cause du soleil…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949550
    m_Localized: 'Anxiety: Il n''y a plus d''espoir. La mort approche, quoi qu''il advienne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949551
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949552
    m_Localized: 'Anxiety: Laissez-moi tranquille.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949553
    m_Localized: 'Anxiety: COMMENT PUIS-JE EN ÊTRE SÛRE ?! Je n''ai pas examiné vos dents ou vos yeux…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949554
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949555
    m_Localized: 'Anxiety: On va tous mourir. Soit à cause des Visiteurs, soit à cause du soleil…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949556
    m_Localized: 'Anxiety: Il n''y a plus d''espoir. La mort approche, quoi qu''il advienne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949557
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949558
    m_Localized: 'Anxiety: Laissez-moi tranquille.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949559
    m_Localized: 'Anxiety: Héh h-héh. J''espère qu''on verra bientôt le bout de toute cette histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949560
    m_Localized: Qu'est-ce qui vous arrive ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949561
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949562
    m_Localized: 'Anxiety: LES VISITEURS ! ILS VIENNENT POUR NOUS TUER !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949563
    m_Localized: 'Anxiety: Vous n''entendez pas ? LA MORT NOUS APPELLE.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949564
    m_Localized: 'Anxiety: VISITEUR, HUMAIN… QUELLE EST LA DIFFÉRENCE ? !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949565
    m_Localized: 'Anxiety: NOUS SOMMES TOUS LES MÊMES AVANT LA MORT.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949566
    m_Localized: 'Anxiety: Mais à quoi bon se torturer en attendant ? LAISSONS-LES VENIR !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949567
    m_Localized: 'Anxiety: ILS VEULENT CE QU''IL Y A DE MIEUX POUR NOUS ! LAISSONS VENIR LES VISITEURS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949568
    m_Localized: Vous n'avez pas l'air en forme.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949569
    m_Localized: Est-ce que vous êtes devenue folle ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949570
    m_Localized: 'Anxiety: NON, JE VIENS D''ENTREVOIR LA LUMIÈRE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949571
    m_Localized: 'Anxiety: JE SUIS UN VISITEUR !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949572
    m_Localized: 'Anxiety: NOUS ET LES HUMAINS NE FAISONS QU''UN. NOUS SOMMES TELLEMENT PROCHES LES UNS DES AUTRES !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949573
    m_Localized: 'Anxiety: NOUS SOMMES COMME DES IMAGES MIROIRS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949574
    m_Localized: 'Anxiety: ACCEPTEZ LA MORT À NOS CÔTÉS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949575
    m_Localized: Je ne crois pas que vous compreniez ce que vous dites.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949576
    m_Localized: Vous ne me laissez pas le choix.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949577
    m_Localized: 'Anxiety: JE NE SUIS PAS FOLLE, J''AI VU LA LUMIÈRE !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949578
    m_Localized: 'Anxiety: JE SUIS UN VISITEUR !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949579
    m_Localized: 'Anxiety: NOUS ET LES HUMAINS NE FAISONS QU''UN. NOUS SOMMES TELLEMENT PROCHES LES UNS DES AUTRES !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949580
    m_Localized: 'Anxiety: NOUS SOMMES COMME DES IMAGES MIROIRS !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949581
    m_Localized: 'Anxiety: ACCEPTEZ LA MORT À NOS CÔTÉS ! ELLE ARRIVE BIENTÔT !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949582
    m_Localized: Je ne crois pas que vous compreniez ce que vous dites.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949583
    m_Localized: Vous ne me laissez pas le choix.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949584
    m_Localized: 'Anxiety: Non, vous ne comprenez rien !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949585
    m_Localized: 'Anxiety: La mort arrive ! LE SOLEIL ANNONCE L''APPROCHE DE LA MORT.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949586
    m_Localized: 'Anxiety: Nous allons bientôt la rencontrer. Très bientôt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949587
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949588
    m_Localized: Lui tirer dessus
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949589
    m_Localized: 'Anxiety: Tirez alors ! Qu''attendez-vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949590
    m_Localized: 'Anxiety: POUVEZ-VOUS TUER SANS LE MOINDRE REMORDS ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949591
    m_Localized: 'Anxiety: Peu m''importe. FAITES CE QUE VOUS AVEZ À FAIRE, HUMAIN.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949592
    m_Localized: La laisser tranquille
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949593
    m_Localized: Lui tirer dessus
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949594
    m_Localized: 'Esenin: Oui ? Tu voulais quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949595
    m_Localized: Dis-moi, pourquoi t'ont-ils viré du bar ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949596
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949597
    m_Localized: 'Esenin: Parce que les catastrophes en série ont rendu tout le monde complètement fou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949598
    m_Localized: 'Esenin: Le soleil qui explose, les Visiteurs, la crise économique, et j''en passe…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949599
    m_Localized: 'Esenin: Ça les a tous détraqués. Pour certains c''est le stress, pour d''autres c''est la picole.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949600
    m_Localized: 'Esenin: Eh bien… Moi, j''ai perdu la boule par colère.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949601
    m_Localized: 'Esenin: J''ai grimpé sur une table et j''ai hurlé : « Arrêtez d''accuser tout et n''importe quoi, putain. Restons humains ! »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949602
    m_Localized: 'Esenin: Les larmes dans la bière, c''est pas gênant… le houblon a meilleur goût avec du sel.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949603
    m_Localized: 'Esenin: De toute façon, personne n''a besoin de ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949604
    m_Localized: 'Esenin: Oui ? Tu voulais quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949605
    m_Localized: Est-ce que c'est différent ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949606
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949607
    m_Localized: 'Esenin: Je n''emmerde plus personne. À quoi bon ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949608
    m_Localized: 'Esenin: Mais dès que j''entends la télé ou les gens parler, y a un truc qui s''allume à l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949609
    m_Localized: 'Esenin: Alors je me demande… Est-ce que j''ai besoin de ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949610
    m_Localized: 'Esenin: Non, mon bon monsieur… Non, j''ai déjà les nerfs à vif.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949611
    m_Localized: 'Esenin: C''était déjà pas la fête avant, alors maintenant…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949612
    m_Localized: 'Esenin: Un jour, je m''accrocherai à ce foutu lustre et je planerai au-dessus de ce monde lavé à l''eau bénite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949613
    m_Localized: 'Esenin: Oui ? Tu veux quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949614
    m_Localized: Tout va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949615
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949616
    m_Localized: 'Esenin: Hm ? Pourquoi cette question ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949617
    m_Localized: Tu portes une drôle d'odeur.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949618
    m_Localized: Est-ce que tu as de la fièvre ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949619
    m_Localized: 'Esenin: Eh bien… J''ai bu un peu de ta bière.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949620
    m_Localized: 'Esenin: Je me suis senti malade. J''ai décidé de boire un petit coup. Y a rien de criminel là-dedans.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949621
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949622
    m_Localized: 'Esenin: Tout ça, c''est du foutage de gueule.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949623
    m_Localized: 'Esenin: Tout le monde prétend vouloir régler les problèmes, mais c''est des conneries… Il se passe jamais rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949624
    m_Localized: 'Esenin: Tu sais, je crois qu''on pourrait bien tous mourir sous peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949625
    m_Localized: 'Esenin: Si le soleil ne nous tue pas, les Visiteurs s''en chargeront. Si on leur échappe, on s''entretuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949626
    m_Localized: 'Esenin: Même quand on n''a pas de problèmes, on s''en invente des nouveaux, putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949627
    m_Localized: 'Esenin: Comme si on ne pouvait pas exister sans se pourrir la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949628
    m_Localized: 'Esenin: Putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949629
    m_Localized: 'Esenin: Va-t''en. J''me sens malade.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949630
    m_Localized: 'Esenin: C''est pas moi qui ai de la fièvre. C''est toute cette putain de planète.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949631
    m_Localized: 'Esenin: Partout où tu regardes, il y a la mort. Ou les glaciers fondent. Ou les forêts brûlent. Le monde a la fièvre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949632
    m_Localized: 'Esenin: La Terre se secoue pour se débarrasser des puces lourdes de sang que nous sommes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949633
    m_Localized: 'Esenin: Un jour, elle y parviendra. Et là, il y aura du grabuge.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949634
    m_Localized: 'Esenin: Arghhh…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949635
    m_Localized: 'Esenin: Dégage. Allez, s''il te plaît. J''vais pas bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949636
    m_Localized: 'Esenin: Oui ? Tu voulais quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949637
    m_Localized: Tu te sens mieux ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949638
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949639
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949640
    m_Localized: 'Esenin: Mon vieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949641
    m_Localized: 'Esenin: On va tous crever un jour. C''est comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949642
    m_Localized: 'Esenin: Tu t''es déjà demandé ce qu''il se passe quand on meurt ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949643
    m_Localized: Mes croyances deviendront vraies.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949644
    m_Localized: C'est le néant.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949645
    m_Localized: J'en sais rien, peut-être qu'on finit dans l'espace.
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949646
    m_Localized: 'Esenin: Ouais… pourquoi pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949647
    m_Localized: 'Esenin: Mais ça me fait pas me sentir mieux. Tu sais pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949648
    m_Localized: 'Esenin: Quand je mourrai, mon cerveau comprendra. Il me montrera un truc, un doux souvenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949649
    m_Localized: 'Esenin: Et quand j''aurai plus la force de rêver… alors quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949650
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949651
    m_Localized: 'Esenin: Non. Ça m''aide pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949652
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949653
    m_Localized: 'Esenin: J''aurais préféré que tu me dises autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949654
    m_Localized: 'Esenin: T''as peut-être raison, hein. Mais putain, c''est affreux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949655
    m_Localized: 'Esenin: Qu''il n''y ait rien du tout… Juste du noir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080606949656
    m_Localized: 'Esenin: J''ai plus envie de parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143680
    m_Localized: 'Esenin: Tu sais…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143681
    m_Localized: 'Esenin: Y a rien dans l''espace, sauf nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143682
    m_Localized: 'Esenin: Pas d''autre vie. Juste un vide glacé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143683
    m_Localized: 'Esenin: S''il y avait de la vie, on aurait reçu un signal, quelque chose. Mais rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080611143684
    m_Localized: 'Esenin: Cet espace vide et noir… Si c''est là qu''on finit, c''est comme s''effacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337984
    m_Localized: 'Esenin: Je… Je veux rester seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337985
    m_Localized: 'Esenin: Quoi ? T''avais besoin de quelque chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337986
    m_Localized: Tu vas… tu vas bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337987
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337988
    m_Localized: 'Esenin: Au moins y avait de la hauteur sous plafond, au bar.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337989
    m_Localized: 'Esenin: Assez pour se passer la corde au cou.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337990
    m_Localized: 'Esenin: Ici, tout est trop serré. Même la planète, j''la trouve trop petite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337991
    m_Localized: 'Esenin: Tu sais, mon vieux… J''voudrais juste en finir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337992
    m_Localized: 'Esenin: C''est un putain de bordel, cette vie. Et moi, j''ai la trouille, grave.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337993
    m_Localized: 'Esenin: C''est juste que j''en peux plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337994
    m_Localized: 'Esenin: Mais qu''est-ce que j''suis venu foutre ici ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337995
    m_Localized: 'Widow: J''aimerais bien me reposer un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337996
    m_Localized: Besoin de quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337997
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337998
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615337999
    m_Localized: 'Widow: Qu''il soit en vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338000
    m_Localized: 'Widow: C''est tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338001
    m_Localized: 'Widow: C''est tout ce dont j''ai besoin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338002
    m_Localized: Est-ce que vous voulez un peu d'eau ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338003
    m_Localized: Voulez-vous de la nourriture ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338004
    m_Localized: 'Widow: Je vais juste…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338005
    m_Localized: 'Widow: … M''asseoir près du robinet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338006
    m_Localized: 'Widow: Je boirai si j''ai soif.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338007
    m_Localized: Bon… Je vous laisse, alors.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338008
    m_Localized: Est-ce que je peux m'asseoir à côté de vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338009
    m_Localized: 'Widow: J''ai pas faim.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338010
    m_Localized: 'Widow: Je vais juste…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338011
    m_Localized: 'Widow: Je veux juste m''asseoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338012
    m_Localized: Bon… Je vous laisse, alors.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338013
    m_Localized: Est-ce que je peux m'asseoir à côté de vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338014
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338015
    m_Localized: 'Widow: Pourquoi a-t-il fallu que tu meures ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338016
    m_Localized: 'Widow: Tu m''avais promis que les choses s''arrangeraient.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338017
    m_Localized: 'Widow: Tu avais dit que tout irait mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338018
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338019
    m_Localized: 'Widow: Et puis, tu es mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338020
    m_Localized: 'Widow: Et maintenant, je suis la seule à survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338021
    m_Localized: 'Widow: Pourquoi est-ce que t''as fait ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338022
    m_Localized: 'Widow: Je veux juste être avec lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338023
    m_Localized: 'Widow: Personne ne peut me le ramener.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338024
    m_Localized: 'Widow: Je ne peux même pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338025
    m_Localized: 'Widow: Enterrer…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338026
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338027
    m_Localized: 'Widow: Je ne peux pas t''enterrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338028
    m_Localized: 'Widow: Qu''est-ce que je suis censée faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338029
    m_Localized: 'Widow: Il faut que je me repose…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338030
    m_Localized: Comment est-il mort ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338031
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338032
    m_Localized: 'Widow: Je peux pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338033
    m_Localized: 'Widow: C''est trop.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338034
    m_Localized: 'Widow: Je n''ai plus de larmes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338035
    m_Localized: 'Widow: J''ai tant pleuré qu''il ne me reste plus de larme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338036
    m_Localized: 'Widow: Mais est-ce que c''est une bonne chose ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338037
    m_Localized: 'Widow: Arrête de pleurer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338038
    m_Localized: Il faut l'enterrer.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338039
    m_Localized: La seule chose qui reste de lui est un corps. Vous devez l'accepter.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338040
    m_Localized: 'Widow: Non…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338041
    m_Localized: 'Widow: Non, non, non !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338042
    m_Localized: 'Widow: Je ne suis pas prête.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338043
    m_Localized: 'Widow: Ils venaient tout juste de me le rendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338044
    m_Localized: 'Widow: Et maintenant il faudrait qu''on se sépare à nouveau ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338045
    m_Localized: 'Widow: Je ne peux pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338046
    m_Localized: 'Widow: Je ne le donnerai pas à cette terre au cœur froid.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338047
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338048
    m_Localized: 'Widow: Non.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338049
    m_Localized: 'Widow: Non, c''est pas vrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338050
    m_Localized: 'Widow: Il m''entend encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338051
    m_Localized: 'Widow: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338052
    m_Localized: 'Widow: Je voudrais tant y croire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338053
    m_Localized: 'Widow: Il faudrait que je me repose un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338054
    m_Localized: Quels sont vos souvenirs de lui ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338055
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338056
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338057
    m_Localized: 'Widow: Un jour, on est allés chez des amis.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338058
    m_Localized: 'Widow: On était beaucoup plus jeunes à l''époque.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338059
    m_Localized: 'Widow: On traînait ensemble, on buvait. Il était du genre grognon et pas très bavard lors de ce genre d''occasions.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338060
    m_Localized: 'Widow: Ce jour-là, on avait beaucoup bu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338061
    m_Localized: 'Widow: Il était comme d''habitude silencieux, et tout d''un coup, il a dit :'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338062
    m_Localized: 'Widow: « Donnez-moi une guitare. Je vais chanter. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338063
    m_Localized: 'Widow: Et il a si bien joué. J''ai adoré.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338064
    m_Localized: 'Widow: Nos amis ont demandé des chansons, il est resté assis un moment, et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338065
    m_Localized: 'Widow: Il s''est levé pour partir, il a renversé un verre, il a fait tomber la guitare en voulant le rattraper…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338066
    m_Localized: 'Widow: J''ai découvert qu''il ne savait jouer qu''une seule chanson. Il l''avait apprise pour m''impressionner.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338067
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338068
    m_Localized: 'Widow: J''ai encore une photo de cette soirée.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338069
    m_Localized: 'Widow: Elle est un peu abîmée…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338070
    m_Localized: 'Widow: Maintenant, tu ne peux plus jouer pour moi. Tu m''as chanté ta dernière chanson.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338071
    m_Localized: 'Widow: Il faut que je me repose…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338072
    m_Localized: Que lui est-il arrivé ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338073
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338074
    m_Localized: 'Widow: Il est mort, putain.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338075
    m_Localized: Je comprends. Pardon de vous avoir dérangé.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338076
    m_Localized: Ce n'est pas moi qui l'ai tué.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338077
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338078
    m_Localized: 'Widow: Je suis désolée, mais je peux pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338079
    m_Localized: 'Widow: Tous les soirs, les larmes coulent. Je ne peux pas les arrêter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338080
    m_Localized: 'Widow: Mais surtout, je veux que les responsables de… tout ce qui s''est passé… je veux qu''ils brûlent au soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338081
    m_Localized: Mais… Que s'est-il passé ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338082
    m_Localized: Je peux arrêter de vous poser des questions si vous préférez.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338083
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338084
    m_Localized: 'Widow: Oui. Je sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338085
    m_Localized: 'Widow: C''était impoli de ma part. Mais c''est si dur pour moi de parler de lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338086
    m_Localized: 'Widow: J''espère que ces salopards auront ce qu''ils méritent.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338087
    m_Localized: 'Widow: Et qu''ils vont se faire buter.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338088
    m_Localized: Mais… Que s'est-il passé ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338089
    m_Localized: Je peux arrêter de vous poser des questions si vous préférez.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338090
    m_Localized: 'Widow: Mon mari ne se sentait pas bien. Il est allé à l''hôpital, mais ils l''ont envoyé chez ces fumiers.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338091
    m_Localized: 'Widow: On est allés au centre que la FEMA avait ouvert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338092
    m_Localized: 'Widow: Ils l''ont mis en quarantaine et lui ont pris son téléphone. Ils ont dit qu''il repartirait au bout de trois semaines.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338093
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338094
    m_Localized: 'Widow: J''y suis allé plus tôt, juste pour vérifier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338095
    m_Localized: 'Widow: Ils ont juste froidement…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338096
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338097
    m_Localized: 'Widow: Accordez-moi une minute. Je suis désolée.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338098
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338099
    m_Localized: 'Widow: Ils ont dit : « Il est mort. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338100
    m_Localized: 'Widow: C''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338101
    m_Localized: 'Widow: Ils ne m''ont pas laissé voir le corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338102
    m_Localized: 'Widow: Ils ne m''ont pas laissé le ramener chez moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338103
    m_Localized: 'Widow: Mais c''est toujours la pagaille avec ces abrutis. Il m''a suffi d''enfiler une blouse et d''aller à la morgue.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338104
    m_Localized: 'Widow: Et il…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338105
    m_Localized: 'Widow: Il était vraiment là…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338106
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338107
    m_Localized: 'Widow: Ils l''ont tué, son sang est sur leurs mains. Il ne me reste plus qu''à hurler que je me fiche du monde entier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338108
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338109
    m_Localized: 'Widow: J''aimerais être seule.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338110
    m_Localized: 'Widow: Oui. Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338111
    m_Localized: 'Widow: Vivre sans lui, c''est si difficile…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338112
    m_Localized: 'Widow: Il faut que je me repose…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338113
    m_Localized: Quelque chose ne va pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338114
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338115
    m_Localized: 'Widow: Je vais partir ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338116
    m_Localized: 'Widow: Je vous avais dit que je ne comptais pas rester longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338117
    m_Localized: 'Widow: J''avais juste besoin de me reposer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338118
    m_Localized: Et maintenant ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338119
    m_Localized: Vous allez voir votre famille ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338120
    m_Localized: 'Widow: Je préfère ne pas y penser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338121
    m_Localized: 'Widow: Je vais rentrer à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338122
    m_Localized: 'Widow: Je prendrai la guitare.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338123
    m_Localized: 'Widow: Et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338124
    m_Localized: Vous pouvez rester ici.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338125
    m_Localized: Bonne chance.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338126
    m_Localized: 'Widow: Il n''y a plus personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338127
    m_Localized: 'Widow: On rentre à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338128
    m_Localized: 'Widow: Je n''ai plus envie de rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338129
    m_Localized: Vous pouvez rester ici.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338130
    m_Localized: Bonne chance.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338131
    m_Localized: 'Widow: Pourquoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338132
    m_Localized: 'Widow: Ça me facilitera pas la tâche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338133
    m_Localized: 'Widow: Sans vouloir être désagréable, je n''en ai rien à faire de vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338134
    m_Localized: 'Widow: Je veux vraiment rentrer à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338135
    m_Localized: 'Widow: J''ai la force de rien, pas avant d''être chez moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338136
    m_Localized: 'Widow: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338137
    m_Localized: 'Widow: Vous parlez pas beaucoup… Pourtant j''ai apprécié notre échange.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338138
    m_Localized: 'Widow: J''espère que vous trouverez ce que vous cherchez.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338139
    m_Localized: 'Scammer: Héhé… Bien ou bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338140
    m_Localized: Tu faisais quoi avant le Cataclysme ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338141
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338142
    m_Localized: 'Scammer: Oh oh ! Je suis content que tu me le demandes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338143
    m_Localized: 'Scammer: T''as déjà entendu parler de…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338144
    m_Localized: 'Scammer: … des paris sportifs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338145
    m_Localized: Tu es quoi ? Un escroc ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338146
    m_Localized: Ouais…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338147
    m_Localized: 'Scammer: Hé, doucement, mec ! Je suis un putain d''analyste sportif.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338148
    m_Localized: 'Scammer: Si tu savais la quantité de pognon qui m''est passée dans les mains, tu baverais, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338149
    m_Localized: 'Scammer: Je suis un vrai professionnel dans mon domaine, mon vieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338150
    m_Localized: 'Scammer: Les gens m''apportaient leur argent et en récupéraient cinq… non, DIX fois plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338151
    m_Localized: Alors… Combien as-tu gagné ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338152
    m_Localized: Tu appelles ça du travail ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338153
    m_Localized: 'Scammer: C''est comme ça que je gagnais ma vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338154
    m_Localized: 'Scammer: Placer des paris, c''était juste un truc à faire, mon pote. Vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338155
    m_Localized: 'Scammer: Il y a des méthodes pour gruger les bookmakers.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338156
    m_Localized: 'Scammer: Tu paries sur une équipe et tu attends que l''argent te revienne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338157
    m_Localized: 'Scammer: Et si t''as pas d''argent, c''est pas grave ! Tu empruntes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338158
    m_Localized: Alors… Combien as-tu gagné ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338159
    m_Localized: Tu appelles ça du travail ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338160
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338161
    m_Localized: 'Scammer: Comment dire…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338162
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338163
    m_Localized: 'Scammer: J''me suis fait plus de trente… putains de millions…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338164
    m_Localized: 'Scammer: … de dettes ! Hé ouais, les dettes, ça me dérange pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338165
    m_Localized: 'Scammer: Et j''en ai absolument rien à carrer maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338166
    m_Localized: 'Scammer: Je regarde le danger droit dans les yeux, mon frère.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338167
    m_Localized: 'Scammer: Tu déconnes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338168
    m_Localized: 'Scammer: Bien sûr, c''est du travail.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338169
    m_Localized: 'Scammer: J''avais même un bureau. Mec, c''était le grand luxe…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338170
    m_Localized: 'Scammer: Un canapé brillant et un bloc-notes avec les noms des bookmakers, les sommes à payer et le bénéfice net.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338171
    m_Localized: 'Scammer: Héhé. Comment va ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338172
    m_Localized: Les huissiers ne sont toujours pas venus te chercher ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338173
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338174
    m_Localized: 'Scammer: Les huissiers ? Qu''est-ce que tu racontes, les huissiers ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338175
    m_Localized: 'Scammer: Pfff, oublie-les. Écoute, j''ai plus de dettes. Le soleil a tout cramé, problème réglé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338176
    m_Localized: 'Scammer: Les banques sont à la ramasse maintenant. Et à mon avis, elles le resteront.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338177
    m_Localized: 'Scammer: Donc je suis putain de libre. Prêt pour un nouveau coup.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338178
    m_Localized: 'Scammer: Parier, c''est bon pour les ringards. Je peux relancer une combine.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338179
    m_Localized: T'as eu du bol, avec le soleil, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338180
    m_Localized: Alors quoi ? Tu veux monter un « coup » ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338181
    m_Localized: 'Scammer: Oh, sois pas comme ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338182
    m_Localized: 'Scammer: Avant, je récupérais toujours mes pertes, je finissais toujours par régler mes dettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338183
    m_Localized: 'Scammer: Mais maintenant, je peux prendre un nouveau départ.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338184
    m_Localized: 'Scammer: D''ailleurs, j''ai une nouvelle activité. Tu veux savoir ce que c''est ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338185
    m_Localized: C'est quoi le plan ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338186
    m_Localized: Non, pas vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338187
    m_Localized: 'Scammer: J''ai trouvé un système pour me faire du fric y a un p''tit bout de temps. Je pourrais t''en parler si ça t''intéresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338188
    m_Localized: C'est quoi le plan ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338189
    m_Localized: Non, pas vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338190
    m_Localized: 'Scammer: La FEMA, tu vois ? C''est eux qui tiennent la baraque maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338191
    m_Localized: 'Scammer: Faut juste se faire bien voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338192
    m_Localized: 'Scammer: Et j''me dis que si on leur livre des gens de temps en temps, ils vont nous filer une place dans un de leurs bunkers.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338193
    m_Localized: 'Scammer: Tu piges ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338194
    m_Localized: T'as l'intention de balancer des gens à la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338195
    m_Localized: Tu penses vraiment que la FEMA va te sortir de là ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338196
    m_Localized: 'Scammer: Ben ouais, pourquoi j''le ferais pas, merde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338197
    m_Localized: 'Scammer: J''te jure, c''est comme ça qu''on va s''en sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338198
    m_Localized: 'Scammer: Les temps changent, faut se réinventer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338199
    m_Localized: 'Scammer: Faut pas rester avec le troupeau dans leurs foutues zones de quarantaine, c''est clair.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338200
    m_Localized: 'Scammer: C''est pour ça qu''il faut s''mettre la FEMA dans la poche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338201
    m_Localized: 'Scammer: Tu fermes ta gueule, tu leur files des gens…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338202
    m_Localized: 'Scammer: Même leur causer de dépistage au téléphone, histoire qu''ils pigent bien que j''suis pas un de ces foutus Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338203
    m_Localized: 'Scammer: C''est des gars bien, hein. Eux, ils sauront quoi faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338204
    m_Localized: T'as peut-être raison…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338205
    m_Localized: Ça m'a tout l'air d'être bancal, ton histoire…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338206
    m_Localized: Si tu veux tant t'acoquiner avec eux, alors casse-toi d'ici.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338207
    m_Localized: 'Scammer: Putain, mec. Tu sens rien venir ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338208
    m_Localized: 'Scammer: Faut capter qui tient les rênes maintenant et s''les mettre dans la poche. C''est comme ça qu''on s''en sort. Sérieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338209
    m_Localized: 'Scammer: Donc ouais, faut être bien vus par la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338210
    m_Localized: 'Scammer: Pas leur cracher à la gueule, non. Faut leur balancer des gens…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338211
    m_Localized: 'Scammer: Même leur causer de dépistage au téléphone, histoire qu''ils pigent bien que j''suis pas un de ces foutus Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338212
    m_Localized: 'Scammer: C''est des gars bien, hein. Eux, ils sauront quoi faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338213
    m_Localized: T'as peut-être raison…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338214
    m_Localized: Ça m'a tout l'air d'être bancal, ton histoire…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338215
    m_Localized: Si tu veux tant t'acoquiner avec eux, alors casse-toi d'ici.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338216
    m_Localized: 'Scammer: Évidemment, j''ai raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338217
    m_Localized: 'Scammer: J''ai un sixième sens pour les affaires qui rapportent, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338218
    m_Localized: 'Scammer: Fais-moi confiance, tu peux pas perdre avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338219
    m_Localized: 'Scammer: Sérieux, arrête tes conneries. T''es un putain de boulet.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338220
    m_Localized: 'Scammer: Y en a qui me payaient pour mes conseils, j''te file ça pour rien, gratos, et toi tu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338221
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338222
    m_Localized: 'Scammer: Putain. Crève.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338223
    m_Localized: 'Scammer: Quoi, tu veux me virer maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338224
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338225
    m_Localized: 'Scammer: J''croyais que t''étais un bon gars.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338226
    m_Localized: 'Scammer: J''te file un tuyau en or, et toi tu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338227
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338228
    m_Localized: 'Scammer: J''me casse, enfoiré. Va au diable.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338229
    m_Localized: 'Scammer: Franchement, c''était du lourd, ce plan. Bon, tant pis…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338230
    m_Localized: 'Scammer: Si tu changes d''avis, fais pas ton timide.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338231
    m_Localized: 'Scammer: Hé hé. Alors, mon pote ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338232
    m_Localized: Tu veux quoi, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338233
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338234
    m_Localized: 'Scammer: Écoute, j''ai trouvé une nouvelle astuce. Ça va marcher. C''est sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338235
    m_Localized: 'Scammer: OK, donc… En gros…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338236
    m_Localized: 'Scammer: Le soleil brûle comme un sauna, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338237
    m_Localized: 'Scammer: À mon avis, les couches d''ozone sont foutues.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338238
    m_Localized: 'Scammer: Mais je me suis souvenu que l''oxygène provient de la lumière du soleil qui passe à travers l''ozone.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338239
    m_Localized: 'Scammer: Alors tu sais ce que j''me suis dit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338240
    m_Localized: 'Scammer: On pourrait… VENDRE DE L''AIR !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338241
    m_Localized: 'Scammer: Ça, c''est un business solide, crois-moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338242
    m_Localized: Un plan incroyable, du pur génie.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338243
    m_Localized: Je n'ai jamais rien entendu d'aussi débile de toute ma vie.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338244
    m_Localized: 'Scammer: C''est vrai ? Tu le penses vraiment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338245
    m_Localized: Mais ouais, carrément ! Tu devrais bosser dans la science.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338246
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338247
    m_Localized: 'Scammer: Merde, bon…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338248
    m_Localized: 'Scammer: Merci. Ça fait plaisir qu''au moins une personne reconnaisse mon intelligence.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338249
    m_Localized: 'Scammer: J''obtiendrai un Darwin Award avant que tu ne t''en rendes compte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338250
    m_Localized: Tu… sais ce qu'est un Darwin Award ? Rassure-moi…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338251
    m_Localized: Oh, tu en recevras un, c'est sûr.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338252
    m_Localized: 'Scammer: Ben… C''est pour les avancées scientifiques ou un truc du genre, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338253
    m_Localized: 'Scammer: Pourquoi tu demandes ça, de toute façon ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338254
    m_Localized: Pour rien, pour rien…
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338255
    m_Localized: Les Darwin Awards sont décernés aux personnes qui meurent de façon débile.
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338256
    m_Localized: 'Scammer: Haha ! Je sens déjà le goût de la consécration scientifique dans ma bouche.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338257
    m_Localized: 'Scammer: Un paquet de pognon, un statut social, des nanas… Le rêve…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338258
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338259
    m_Localized: 'Scammer: Bon, quand tout ça sera fini, j''vais déposer un brevet pour vendre de l''air.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338260
    m_Localized: 'Scammer: D''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338261
    m_Localized: 'Scammer: Ah…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338262
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338263
    m_Localized: 'Scammer: Attends, tu te fous de moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338264
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338265
    m_Localized: 'Scammer: Va te faire foutre ! J''essaie de mettre au point des plans solides et tu te moques…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338266
    m_Localized: 'Scammer: Va te faire foutre. Je suis ici en train de penser à de vraies combines, et tu te moques…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338267
    m_Localized: 'Scammer: J''vais rafler mon Darwin Award et devenir un putain de big boss.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338268
    m_Localized: 'Scammer: Et toi tu viendras me supplier à genoux…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338269
    m_Localized: 'Parce que t''as osé me dire : « Fous-moi la paix avec tes plans bidon. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338270
    m_Localized: 'Scammer: Sérieux, mec…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338271
    m_Localized: 'Scammer: T''as vraiment du mal à m''écouter, ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080615338272
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532288
    m_Localized: 'Scammer: Peu importe, va te faire foutre. J''me ferai plus de blé sans toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532289
    m_Localized: 'Scammer: Putain, mec…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532290
    m_Localized: 'Scammer: Va te faire foutre. Je suis ici en train de penser à de vraies combines, et tu te moques…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532291
    m_Localized: 'Scammer: J''vais rafler mon Darwin Award et devenir un putain de big boss.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532292
    m_Localized: 'Scammer: Et toi tu viendras me supplier à genoux…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532293
    m_Localized: 'Neighbour: Bon sang… Alors c''est vrai, en fin de compte…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532294
    m_Localized: 'Neighbour: Eh bien, ce que je disais prend tout son sens.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532295
    m_Localized: 'Neighbour: Ne sors pas pendant la journée. Et surtout, accueille d''autres personnes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532296
    m_Localized: Vraiment ? Laisser entrer des inconnus chez moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532297
    m_Localized: Accueillir des gens ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532298
    m_Localized: 'Neighbour: Je sais bien que t''aimes pas trop voir du monde, mais t''as pas le choix.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532299
    m_Localized: 'Neighbour: Ma cousine sait pas exactement ce qu''il se passe… Juste qu''on doit pas rester seul…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532300
    m_Localized: 'Neighbour: Et si jamais quelqu''un te demande, tu dis surtout que non, que t''es pas tout seul, qu''il y a quelqu''un chez toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532301
    m_Localized: Parler aux gens, c'est une corvée pour moi.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532302
    m_Localized: Quel est l'intérêt d'être entouré de gens ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532303
    m_Localized: 'Neighbour: Ouais…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532304
    m_Localized: 'Neighbour: Je sais que t''es du genre solitaire. Mais tu dois absolument les faire entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532305
    m_Localized: 'Neighbour: Ma cousine sait pas vraiment pourquoi on ne peut pas être seuls…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532306
    m_Localized: 'Neighbour: Mais selon elle, si on te demande si tu es seul, tu réponds que non, qu''il y a quelqu''un avec toi dans la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532307
    m_Localized: Parler aux gens, c'est une corvée pour moi.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532308
    m_Localized: Quel est l'intérêt d'être entouré de gens ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532309
    m_Localized: 'Neighbour: Oui, je sais bien. Je réalise que ça va être pénible pour toi, mais t''as pas le choix. Sinon, on ne survivra pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532310
    m_Localized: 'Neighbour: Ils peuvent toujours t''apporter un truc ou te raconter quelque chose d''utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532311
    m_Localized: 'Neighbour: Surtout, teste-les pour voir si c''est des Visiteurs. Avec la chaleur, t''auras pas la force de faire ça à tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532312
    m_Localized: 'Neighbour: Alors, fais attention. Choisis bien. Les tests sont crevants, faut vraiment être observateur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532313
    m_Localized: 'Neighbour: Mais j''te rassure… Parler, ça te pompe pas d''énergie. Tu peux papoter autant que tu veux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532314
    m_Localized: 'Neighbour: Et pense à regarder dehors, par la fenêtre. La télé, c''est bien, mais ça te dit pas ce qui se passe juste à côté.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532315
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532316
    m_Localized: Qu'est-ce qu'il faut faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532317
    m_Localized: 'Neighbour: Ils peuvent toujours t''apporter un truc ou te raconter quelque chose d''utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532318
    m_Localized: 'Neighbour: Surtout, teste-les pour voir si c''est des Visiteurs. Avec la chaleur, t''auras pas la force de faire ça à tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532319
    m_Localized: 'Neighbour: Alors, fais attention. Choisis bien. Les tests sont crevants, faut vraiment être observateur.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532320
    m_Localized: 'Neighbour: Mais j''te rassure… Parler, ça te pompe pas d''énergie. Tu peux papoter autant que tu veux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532321
    m_Localized: 'Neighbour: Et pense à regarder dehors, par la fenêtre. La télé, c''est bien, mais ça te dit pas ce qui se passe juste à côté.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532322
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532323
    m_Localized: Qu'est-ce qu'il faut faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532324
    m_Localized: 'Neighbour: J''ai peur que tout ce qu''on puisse faire, c''est essayer de survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532325
    m_Localized: 'Neighbour: Et espérer que ce cauchemar se termine bientôt.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532326
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532327
    m_Localized: 'Neighbour: Je suis sûr que le gouvernement finira par intervenir. Ils trouveront bien un moyen de mettre tout le monde à l''abri.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532328
    m_Localized: 'Neighbour: Si c''est le cas, reste avec ma famille.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532329
    m_Localized: 'Neighbour: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532330
    m_Localized: 'Neighbour: Oh, j''ai failli oublier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532331
    m_Localized: 'Neighbour: Je rentre chez moi demain soir. Prends mon numéro pour que tu puisses me joindre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532332
    m_Localized: 'Neighbour: On vient de faire installer la ligne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532333
    m_Localized: 'Neighbour: XX-XX-XX-XX-XX'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532334
    m_Localized: 'Neighbour: On se téléphone pour se donner des nouvelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532335
    m_Localized: 'Neighbour: Voilà, je crois que j''ai tout dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532336
    m_Localized: 'Neighbour: Ah, j''ai aussi pensé à t''apporter une caisse de bière. Mon beau-frère travaille dans une brasserie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532337
    m_Localized: 'Neighbour: Tu peux en boire une pour t''endormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532338
    m_Localized: 'Neighbour: Ça assomme pas mal. Donc si tu veux juste être tranquille, bois une bière et repose-toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532339
    m_Localized: 'Daughter: Je… Je veux ma m-maman.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532340
    m_Localized: Raconte-moi ce qui s'est passé.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532341
    m_Localized: Je voudrais m'assurer que tu n'as pas de bobo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532342
    m_Localized: 'Daughter: Je sais paaaaas…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532343
    m_Localized: 'Daughter: Ils sont entrés et-et-et ils ont discuté, et-et-et papa a dit que c''était mal, et-et-et ils ont dit… ils ont dit…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532344
    m_Localized: 'Daughter: PAPA !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532345
    m_Localized: 'Daughter: PA-A-APAA !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532346
    m_Localized: Essaie… de te reposer pour le moment.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532347
    m_Localized: On en reparlera demain, d'accord ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532348
    m_Localized: 'Daughter: (La fillette réclame son père sans arrêt, rien ne peut apaiser ses crises d''hystérie.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532349
    m_Localized: 'Daughter: (La petite fille ne vous entend même pas. Elle est seule dans son malheur.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532350
    m_Localized: 'Daughter: Je… Je veux ma m-maman.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532351
    m_Localized: Comment vas-tu ? Tu te plais ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532352
    m_Localized: Je voudrais m'assurer que tu n'as pas de bobo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532353
    m_Localized: 'Daughter: C''est pas trop mal chez toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532354
    m_Localized: 'Daughter: Je voudrais être à la maison…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532355
    m_Localized: 'Daughter: Quand est-ce que je pourrai rentrer chez moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532356
    m_Localized: Plus tard… La maison est en train d'être rénovée.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532357
    m_Localized: C'est pas pour tout de suite. Ta maison a brûlé.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532358
    m_Localized: 'Daughter: D''accord. Alors, ils vont bientôt venir me chercher ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532359
    m_Localized: 'Daughter: Et ils vont m''emmener dans une nouvelle maison ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532360
    m_Localized: 'Daughter: Ou dans la même ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532361
    m_Localized: 'Daughter: Ils me font une nouvelle chambre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532362
    m_Localized: 'Daughter: Alors, papa va quand même venir me chercher, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532363
    m_Localized: Tu sais ce qui s'est passé…
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532364
    m_Localized: Tu devrais rester ici pour l'instant.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532365
    m_Localized: 'Daughter: Mais papa va bien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532366
    m_Localized: 'Daughter: Et ma chambre ? Est-ce qu''elle a brûlé aussi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532367
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532368
    m_Localized: 'Daughter: Maman vient pas nous rejoindre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532369
    m_Localized: 'Daughter: Est-ce qu''il reste encore quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532370
    m_Localized: Tu sais ce qui s'est passé…
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532371
    m_Localized: Tu devrais rester ici pour l'instant.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532372
    m_Localized: 'Daughter: Je sais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532373
    m_Localized: 'Daughter: Je ne suis pas sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532374
    m_Localized: 'Daughter: Ils ont cogné Papa, mais il s''est relevé. J''ai tout vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532375
    m_Localized: 'Daughter: Ça veut dire… Ça veut dire qu''il aurait pu éteindre le feu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532376
    m_Localized: 'Daughter: Ou juste venir me chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532377
    m_Localized: 'Daughter: Est-ce qu''il va bientôt venir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532378
    m_Localized: 'Daughter: Moi, je vais nulle part sans mon papa.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532379
    m_Localized: 'Daughter: Il vient me chercher, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532380
    m_Localized: 'Daughter: J''ai vu qu''il s''est levé et qu''il est parti.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532381
    m_Localized: 'Daughter: Je courais, mais j''ai tout vu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532382
    m_Localized: 'Daughter: Je… Je veux ma m-maman.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532383
    m_Localized: Tu dois accepter ce qui s'est passé.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532384
    m_Localized: Je voudrais m'assurer que tu n'as pas de bobo.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532385
    m_Localized: 'Daughter: Comment ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532386
    m_Localized: 'Daughter: Y a une télé dans ta chambre. Je peux regarder des dessins animés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532387
    m_Localized: Je ne sais pas ce que tu as vu. Mais je crois que ton père est mort.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532388
    m_Localized: Ton père ne viendra peut-être pas te chercher. Je ne sais pas ce qui lui est arrivé.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532389
    m_Localized: 'Daughter: Toi, t''as rien vu du tout ! Alors, tais-toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532390
    m_Localized: 'Daughter: Moi, j''étais là ! Il était en train de bouger quand j''ai couru.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532391
    m_Localized: 'Daughter: Et ça, ça veut dire qu''il va bientôt arriver !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532392
    m_Localized: Pourquoi est-ce qu'il est pas encore venu te chercher ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532393
    m_Localized: À quoi il ressemblait la dernière fois que tu l'as vu ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532394
    m_Localized: 'Daughter: Il va pas venir ? Pourquoi tu dis ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532395
    m_Localized: Alors, pourquoi est-ce qu'il n'est pas encore venu te chercher ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532396
    m_Localized: À quoi il ressemblait la dernière fois que tu l'as vu ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532397
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532398
    m_Localized: 'Daughter: Il avait peut-être des trucs à faire d''abord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532399
    m_Localized: 'Daughter: Peut-être qu''il est allé casser la figure aux méchants.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532400
    m_Localized: 'Daughter: Il… Il va bientôt arriver. C''est obligé…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532401
    m_Localized: Je suis tellement désolée pour ton père. C'était quelqu'un de bien. Mais il était trop gentil.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532402
    m_Localized: D'accord, d'accord… Tu as raison, ton père va probablement bientôt arriver.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532403
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532404
    m_Localized: 'Daughter: Il était gentil.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532405
    m_Localized: 'Daughter: Ils l''ont frappé… alors…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532406
    m_Localized: 'Daughter: Je me rappelle plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532407
    m_Localized: Je suis tellement désolée pour ton père. C'était quelqu'un de bien. Mais il était trop gentil.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532408
    m_Localized: D'accord, d'accord… Tu as raison, ton père va probablement bientôt arriver.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532409
    m_Localized: 'Daughter: (La fillette vous transperce du regard. Vous hésitez à bouger, alors vous attendez qu''il se passe quelque chose.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532410
    m_Localized: 'Daughter: (Au bout d''un certain temps, elle se met à pleurer. Vous vous sentez, à juste titre, impuissant.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532411
    m_Localized: 'Daughter: (Ce serait pire de la laisser croire à un mensonge. Il faut qu''elle accepte la réalité le plus tôt possible.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532412
    m_Localized: 'Daughter: Je m''en doutais un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532413
    m_Localized: 'Daughter: (La fillette a l''air perdue dans ses pensées. Elle est manifestement en train de réfléchir à quelque chose.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532414
    m_Localized: 'Daughter: (Mais est-ce que ça vaut la peine de gâcher son enfance ? Peut-elle supporter un tel choc ?)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532415
    m_Localized: 'Daughter: (Vous décidez qu''elle a assez de problèmes pour l''instant. Il n''y a aucune raison de la chagriner davantage.)'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532416
    m_Localized: 'NotTrue: Bon sang de bonsoir, c''est que j''deviens vieille, moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532417
    m_Localized: D'où est-ce que vous venez ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532418
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532419
    m_Localized: 'NotTrue: Mais oui, mais oui, et alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532420
    m_Localized: 'NotTrue: Ils viennent m''écouter, ils me pressent comme une prune mûre… et puis ils m''en veulent d''avoir su.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532421
    m_Localized: 'NotTrue: T''imagines un peu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532422
    m_Localized: 'NotTrue: J''ai une maisonnette, tu sais… une vraie, avec des murs qui craquent comme des vieux genoux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532423
    m_Localized: 'NotTrue: J''y suis bien, mais j''me ratatine si j''suis toute seule.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532424
    m_Localized: 'NotTrue: Et qui viendrait dans mon trou de taupe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532425
    m_Localized: 'NotTrue: Alors j''pars en vadrouille, j''me promène… Après tout, j''ai rien à perdre…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532426
    m_Localized: 'NotTrue: Bon sang de bonsoir, c''est que j''deviens vieille, moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532427
    m_Localized: Vous n'avez pas de famille ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532428
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532429
    m_Localized: 'NotTrue: Oh, des histoires toutes simples. Je les ramasse là où je vais, comme des pommes tombées.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532430
    m_Localized: 'NotTrue: Après, je les raconte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532431
    m_Localized: 'NotTrue: Mais j''suis vieille, moi. J''m''en rappelle plus bien. Alors j''les raconte plus tard, à ma façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532432
    m_Localized: 'NotTrue: Et ça plaît pas toujours…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532433
    m_Localized: 'NotTrue: Mais c''est pas moi qui dirais qu''le chagrin, c''est ce qu''y a d''pire. Le pire ? C''est l''attente.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532434
    m_Localized: 'NotTrue: Mais j''suis pas la seule à enjoliver un peu. Hein, tu comprends ? Hé hé.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532435
    m_Localized: 'NotTrue: Tout l''monde vient à moi, tôt ou tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532436
    m_Localized: 'NotTrue: Les gens… ils ont tous besoin d''histoires.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532437
    m_Localized: 'NotTrue: Bon sang de bonsoir, c''est que j''deviens vieille, moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532438
    m_Localized: Pourquoi votre mari n'est-il pas avec vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532439
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532440
    m_Localized: 'NotTrue: Quoi, tu veux une histoire ? D''accord, d''accord…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532441
    m_Localized: 'NotTrue: L''homme, c''est un être de peur, faut pas croire.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532442
    m_Localized: 'NotTrue: J''en ai connu un, il s''était calfeutré tout seul dans une grande tour.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532443
    m_Localized: 'NotTrue: Il s''était barricadé. Plus un mot à personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532444
    m_Localized: 'NotTrue: Il avait peur, tu comprends ? Peur des Visiteurs… ou de la mort qui gratte à la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532445
    m_Localized: 'NotTrue: Personne allait le voir. D''toute façon, il aurait pas ouvert.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532446
    m_Localized: 'NotTrue: Et puis un jour…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532447
    m_Localized: 'NotTrue: Un jour, j''ai entendu un gros boum. BOOUUM !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532448
    m_Localized: 'NotTrue: J''ai pas compris tout de suite.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532449
    m_Localized: 'NotTrue: J''ai regardé par la fenêtre. Il avait sauté.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532450
    m_Localized: 'NotTrue: Il a fini par craquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532451
    m_Localized: 'NotTrue: Alors, elle te plaît mon histoire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532452
    m_Localized: Euh… Pas vraiment.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532453
    m_Localized: Euh… C'est déjà fini ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532454
    m_Localized: 'NotTrue: Bah. C''est p''têt pour ça que les gens m''aiment pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532455
    m_Localized: 'NotTrue: Bah, c''est pas grave. Un jour, j''raconterai ton histoire… à ma façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532456
    m_Localized: 'NotTrue: L''homme ? Ouais, il s''est écrabouillé, l''homme.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532457
    m_Localized: 'NotTrue: Peut-être qu''il avait peur de souffrir, de brûler vif quand le soleil exploserait… ou bien peur d''autre chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532458
    m_Localized: 'NotTrue: Moi j''crois que son pauvre cœur a lâché d''un coup, à cause de la solitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532459
    m_Localized: 'NotTrue: Mais bon… hein… que veux-tu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532460
    m_Localized: 'NotTrue: Bon sang de bonsoir, c''est que j''deviens vieille, moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532461
    m_Localized: Alors, c'était comment de passer son temps assise sur un banc ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532462
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532463
    m_Localized: 'NotTrue: Bon, tiens, écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532464
    m_Localized: 'NotTrue: Quand j''habitais au village, y avait un homme, là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532465
    m_Localized: 'NotTrue: Il aimait bien marcher dans la forêt. J''sais pas pourquoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532466
    m_Localized: 'NotTrue: Mais il y allait. Et puis un jour… et il s''est rendu compte qu''il était perdu. Impossible de retrouver le sentier.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532467
    m_Localized: 'NotTrue: Alors, il s''est arrêté pour réfléchir. Il s''est dit : « Si je marche tout droit, je finirai par ressortir quelque part. »'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532468
    m_Localized: 'NotTrue: Il a marché, marché… et rien. Pas de sortie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532469
    m_Localized: 'NotTrue: C''est là qu''il a compris… il tournait en rond !'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532470
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532471
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532472
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532473
    m_Localized: C'est idiot.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532474
    m_Localized: 'NotTrue: Ils l''ont retrouvé mort. Jamais réussi à ressortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532475
    m_Localized: 'NotTrue: Il est jamais sorti. On a retrouvé ses traces, qui tournaient en rond, sans fin, vers son destin funeste.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532476
    m_Localized: 'NotTrue: Tu sais ce qu''on dit… Y a toujours une jambe qui fait des pas plus longs que l''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532477
    m_Localized: 'NotTrue: Voilà. C''est comme ça que ça s''est fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532478
    m_Localized: 'NotTrue: Quoi ? T''aimes pas mon histoire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532479
    m_Localized: 'NotTrue: Bah, j''ai brodé un peu, c''est vrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532480
    m_Localized: 'NotTrue: Mais c''est arrivé. Et ça arrive encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532481
    m_Localized: 'NotTrue: Les gens marchent, se perdent… Mais qui sait comment on retrouve la sortie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532482
    m_Localized: 'Alkonost: Il faut que je rassemble mes forces. Si seulement quelqu''un pouvait m''en prêter un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532483
    m_Localized: Comment va votre sœur ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532484
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532485
    m_Localized: 'Alkonost: Je suis obligée de l''aider. Pour tout un tas de choses.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532486
    m_Localized: 'Alkonost: J''ai pu lui donner un bain hier. Elle ne pouvait même pas entrer dans la baignoire à la maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532487
    m_Localized: 'Alkonost: Pas d''améliorations pour l''instant. Mais merci de demander.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532488
    m_Localized: 'Alkonost: Les personnes dépressives sont vraiment… compliquées.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532489
    m_Localized: 'Alkonost: J''ai peur qu''en cas d''urgence, elle n''arrive pas à trouver la force de fuir avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532490
    m_Localized: 'Alkonost: Ou qu''elle arrête de manger parce qu''elle n''en a plus la force.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532491
    m_Localized: 'Alkonost: Moi aussi, je suis fatiguée. Je crois que je vais me reposer un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532492
    m_Localized: 'Alkonost: Il faut que je rassemble mes forces. Si seulement quelqu''un pouvait m''en prêter un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532493
    m_Localized: Qu'allez-vous faire ensuite ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532494
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532495
    m_Localized: 'Alkonost: Bonne question.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532496
    m_Localized: 'Alkonost: Mon mari devrait bientôt venir nous rejoindre. J''espère qu''il va pouvoir trouver un abri sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532497
    m_Localized: 'Alkonost: Un endroit où on pourrait attendre la fin des attaques de Visiteurs et de la canicule.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532498
    m_Localized: 'Alkonost: Selon lui, ce genre d''endroit existe. Il dit aussi que le soleil ne peut pas exploser.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532499
    m_Localized: 'Alkonost: Si ça devait arriver, on serait anéantis en moins de 10 minutes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532500
    m_Localized: 'Alkonost: Je crois qu''il a raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532501
    m_Localized: 'Alkonost: Il faut que je rassemble mes forces. Si seulement quelqu''un pouvait m''en prêter un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532502
    m_Localized: Des nouvelles de votre mari ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532503
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532504
    m_Localized: 'Alkonost: Je ne sais pas pourquoi, mais il ne m''a pas du tout contactée. Il n''a pas appelé et il n''est pas venu nous chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532505
    m_Localized: 'Alkonost: Est-ce qu''il lui est arrivé quelque chose ? Est-ce qu''il a eu des ennuis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532506
    m_Localized: 'Alkonost: Une chose est sûre : il ne nous a pas abandonnées. C''est impossible.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532507
    m_Localized: 'Alkonost: Même quand il ne supportait plus ma sœur, il me donnait un coup de main pour s''occuper d''elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532508
    m_Localized: 'Alkonost: Il… Il est sûrement en route.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532509
    m_Localized: 'Alkonost: Et ma sœur a l''air d''aller un peu mieux… Donc… Il va venir. Et tout ira mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532510
    m_Localized: 'Alkonost: Il faut que je rassemble mes forces. Si seulement quelqu''un pouvait m''en prêter un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532511
    m_Localized: Vous avez l'air mélancolique.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532512
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532513
    m_Localized: 'Alkonost: Hm ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532514
    m_Localized: 'Alkonost: Oh. Certainement.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532515
    m_Localized: 'Alkonost: Je me pose beaucoup de questions…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532516
    m_Localized: 'Alkonost: Si le soleil n''explose pas, pourquoi fait-il si chaud ? Pourquoi les gens sont-ils obsédés par la fin du monde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532517
    m_Localized: 'Alkonost: J''ai regardé les infos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532518
    m_Localized: 'Alkonost: Ils ne l''ont pas dit explicitement, mais apparemment, les journées sont de plus en plus chaudes.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532519
    m_Localized: 'Alkonost: La météo change. Ce qui veut dire que les animaux meurent parce qu''ils ne peuvent pas s''adapter au nouveau… climat.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532520
    m_Localized: 'Alkonost: Qu''est-ce qui va nous arriver ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532521
    m_Localized: 'Alkonost: Il faut que je rassemble mes forces. Si seulement quelqu''un pouvait m''en prêter un peu…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532522
    m_Localized: Hé, comment allez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532523
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532524
    m_Localized: 'Alkonost: Hm ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532525
    m_Localized: 'Alkonost: Oh. Probablement.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532526
    m_Localized: 'Alkonost: J''ai pas mal de choses en tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532527
    m_Localized: 'Alkonost: Si le soleil n''explose pas, pourquoi fait-il encore si chaud ? Pourquoi les gens ne pensent-ils qu''à la fin du monde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532528
    m_Localized: 'Alkonost: J''ai regardé les infos.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532529
    m_Localized: 'Alkonost: Ils ne l''ont pas dit explicitement, mais il semblerait que la chaleur continue de s''intensifier le jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532530
    m_Localized: 'Sirin: C''est la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532531
    m_Localized: Que va-t-il nous arriver ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532532
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532533
    m_Localized: 'Sirin: Je me sens…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532534
    m_Localized: 'Sirin: Comme s''il y avait une lourde couverture. Très lourde.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532535
    m_Localized: 'Sirin: Qui pèse sur mon corps.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532536
    m_Localized: 'Sirin: Je… ne veux pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532537
    m_Localized: 'Sirin: C''est la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532538
    m_Localized: Vous avez l'air un peu plus gai aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532539
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532540
    m_Localized: 'Sirin: Ouais.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532541
    m_Localized: 'Sirin: Que savez-vous au sujet du soleil ? Qu''il est en train d''exploser ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532542
    m_Localized: 'Sirin: J''ai découvert ça ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532543
    m_Localized: 'Sirin: Alors, c''est la fin ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532544
    m_Localized: 'Sirin: Il ne restera plus aucune trace de notre existence ?'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532545
    m_Localized: 'Sirin: Voilà une idée intéressante…'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532546
    m_Localized: 'Sirin: C''est la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532547
    m_Localized: Comment se porte votre sœur ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532548
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532549
    m_Localized: 'Sirin: Elle a peur de tout perdre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532550
    m_Localized: 'Sirin: Mais je ne pense pas que nous ayons quoi que ce soit à perdre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532551
    m_Localized: 'Sirin: Dans ce monde en perpétuelle expansion, nous ne sommes que des grains de poussière.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532552
    m_Localized: 'Sirin: Personne n''a besoin de nous… parce qu''il n''y a personne d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532553
    m_Localized: 'Sirin: Si la planète venait à disparaître, personne ne nous pleurerait. Et quand bien même, ils n''en ont pas envie.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532554
    m_Localized: 'Sirin: Mais ma sœur est terrifiée à cette idée.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532555
    m_Localized: 'Sirin: C''est la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532556
    m_Localized: Est-ce que votre sœur est malade ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532557
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532558
    m_Localized: 'Sirin: En effet, elle a décidé de partir à la recherche de son mari pour éviter d''avoir des idées noires.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532559
    m_Localized: 'Sirin: Je sens que c''est une mauvaise idée. Mais elle ne peut pas rester les bras croisés.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532560
    m_Localized: 'Sirin: Si elle persiste à vouloir partir à sa recherche, alors il faudra que je l''accompagne.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532561
    m_Localized: 'Sirin: Je ne peux pas la perdre avant de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532562
    m_Localized: 'Sirin: C''est la fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532563
    m_Localized: Alors, vous êtes sortie ?
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532564
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532565
    m_Localized: 'Sirin: Oui. Elle est tombée sur le corps de son mari.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532566
    m_Localized: 'Sirin: Il lui a dit que tout irait mieux, puis il s''est suicidé… Il avait trop peur de la vraie fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080619532567
    m_Localized: 'Sirin: Je crois qu''elle est à bout de forces.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726592
    m_Localized: 'Sirin: Maintenant, c''est moi qui vais devoir m''occuper d''elle jusqu''à ce que nous mourions tous.'
    m_Metadata:
      m_Items: []
  - m_Id: 22080623726593
    m_Localized: 'Sirin: Et puis, un jour, il ne restera plus rien à redouter, à craindre, à regretter ou à cacher. Plus rien à porter.'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166080
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166081
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166082
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166083
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166084
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166085
    m_Localized: 'Alkonost: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166086
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166087
    m_Localized: La laisser tranquille.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166088
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166089
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166090
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160821166091
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360384
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360385
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360386
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 23514160825360387
    m_Localized: La laisser tranquille.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713862
    m_Localized: 'NotTrue: Moi, j''viens d''la ville, mon poussin. J''avais un petit appartement là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713863
    m_Localized: 'NotTrue: Pas de maison à la campagne, pas de famille, pas de petits-enfants… Oh, que c''est triste…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713864
    m_Localized: 'NotTrue: Alors, je passais le temps assise sur un banc, devant ma porte. Là, y avait un peu d''vie, j''écoutais les ragots.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713865
    m_Localized: 'NotTrue: Mais quand les ennuis sont arrivés, même ça, ça m''a plus rien apporté de bon.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713866
    m_Localized: 'NotTrue: Comment tu veux t''sentir vivante quand la faucheuse rôde partout ? Les gens claquent les uns après les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713867
    m_Localized: 'NotTrue: Il suffisait de mettre le pied dans la cage d''escalier pour en voir un nouveau allongé là, recouvert d''un drap blanc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713868
    m_Localized: 'NotTrue: Franchement, à force, t''as juste envie de fermer les yeux pour de bon plutôt que d''voir ça encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713869
    m_Localized: 'NotTrue: Alors, j''me suis sauvée… histoire de trouver un coin où y a encore des gens, des histoires, un peu de chaleur humaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713870
    m_Localized: 'NotTrue: Et v''là donc pas qu''le destin m''a menée droit devant ta porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713871
    m_Localized: 'NotTrue: J''suis pas une grenouille de bénitier, mais… J''ai comme l''impression que c''est l''bon Dieu qu''a guidé mes pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713872
    m_Localized: 'NotTrue: Mais tout le monde m''a oubliée, mon petit.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713873
    m_Localized: 'NotTrue: S''il reste une personne en vie, c''est pas moi qu''elle viendra voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713874
    m_Localized: 'NotTrue: Et à vrai dire, j''suis pas la seule dans ce cas-là. Y en a plein qui oublient leur propre famille…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713875
    m_Localized: 'NotTrue: Les gens pensent qu''à eux. Personne appelle pour prendre des nouvelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713876
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713877
    m_Localized: 'NotTrue: Un jour, j''étais assise sur mon banc et ma voisine s''est mise à se vanter de son petit-fils.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713878
    m_Localized: 'NotTrue: « Mon garçon est un si bon garçon ! Il respecte ses aînés, il me rend visite. Pas comme les autres ! » qu''elle disait…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713879
    m_Localized: 'NotTrue: Et c''était vrai, c''était un bon gars. Il m''disait toujours bonjour, il m''demandait comment qu''ça allait.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713880
    m_Localized: 'NotTrue: Peut-être bien même que j''étais un peu jalouse…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713881
    m_Localized: 'NotTrue: Mais malheureusement… La faucheuse est venue la chercher…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713882
    m_Localized: 'NotTrue: Et le gamin… Eh ben, ni une ni deux… Il est devenu méchant et aigri.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713883
    m_Localized: 'NotTrue: Finalement, sa gentillesse, c''était juste pour l''appartement. Il voulait en hériter… C''est tout…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713884
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713885
    m_Localized: 'NotTrue: Pourquoi tu crois qu''les gens sont si niais que ça, hein ? Surtout en famille ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713886
    m_Localized: 'NotTrue: On s''marie, on fait des gosses, et après… C''est pas facile à accepter… Mais en fait, ils t''aiment pas du tout !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713887
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713888
    m_Localized: 'NotTrue: Eh ben, j''vais t''dire… J''ai de la chance, moi ! J''ai plus d''mari. C''était un vieux grincheux. Pouah !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713889
    m_Localized: 'NotTrue: Ah, mais lui aussi, il est mort à présent, mon poussin.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713890
    m_Localized: 'NotTrue: Il m''a pourri la vie, ce vieux grincheux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713891
    m_Localized: 'NotTrue: Je l''ai épousé uniquement parce que mes parents m''y ont poussée.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713892
    m_Localized: 'NotTrue: « Épouse-le, ma fille », qu''ils disaient. Alors, je l''ai fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713893
    m_Localized: 'NotTrue: Au début, il était vraiment attentionné. Mais à peine la nuit de noces terminée, le pourri de sa nature est ressorti.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713894
    m_Localized: 'NotTrue: Toujours à râler sur ma tambouille. Et c''était des « Fous-moi la paix, tu vois pas que j''mange ? » à longueur de repas…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713895
    m_Localized: 'NotTrue: Et plus il vieillissait, plus il traînait au bistrot avec ses potes, disparaissant des heures.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713896
    m_Localized: 'NotTrue: Il revenait bourré et il m''racontait des histoires à dormir debout sur ses parties de dominos dans le garage.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713897
    m_Localized: 'NotTrue: Et si j''osais lui demander s''il avait picolé, j''me faisais engueuler comme du poisson pourri… Ce vieux débris.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713898
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713899
    m_Localized: 'NotTrue: Et la faucheuse est venue le chercher, lui aussi…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713900
    m_Localized: 'NotTrue: Au début, je me sentais soulagée. Mais le vide s''est installé plus vite que j''aurais jamais cru.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713901
    m_Localized: 'NotTrue: La télé m''a occupée un temps… Mais maintenant, c''est qu''un ramassis de bobards.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713902
    m_Localized: 'NotTrue: Alors, j''me suis installée sur mon banc, au bord de la route.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713903
    m_Localized: 'NotTrue: Ah, mon poussin…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713904
    m_Localized: 'NotTrue: Ça m''réchauffait d''voir la vie : les rires d''enfants, les jeunes qui se tiennent par la main, les chiens qui trottent…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713905
    m_Localized: 'NotTrue: Et puis paf, le malheur est arrivé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713906
    m_Localized: 'NotTrue: Et un par un, les gens se sont enfermés chez eux. Plus personne assis dehors le soir à regarder la vie grouiller.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713907
    m_Localized: 'NotTrue: Et regarder par la fenêtre, c''était guère mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713908
    m_Localized: 'NotTrue: Là où les gamins jouaient, y avait des sacs à cadavres, des chiens errants et des voisins qui s''regardaient de travers.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713909
    m_Localized: 'NotTrue: La vie, mon gamin… C''est comme si elle s''était arrêtée d''un coup.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713910
    m_Localized: 'NotTrue: Et maintenant, on ne sait même plus distinguer le vrai du faux…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713911
    m_Localized: 'NotTrue: Si seulement les gens arrêtaient leurs salades…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083328
    m_Localized: 'Firefighter: Bon sang… *tousse*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083329
    m_Localized: 'Firefighter: Dites-moi, mon vieux. Si c''est pas trop vous demander… Vous ne voudriez pas les appeler ? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083330
    m_Localized: …
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083331
    m_Localized: 'Firefighter: Je ne leur demande pas de venir me chercher… Je n''ai pas besoin d''adieux… Dis-leur juste…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083332
    m_Localized: 'Firefighter: Dites-leur juste que leur papa ne s''est pas défilé… qu''il est juste… resté là où on avait besoin de lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083333
    m_Localized: 'Firefighter: *tousse* *tousse* C''est la seule chose qui compte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083334
    m_Localized: 'Theorist: Allez-y, je vous en prie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083335
    m_Localized: C'est quoi ces papiers au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083336
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083337
    m_Localized: 'Theorist: Vous n''imaginez pas ce que contiennent ces dossiers. Certains passages sont… vraiment intéressants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083338
    m_Localized: 'Theorist: Tenez, là, par exemple. Une théorie particulièrement fascinante.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083339
    m_Localized: 'Theorist: Elle affirme que les Visiteurs n''existent pas. Ce serait un plan du gouvernement pour gérer la surpopulation.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083340
    m_Localized: 'Theorist: Franchement, ça se lit bien… et bizarrement, c''est plutôt logique.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083341
    m_Localized: 'Theorist: La surpopulation reste un problème, qu''on le veuille ou non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083342
    m_Localized: 'Theorist: Peut-être que c''est comme ça qu''ils ont choisi de « régler » le problème.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083343
    m_Localized: 'Theorist: Allez-y, je vous en prie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083344
    m_Localized: Vous êtes encore en train de fouiller dans vos papiers ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083345
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083346
    m_Localized: 'Theorist: Tout à fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083347
    m_Localized: 'Theorist: J''ai plein d''autres théories, si ça vous intéresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083348
    m_Localized: 'Theorist: Tenez, regardez celle-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083349
    m_Localized: 'Theorist: Accrochez-vous bien : la FEMA *serait* les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083350
    m_Localized: 'Theorist: Leurs combinaisons les couvrent complètement. Impossible de les tester.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083351
    m_Localized: 'Theorist: Fascinant. J''aime beaucoup leur version de FEMA : « Force d''Extermination Massive Appliquée ».'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083352
    m_Localized: 'Theorist: Ou peut-être que c''était autre chose… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083353
    m_Localized: 'Theorist: Allez-y, je vous en prie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083354
    m_Localized: Alors, qu'avez-vous découvert cette fois-ci ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083355
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083356
    m_Localized: 'Theorist: Apparemment, les Visiteurs sont des skinwalkers.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083357
    m_Localized: 'Theorist: On dirait un passage sorti tout droit d''un roman de science-fiction, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083358
    m_Localized: 'Theorist: Et pourtant… Il y a peut-être un fond de vérité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083359
    m_Localized: 'Theorist: Dans un rapport, un témoin a raconté avoir vu un homme pâle errer dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083360
    m_Localized: 'Theorist: Cela dit, j''ai remarqué que l''auteur a fait une erreur assez… évidente.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083361
    m_Localized: 'Theorist: Il affirme qu''il y avait DEUX silhouettes pâles et inquiétantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083362
    m_Localized: 'Theorist: L''une a été aperçue par la fenêtre, l''autre sur le pas de la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083363
    m_Localized: 'Theorist: Franchement… C''est forcément la même personne, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083364
    m_Localized: "Theorist: À mon avis, la vitre était déformée et ça a modifié l'apparence du visage.\n  C'est une erreur de perception, voilà tout."
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083365
    m_Localized: 'Theorist: Quoi qu''il en soit, c''est intéressant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083366
    m_Localized: 'Theorist: Allez-y, je vous en prie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083367
    m_Localized: Et si c'était vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083368
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083369
    m_Localized: 'Theorist: Qu''est-ce que la vérité, au fond ? Un concept changeant, façonné par notre regard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083370
    m_Localized: 'Theorist: Ce que l''un croit vrai, l''autre le tient pour un mensonge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083371
    m_Localized: 'Theorist: Ce que l''un juge bon, un autre le verra comme mauvais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083372
    m_Localized: 'Theorist: L''humanité en débat depuis toujours. Et aujourd''hui ? Plus aucun repère moral.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083373
    m_Localized: 'Theorist: Si vos convictions sont fortes, comme les miennes, elles deviennent alors votre vérité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083374
    m_Localized: 'Theorist: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083375
    m_Localized: 'Theorist: Hmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083376
    m_Localized: 'Theorist: Intrigant, cet article. De quoi parlait-on déjà ? Ah oui, la vérité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083377
    m_Localized: 'Theorist: N''oubliez surtout pas qu''il n''y a qu''une vérité : les Visiteurs sont des parasites cérébraux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083378
    m_Localized: 'Theorist: Gardez des bouchons d''oreilles. En permanence. Et tout ira bien !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083379
    m_Localized: 'Theorist: Bon, j''ai encore beaucoup de choses à lire. Ne me dérangez pas. J''ai besoin de me concentrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083380
    m_Localized: 'Wifefema: C''est quoi, le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083381
    m_Localized: Tu as dit que tu travaillais à la douane avant, pas vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083382
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083383
    m_Localized: 'Wifefema: Ouais, c''était pas des cracs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083384
    m_Localized: 'Wifefema: Au fait, t''as déjà regardé si les gens avaient des signes qui montraient que c''étaient des Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083385
    m_Localized: 'Wifefema: Bon sang, tout ça, c''est complètement débile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083386
    m_Localized: 'Wifefema: Qui est le génie qui a décidé d''appeler ces monstres des Visiteurs ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083387
    m_Localized: 'Wifefema: On aurait dû leur trouver un nom plus adapté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083388
    m_Localized: 'Wifefema: C''est quoi, le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083389
    m_Localized: Pourquoi détestes-tu autant les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083390
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083391
    m_Localized: 'Wifefema: C''est quoi cette question débile ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083392
    m_Localized: 'Wifefema: C''est à cause d''eux que tout est parti en vrille ! Tu regardes pas les infos ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083393
    m_Localized: 'Wifefema: Le soleil explose, les gens tombent comme des mouches dans la rue. Et tout ça, c''est à cause d''eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083394
    m_Localized: 'Wifefema: Je te jure que si je pouvais, je les buterais tous, jusqu''au dernier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083395
    m_Localized: 'Wifefema: Donne-moi juste un peu de temps. Je vais les flairer de loin, comme à la frontière, tu vas voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083396
    m_Localized: 'Wifefema: Si seulement les gars de la FEMA voulaient bien m''embaucher…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083397
    m_Localized: 'Wifefema: C''est quoi, le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083398
    m_Localized: Pourquoi est-ce que tu veux autant travailler pour la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083399
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083400
    m_Localized: 'Wifefema: Parce que j''en ai quelque chose à faire, voilà pourquoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083401
    m_Localized: 'Wifefema: Je sais qu''on peut encore arrêter ces fichus Visiteurs. Il faut les arrêter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083402
    m_Localized: 'Wifefema: J''ai même dénoncé mon voisin. J''ai fait mon devoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083403
    m_Localized: 'Wifefema: Et eux, qu''est-ce qu''ils font ? Ils ont recruté mon mari ! Mais pas moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083404
    m_Localized: 'Wifefema: Comprends bien, je suis très fière que mon mari ait été embauché, mais bon, quand même…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083405
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083406
    m_Localized: 'Wifefema: Franchement ? Ça m''a fait l''effet de me prendre une bonne grosse claque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083407
    m_Localized: 'Wifefema: C''est quoi, le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083408
    m_Localized: Pourquoi as-tu dénoncé ton voisin, au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083409
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083410
    m_Localized: 'Wifefema: Je t''ai déjà dit pourquoi : c''était un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083411
    m_Localized: 'Wifefema: Et il me foutait les jetons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083412
    m_Localized: 'Wifefema: Franchement ? Ça m''a fait un bien fou de le dénoncer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083413
    m_Localized: 'Wifefema: Ça m''a rappelé le bon vieux temps à la douane.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083414
    m_Localized: 'Wifefema: C''est à ce moment-là que j''ai compris que je devais à tout prix rejoindre la FEMA !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083415
    m_Localized: 'Wifefema: C''est quoi, le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083416
    m_Localized: Tu n'es pas là pour ton mari. T'es venue pour la FEMA, c'est ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083417
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083418
    m_Localized: 'Wifefema: Ouais ? Et alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083419
    m_Localized: 'Wifefema: Ouais, je suis venue ici pour faire un scandale jusqu''à ce que quelqu''un de haut placé daigne m''écouter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083420
    m_Localized: 'Wifefema: Je veux contester ce refus d''embauche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083421
    m_Localized: 'Wifefema: Je rêve ! C''est moi qui identifie le Visiteur, qui ai fait mon devoir, et c''est à LUI qu''ils filent le boulot ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083422
    m_Localized: 'Wifefema: Franchement ? J''y comprends rien. C''est débile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083423
    m_Localized: 'Wifefema: Je déteste cet enfoiré. Je le déteste de toutes mes forces.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083424
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083425
    m_Localized: 'Wifefema: Hé, j''ai un petit service à te demander.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083426
    m_Localized: 'Wifefema: Tu peux les appeler ? Utilise leur ligne interne, ils ont un numéro spécial : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083427
    m_Localized: 'Wifefema: Dis-leur que t''as rencontré une nana compétente qui a de l''expérience et du cran… Que j''leur ai déjà trouvé une recrue !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083428
    m_Localized: 'Wifefema: Fais-en des tonnes. Plaide ma cause et peut-être qu''ils me fileront enfin du boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083429
    m_Localized: 'Wifefema: C''est quoi, le problème ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083430
    m_Localized: C'était mieux aux douanes, non ? Au moins, tu avais un peu de pouvoir là-bas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083431
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083432
    m_Localized: 'Wifefema: Oh, monte pas sur tes grands chevaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083433
    m_Localized: 'Wifefema: Je t''ai pas demandé ton avis. Tu vaux pas mieux que moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083434
    m_Localized: 'Wifefema: Tu veux jouer les chefs, c''est ça ? Ici, c''est chez toi, les gens viennent à toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083435
    m_Localized: 'Wifefema: C''est toi qui prends les décisions ici, qui choisis qui est un Visiteur et qui ne l''est pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083436
    m_Localized: 'Wifefema: Mais c''est pas ton boulot. C''est le rôle de la FEMA. Tu joues au flic sans avoir d''insigne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083437
    m_Localized: 'Wifefema: Alors, dis-moi… En quoi tu vaux mieux que la FEMA ? Eux, au moins, c''est leur boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083438
    m_Localized: 'Wifefema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083439
    m_Localized: 'Wifefema: C''est bien ce que j''me disais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083440
    m_Localized: 'Raskolnikov: J''espère juste qu''un jour… Tout ce que je veux, c''est apprendre à tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083441
    m_Localized: Tu veux toujours me voir tuer les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083442
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083443
    m_Localized: 'Raskolnikov: À vrai dire… j''ai changé d''avis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083444
    m_Localized: 'Raskolnikov: Ouais, j''ai eu la trouille. Je l''avoue. Désolé. Mais je suis pas prêt, pas encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083445
    m_Localized: 'Raskolnikov: Les cadavres… rien que les voir, ça me file la gerbe. Il va me falloir un peu de temps pour dépasser ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083446
    m_Localized: 'Raskolnikov: C''est juste que… les Visiteurs… Apparemment, leurs corps bougent encore, même morts. Comme ce type… dans la ruelle…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083447
    m_Localized: 'Raskolnikov: Merde, j''veux pas imaginer ça. Pas maintenant. Je suis pas prêt…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083448
    m_Localized: 'Raskolnikov: J''espère juste qu''un jour… Tout ce que je veux, c''est apprendre à tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083449
    m_Localized: Raconte-moi ce qui s'est passé dans la ruelle.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083450
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083451
    m_Localized: 'Raskolnikov: C''est… difficile d''en parler. Mais je vais essayer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083452
    m_Localized: 'Raskolnikov: Je pensais que les rues étaient plus sûres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083453
    m_Localized: 'Raskolnikov: Mais dès que j''ai tourné au coin de la ruelle, j''ai eu l''impression d''entrer dans un cimetière.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083454
    m_Localized: 'Raskolnikov: Il y avait des dizaines de corps qui traînaient par terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083455
    m_Localized: 'Raskolnikov: Il y en avait qui bougeaient encore. Comme s''ils n''étaient pas encore tout à fait morts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083456
    m_Localized: 'Raskolnikov: Et au bout de la ruelle, il y avait un type avec un flingue, et il…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083457
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083458
    m_Localized: 'Raskolnikov: Non… Assez. Je ne veux pas me souvenir de tout ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083459
    m_Localized: 'Raskolnikov: J''espère juste qu''un jour… Tout ce que je veux, c''est apprendre à tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083460
    m_Localized: C'était qui le type au fond de la ruelle ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083461
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083462
    m_Localized: 'Raskolnikov: C''était…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083463
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083464
    m_Localized: 'Raskolnikov: Un mec encapuchonné… Il portait des colliers de doigts et de dents…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083465
    m_Localized: 'Raskolnikov: Il y avait un gamin à côté de lui. Il avait l''air complètement perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083466
    m_Localized: 'Raskolnikov: Le mec à la capuche lui criait dessus et il le menaçait avec un flingue'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083467
    m_Localized: 'Raskolnikov: Il lui criait de montrer ses dents. Et le gamin le suppliait de lui laisser la vie sauve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083468
    m_Localized: 'Raskolnikov: Je me suis planqué derrière une benne à ordures… Et là, je sais pas pourquoi, mais je me suis vu à la place du môme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083469
    m_Localized: 'Raskolnikov: Il était en larmes… Il suppliait, il implorait pour avoir la vie sauve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083470
    m_Localized: 'Raskolnikov: Et puis… Boum. Son corps s''est effondré, comme tous les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083471
    m_Localized: 'Raskolnikov: À ce moment-là, j''ai compris… Il n''y a plus que deux catégories de personnes maintenant. Les prédateurs et les proies.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083472
    m_Localized: 'Raskolnikov: J''espère juste qu''un jour… Tout ce que je veux, c''est apprendre à tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083473
    m_Localized: Pas besoin de devenir un tueur sanguinaire pour survivre.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083474
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083475
    m_Localized: 'Raskolnikov: Pourquoi tu dis ça ? C''est complètement faux !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083476
    m_Localized: 'Raskolnikov: Si t''es en vie, c''est parce que t''as montré les crocs. T''es un prédateur ! C''est pour ça que personne s''en prend à toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083477
    m_Localized: 'Raskolnikov: Tant que les gens ont peur de toi, t''as rien à craindre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944282083478
    m_Localized: 'Raskolnikov: Je veux pas être une proie. Je veux pas mourir en pleurant comme une mauviette.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277632
    m_Localized: 'Raskolnikov: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277633
    m_Localized: 'Raskolnikov: C''est pour ça que je dois apprendre à tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277634
    m_Localized: 'Nun: Notre Père, qui êtes aux Cieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277635
    m_Localized: Alors… Comment trouvez-vous la maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277636
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277637
    m_Localized: 'Nun: Pouah. Une horreur !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277638
    m_Localized: 'Nun: Il n''y a pas un seul mur droit et l''agencement n''a ni queue ni tête !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277639
    m_Localized: 'Nun: Et admettez-le… Vous m''avez refourgué la plus minable des pièces que vous aviez, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277640
    m_Localized: 'Nun: Les meubles ? Vieux, pourris, affaissés… Et sûrement infestés de mites !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277641
    m_Localized: 'Nun: Vous n''êtes même pas fichu de mettre une croix dans une chambre digne de ce nom !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277642
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277643
    m_Localized: 'Nun: Enfin, passons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277644
    m_Localized: 'Nun: Notre Père, qui êtes aux Cieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277645
    m_Localized: Si vous détestez tellement cet endroit, pourquoi ne partez-vous pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277646
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277647
    m_Localized: 'Nun: Comme si j''étais là de gaieté de cœur ! Si le monastère tenait encore debout, je n''aurais jamais quitté ce lieu saint !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277648
    m_Localized: 'Nun: Vous croyez que j''en ai quelque chose à faire de ce taudis en ruines ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277649
    m_Localized: 'Nun: Si j''avais eu le choix, je n''aurais jamais mis les pieds ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277650
    m_Localized: 'Nun: Ici, ça empeste le meurtre et la mort… Ô Seigneur ! Et je suis sûre que vous aimez ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277651
    m_Localized: 'Nun: Vous massacrez tous ceux que vous pensez être des démons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277652
    m_Localized: 'Nun: Si ça se trouve, vous aussi vous en êtes un ! Avec les cornes et le reste, qui ne demandent qu''à pousser !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277653
    m_Localized: 'Nun: Pourtant, je n''ai pas peur. Le Père céleste veille sur son troupeau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277654
    m_Localized: 'Nun: Notre Père, qui êtes aux Cieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277655
    m_Localized: Pourquoi n'êtes-vous pas restée dans votre monastère ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277656
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277657
    m_Localized: 'Nun: Premièrement, le monastère n''est pas à moi. C''est la maison de notre Seigneur tout-puissant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277658
    m_Localized: 'Nun: Ensuite, tout est à cause de ces ignobles blasphémateurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277659
    m_Localized: 'Nun: Ils ont profané Son lieu sacré… Que le feu du Ciel les consume !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277660
    m_Localized: 'Nun: Ils ont fait irruption, chassé mes brebis, et moi avec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277661
    m_Localized: 'Nun: Et ils se sont installés comme s''ils étaient chez eux. Des barbares, tous autant qu''ils sont !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277662
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277663
    m_Localized: 'Nun: Nous vivions dans la droiture : prières, jeûnes, service du Seigneur. Mais ces animaux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277664
    m_Localized: 'Nun: Ils boivent de l''eau bénite comme du vulgaire vin de table. Qu''ils s''étouffent avec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277665
    m_Localized: 'Nun: Qu''ils pourrissent en Enfer !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277666
    m_Localized: 'Nun: Notre Père, qui êtes aux Cieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277667
    m_Localized: Que voulaient-ils, ces « blasphémateurs » ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277668
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277669
    m_Localized: 'Nun: La horde a débarqué… Crasseuse, vociférante… Ils hurlaient comme des possédés, ils blasphémaient comme des impies !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277670
    m_Localized: 'Nun: Et tout ça pour quoi ? Parce que j''ai refusé de les laisser entrer ! Je leur ai dit net : pas de non baptisé ici !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277671
    m_Localized: 'Nun: Ils se sont mis en colère, oh que oui… Ils ont frappé aux portes, ils ont voulu les arracher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277672
    m_Localized: 'Nun: Et ils ont fini par entrer de force avant de me mettre dehors.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277673
    m_Localized: Vous avez tourné le dos à ceux qui étaient dans le besoin ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277674
    m_Localized: J'aurais pu vous fermer la porte, moi aussi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277675
    m_Localized: 'Nun: Les lieux sacrés ne sont pas des refuges pour les non-croyants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277676
    m_Localized: 'Nun: Et alors ? Qu''importe s''ils cherchaient à s''abriter du soleil ou à se protéger de ces soi-disant Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277677
    m_Localized: 'Nun: Même si le feu tombait du ciel, la maison de Dieu n''est pas un refuge pour les aberrations.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277678
    m_Localized: 'Nun: Le Seigneur n''accorde sa miséricorde qu''à ceux qui ont la foi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277679
    m_Localized: 'Nun: Et s''ils doivent brûler dans les rues, qu''il en soit ainsi. Tel est leur jugement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277680
    m_Localized: Vous êtes odieuse, mais ce n'est pas à moi de vous juger.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277681
    m_Localized: Vous feriez mieux de partir très vite, avant que je ne vous tire dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277682
    m_Localized: 'Nun: Misérable insolent !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277683
    m_Localized: 'Nun: Vous avez perdu la boule ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277684
    m_Localized: 'Nun: Je suis une servante de Dieu ! J''ai été chassée de Sa maison par des vermines impies… Et vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277685
    m_Localized: 'Nun: Vous osez vous moquer de moi ? Vous osez dire que je l''ai bien mérité ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277686
    m_Localized: 'Nun: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277687
    m_Localized: 'Nun: Vous n''êtes pas un homme. Vous êtes un serpent !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277688
    m_Localized: 'Nun: BLASPHÉMATEUR ! VOUS N''ÊTES QU''UN AUTRE BLASPHÉMATEUR !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277689
    m_Localized: 'Nun: Et moi qui espérais que vous comprendriez. Mais vous ne valez pas mieux que les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277690
    m_Localized: 'Nun: Nous ne sommes que de simples serviteurs ! LES SERVITEURS DU SEIGNEUR !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277691
    m_Localized: 'Nun: Tout ce que nous pouvons faire, c''est accepter Sa volonté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277692
    m_Localized: 'Nun: Ses voies sont impénétrables. Jamais nous ne pourrons comprendre Son plan.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277693
    m_Localized: Vous êtes odieuse, mais ce n'est pas à moi de vous juger.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277694
    m_Localized: Vous feriez mieux de partir très vite, avant que je ne vous tire dessus.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277695
    m_Localized: 'Nun: Ah, vous jouez les héros maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277696
    m_Localized: 'Nun: Je ne veux pas de ce taudis qui vous sert de maison. Je ne resterai pas ici une seconde de plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277697
    m_Localized: 'Nun: Adieu. Que la colère de Dieu s''abatte sur vous !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277698
    m_Localized: 'Nun: Je n''avais pas l''intention de rester, rassurez-vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277699
    m_Localized: 'Nun: Je l''ai senti dès que j''ai franchi le seuil : Dieu n''a pas sa place dans cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277700
    m_Localized: 'Nun: Peut-être me parle-t-il en ce moment même, pour me dire de partir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277701
    m_Localized: 'Nun: Adieu. Que la colère de Dieu s''abatte sur vous !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277702
    m_Localized: 'Fugitive: Putain de blessure…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277703
    m_Localized: Pourquoi la FEMA s'en est-elle prise à toi, au fait ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277704
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277705
    m_Localized: 'Fugitive: J''en suis pas vraiment sûr, mais j''ai ma petite idée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277706
    m_Localized: 'Fugitive: Je croyais que c''était juste une inspection de routine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277707
    m_Localized: 'Fugitive: Mais je suis prêt à parier que c''est cette garce qui vit à côté qui m''a dénoncé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277708
    m_Localized: 'Fugitive: On n''a jamais pu se blairer. Elle a dû sauter sur l''occasion de me faire un sale coup… et dire que j''étais un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277709
    m_Localized: 'Fugitive: Elle doit être sacrément fière d''elle, cette connasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277710
    m_Localized: 'Fugitive: Putain de blessure…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277711
    m_Localized: Ta blessure, ça se présente comment ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277712
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277713
    m_Localized: 'Fugitive: Je vais bien, vraiment. Ça va mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277714
    m_Localized: 'Fugitive: Je te l''ai dit, la balle est sortie proprement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277715
    m_Localized: 'Fugitive: Les gens devraient pas s''entre-déchirer comme ça. Mais ce type ? Il tire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277716
    m_Localized: 'Fugitive: À ce rythme-là, on finira tous six pieds sous terre. On peut pas dormir à la surface, autant se reposer en dessous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277717
    m_Localized: 'Fugitive: Mais non… On préfère vivre comme des chiens et entraîner les autres dans notre chute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277718
    m_Localized: 'Fugitive: Tu aurais dû voir ce cinglé avec son flingue. C''était un sale type…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277719
    m_Localized: Un cinglé ? T'avais pas dit que les gars de la FEMA t'avaient tiré dessus ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277720
    m_Localized: De quel cinglé tu parles ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277721
    m_Localized: 'Fugitive: O-Ouais… Je… Ouais, c''était bien la FEMA… Il…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277722
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277723
    m_Localized: Dis-moi la vérité.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277724
    m_Localized: Arrête. Tu mens comme tu respires.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277725
    m_Localized: 'Fugitive: Enfin, je veux dire… Je parle d''un type de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277726
    m_Localized: 'Fugitive: Il avait vraiment l''air menaçant quand je l''ai vu… face à face.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277727
    m_Localized: 'Fugitive: Enfin, je veux dire… quand il m''a tiré dessus… dans le dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277728
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277729
    m_Localized: Dis-moi la vérité.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277730
    m_Localized: Arrête. Tu mens comme tu respires.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277731
    m_Localized: 'Fugitive: D''accord, d''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277732
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277733
    m_Localized: 'Fugitive: La vérité, c''est que j''ai réussi à sortir de la zone de quarantaine… Par contre, y a pas eu de coup de feu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277734
    m_Localized: 'Fugitive: C''est un docteur qui m''a aidé. Il a falsifié les papiers et m''a fait sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277735
    m_Localized: 'Fugitive: Je peux pas rentrer chez moi. Elle est toujours là-bas. La voisine qui m''a dénoncé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277736
    m_Localized: 'Fugitive: C''est pour ça que je cherchais un endroit où me cacher. Et c''est là que je suis tombé sur ce type.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277737
    m_Localized: 'Fugitive: Moi, je voulais juste lui demander où je pouvais passer la nuit. Et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277738
    m_Localized: 'Fugitive: J''ai vu un fusil dans son dos… Un collier de dents et d''ongles… Dans la ruelle derrière lui, plein de cadavres…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277739
    m_Localized: 'Fugitive: C''est là que j''ai compris que c''était un putain de cinglé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277740
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277741
    m_Localized: 'Fugitive: Écoute, ça recommence à me faire mal. Ça te dérange si je m''allonge un moment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277742
    m_Localized: 'Fugitive: Putain…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277743
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277744
    m_Localized: 'Fugitive: Écoute, je peux tout t''expliquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277745
    m_Localized: 'Fugitive: La vérité, c''est que j''ai réussi à sortir de la zone de quarantaine… Par contre, y a pas eu de coup de feu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277746
    m_Localized: 'Fugitive: C''est un docteur qui m''a aidé. Il a falsifié les papiers et m''a fait sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277747
    m_Localized: 'Fugitive: Je peux pas rentrer chez moi. Elle est toujours là-bas. La voisine qui m''a dénoncé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277748
    m_Localized: 'Fugitive: C''est pour ça que je cherchais un endroit où me cacher. Et c''est là que je suis tombé sur ce type.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277749
    m_Localized: 'Fugitive: Moi, je voulais juste lui demander où je pouvais passer la nuit. Et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277750
    m_Localized: 'Fugitive: J''ai vu un fusil dans son dos… Un collier de dents et d''ongles… Dans la ruelle derrière lui, plein de cadavres…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277751
    m_Localized: 'Fugitive: C''est là que j''ai compris… C''était un putain de cinglé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277752
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277753
    m_Localized: 'Fugitive: Écoute, ça recommence à me faire mal. Ça te dérange si je m''allonge un moment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277754
    m_Localized: 'Fugitive: Putain de blessure…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277755
    m_Localized: Et donc… Ce cinglé avec son fusil ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277756
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277757
    m_Localized: 'Fugitive: Ouais, ce gros cinglé… Il était couvert de dents et de doigts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277758
    m_Localized: 'Fugitive: Il a senti que j''hésitais, alors il a sorti son flingue. J''ai réussi à le lui prendre et on s''est battus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277759
    m_Localized: 'Fugitive: On s''est battus comme des chiens pour l''arme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277760
    m_Localized: 'Fugitive: Il a tiré. Avant que je comprenne quoi que ce soit, je lui ai fracassé le crâne et ça l''a assommé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277761
    m_Localized: 'Fugitive: Je me suis enfui. J''ai couru aussi vite que possible. Puis j''ai senti une douleur dans le ventre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277762
    m_Localized: 'Fugitive: J''ai baissé les yeux et j''ai vu du sang partout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277763
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277764
    m_Localized: 'Fugitive: Si je t''avais dit qu''il m''avait tiré dessus, tu ne m''aurais pas laissé entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277765
    m_Localized: 'Fugitive: Dans ces moments-là, on pense juste à sauver sa peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277766
    m_Localized: 'Fugitive: Sois honnête… Si tu avais su qu''un psychopathe armé était à mes trousses, tu m''aurais vraiment laissé rester ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277767
    m_Localized: 'Fugitive: Il me fallait un abri. Je veux pas mourir comme ces pauvres types dans cette ruelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277768
    m_Localized: 'Fugitive: Alors, ouais… J''ai menti. J''espère que tu peux me pardonner. Ne m''en veux pas, s''il te plaît.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277769
    m_Localized: D'accord. Tu peux rester.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277770
    m_Localized: Je ne peux plus te faire confiance maintenant. Va-t'en.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277771
    m_Localized: 'Fugitive: Merci. Ça me fait vraiment plaisir que tu te montres compréhensif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277772
    m_Localized: 'Fugitive: Tout ce que j''espère, c''est que ce cinglé ne se pointe pas. Heureusement que toi aussi, t''es armé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277773
    m_Localized: 'Fugitive: Qui sait, quelqu''un d''autre s''est peut-être déjà occupé de lui. Peut-être même ce Visiteur pâle et rachitique.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277774
    m_Localized: 'Fugitive: Comme quoi… J''avais raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277775
    m_Localized: 'Fugitive: Tu vois ? Si j''ai menti, c''était pas pour rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277776
    m_Localized: 'Fugitive: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277777
    m_Localized: 'Fugitive: Adieu, connard !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277778
    m_Localized: 'Bestson: C''est pas vrai… Où est-ce qu''ils sont passés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277779
    m_Localized: Comment ça va ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277780
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277781
    m_Localized: 'Bestson: Je sais pas… Je voudrais vraiment que mes parents reviennent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277782
    m_Localized: 'Bestson: Ils ont pris soin de moi toute ma vie, et maintenant… Je sais même pas ce qui leur est arrivé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277783
    m_Localized: 'Bestson: J''espère qu''ils vont bien. Je peux pas imaginer ma vie sans eux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277784
    m_Localized: 'Bestson: C''est pas vrai… Où est-ce qu''ils sont passés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277785
    m_Localized: Tu as d'autres proches ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277786
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277787
    m_Localized: 'Bestson: Presque personne. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277788
    m_Localized: 'Bestson: J''ai découvert il y a peu que j''avais une grande sœur… issue du premier mariage de mon père. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277789
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277790
    m_Localized: 'Bestson: Mince, ma grand-mère !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277791
    m_Localized: 'Bestson: Oh sapristi ! Je crois que je viens de comprendre où mes parents sont peut-être allés…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277792
    m_Localized: 'Bestson: Et si ma grand-mère était en fait un Visiteur et qu''elle les avait tués ? Et si la FEMA les avait emmenés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277793
    m_Localized: 'Bestson: Pourquoi ? Pourquoi est-ce qu''ils sont pas restés ? Pourquoi est-ce qu''ils m''ont pas emmené avec eux ? POURQUOI…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277794
    m_Localized: 'Bestson: JE SURVIVRAI PAS TOUT SEUL. POURQUOI ILS M''ONT ABANDONNÉ ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277795
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277796
    m_Localized: 'Bestson: C''est pas vrai… Où est-ce qu''ils sont passés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277797
    m_Localized: C'est bon, tu t'es calmé ? Qu'est-ce que c'est que cette histoire de sœur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277798
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277799
    m_Localized: 'Bestson: Eh bien, je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277800
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277801
    m_Localized: 'Bestson: Juste avant leur départ, on a reçu une lettre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277802
    m_Localized: 'Bestson: C''est mon père qui me l''a apportée, vu que je regarde jamais le courrier. Il m''a dit de la lire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277803
    m_Localized: 'Bestson: Elle venait de « ma sœur »'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277804
    m_Localized: 'Bestson: Elle disait qu''elle voulait me rencontrer. Mais… je savais pas trop quoi en penser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277805
    m_Localized: 'Bestson: Au début, j''ai cru que c''était une blague. Mais comme c''était mon père qui me l''avait donnée, c''était pas possible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277806
    m_Localized: 'Bestson: Il m''a expliqué que j''étais pas son premier enfant… que depuis toujours, j''avais une grande sœur…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277807
    m_Localized: 'Bestson: C''est juste une demi-sœur… On n''a pas la même mère, juste le même père.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277808
    m_Localized: 'Bestson: Quand j''ai compris ça, je me suis senti bizarre. Je savais pas trop comment réagir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277809
    m_Localized: 'Bestson: C''est censé être « ma sœur », mais c''est une parfaite inconnue… C''est trop bizarre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277810
    m_Localized: 'Bestson: J''aimerais bien lui parler. Mais j''ai pas le courage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277811
    m_Localized: 'Bestson: Tu pourrais peut-être l''appeler pour moi ?… Voilà son numéro : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277812
    m_Localized: 'Bestson: Dis-lui juste que je suis en vie. Et que je ne sais pas quoi faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277813
    m_Localized: 'Bestson: C''est pas vrai… Où est-ce qu''ils sont passés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277814
    m_Localized: Pourquoi tu ne vas pas chez ta sœur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277815
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277816
    m_Localized: 'Bestson: Je la connais à peine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277817
    m_Localized: 'Bestson: Quand mes parents m''ont raconté la vérité, j''ai eu l''impression que toute ma vie, ils m''avaient menti.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277818
    m_Localized: 'Bestson: Ça m''a vraiment mis en rogne… Je me suis enfermé dans ma chambre. Je voulais juste qu''on me foute la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277819
    m_Localized: 'Bestson: Mais, le lendemain…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277820
    m_Localized: 'Bestson: Tout ce que je t''ai raconté est arrivé. La télé, la panique, et puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277821
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277822
    m_Localized: 'Bestson: Ils m''ont vraiment abandonné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277823
    m_Localized: 'Bestson: C''est pas vrai… Je donnerais n''importe quoi pour revoir ma mère et mon père une dernière fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277824
    m_Localized: 'Bestson: C''est pas vrai… Pourquoi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277825
    m_Localized: Va voir ta sœur. Elle t'accueillera, c'est sûr.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277826
    m_Localized: T'es sûr que tes parents sont morts ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277827
    m_Localized: 'Bestson: Vraiment ? Tu crois ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277828
    m_Localized: 'Bestson: Mais je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277829
    m_Localized: 'Bestson: Je ne suis jamais parti aussi loin sans mes parents.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277830
    m_Localized: 'Bestson: Elle habite vraiment super loin d''ici. Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277831
    m_Localized: 'Bestson: J''ai peur. Je ne pense pas en être capable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277832
    m_Localized: Prends un taxi. Il y en a encore.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277833
    m_Localized: Il faut bien que tu fasses quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277834
    m_Localized: 'Bestson: Eh bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277835
    m_Localized: 'Bestson: Ils ne sont pas revenus me chercher, alors je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277836
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277837
    m_Localized: 'Bestson: Je ne sais pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277838
    m_Localized: Essaie de retrouver ta grand-mère.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277839
    m_Localized: Essaie de chercher dans les zones de quarantaine.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277840
    m_Localized: 'Bestson: Hé, c''est… En fait, c''est pas une mauvaise idée… d''une certaine manière…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277841
    m_Localized: 'Bestson: Mais j''ai entendu dire que les taxis coûtaient super cher ces jours-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277842
    m_Localized: 'Bestson: Mais je me suis servi dans la réserve de mes parents. Ça devrait suffire pour payer le trajet jusque chez ma sœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277843
    m_Localized: 'Bestson: Merci de m''avoir remis les idées en place. À plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277844
    m_Localized: 'Bestson: T''as peut-être raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277845
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277846
    m_Localized: 'Bestson: Peut-être que ça fait trop longtemps que je me repose sur mes parents.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277847
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277848
    m_Localized: 'Bestson: Merci de m''avoir remis les idées en place.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277849
    m_Localized: 'Bestson: Je vais essayer de trouver un taxi. Heureusement, j''ai pris l''argent de mes parents avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277850
    m_Localized: 'Bestson: J''espère que je vais m''en sortir. Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277851
    m_Localized: 'Bestson: Peut-être… Peut-être que tu as raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277852
    m_Localized: 'Bestson: Peut-être que leur voiture est tombée en panne ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277853
    m_Localized: 'Bestson: Quand j''y repense… Papa disait qu''elle avait encore besoin d''être réparée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277854
    m_Localized: 'Bestson: Mais Grand-mère n''a jamais voulu avoir de téléphone. Peut-être que c''est pour ça qu''ils n''ont pas pu m''appeler ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277855
    m_Localized: 'Bestson: Peut-être… Peut-être que j''ai vraiment une chance de les trouver là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277856
    m_Localized: 'Bestson: Merci de m''avoir remis les idées en place. Je vais devoir y aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277857
    m_Localized: 'Bestson: Eh bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277858
    m_Localized: 'Bestson: Peut-être qu''ils sont vraiment là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277859
    m_Localized: 'Bestson: J''imagine que je n''ai pas d''autre choix que d''essayer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277860
    m_Localized: 'Bestson: Merci de m''avoir remis les idées en place. Je vais devoir y aller.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277861
    m_Localized: 'Buddy: Vas-y, pose ta question, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277862
    m_Localized: Comment ça va ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277863
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277864
    m_Localized: 'Buddy: Comme sur des roulettes, mon pote !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277865
    m_Localized: 'Buddy: J''ai jeté un œil dans ton frigo. Mec, si j''avais su que t''avais AUTANT de bière…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277866
    m_Localized: 'Buddy: Où t''as trouvé tout ça ? T''as un oncle qui bosse dans une brasserie ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277867
    m_Localized: 'Buddy: Ah, peu importe ! Garde tes combines pour toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277868
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277869
    m_Localized: 'Buddy: Sans ce chaos, on se la coulerait douce, avec des bières bien fraîches en matant du foot. Je t''aurais même présenté à…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277870
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277871
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277872
    m_Localized: Ça va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277873
    m_Localized: T'as une crampe ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277874
    m_Localized: 'Buddy: Hein ? Quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277875
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277876
    m_Localized: 'Buddy: C''est rien. T''en fais pas pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277877
    m_Localized: 'Buddy: Non, c''est juste que je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277878
    m_Localized: 'Buddy: Hmm…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277879
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277880
    m_Localized: 'Buddy: Je réfléchissais, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277881
    m_Localized: 'Buddy: Vas-y, pose ta question, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277882
    m_Localized: Tu as l'air un peu déprimé aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277883
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277884
    m_Localized: 'Buddy: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277885
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277886
    m_Localized: 'Buddy: Je veux pas aller là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277887
    m_Localized: Où ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277888
    m_Localized: De quoi tu parles ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277889
    m_Localized: 'Buddy: Peu importe. Tu comprendrais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277890
    m_Localized: Je veux savoir.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277891
    m_Localized: D'accord, j'insiste pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277892
    m_Localized: 'Buddy: Écoute, j''ai vraiment pas envie d''en parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277893
    m_Localized: Je veux savoir.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944286277894
    m_Localized: D'accord, j'insiste pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471936
    m_Localized: 'Buddy: Me mets pas la pression ! Je suis déjà à deux doigts de craquer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471937
    m_Localized: 'Buddy: Fiche-moi juste la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471938
    m_Localized: 'Buddy: Merci. Je me sens pas super bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471939
    m_Localized: 'Buddy: Vas-y, pose ta question, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471940
    m_Localized: Qu'est-ce qui t'arrive ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471941
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471942
    m_Localized: 'Buddy: C''est pas tes oignons, mec ! Lâche-moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471943
    m_Localized: Dis-moi simplement ce qui se passe.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471944
    m_Localized: Il va bien falloir que tu parles. Ça ne peut qu'empirer sinon.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471945
    m_Localized: 'Buddy: Je peux pas… Tu me verras plus jamais de la même façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471946
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471947
    m_Localized: 'Buddy: Mais bon… Je peux pas garder ça pour moi non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471948
    m_Localized: 'Buddy: J''avais une chienne. Elle est morte il y a quelques jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471949
    m_Localized: Et après ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471950
    m_Localized: Et ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471951
    m_Localized: 'Buddy: Tu veux ma mort ou quoi, mon pote ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471952
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471953
    m_Localized: 'Buddy: Très bien. Tu veux la vérité ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471954
    m_Localized: 'Buddy: J''avais une chienne. Elle est morte il y a quelques jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471955
    m_Localized: Et alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471956
    m_Localized: Et ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471957
    m_Localized: 'Buddy: C''est ça le problème. Elle était vieille, malade… mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471958
    m_Localized: 'Buddy: Elle n''est pas simplement…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471959
    m_Localized: 'Buddy: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471960
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471961
    m_Localized: 'Buddy: Je l''ai tuée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471962
    m_Localized: Qu'est-ce que t'as fait ?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471963
    m_Localized: Espèce de monstre !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471964
    m_Localized: 'Buddy: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471965
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471966
    m_Localized: 'Buddy: Je l''ai tuée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471967
    m_Localized: Qu'est-ce que t'as fait ?!
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471968
    m_Localized: Espèce de monstre !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471969
    m_Localized: 'Buddy: Je sais, c''est horrible. Mais laisse-moi finir, mon pote. Elle… elle souffrait trop. Je pouvais plus le supporter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471970
    m_Localized: 'Buddy: Jour après jour, je voyais la douleur dans ses yeux. Je l''entendais gémir la nuit, souffrir à cause de ses pattes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471971
    m_Localized: 'Buddy: PUTAIN DE BAGNOLE ! Si ce chauffeur de taxi n''avait pas conduit comme un taré, elle serait peut-être encore en vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471972
    m_Localized: 'Buddy: Ah, je paierais cher pour pouvoir lui faire la peau ! Mais il a pris la fuite sans que je puisse relever sa plaque…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471973
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471974
    m_Localized: 'Buddy: Tu sais pas ce que c''est que de perdre un animal de compagnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471975
    m_Localized: 'Buddy: Ils ne sont qu''un chapitre pour nous. Mais nous, nous sommes toute leur vie. On apprend plus d''eux que de n''importe qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471976
    m_Localized: D'accord, tu peux rester.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471977
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471978
    m_Localized: 'Buddy: Ouais, je sais… Je suis qu''un sale type. J''arrive toujours pas à me pardonner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471979
    m_Localized: 'Buddy: Elle… elle souffrait tant. Je pouvais plus la voir comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471980
    m_Localized: 'Buddy: Chaque jour, c''était pire. C''était la nuit le plus dur… Elle pleurait, gémissait… Et les larmes…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471981
    m_Localized: 'Buddy: T''as déjà vu un chien pleurer ? Ses yeux me suppliaient d''en finir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471982
    m_Localized: 'Buddy: Je voulais pas ! Je te jure que je voulais pas ! Mes mains, elles n''auraient jamais dû…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471983
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471984
    m_Localized: 'Buddy: PUTAIN DE TAXI !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471985
    m_Localized: 'Buddy: Ce salaud a roulé sur ma chienne ! Et il a continué comme si de rien n''était !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471986
    m_Localized: 'Buddy: Comme si c''était un vulgaire caillou sur la route et pas un être vivant !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471987
    m_Localized: 'Buddy: Ah, je paierais cher pour pouvoir lui faire la peau ! Mais il a pris la fuite sans que je puisse relever sa plaque…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471988
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471989
    m_Localized: 'Buddy: Tu sais pas ce que c''est que de perdre un animal de compagnie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471990
    m_Localized: 'Buddy: Ils ne sont qu''un chapitre pour nous. Mais nous, nous sommes toute leur vie. On apprend plus d''eux que de n''importe qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471991
    m_Localized: D'accord, tu peux rester.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471992
    m_Localized: Tu ferais mieux de partir.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471993
    m_Localized: 'Buddy: Merci, mon pote.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471994
    m_Localized: 'Buddy: Ça me soulage que tu comprennes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471995
    m_Localized: 'Buddy: T''as raison, mon pote. C''est sans doute mieux comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471996
    m_Localized: 'Buddy: J''y pense tous les jours… Est-ce que j''ai bien fait de mettre fin à ses souffrances ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471997
    m_Localized: 'Buddy: Je suppose que je ne le saurai jamais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471998
    m_Localized: 'Buddy: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290471999
    m_Localized: 'Fatman: Ahh… de l''eau fraîche. Voilà qui est, c''est mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472000
    m_Localized: Ça va mieux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472001
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472002
    m_Localized: 'Fatman: Ouais, ouais… Ça va mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472003
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472004
    m_Localized: 'Fatman: Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472005
    m_Localized: 'Fatman: Tu sais quoi ? Je commence à avoir la dalle. T''aurais pas quelque chose à grignoter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472006
    m_Localized: Je peux te donner de la bière. (Lui donner une canette de bière)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472007
    m_Localized: 'Fatman: Comment ça, t''as pas de bière ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472008
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472009
    m_Localized: 'Fatman: Essaie pas de me faire marcher… Ton frigo était plein. je l''ai vu ! T''as pas pu tout boire aussi vite quand même !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472010
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472011
    m_Localized: 'Fatman: Ah, voilà ! C''est de ça que je parle !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472012
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472013
    m_Localized: 'Fatman: Mmm, c''est bon. Tout ce que je préfère.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472014
    m_Localized: 'Fatman: Tiens, prends un peu d''argent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472015
    m_Localized: 'Fatman: (Il vous lance une poignée de billets froissés, inutilisables ces derniers temps.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472016
    m_Localized: Eh bien, eux… merci.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472017
    m_Localized: Je m'en fous de ton argent !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472018
    m_Localized: 'Fatman: Ah, voilà qui est mieux !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472019
    m_Localized: 'Fatman: Si tu me donnes tout ce que je te demande, je te paierai comme un patron d''usine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472020
    m_Localized: 'Fatman: Je ne lésine pas sur les moyens quand il s''agit de remercier ceux qui m''aident.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472021
    m_Localized: 'Fatman: Oh, au fait ! Tiens, prends ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472022
    m_Localized: 'Fatman: (Il vous lance un bocal de kombucha.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472023
    m_Localized: 'Fatman: Je sais pas qui peut bien boire ce truc dégueulasse, mais prends-le. Ça pourrait te servir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472024
    m_Localized: 'Fatman: Comment ça, tu t''en fous ? Tu te crois au-dessus des autres, c''est ça ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472025
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472026
    m_Localized: 'Fatman: Tout le monde a besoin d''argent ! C''est comme ça que ce fichu monde tourne ! Mais toi, t''as pas besoin d''argent, hein…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472027
    m_Localized: 'Fatman: Tiens, prends ça !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472028
    m_Localized: 'Fatman: (Il vous lance un bocal de kombucha.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472029
    m_Localized: 'Fatman: Je vois pas qui peut bien boire cette cochonnerie, mais prends-le. Ça pourrait te servir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472030
    m_Localized: 'Fatman: Comment ça, non ? Tu te crois au-dessus des autres ? Tout est à vendre ! L''amour, les objets, les gens…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472031
    m_Localized: 'Fatman: C''est l''argent qui fait tourner le monde, mon petit ! Et moi ? Moi, je suis quelqu''un d''important ! Un ministre !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472032
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472033
    m_Localized: 'Fatman: Très bien, laisse tomber. Si tu ne veux pas m''aider, alors va te faire voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472034
    m_Localized: 'Fatman: Ahh… de l''eau fraîche. Voilà qui est mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472035
    m_Localized: Qu'est qu'il te faut, maintenant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472036
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472037
    m_Localized: 'Fatman: Oh, c''est sympa de demander ! J''aimerais bien fumer une clope. T''en aurais pas une à me passer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472038
    m_Localized: 'Oui, sers-toi ! (Donner des cigarettes) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472039
    m_Localized: 'Fatman: Hein ? T''as même pas de cigarettes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472040
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472041
    m_Localized: 'Fatman: D''accord, laisse tomber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472042
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472043
    m_Localized: 'Fatman: Voilà ! C''est ça qu''on veut !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472044
    m_Localized: 'Fatman: Je préfère les cigares, évidemment… mais bonne chance pour en trouver ces jours-ci. Quand j''étais au gouvernement…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472045
    m_Localized: 'Fatman: Ouais… les choses étaient différentes. Maintenant, c''est un véritable chaos… Quel cauchemar !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472046
    m_Localized: 'Fatman: Quand est-ce que la FEMA va intervenir et faire le ménage ? Elle n''a pas été fondée pour rien cette organisation, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472047
    m_Localized: 'Fatman: Quand j''étais au gouvernement, rien de tout ça ne se serait produit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472048
    m_Localized: 'Fatman: Mais peut-être qu''ils ont juste besoin de temps. Tout finira par s''arranger. Il faut juste faire preuve de patience.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472049
    m_Localized: Tu étais au gouvernement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472050
    m_Localized: Tu as participé à la création de la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472051
    m_Localized: 'Fatman: Eh bien, oui ! Je viens de te le dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472052
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472053
    m_Localized: 'Fatman: Ah oui ! La voilà, ta récompense !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472054
    m_Localized: 'Fatman: (Il vous lance une poignée de billets froissés, sans valeur, et une drôle de carte postale portant le sceau de la FEMA.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472055
    m_Localized: 'Fatman: Qu''est-ce qui te fait croire ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472056
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472057
    m_Localized: 'Fatman: Bon, d''accord ! Tiens, prends ta récompense !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472058
    m_Localized: 'Fatman: (Il vous lance une poignée de billets froissés, sans valeur, et une drôle de carte postale portant le sceau de la FEMA.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472059
    m_Localized: 'Fatman: Comment ça, non ?! Tu sais pas qui je suis ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472060
    m_Localized: 'Fatman: J''étais ministre ! Le gouvernement, c''est une machine compliquée, qui a besoin de gens comme moi pour la faire tourner !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472061
    m_Localized: 'Fatman: Moi, je suis la voix du peuple ! Sans moi, les gens comme toi, on ne les entendrait pas. Je rends ta vie moins pénible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472062
    m_Localized: 'Fatman: En temps normal, tu n''oserais même pas me répondre ! Tu serais arrêté en une seconde !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472063
    m_Localized: 'Fatman: Le monde part en vrille… Les gens se fichent du statut des ministres. Ils pensent qu''on ne fait rien de nos dix doigts…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472064
    m_Localized: 'Fatman: Hé. On verra ce qu''ils en penseront quand l''enfer se déchaînera vraiment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472065
    m_Localized: 'Fatman: Ahh… De l''eau fraîche. Voilà qui est mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472066
    m_Localized: T'as besoin d'autre chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472067
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472068
    m_Localized: 'Fatman: T''es pas bête, mon petit !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472069
    m_Localized: 'Fatman: Je veux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472070
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472071
    m_Localized: 'Fatman: Je veux une boisson énergisante ! Ça fait un bail que je n''ai rien bu de frais et de stimulant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472072
    m_Localized: 'D''accord, tiens. (Lui donner une boisson énergisante) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472073
    m_Localized: 'Fatman: Tu n''as pas d''Énerjéka ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472074
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472075
    m_Localized: 'Fatman: Bon, tant pis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472080
    m_Localized: Pas de chance
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472081
    m_Localized: 'Fatman: Oooh oh ! Génial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472082
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472084
    m_Localized: Parle-moi de la FEMA. Qui sont-ils ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472085
    m_Localized: Qu'est-ce que la FEMA prévoit de faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472101
    m_Localized: 'Fatman: Quoi, c''est sans sucre ? C''est nul !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472104
    m_Localized: 'Fatman: T''aurais dû m''apporter un soda plutôt que ce truc dégueulasse… Attends, qu''est-ce que tu viens de me demander ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472105
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472106
    m_Localized: 'Fatman: T''as perdu la tête ? Je te dirai rien du tout. C''est confidentiel !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472107
    m_Localized: 'Fatman: J''ai signé des papiers, tu comprends ? Con-fi-den-tiel ! T''es pas habilité à savoir ça, sans vouloir te vexer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472108
    m_Localized: 'Fatman: Tiens ! Prends plutôt un café et arrête de poser ces questions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472109
    m_Localized: 'Fatman: (Il vous lance une canette de café.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472110
    m_Localized: 'Fatman: Et c''est de l''Énerjéka, en plus. Dieu sait ce qu''ils ont mis dedans… Attends… Qu''est-ce que tu viens de me demander ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472111
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472112
    m_Localized: 'Fatman: T''as perdu la tête ? Je te dirai rien du tout. C''est confidentiel !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472113
    m_Localized: 'Fatman: J''ai signé des papiers, tu vois ? Un accord de confidentialité. T''as pas le droit de savoir, sans vouloir te vexer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472114
    m_Localized: 'Fatman: Tiens, prends plutôt un café et arrête de poser ce genre de questions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472115
    m_Localized: 'Fatman: (Il vous lance une canette de café.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472116
    m_Localized: 'Fatman: C''est quoi ce bordel ? Comment est-ce que je suis censé bosser si j''ai l''estomac vide ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472117
    m_Localized: 'Fatman: Je suis là pour essayer d''améliorer la vie des gens ! Je me bats pour eux !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472118
    m_Localized: 'Fatman: Les gens critiquent à tout bout de champ… Ils se croient si malins. Mais alors, pourquoi ils sont pas au gouvernement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472119
    m_Localized: 'Fatman: Exactement. Beaucoup de blabla, mais zéro action.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472120
    m_Localized: 'Fatman: Ahh… de l''eau fraîche. Ça, ça fait du bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472121
    m_Localized: Quoi ? T'as encore besoin de quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472122
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472123
    m_Localized: 'Fatman: C''est ça, mon petit. Et moi, je veux ton flingue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472124
    m_Localized: Quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472125
    m_Localized: T'as complètement perdu la boule !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472126
    m_Localized: 'Fatman: Ouais, j''en ai besoin pour me protéger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472127
    m_Localized: 'Fatman: T''inquiète pas, avant je chassais. Je sais m''en servir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472128
    m_Localized: Tu l'auras pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472129
    m_Localized: Va au diable.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472130
    m_Localized: 'Fatman: Fais gaffe à ce que tu dis, mon petit. T''as oublié à qui tu avais affaire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472131
    m_Localized: 'Fatman: Si je voulais, je pourrais te jeter en prison en un rien de temps !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472132
    m_Localized: Tu l'auras pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472133
    m_Localized: Va au diable.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472134
    m_Localized: 'Fatman: Quoi ? Qu''est-ce que tu viens de dire ? J''ai bien entendu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472135
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472136
    m_Localized: 'Fatman: T''as tout gagné. Tu vas me le payer cher !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472137
    m_Localized: 'Fatman: Commence à faire tes valises, parce que ta cellule t''a déjà été attribuée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472138
    m_Localized: Pour moi, tu n'es rien de plus qu'un Visiteur parmi tant d'autres.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472139
    m_Localized: Je m'en fiche que tu sois ministre. Pour moi, tu n'es rien.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472140
    m_Localized: 'Fatman: T''as perdu la tête pour parler comme ça à un représentant du peuple ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472141
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472142
    m_Localized: 'Fatman: T''es foutu, mon petit. Prépare-toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472143
    m_Localized: 'Fatman: Grosse erreur, de me mettre en colère ! Au cas où tu l''ignorerais, les élus sont des gens puissants !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472144
    m_Localized: 'Fatman: T''inquiète pas… Tu vas vite rentrer dans le rang.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472145
    m_Localized: Pour moi, tu n'es rien de plus qu'un Visiteur parmi tant d'autres.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472146
    m_Localized: Je m'en fiche que tu sois ministre. Pour moi, tu n'es rien.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472147
    m_Localized: 'Fatman: Mais qu''est-ce que tu racontes ?! Tu… Tu ferais mieux de faire attention à ce que tu dis !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472148
    m_Localized: 'Fatman: Je ne rigole pas, tu sais… Je suis super sérieux. Tu vas vraiment finir derrière les barreaux, tu verras…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472149
    m_Localized: 'Fatman: Mais qu''est-ce que tu racontes ?! Tu… Tu ferais mieux de faire attention à ce que tu dis !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472150
    m_Localized: 'Fatman: Je ne rigole pas, tu sais… Je suis super sérieux. Tu vas vraiment finir derrière les barreaux, tu verras…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472151
    m_Localized: 'Fatman: Ahh… de l''eau froide. Voilà qui est mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472152
    m_Localized: Mais dis-moi… Pourquoi je ne suis pas encore derrière les barreaux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472153
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472154
    m_Localized: 'Fatman: Tu te moques de moi, c''est ça ? Je… Je ne rigole pas ! Tu vas vraiment finir au trou !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472155
    m_Localized: Peut-être que le statut social avait de l'importance avant. Mais aujourd'hui, tu n'es plus rien.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472156
    m_Localized: L'argent ne veut plus rien dire. T'as pas encore compris ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472157
    m_Localized: 'Fatman: C''est… c''est pas vrai ! Je suis toujours au gouvernement !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472158
    m_Localized: 'Fatman: Ils m''ont juste… mis en congé…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472159
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472160
    m_Localized: 'Fatman: C''est quoi cette blague ? La vie ne sera plus jamais comme avant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472161
    m_Localized: 'Fatman: Quand j''étais au pouvoir, tout le pays bossait pour nous, les ministres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472162
    m_Localized: 'Fatman: Les gens me craignaient et me respectaient. Les voitures s''écartaient, les foules me saluaient. Et maintenant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472163
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472164
    m_Localized: 'Fatman: Super. Maintenant, j''ai l''estomac noué à cause de tout ce stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472165
    m_Localized: 'Fatman: T''es content maintenant ? Va-t''en. J''en ai marre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472166
    m_Localized: 'Fatman: Ce n''est pas vrai ! J''ai encore plein d''argent !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472167
    m_Localized: 'Fatman: Tu t''en fiches peut-être, mais… mais tous les autres, ça les intéresse…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472168
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472169
    m_Localized: 'Fatman: C''est quoi cette blague… La vie ne sera plus jamais comme avant…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472170
    m_Localized: 'Fatman: Fini le luxe, les limos, les filles…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472171
    m_Localized: 'Fatman: Avec du fric, tout était tellement plus facile. T''avais du cash, t''étais quelqu''un !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472172
    m_Localized: 'Fatman: Si seulement il n''y avait pas eu ce cataclysme…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472173
    m_Localized: 'Fatman: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472174
    m_Localized: 'Fatman: Super. Maintenant, j''ai l''estomac noué à cause du stress.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472175
    m_Localized: 'Fatman: T''es content maintenant ? Va-t''en. J''en ai marre…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173076770816
    m_Localized: 'Fatman: On en a déjà assez discuté comme ça. Je suis crevé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173093548032
    m_Localized: 'Fatman: On reparlera demain.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472176
    m_Localized: 'Blind: Tellement sombre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944290472177
    m_Localized: Alors, dis-moi… Qu'as-tu vu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666240
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666241
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666242
    m_Localized: 'Blind: Mieux vaut que tu ne saches pas. Crois-moi. C''est pour ton bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666243
    m_Localized: 'Blind: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666244
    m_Localized: 'Blind: Je croyais qu''en devenant aveugle, je ne reverrais plus jamais cette… chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666245
    m_Localized: 'Blind: Mais son image est gravée dans ma mémoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666246
    m_Localized: 'Blind: Je fais encore des cauchemars. Elle est toujours là. Elle me rend souvent visite.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666247
    m_Localized: 'Blind: Tellement sombre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666248
    m_Localized: Alors ? C'est mieux sans tes yeux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666249
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666250
    m_Localized: 'Blind: Difficile à dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666251
    m_Localized: 'Blind: Je sais que je ne reverrai plus jamais cette chose. Même si je meurs, je ne saurai jamais ce qui m''a tué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666252
    m_Localized: 'Blind: Mais bon… C''est vrai que c''est bizarre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666253
    m_Localized: 'Blind: Je ne sais pas à quoi ressemble ta maison. C''est dur de m''y repérer. Sans les médocs, j''aurais super mal aux orbites…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666254
    m_Localized: 'Blind: Je finirai bien par m''y faire. Ce qui compte, c''est que je ne reverrai plus jamais cette horreur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666255
    m_Localized: 'Blind: Mais quand même… Ce que j''ai vu… Ça reste gravé dans ma mémoire. Je le porterai en moi jusqu''à la mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666256
    m_Localized: 'Blind: Tellement sombre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666257
    m_Localized: Tu as l'air plutôt mal en point.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666258
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666259
    m_Localized: 'Blind: Tu dis ça parce que je suis mal peigné? Hmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666260
    m_Localized: 'Blind: J''ai fait un rêve cette nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666261
    m_Localized: 'Blind: Je marchais le long des rails du tram, je rentrais chez moi. Y avait des maisons tout autour. Des arbres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666262
    m_Localized: 'Blind: J''ai entendu le tram arriver et je me suis écarté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666263
    m_Localized: 'Blind: Je me suis retourné et j''ai vu quelque chose attraper un type dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666264
    m_Localized: 'Blind: Ça bougeait trop vite autour de lui, je voyais pas bien. Mais je savais. Je savais ce que c''était.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666265
    m_Localized: 'Blind: J''ai couru après le tram, sans le rattraper. Impossible. Je saurai jamais ce qui se cache au bout de la ligne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666266
    m_Localized: 'Blind: Et puis je me suis réveillé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666267
    m_Localized: 'Blind: Tellement sombre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666268
    m_Localized: Tu vas bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666269
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666270
    m_Localized: 'Blind: Encore un rêve. Ça a recommencé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666271
    m_Localized: 'Blind: Je marchais sur une route. Il faisait nuit. Les lampadaires clignotaient.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666272
    m_Localized: 'Blind: Je me suis retourné et je l''ai vu qui courait vers moi. Lentement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666273
    m_Localized: 'Blind: Cette fois, j''ai pu voir comment la chose se déplaçait. Très clairement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666274
    m_Localized: 'Blind: J''ai essayé de courir, mais elle gagnait du terrain.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666275
    m_Localized: 'Blind: Je suis arrivé devant chez moi, mais j''arrivais pas à ouvrir le portail. Je suis passé par-dessus la clôture.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666276
    m_Localized: 'Blind: J''ai fouillé dans mes poches. Les clés glissaient entre mes doigts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666277
    m_Localized: 'Blind: Alors, j''ai fait le tour de la maison. Une autre clôture. Je suis encore passé par-dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666278
    m_Localized: 'Blind: Je me suis arrêté. Y avait pas un bruit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666279
    m_Localized: 'Blind: J''ai levé les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666280
    m_Localized: 'Blind: Et elle était là. Elle essayait de m''attraper par-dessus la clôture.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666281
    m_Localized: 'Blind: C''est peut-être l''effet des analgésiques.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666282
    m_Localized: 'Blind: Tellement sombre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666283
    m_Localized: Tu as encore rêvé la nuit dernière ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666284
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666285
    m_Localized: 'Blind: Ouais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666286
    m_Localized: 'Blind: J''ai pas envie d''en parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666287
    m_Localized: 'Blind: J''ai enfin compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666288
    m_Localized: 'Blind: On va tous crever.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666289
    m_Localized: 'Blind: La chose, elle va nous déchiqueter. Même dans notre sommeil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666290
    m_Localized: 'Blind: Le soleil va nous cramer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666291
    m_Localized: 'Blind: Plus rien n''a d''importance. C''est fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666292
    m_Localized: 'Blind: Je… Laisse-moi. S''il te plaît.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666293
    m_Localized: 'Dude: Yo, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666294
    m_Localized: Tu faisais quoi avant le cataclysme ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666295
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666296
    m_Localized: 'Dude: Man, j''étais peinard. Je matais des films, je traînais avec mes potes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666297
    m_Localized: 'Dude: Mais maintenant ? Finis les films, fini les sorties.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666298
    m_Localized: 'Dude: Ils repassent juste les mêmes infos alarmistes et les mêmes pubs en boucle. Mes potes répondent même pas au téléphone.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666299
    m_Localized: 'Dude: J''ai entendu un mec haut placé qui disait : « Ce n''est pas le moment de s''amuser, nous sommes en pleine crise… »'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666300
    m_Localized: 'Dude: Man, il peut aller se faire voir, lui. C''est moi qui décide quand c''est le moment de s''amuser.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666301
    m_Localized: 'Dude: Yo, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666302
    m_Localized: Tu faisais quoi dans la vie ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666303
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666304
    m_Localized: 'Dude: Moi ? Travailler ? Pouahahah !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666305
    m_Localized: 'Dude: Man, y a que les nazes qui travaillent. Moi, je vivais, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666306
    m_Localized: 'Dude: Un jour, j''ai vu un film. Le personnage principal ? C''était tout moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666307
    m_Localized: 'Dude: Dis-moi, tu crois que les mecs qui travaillent en usine ont l''air heureux ? Bien sûr que non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666308
    m_Localized: 'Dude: Moi, j''organisais des teufs, je rencontrais de nouvelles têtes. C''était ça, la vraie vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666309
    m_Localized: 'Dude: Bon… Une fois, j''ai bossé comme chef d''entrepôt. Dans une boîte de livraison. C''est mes vieux qui m''ont trouvé le taf.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666310
    m_Localized: Donc tu vivais aux crochets de tes parents ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666311
    m_Localized: T'es qu'un bon à rien, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666312
    m_Localized: 'Dude: À quoi ça sert de se prendre la tête, man ? Moi, j''ai tout compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666313
    m_Localized: 'Dude: Tu profites pas de ce que t''as ? C''est trop débile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666314
    m_Localized: 'Dude: T''as un flingue, par exemple. Tu vas l''accrocher au mur ou tu vas t''en servir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666315
    m_Localized: 'Dude: Exactement. J''suis pas débile. Moi, je profite de mes avantages.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666316
    m_Localized: 'Dude: Détends-toi, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666317
    m_Localized: 'Dude: Si t''es jaloux, faut le dire, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666318
    m_Localized: 'Dude: Je comprends… C''est pas tout le monde qui peut gagner le gros lot. C''est la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666319
    m_Localized: 'Dude: Yo, man.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666320
    m_Localized: Est-ce qu'il y a un problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666321
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666322
    m_Localized: 'Dude: Man… Ils sont où tes films ? T''as pas une seule cassette.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666323
    m_Localized: 'Dude: Tu regardes jamais rien ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666324
    m_Localized: 'Dude: Je m''ennuie comme un rat mort ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666325
    m_Localized: C'est pas le moment de regarder des films.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666326
    m_Localized: J'en ai pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666327
    m_Localized: 'Dude: Man… Moi qui pensais que cet endroit serait génial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666328
    m_Localized: 'Dude: Mais honnêtement, tes potes ? Ils craignent. Et en plus, y a rien à mater.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666329
    m_Localized: 'Dude: Pas de magazines, pas de films… Juste des livres…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666330
    m_Localized: 'Dude: Qui lit de nos jours, man ? Tu vis à l''âge de pierre ! Que des mots et des descriptions sans fin. Ennuyeux à mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666331
    m_Localized: On n'est pas dans un cinéma, ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666332
    m_Localized: Tu es là pour t'amuser ou pour survivre ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666333
    m_Localized: 'Dude: Attends, quoi ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666334
    m_Localized: 'Dude: Man, j''hallucine ! T''es sérieux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666335
    m_Localized: 'Dude: T''as une télé dans ta piaule, mais t''as pas de films ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666336
    m_Localized: 'Dude: Man, elle est pourrie, ta soirée. Et moi qui croyais que t''étais cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666337
    m_Localized: On n'est pas dans un cinéma, ici.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666338
    m_Localized: Tu es là pour t'amuser ou pour survivre ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666339
    m_Localized: 'Dude: J''y crois pas, man…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666340
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666341
    m_Localized: 'Dude: T''es le plus gros rabat-joie que j''ai jamais rencontré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666342
    m_Localized: Si tu veux survivre, il va falloir te calmer.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666343
    m_Localized: Si ça te plaît pas ici, la porte est grande ouverte…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666344
    m_Localized: 'Dude: J''y crois pas, man…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666345
    m_Localized: 'Dude: Ma télé est morte chez moi, man. Je comptais sur toi pour me sortir de l''ennui, mais naaaan…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666346
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666347
    m_Localized: 'Dude: T''es le plus gros rabat-joie que j''ai jamais rencontré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666348
    m_Localized: Si tu veux survivre, il va falloir te calmer.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666349
    m_Localized: Si ça te plaît pas ici, la porte est grande ouverte…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666350
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666351
    m_Localized: 'Dude: D''accord, c''est comme tu veux, man. Ça craint ici, mais c''est toujours mieux que la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666352
    m_Localized: 'Dude: Laisse-moi juste regarder un peu la télé, man. Pas longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666353
    m_Localized: 'Dude: Je le savais ! T''es vraiment un gros rabat-joie !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666354
    m_Localized: 'Dude: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666355
    m_Localized: 'Dude: J''me tire d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666356
    m_Localized: 'Teacher: Ces pauvres petits…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666357
    m_Localized: Vous allez bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666358
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666359
    m_Localized: 'Teacher: Oui, je crois… Je… Je n''en sais rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666360
    m_Localized: 'Teacher: Je n''arrive pas à comprendre comment des adultes sensés peuvent se laisser emporter au point d''en arriver là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666361
    m_Localized: 'Teacher: Sont-ils vraiment à ce point terrifiés ? Au point de tuer un enfant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666362
    m_Localized: Les gens font bien pire de nos jours.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666363
    m_Localized: Dans le chaos, la raison est la première à disparaître.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666364
    m_Localized: 'Teacher: Qu''y a-t-il de pire que de tuer un enfant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666365
    m_Localized: 'Teacher: Ce n''était pas seulement une personne… c''était une horde, une meute, en pleine chasse aux sorcières…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666366
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666367
    m_Localized: 'Teacher: Notre vraie nature se révèle peut-être dans l''adversité. Les vrais monstres ne viennent peut-être pas des souterrains.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666368
    m_Localized: 'Teacher: Mais les gens ne se rendent-ils pas compte que tuer des enfants, c''est… Je ne trouve même pas les mots…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666369
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666370
    m_Localized: 'Teacher: Notre vraie nature se révèle peut-être dans l''adversité. Les vrais monstres ne viennent peut-être pas des souterrains.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666371
    m_Localized: 'Teacher: Ces pauvres petits…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666372
    m_Localized: Depuis combien de temps êtes-vous enseignante ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666373
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666374
    m_Localized: 'Teacher: J''ai commencé à enseigner environ trois mois avant le cataclysme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666375
    m_Localized: 'Teacher: J''étais loin d''être un enseignant modèle. Je n''aimais pas le métier. Je trouvais les enfants bruyants et épuisants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666376
    m_Localized: 'Teacher: Le cataclysme a tout changé. Ça m''a ouvert les yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666377
    m_Localized: 'Teacher: Vous savez, n''importe lequel de ces enfants aurait pu devenir une rock star, un politicien, un parent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666378
    m_Localized: 'Teacher: Mais maintenant, ils ne tiendront jamais une guitare, ils n''iront jamais à l''école, ils ne grandiront jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666379
    m_Localized: 'Teacher: Ils resteront à jamais… une armée de rêveurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666380
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666381
    m_Localized: 'Teacher: Un jour, un des enfants est venu me voir en courant. Il pleurait. Il disait que ses parents avaient peur de lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666382
    m_Localized: 'Teacher: Ils pensaient que c''était un Visiteur et… Ils l''avaient mis à la porte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666383
    m_Localized: 'Teacher: Il ne savait pas où aller, alors il est venu me voir… à la maternelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666384
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666385
    m_Localized: 'Teacher: (La femme ne peut plus retenir ses larmes et pleure.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666386
    m_Localized: 'Teacher: Pardonnez-moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666387
    m_Localized: 'Teacher: Ces pauvres petits…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666388
    m_Localized: Je tiens à m'excuser pour hier. Je ne voulais pas vous faire de peine.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666389
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666390
    m_Localized: 'Teacher: Ce n''est rien. Je… Je vais bien maintenant. Je me sens mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666391
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666392
    m_Localized: 'Teacher: Ce garçon… À cause de lui, j''ai réalisé à quel point les enfants sont sans défense. Surtout quand le monde s''écroule.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666393
    m_Localized: 'Teacher: J''ai commencé à recueillir tous les « rejetés », et autant d''âmes abandonnées que je pouvais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666394
    m_Localized: 'Teacher: J''ai écouté leurs histoires… C''était horrible de voir comment certains parents les avaient abandonnés sans hésiter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666395
    m_Localized: 'Teacher: Comme si le cataclysme n''était qu''une excuse pour se débarrasser d''un enfant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666396
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666397
    m_Localized: 'Teacher: Peut-être… qu''ils n''avaient jamais voulu d''enfants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666398
    m_Localized: 'Teacher: Ces pauvres petits…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666399
    m_Localized: Vous avez des enfants à vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666400
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666401
    m_Localized: 'Teacher: Non, je… Ma mère me disait souvent de me poser, d''avoir un enfant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666402
    m_Localized: 'Teacher: Mais je n''étais pas prête. Je voulais que ce soit un choix conscient. Je voulais être maman au bon moment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666403
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666404
    m_Localized: 'Teacher: En entendant toutes ces histoires d''enfants abandonnés… Je n''ai pas pu m''empêcher de me poser des questions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666405
    m_Localized: 'Teacher: Si j''avais écouté ma mère, j''aurais peut-être fini comme ces parents.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666406
    m_Localized: 'Teacher: C''est pour cette raison que j''ai choisi d''aider tous les enfants abandonnés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666407
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666408
    m_Localized: 'Teacher: Vous savez ce qui est le plus dur ? L''un des incendiaires était le parent d''un des enfants que j''avais recueillis…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666409
    m_Localized: 'Teacher: (La femme fond en larmes.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666410
    m_Localized: 'Teacher: Pardonnez-moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666411
    m_Localized: 'Teacher: J''ai vraiment essayé de leur offrir une vie meilleure. Je me suis occupée d''eux. Ça n''aurait pas dû se terminer ainsi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666412
    m_Localized: 'Teacher: Je m''en veux tellement…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666413
    m_Localized: Ce n'est pas votre faute s'ils sont morts.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666414
    m_Localized: Je compatis à votre douleur.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666415
    m_Localized: 'Teacher: Vous avez peut-être raison. Mais. Je me sens toujours tellement vide à l''intérieur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666416
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666417
    m_Localized: 'Teacher: Vous savez ce qui me hante ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666418
    m_Localized: 'Teacher: Et si leurs parents n''avaient jamais rien ressenti pour eux ? S''ils ne les avaient jamais vraiment aimés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666419
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666420
    m_Localized: 'Teacher: J''espère juste… J''espère avoir réussi à leur donner un peu d''amour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666421
    m_Localized: 'Teacher: Merci… Mais je me sens toujours brisée. Je ne pense pas que je pourrai m''en remettre un jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666422
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666423
    m_Localized: 'Teacher: Vous savez ce qui me hante ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666424
    m_Localized: 'Teacher: Et si leurs parents n''avaient jamais rien ressenti pour eux ? S''ils ne les avaient jamais vraiment aimés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666425
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944294666426
    m_Localized: 'Teacher: J''espère juste… J''espère avoir réussi à leur donner un peu d''amour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860544
    m_Localized: 'Ballerina: Le petit chat est là ! Que demander de plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860545
    m_Localized: Que viens-tu faire ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860546
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860547
    m_Localized: 'Ballerina: Quelle question idiote !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860548
    m_Localized: 'Ballerina: C''est toi qui as ouvert la porte. Demande-toi plutôt pour quoi. Pour quoi je suis là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860549
    m_Localized: 'Ballerina: Pour moi, c''est tout pareil. Un endroit est un endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860550
    m_Localized: 'Ballerina: On m''a dit de venir ici, alors je suis venue ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860551
    m_Localized: 'Ballerina: Je ne veux rien de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860552
    m_Localized: 'Ballerina: Tout ce qui te concerne, c''est que cet endroit soit confortable pour moi. Le reste ? Peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860553
    m_Localized: 'Ballerina: Le petit chat est là ! Que demander de plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860554
    m_Localized: Est-ce que tu es bien humaine ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860555
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860556
    m_Localized: 'Ballerina: Et toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860557
    m_Localized: 'Ballerina: Est-ce qu''il reste encore quelque chose à l''intérieur de toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860558
    m_Localized: 'Ballerina: Qu''est-ce qui me rend pire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860559
    m_Localized: 'Ballerina: Le petit chat est là ! Que demander de plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860560
    m_Localized: Qui t'a envoyée ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860561
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860562
    m_Localized: 'Ballerina: Tu as déjà fait ce que tu devais faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860563
    m_Localized: 'Ballerina: Pourquoi te soucier du reste ? Peu importe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860564
    m_Localized: 'Ballerina: Une connaissance… commune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860565
    m_Localized: 'Ballerina: Mais on m''a pas dit pour après.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860566
    m_Localized: 'Ballerina: Le petit chat est là ! Que demander de plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860567
    m_Localized: Tu comptes rester combien de temps ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860568
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860569
    m_Localized: 'Ballerina: Jusqu''à ce qu''on vienne me chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860570
    m_Localized: 'Ballerina: Qu''est-ce que je peux faire d''autre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860571
    m_Localized: 'Ballerina: Je sais pas. On m''a dit quelque chose. Maintenant, j''attends qu''on m''en dise plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860572
    m_Localized: 'Ballerina: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860573
    m_Localized: 'Ballerina: Et qui te dit quoi faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860574
    m_Localized: 'Ballerina: Et qui attends-tu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860575
    m_Localized: 'Ballerina: Le petit chat est là ! Que demander de plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860576
    m_Localized: Pourquoi tu ne m'as pas tué ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860577
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860578
    m_Localized: 'Ballerina: Tu es un peu idiot, tu savais ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860579
    m_Localized: 'Ballerina: Toujours la même chose. Tous les jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860580
    m_Localized: 'Ballerina: Je t''ai dit qu''on m''avait rien dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860581
    m_Localized: 'Ballerina: J''attends. Pourquoi t''attends ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860582
    m_Localized: 'Mother: On étouffe là-dedans…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860583
    m_Localized: Tout va bien ? Comment se porte la petite ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860584
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860585
    m_Localized: 'Mother: Ça va, ça va… Elle est… fatiguée, comme moi. Et elle est timide avec les inconnus, alors c''est un vrai pot de colle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860586
    m_Localized: 'Mother: Les gamins encaissent mal ce genre de situation. Même quand ils ne se plaignent pas, ça se lit sur leurs visages.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860587
    m_Localized: 'Mother: Parfois, je me sens coupable de les avoir embarqués là-dedans.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860588
    m_Localized: 'Mother: Mais c''est trop tard pour revenir en arrière maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860589
    m_Localized: 'Couple: Allez, bébé… Tire pas la tronche !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860590
    m_Localized: Comment se fait-il que vous soyez à la rue ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860591
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860592
    m_Localized: 'Couple: Oh, on était simplement censés rendre visite à la mère de ma tendre fiancée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860593
    m_Localized: 'Couple: On a réalisé à temps qu''on n''y arriverait pas par nos propres moyens, et… Eh bien, on a trouvé ta maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860594
    m_Localized: 'Couple: D''ailleurs, je ne vous remercierais jamais assez de nous avoir permis de rester !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860595
    m_Localized: 'Couple: Allez, bébé… Tire pas la tronche !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860596
    m_Localized: C'est loin d'ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860597
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860598
    m_Localized: 'Couple: Ma chérie n''a pas un très bon sens de l''orientation, surtout dans cette région.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860599
    m_Localized: 'Couple: Si personne ne nous aide, alors il faut peut-être compter deux jours ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860600
    m_Localized: 'Couple: Le temps de trouver la route et de la perdre plusieurs fois. Ha ha ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860601
    m_Localized: 'Couple: Mais si quelqu''un nous emmène ? Ce serait idéal. On ne mettrait que quelques heures, tout au plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860602
    m_Localized: Mais pourquoi maintenant ? Pourquoi rendre subitement visite à sa mère ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860603
    m_Localized: Le moment a l'air vraiment mal choisi…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860604
    m_Localized: 'Couple: Mais il pourrait lui être arrivé n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860605
    m_Localized: 'Couple: Le téléphone de sa mère est éteint. Ça fait des jours qu''on n''arrive pas à la joindre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860606
    m_Localized: 'Couple: Il faut bien qu''on s''assure qu''elle va bien… Elle a peut-être besoin d''aide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860607
    m_Localized: 'Couple: Et les nuits se font plus courtes ces jours-ci. On n''a pas l''esprit tranquille quand on se promène.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860608
    m_Localized: 'Couple: Mais ça va aller… On va bientôt voir ta mère. Pas vrai, ma chérie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860609
    m_Localized: 'Couple: Je ne me souviens plus du chemin et ma fiancée choisit toujours la mauvaise direction.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860610
    m_Localized: 'Couple: Mais ça ne fait rien. Tout ce qui compte, c''est d''aller de l''avant, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860611
    m_Localized: 'Couple: Peut-être qu''on arrivera à destination dans une semaine ! Ha ha ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860612
    m_Localized: 'Couple: Allez, bébé… Tire pas la tronche !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860613
    m_Localized: Je croyais que vous vouliez partir ce soir.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860614
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860615
    m_Localized: 'Couple: Ma petite chérie a mis plus de trois heures à se préparer. Il était trop tard pour sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860616
    m_Localized: 'Couple: Nous partirons plus tard puisque c''est comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860617
    m_Localized: 'Couple: La prochaine fois, on fera plus vite. Pardon pour ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860618
    m_Localized: 'Couple: Je ferai en sorte que ma mollassonne de fiancée ne nous fasse pas perdre plus de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860619
    m_Localized: 'Couple: J''espère que nous ne nous imposons pas trop… Encore une fois, pardon !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860620
    m_Localized: 'Couple: Allez, bébé… Tire pas la tronche !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860621
    m_Localized: Mademoiselle, tout va bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860622
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860623
    m_Localized: 'Couple: Elle va bien. Qu''est-ce que c''est que cette question ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860624
    m_Localized: 'Couple: C''est moi qui vous parle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860625
    m_Localized: 'Couple: Elle est juste un peu nerveuse, c''est tout. Il n''y a pas de quoi s''affoler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860626
    m_Localized: C'est à elle que j'ai posé la question.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860627
    m_Localized: Et vous, comment allez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860628
    m_Localized: 'Couple: Elle est fatiguée. Ne la brusquez pas, s''il vous plaît.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860629
    m_Localized: 'Couple: Pour être honnête, je crois qu''elle a arrêté de s''inquiéter pour sa mère.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860630
    m_Localized: 'Couple: Mais ça ne fait rien. Mon petit escargot finira bien par se bouger, et on pourra aller voir sa mère.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860631
    m_Localized: 'Couple: Si elle est encore en vie, ha ha ha !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860632
    m_Localized: 'Couple: Allez, ma chérie, prépare-toi vite. Il va falloir que j''attende encore longtemps ? Bordel…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860633
    m_Localized: 'Couple: Oh, dans l''ensemble, tout va bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860634
    m_Localized: 'Couple: J''ai juste l''impression que ma chérie se fiche complètement de sa propre mère, ha ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860635
    m_Localized: 'Couple: Peut-être que je devrais te donner un petit coup de pouce, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860636
    m_Localized: 'Couple: Je suis désolé de vous imposer ça. Elle me rend fou à être d''une telle mollesse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860637
    m_Localized: 'Couple: Assieds-toi et prépare-toi ! J''en ai marre d''attendre ! Putain de merde !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860638
    m_Localized: 'Couple: Allez, bébé… Tire pas la tronche !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860639
    m_Localized: Votre fiancée ne veut pas partir… Qu'est-ce qui se passe au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860640
    m_Localized: Je voudrais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860641
    m_Localized: 'Couple: Elle me fait chier, putain ! C''est clair, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860642
    m_Localized: 'Couple: Toujours à se plaindre, toujours à me faire des reproches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860643
    m_Localized: 'Couple: Mais, putain ! Tais-toi et fais ce que je dis, c''est pas compliqué pourtant ! Mais non, c''est trop te demander.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860644
    m_Localized: 'Couple: Je suis désolé qu''on soit restés trop longtemps, vraiment. C''est le dernier jour. Promis, on s''en va.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860645
    m_Localized: 'Couple: Tu m''entends ? Prépare tes foutues affaires. Si on est encore là ce soir, je te jure que je te balance par la fenêtre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860646
    m_Localized: Mademoiselle, vous êtes sûre que ça va ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860647
    m_Localized: Qu'est-ce qui se passe au juste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860648
    m_Localized: 'Couple: Restez en dehors de ça, s''il vous plaît. Je vous l''ai déjà dit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860649
    m_Localized: 'Couple: Arrêtez de vous mêler de ce qui ne vous regarde pas. Ce ne sont pas vos affaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860650
    m_Localized: 'Couple: On va régler ça entre nous, mais arrêtez de me taper sur les nerfs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860651
    m_Localized: Dites-moi la vérité. J'en ai marre de vos conneries ! (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860652
    m_Localized: Je m'en fiche. Vous partez, oui ou non ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860653
    m_Localized: 'Couple: Écoutez, monsieur le proprio… Je vous ai dit que tout allait bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860654
    m_Localized: 'Couple: Ma fiancée s''ennuie, alors elle fait des caprices. Et moi, ça m''énerve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860655
    m_Localized: 'Couple: Qu''est-ce que vous voulez de plus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860656
    m_Localized: Dites-moi la vérité. J'en ai marre de vos conneries ! (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860657
    m_Localized: Je m'en fiche. Vous partez, oui ou non ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860658
    m_Localized: 'Couple: Tout doux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860659
    m_Localized: 'Couple: J''ai un flingue dans la main. Si vous tentez quoi que ce soit, je tire sur cette salope.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860660
    m_Localized: 'Couple: Moi, j''ai rien à perdre. Et vous ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860661
    m_Localized: Vous allez mourir dans tous les cas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860662
    m_Localized: Vous pouvez encore partir. Je vous laisse une chance.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860663
    m_Localized: 'Couple: Ouais, ouais. On ne va pas rester plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944298860664
    m_Localized: 'Couple: On s''en va.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054848
    m_Localized: 'Couple: Tu as compris ? C''est la dernière nuit qu''on passe ici. Prépare-toi, putain ! Et arrête de perdre du temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054849
    m_Localized: 'Couple: Qu''est-ce que j''ai à perdre ? Vous me tuez, et après ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054850
    m_Localized: 'Couple: Au moins, la souffrance s''arrêtera. Et cette salope mourra avec moi. Ça serait pas pour me déplaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054851
    m_Localized: Je vais tirer.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054852
    m_Localized: Calmez-vous. Lâchez votre arme et je baisserai la mienne.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054853
    m_Localized: 'Couple: Pourquoi ? Je dois partir avec elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054854
    m_Localized: 'Couple: Sans elle, je ne pars pas. Alors, baissez votre arme. On s''en va ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054855
    m_Localized: 'Couple: Personne n''a besoin d''être blessé, il suffit que vous laissiez tomber.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054856
    m_Localized: Je vais tirer.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054857
    m_Localized: Calmez-vous. Lâchez votre arme et je baisserai la mienne.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054858
    m_Localized: 'Couple: Vous allez vraiment tirer sur une femme ? Vous vous en foutez ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054859
    m_Localized: 'Couple: Si vous me tirez dessus, vous la toucherez aussi. Vous aurez son sang sur les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054860
    m_Localized: 'Couple: Je… Ce n''est pas moi ! C''est vous le tueur !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054861
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054862
    m_Localized: Avertir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054863
    m_Localized: 'Couple: Je dois partir. Sinon, on meurt tous les deux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054864
    m_Localized: 'Couple: Y a pas d''autre solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054865
    m_Localized: 'Couple: Si cette salope avait arrêté de trembler comme une feuille… Si elle était venue avec moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054866
    m_Localized: 'Couple: Tout est de sa faute. Tu m''entends ? T''as tout gâché !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054867
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054868
    m_Localized: Avertir
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054869
    m_Localized: 'Couple: Vous… vous baissez votre arme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054870
    m_Localized: 'Couple: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054871
    m_Localized: 'Couple: Attendez, vous avez toujours l''intention de tirer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054872
    m_Localized: 'Couple: ATTENDEZ, NON !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054873
    m_Localized: 'Couple: D''accord ! D''accord. On va partir. Calmement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054874
    m_Localized: 'Couple: Pas vrai ? Tu vas vraiment partir ce soir cette fois-ci ? Hein ? Espèce de salope.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054875
    m_Localized: 'Couple: (Soudain, la femme se libère et l''homme lui tire dessus.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054876
    m_Localized: 'Couple: (Vous réagissez instantanément et tirez une balle dans la tête de l''homme.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054877
    m_Localized: 'Couple: (On dirait qu''ils sont tous les deux morts. Au moins, c''est fini.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054878
    m_Localized: 'Couple: (Un couple de fous.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054879
    m_Localized: 'Couple: D''accord, on y va. Tout de suite. Laissez-nous juste prendre quelque chose pour nous couvrir, et on sera partis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054880
    m_Localized: 'Couple: Vous ne nous reverrez plus jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054881
    m_Localized: 'Couple: Attendez…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054882
    m_Localized: 'Couple: QU''EST-CE QUE VOUS FAITES ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054883
    m_Localized: 'Couple: (Vous tirez sur l''homme, mais vous touchez aussi la femme.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054884
    m_Localized: 'Couple: (Les deux s''effondrent, en sang.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054885
    m_Localized: 'Couple: (La femme gémit un instant, mais vous ne pouvez rien pour elle.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054886
    m_Localized: 'Couple: (Les deux sont morts.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054887
    m_Localized: 'Couple: Vous ne comprenez pas ? C''est la seule solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054888
    m_Localized: 'Couple: On part, ça y est.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054889
    m_Localized: 'Couple: Hé ! Attrape la couverture. Maintenant. On y va.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054890
    m_Localized: 'Couple: (Vous regardez les deux s''envelopper et sortir.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054891
    m_Localized: 'Couple: (Ils marchent un moment. Soudain, ils s''effondrent.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054892
    m_Localized: 'Couple: (De la fumée s''échappe de la couverture. Vous tournez les talons.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054893
    m_Localized: 'BigLebowski: Bon sang, j''en ai marre de tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054894
    m_Localized: Pourquoi tu es tout seul, dans ce trou perdu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054895
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054896
    m_Localized: 'BigLebowski: Eh bien… la maison était petite. Et bruyante. Pas du tout confortable. Je voulais partir. Voir le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054897
    m_Localized: 'BigLebowski: J''ai pris un sac à dos, des sodas, des barres chocolatées et ce vieux bracelet que j''avais fabriqué à l''école.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054898
    m_Localized: 'BigLebowski: Et je suis partie. Mes parents s''en sont probablement pas aperçus. Mais je m''en fiche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054899
    m_Localized: 'BigLebowski: Depuis, je me balade, je dors là où je peux. Et honnêtement ? Ça se passe pas trop mal pour l''instant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054900
    m_Localized: 'BigLebowski: Au moins, personne me met la pression et je suis ma propre patronne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054903
    m_Localized: 'BigLebowski: Bon sang, ce que j''en ai marre de tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054904
    m_Localized: Et comment t'as survécu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054905
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054906
    m_Localized: 'BigLebowski: Comme j''ai pu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054907
    m_Localized: 'BigLebowski: Je me suis abritée de la chaleur dans des halls, des cabanes, tout ce que je trouvais. J''ai dormi sous des arbres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054908
    m_Localized: 'BigLebowski: J''ai mangé ce qui me tombait sous la main. Des légumes ou des barres chocolatées que je piquais dans les magasins.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054909
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054910
    m_Localized: 'BigLebowski: Me juge pas ! J''ai volé, et alors ? Personne veut de moi à mon âge. Faut bien que je survive !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054911
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233280
    m_Localized: 'BigLebowski: C''est pas vrai… Quoi encore ? T''as peur que j''te pique des trucs ou quoi ? Pfff, j''te jure.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233281
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233282
    m_Localized: 'BigLebowski: Sérieux ? C''est quoi ton délire ? C''est un interrogatoire ? Lâche-moi, franchement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054912
    m_Localized: 'BigLebowski: Bon sang, j''en ai marre de tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054913
    m_Localized: Tu comptes vivre encore longtemps comme ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054914
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054915
    m_Localized: 'BigLebowski: Qu''est-ce que ça peut te faire ? Je finirai bien par trouver une solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054916
    m_Localized: 'BigLebowski: Je te dérange ici ? Je t''ai volé un truc ? Je t''ai bouché les toilettes ? Ben alors, pourquoi tu me fais la morale ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054917
    m_Localized: 'BigLebowski: Je vois… Peut-être que toi aussi, t''es un de ces types louches…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054918
    m_Localized: 'BigLebowski: Une fois, un type m''a accueille. Il était super sympa, m''a donné un endroit où passer la nuit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054919
    m_Localized: 'BigLebowski: On a passé des heures à regarder des dessins animés, tout ça. Je pensais avoir enfin trouvé quelqu''un de bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054920
    m_Localized: 'BigLebowski: Et puis il a essayé de me toucher. Quel gros dégueulasse…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054921
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233283
    m_Localized: 'BigLebowski: Si tu tentes quoi que ce soit, j''te jure j''te griffe, j''te mords, et tout. J''me laisserai pas faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233284
    m_Localized: 'BigLebowski: Mon père, c''est un vrai connard, mais au moins, il m''a appris à me battre.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233285
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233286
    m_Localized: 'BigLebowski: Vas-y, me touche pas, toi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054922
    m_Localized: 'BigLebowski: Bon sang, j''en ai marre de tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054923
    m_Localized: Et qu'est-ce qui est arrivé à ce type ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054924
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054925
    m_Localized: 'BigLebowski: En quoi ça t''intéresse ? Tu veux savoir comment me maîtriser si je me défends ? T''as capté que je m''en étais débarrassé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054926
    m_Localized: 'BigLebowski: Et va pas t''imaginer que je pige que dalle. C''est pas par gentillesse que tu me poses cette question !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054927
    m_Localized: 'BigLebowski: Tu veux juste éviter les ennuis sous ton toit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054928
    m_Localized: 'BigLebowski: Hé, je vole pas, je vais pas casser tes fenêtres, moi ! Me traite pas comme si j''étais du genre à causer des ennuis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054929
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054930
    m_Localized: 'BigLebowski: Et de toute façon…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054931
    m_Localized: 'BigLebowski: J''suis là parce que t''as besoin de moi. T''as peur que ce Visiteur à moitié à poil s''en prenne à toi ? Hé ouais, je sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233287
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233288
    m_Localized: 'BigLebowski: Si c''est comme ça, alors tant pis. Fais tes tests bizarres, si tu veux… Mais viens pas me parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054932
    m_Localized: 'BigLebowski: Bon sang, j''en ai marre de tout ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054933
    m_Localized: Pourquoi ton père t'a appris à te battre ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054934
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054935
    m_Localized: 'BigLebowski: Pour pouvoir tabasser les voyous. Ou pour qu''il puisse se défouler sur moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054936
    m_Localized: 'BigLebowski: Il m''a entraînée depuis toujours. Donner, encaisser les coups… Mais au lieu d''un sac de frappe, on utilisait mon visage.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233289
    m_Localized: 'BigLebowski: Mais bon, s''entraîner avec lui, c''était pas de la tarte. Et je détestais ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233290
    m_Localized: 'BigLebowski: C''était une autre histoire quand il piquait une crise et qu''il me tabassait. Et ma daronne ? Elle en avait rien à faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233291
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233292
    m_Localized: 'BigLebowski: Arf… J''veux pas finir comme eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233293
    m_Localized: 'BigLebowski: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233294
    m_Localized: 'BigLebowski: À quoi ça sert de m''avoir mise au monde si c''était pour me traiter comme ça ? J''comprendrai jamais. C''est ça, la vie ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233295
    m_Localized: 'BigLebowski: Et maintenant ? Le soleil et les Visiteurs ? Super… Encore plus de raisons pour que tout aille de travers. Génial.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233296
    m_Localized: 'BigLebowski: Y aura jamais rien de positif dans ma vie ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41583368939233297
    m_Localized: 'BigLebowski: J''en sais foutrement rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054937
    m_Localized: 'Luka: Tout va bien se passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054938
    m_Localized: Tu te sens toujours de bonne humeur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054939
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054940
    m_Localized: 'Luka: De bonne humeur ? Non, pas vraiment… mais je ne suis pas non plus en train de m''effondrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054941
    m_Localized: 'Luka: On reste des humains. On continue de s''accrocher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054942
    m_Localized: 'Luka: On évite de rendre la tempête plus violente qu''elle ne l''est déjà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054943
    m_Localized: 'Luka: Et quand tout sera fini… Je crois qu''on sera capables de se pardonner les uns les autres pour tout ce qu''on a fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054944
    m_Localized: 'Luka: Tant qu''il y a de la compassion, il y a de l''humanité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054945
    m_Localized: 'Luka: Tu me suis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054946
    m_Localized: 'Luka: Tout va bien se passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054947
    m_Localized: Tu as toujours été comme ça ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054948
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054949
    m_Localized: 'Luka: Non, pas toujours, tu sais. J''avais l''habitude d''être en colère. Contre les gens, contre le monde, contre moi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054950
    m_Localized: 'Luka: Je piquais des crises, j''hurlais, je claquais les portes. Et puis j''ai réalisé que la colère ne fait que te déchirer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054951
    m_Localized: 'Luka: Elle te déchire d''abord à l''intérieur. Ensuite, elle déchire tout, tout autour de toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054952
    m_Localized: 'Luka: Une fois… Je me suis énervé contre quelqu''un qui ne voulait qu''aider. Et maintenant… il… elle est partie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054953
    m_Localized: 'Luka: Ce jour-là, quelque chose s''est brisé en moi. J''ai compris que je devais changer, sinon je finirais par tout détruire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054954
    m_Localized: 'Luka: Alors, j''ai appris à lâcher prise. À respirer. À faire la paix. C''est comme ça que je suis arrivé ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054955
    m_Localized: 'Luka: Tout va bien se passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054956
    m_Localized: Tu as perdu quoi, exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054957
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054958
    m_Localized: 'Luka: Ma famille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054959
    m_Localized: 'Luka: La maison a brûlé alors que j''étais parti chercher de l''eau. À mon retour, il n''y avait que de la fumée et des cendres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054960
    m_Localized: 'Luka: Il faut du temps pour accepter. J''arrêtais pas de me demander : pourquoi je suis parti ? Pourquoi je les ai pas sauvés ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054961
    m_Localized: 'Luka: C''est peut-être là le problème. Peut-être qu''il ne s''agit pas de sauver le passé. Peut-être qu''il s''agit d''avancer avec.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054962
    m_Localized: 'Luka: Leur souvenir est toujours avec moi. Il me donne de la force. C''est pour ça que j''essaie d''aider les gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054963
    m_Localized: 'Luka: Je sais ce que c''est que de perdre. Et je sais ce que c''est de trouver un but une fois que tout s''est effondré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054964
    m_Localized: 'Luka: Tout va bien se passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054965
    m_Localized: Et tu arrives à vivre avec ça ? Après les avoir perdus ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054966
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054967
    m_Localized: 'Luka: Oui, j''arrive à m''en sortir. Mais c''est pas tous les jours facile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054968
    m_Localized: 'Luka: Je m''en suis voulu longtemps. Je pensais que si j''étais rentré plus tôt, tout aurait été différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054969
    m_Localized: 'Luka: Mais la peine se nourrit de culpabilité. Et pour vivre, il faut pardonner. Sinon, on finit par se perdre soi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054970
    m_Localized: 'Luka: Le pardon. C''est ça qui m''a sauvé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054971
    m_Localized: 'Luka: J''ai pardonné mon impuissance face au passé. J''ai pardonné la cruauté du destin. La colère me bouffait, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054972
    m_Localized: 'Luka: Tout va bien se passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054973
    m_Localized: Alors, qu'est-ce qui te fait avancer maintenant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054974
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054975
    m_Localized: 'Luka: Je crois que les gens peuvent devenir meilleurs. Même dans ce marasme, on peut s''élever.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054976
    m_Localized: 'Luka: Je ne crois pas aux miracles ni à la providence. Je crois aux gens. Et en la façon dont on se tire vers le haut.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054977
    m_Localized: 'Luka: On relève celui qui tombe. On sourit dans le malheur. On donne le dernier bout de pain. Ces broutilles, c''est ça la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054978
    m_Localized: 'Luka: Chaque fois que quelqu''un rend le monde un peu meilleur, je sais que rien de tout ça n''est arrivé en vain.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054979
    m_Localized: 'Luka: Tout va bien se passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054980
    m_Localized: Si tu voulais tout récupérer… Ta maison, ta famille… Tu le ferais ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054981
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054982
    m_Localized: 'Luka: Si je pouvais les revoir… leur parler, les serrer dans mes bras… Je le ferais, bien sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054983
    m_Localized: 'Luka: Mais tout ramener ? Pas sûr. La perte fait partie de la vie. C''est terrible, ça fait mal, mais ça nous forge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054984
    m_Localized: 'Luka: Bien sûr, je donnerais presque tout pour un jour de plus avec eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054985
    m_Localized: 'Luka: Mais si ça signifiait renoncer à tout ce que j''ai appris ? À pardonner, à aller de l''avant… Non, je ne le ferais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944303054986
    m_Localized: 'Luka: Le temps est si précieux. Mieux vaut s''accrocher à ce qu''on a maintenant que de se laisser ronger par ce qu''on a perdu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249152
    m_Localized: 'Hunter: Reste sur tes gardes. N''importe lequel d''entre nous pourrait être un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249153
    m_Localized: Tu es un chasseur, pas vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249154
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249155
    m_Localized: 'Hunter: Je suis plutôt un garde-forestier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249156
    m_Localized: 'Hunter: Moi, je vis dans la cambrousse. Pas de télé, juste la radio. C''est comme ça que j''ai appris ce qui se passait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249157
    m_Localized: 'Hunter: J''ai décidé de ne laisser personne entrer chez moi. Ma maison, c''est ma forteresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249158
    m_Localized: 'Hunter: Et si c''était un Visiteur ? Un mec qui chercherait à m''amadouer, juste avant de me trancher la gorge dans mon sommeil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249159
    m_Localized: Qu'est-ce que tu fais là, alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249160
    m_Localized: C'est dangereux de rester tout seul.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249161
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249162
    m_Localized: 'Hunter: Hors de question que je laisse ce grand enfoiré tout pâle me mettre la main dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249163
    m_Localized: 'Hunter: C''est à cause de lui que j''ai quitté ma cabane.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249164
    m_Localized: 'Hunter: Et je vois dans tes yeux que toi aussi, tu l''as croisé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249165
    m_Localized: Comment t'as réussi à survivre là-bas, tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249166
    m_Localized: Toi aussi, tu as vu le grand Visiteur blafard ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249167
    m_Localized: 'Hunter: Tu me prends pour un débile, gros malin ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249168
    m_Localized: 'Hunter: Si j''avais pas capté, je serais déjà six pieds sous terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249169
    m_Localized: 'Hunter: Avant, je trouvais ça débile de laisser entrer des étrangers.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249170
    m_Localized: 'Hunter: Je me disais que j''étais plus en sécurité tout seul. Et puis ce taré s''est pointé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249171
    m_Localized: 'Hunter: Jamais vu un monstre pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249172
    m_Localized: Comment t'as réussi à survivre là-bas, tout seul ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249173
    m_Localized: Toi aussi, tu as vu le grand Visiteur blafard ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249174
    m_Localized: 'Hunter: Oh, mon garçon… C''est une longue histoire. Et je suis pas d''humeur à parler aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249175
    m_Localized: 'Hunter: Apporte-moi une bière demain, et je te dirai tout, promis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249176
    m_Localized: 'Hunter: Alors, je suis pas tout seul, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249177
    m_Localized: 'Hunter: Ouais… je le vois dans ton regard…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249178
    m_Localized: 'Hunter: Oh, mon garçon… Si tu savais ce que j''ai vécu…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249179
    m_Localized: 'Hunter: Je te raconterai. Mais pas ce soir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249180
    m_Localized: 'Hunter: Apporte-moi une bière demain et tu sauras tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249181
    m_Localized: 'Hunter: Reste sur tes gardes. N''importe lequel d''entre nous pourrait être un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249182
    m_Localized: Alors, c'est quoi ton histoire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249183
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249184
    m_Localized: 'Hunter: T''as apporté la bière ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249185
    m_Localized: Oui ! (Lui donner la bière)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249186
    m_Localized: 'Hunter: Comment ça, t''as pas de bière ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249187
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249188
    m_Localized: Non… (Ne pas donner la bière)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249189
    m_Localized: 'Hunter: Ça va faire l''affaire…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249190
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249191
    m_Localized: 'Hunter: Comme je te l''ai dit, j''étais planqué dans ma cabane, tranquille dans mon coin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249192
    m_Localized: 'Hunter: Et un jour, ce type débarque. Haletant, désespéré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249193
    m_Localized: 'Hunter: Il tape comme un dingue à la porte, me supplie de le laisser entrer. Mais y avait un truc qui clochait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249194
    m_Localized: 'Hunter: Tout pâle, secoué, comme s''il avait vu la mort. Aucune idée de comment il avait pu s''enfoncer aussi loin dans les bois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249195
    m_Localized: 'Hunter: Il ressemblait pas à un randonneur, c''est clair. Alors, j''lui ai dit de foutre le camp.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249196
    m_Localized: 'Hunter: Quand il a voulu péter ma fenêtre, j''lui ai crié que j''avais un fusil. Là, il s''est tiré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249197
    m_Localized: 'Hunter: J''étais sûr que je le reverrais plus jamais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249198
    m_Localized: T'aurais peut-être dû l'aider…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249199
    m_Localized: T'aurais dû le laisser entrer.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249200
    m_Localized: Tu veux dire… que tu l'as revu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249201
    m_Localized: 'Hunter: Et qu''il ramène avec lui ce qui le poursuivait, direct à ma porte ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249202
    m_Localized: 'Hunter: Non merci. J''ai bien assez de problèmes comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249203
    m_Localized: Très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249204
    m_Localized: T'es pas du genre bavard.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249205
    m_Localized: T'as pas dit grand-chose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249206
    m_Localized: Laisse-moi deviner. Tu te confies plus facilement autour d'une bière ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249207
    m_Localized: 'Hunter: Fais pas semblant d''être un héros, mon garçon. Je parie que tu as déjà fermé la porte à plus d''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249208
    m_Localized: 'Hunter: Sinon, tu t''en serais pas sorti jusqu''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249209
    m_Localized: 'Hunter: Mais ça, c''est une autre histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249210
    m_Localized: Très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249211
    m_Localized: T'es pas du genre bavard.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249212
    m_Localized: T'as pas dit grand-chose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249213
    m_Localized: Laisse-moi deviner. Tu te confies plus facilement autour d'une bière ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249214
    m_Localized: 'Hunter: J''étais sûr que je ne le reverrais plus jamais. Mais ensuite… il m''a retrouvé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249215
    m_Localized: 'Hunter: Mais je te raconterai ça une autre fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249216
    m_Localized: Très bien.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249217
    m_Localized: T'es pas du genre bavard.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249218
    m_Localized: T'as pas dit grand-chose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249219
    m_Localized: Laisse-moi deviner. Tu te confies plus facilement autour d'une bière ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249220
    m_Localized: 'Hunter: Apporte-moi une bière demain et je te raconterai la fin de l''histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249221
    m_Localized: 'Hunter: J''suis pas un grand bavard, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249222
    m_Localized: 'Hunter: Estime-toi heureux que je t''en dise déjà autant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249223
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249224
    m_Localized: 'Hunter: Apporte-moi une bière demain et je te raconterai le reste. Marché conclu ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249225
    m_Localized: 'Hunter: Faut être patient, mon garçon. J''ai vu des trucs que t''imagines même pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249226
    m_Localized: 'Hunter: Et j''préfère pas y repenser la tête claire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249227
    m_Localized: 'Hunter: Apporte-moi une bière et je t''en parlerai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249228
    m_Localized: 'Hunter: T''es pas idiot, je veux bien l''admettre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249229
    m_Localized: 'Hunter: Je parle que quand ça vaut le coup.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249230
    m_Localized: 'Hunter: Alors, apporte-moi cette bière demain et je te dirai comment ça finit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249231
    m_Localized: 'Hunter: Désolé, mais sobre, je parlerai pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249232
    m_Localized: 'Hunter: Apporte-moi de la bière, après on parlera.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249233
    m_Localized: 'Hunter: Reste sur tes gardes. N''importe lequel d''entre nous pourrait être un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249234
    m_Localized: Alors, c'est quoi la fin de ton histoire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249235
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249236
    m_Localized: 'Hunter: J''vais te dire ça. Mais d''abord, la bière.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249237
    m_Localized: 'Oui ! (Lui donner la bière) '
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249238
    m_Localized: 'Hunter: Comment ça, t''as pas de bière ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249239
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249240
    m_Localized: Non… (Ne pas donner la bière)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249241
    m_Localized: 'Hunter: Voilà ! C''est ça qu''on veut !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249242
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249243
    m_Localized: 'Hunter: Donc le type s''est barré en courant, et moi, je suis resté dans ma cabane.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249244
    m_Localized: 'Hunter: Mais j''ai fini par manquer de bois. Il a bien fallu que je sorte pour en chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249245
    m_Localized: 'Hunter: J''en ai pris un tas, je suis rentré… Et le fusil avait disparu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249246
    m_Localized: 'Hunter: Ça m''a glacé. J''ai retourné la baraque, rien. Plus de fusil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249247
    m_Localized: 'Hunter: Et là… Je le vois, dehors, à la fenêtre. Le même gars.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249248
    m_Localized: 'Hunter: Il avait mon arme, ouais… Mais il avait changé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249249
    m_Localized: 'Hunter: Plus grand. La peau flasque, comme décollée. Il portait juste un froc.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249250
    m_Localized: 'Hunter: Il a pris le fusil à deux mains… et l''a brisé en deux comme une brindille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249251
    m_Localized: 'Hunter: Puis il est resté là. À me fixer. Comme s''il attendait que je cligne des yeux… pour me briser la nuque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249252
    m_Localized: 'Hunter: Mais il a rien fait. Il s''est contenté de me regarder. Comme un duel de regards tordus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249253
    m_Localized: 'Hunter: Et puis, au lever du jour, ce grand taré s''est volatilisé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249254
    m_Localized: 'Hunter: C''est là que j''ai compris : rester seul là-bas, sans arme ? C''était du suicide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249255
    m_Localized: 'Hunter: Alors, j''ai couru en direction de la ville. Je suis parti avant que le soleil se soit complètement levé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249256
    m_Localized: 'Hunter: C''est comme ça que je suis arrivé ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249257
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249258
    m_Localized: 'Hunter: J''espère juste que t''auras le temps de tirer en premier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249259
    m_Localized: 'Hunter: Avec un peu de chance, les balles, ça peut marcher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249260
    m_Localized: Pourquoi est-ce qu'il ne t'a pas tué ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249261
    m_Localized: Tu crois qu'on peut le tuer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249262
    m_Localized: Il a décimé toute une escouade !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249263
    m_Localized: 'Hunter: Aucune idée. Il a pété un fusil comme si c''était une brindille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249264
    m_Localized: 'Hunter: Il aurait pu m''arracher la tête sans forcer… mais il l''a pas fait.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249265
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249266
    m_Localized: 'Hunter: Peut-être qu''il aime juste jouer avec nous. Comme un chat avec une souris.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249267
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249268
    m_Localized: 'Hunter: Tu sais, j''ai pas peur de grand-chose. Mais ce grand pâle, là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249269
    m_Localized: 'Hunter: Il me fout la trouille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249270
    m_Localized: 'Hunter: J''aimerais pouvoir y croire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249271
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249272
    m_Localized: 'Hunter: Tu sais ce qu''on dit… Si ça saigne, ça peut mourir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249273
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249274
    m_Localized: 'Hunter: S''ils s''y sont mis à plusieurs sans rien pouvoir faire… Alors, on n''a aucune chance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249275
    m_Localized: 'Hunter: S''il décide d''entrer, il détruira tout sur son passage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249276
    m_Localized: 'Hunter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249277
    m_Localized: 'Hunter: Tu sais, j''ai pas peur de grand-chose. Mais ce grand pâle, là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249278
    m_Localized: 'Hunter: Il me fout la trouille.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249279
    m_Localized: 'Hunter: Pas de bière, pas d''histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249280
    m_Localized: 'Hunter: Sobre, je parlerai pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944307249281
    m_Localized: 'Hunter: Si tu veux connaître la fin… Apporte-moi à boire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443456
    m_Localized: 'Cold: Juste un tout petit peu de chaleur…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443457
    m_Localized: Tu ne veux pas enlever ta veste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443458
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443459
    m_Localized: 'Cold: Non. Quelque chose me tracasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443460
    m_Localized: 'Cold: Qu''est-ce qui se passera si je l''enlève ? Je n''arrive pas à me réchauffer, même au chaud.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443461
    m_Localized: 'Cold: Si j''enlève ma veste, est-ce que je vais mourir de froid ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443462
    m_Localized: 'Cold: Ou pire encore, est-ce que je vais rester en vie et avoir encore plus froid ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443463
    m_Localized: Tu n'es pas en nage sous ta veste ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443464
    m_Localized: Mais alors… Tu ne prends jamais de douche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443465
    m_Localized: 'Cold: Non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443466
    m_Localized: 'Cold: Si le corps transpire, c''est pour essayer de se refroidir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443467
    m_Localized: 'Cold: Je ne crois pas que je peux avoir plus froid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443468
    m_Localized: 'Cold: Je préfère faire comme si je n''avais pas entendu. Désolé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443469
    m_Localized: 'Cold: Juste un tout petit peu de chaleur…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443470
    m_Localized: T'as une idée pour faire remonter ta température ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443471
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443472
    m_Localized: 'Cold: Je ne pense pas pouvoir y changer quoi que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443473
    m_Localized: 'Cold: L''eau bouillante, ça brûle. Ça ne sert à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443474
    m_Localized: 'Cold: Tu sais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443475
    m_Localized: 'Cold: J''ai trouvé une métaphore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443476
    m_Localized: 'Cold: Pense à l''espace infini. Vaste et glacé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443477
    m_Localized: 'Cold: Il y a des galaxies. Des étoiles se désagrègent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443478
    m_Localized: 'Cold: Et moi, je regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443479
    m_Localized: 'Cold: Je ne connaîtrai jamais la chaleur du soleil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443480
    m_Localized: 'Cold: Ni celle d''une étreinte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443481
    m_Localized: 'Cold: Je ne pense pas que l''espace ou la société aient besoin de moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443482
    m_Localized: 'Cold: Juste un tout petit peu de chaleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443483
    m_Localized: Quand on s'est rencontrés, tu disais que tu avais quelque chose à me montrer. C'était quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443484
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443485
    m_Localized: 'Cold: Hmm. Je ne sais pas si j''ai envie d''en parler maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443486
    m_Localized: 'Cold: Il y a quelque chose qui me tracasse depuis un moment. C''est peut-être pour ça que je me sens si… froid.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443487
    m_Localized: 'Cold: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443488
    m_Localized: 'Cold: Je ne veux même pas en parler, mais c''est un désir qui me ronge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443489
    m_Localized: 'Cold: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443490
    m_Localized: 'Cold: Je t''en parlerai demain. Je pense que je serai prêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443491
    m_Localized: 'Cold: Juste un tout petit peu de chaleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443492
    m_Localized: Alors, qu'est-ce que tu caches ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443493
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443494
    m_Localized: 'Cold: Oui. Je voulais te dire un secret.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443495
    m_Localized: 'Cold: Je crois que je suis prêt.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443496
    m_Localized: 'Cold: En général, ça finit mal. Mais peut-être pas cette fois-ci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443497
    m_Localized: 'Cold: C''est sous mes vêtements que se cache, je crois, la raison de ma froideur et de ma solitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443498
    m_Localized: 'Cold: Regarde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443499
    m_Localized: 'Cold: Non… Pas encore.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443500
    m_Localized: Qu'est-ce que tu as fait ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443501
    m_Localized: T'es foutu.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443502
    m_Localized: 'Cold: Je ne voulais pas faire ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443503
    m_Localized: 'Cold: Je pensais que les choses seraient différentes ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443504
    m_Localized: 'Cold: Mais c''est toujours pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443505
    m_Localized: 'Cold: Je ne voulais pas que ça se passe comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443506
    m_Localized: 'Cold: Je te jure, je ne voulais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443507
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443508
    m_Localized: Expulser
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443509
    m_Localized: 'Cold: C''est déjà arrivé avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443510
    m_Localized: 'Cold: Pourquoi est-ce que j''ai cru que cette fois serait différente ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443511
    m_Localized: 'Cold: Ne fais pas de bêtises.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443512
    m_Localized: 'Cold: Je n''ai pas fait ça par méchanceté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443513
    m_Localized: 'Cold: C''était pas mon intention.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443514
    m_Localized: Tirer
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443515
    m_Localized: Expulser
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443516
    m_Localized: 'Cold: C''est peut-être mieux comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443517
    m_Localized: 'Cold: Plus de froid. Plus de solitude.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443518
    m_Localized: 'Cold: Je…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443519
    m_Localized: 'Cold: Je ne crois pas avoir prévu que les choses se passeraient comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443520
    m_Localized: 'Cold: Là, tout de suite ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443521
    m_Localized: 'Cold: Une balle, ce serait plus doux, mais je ressens la douleur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443522
    m_Localized: 'Cold: Le soleil prendra plus de temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443523
    m_Localized: 'Cold: Est-ce que je peux rester jusqu''à la tombée de la nuit ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443524
    m_Localized: Pars, maintenant !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443525
    m_Localized: Ne fais pas de bêtises.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443526
    m_Localized: 'Cold: Compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443527
    m_Localized: 'Cold: Pardon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443528
    m_Localized: 'Cold: Peut-être que le soleil me réchauffera. Une dernière fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443529
    m_Localized: 'Cold: Merci.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443530
    m_Localized: 'Cold: Je sais que tu me détestes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443531
    m_Localized: 'Cold: Mais quand même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944311443532
    m_Localized: 'Cold: Je te demande pardon. Je ne voulais pas que les choses se passent comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832064
    m_Localized: 'Daughter: Et aussi… hmm… Tu pourrais peut-être dire à ma copine de venir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832065
    m_Localized: 'Daughter: Quand ce sont les grands qui l''invitent, on la laisse venir… mais si c''est moi, je me fais toujours gronder.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832066
    m_Localized: 'Daughter: Je crois que c''est son numéro de téléphone : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832067
    m_Localized: 'Greatmother: Oh, mon mignon. Ne laisse personne entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832068
    m_Localized: Pourquoi la FEMA t'a expulsée plutôt que de t'emmener ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832069
    m_Localized: Je veux te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832070
    m_Localized: 'Greatmother: J''en sais pas plus que toi, mon mignon. Ces types en combinaison… Impossible de les comprendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832071
    m_Localized: 'Greatmother: Toujours à se pavaner et à aboyer leurs ordres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832072
    m_Localized: 'Greatmother: Pour qui ils se prennent, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832073
    m_Localized: 'Greatmother: Je mettrais ma main à couper qu''ils y connaissent rien. Ils se donnent juste de grands airs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832074
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832075
    m_Localized: 'Greatmother: Dis-moi, ils sont venus frapper à ta porte aussi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832076
    m_Localized: Oui.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832077
    m_Localized: Il y en a un qui traîne toujours dans le coin.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832078
    m_Localized: 'Greatmother: Bande de salauds ! On devrait leur arracher leurs combinaisons et les parquer directement dans leurs enclos de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832079
    m_Localized: 'Greatmother: Comme ça, ils verraient ce que c''est que de vivre parmi les gens normaux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832080
    m_Localized: 'Greatmother: Ils prennent le contrôle des immeubles maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832081
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832082
    m_Localized: 'Greatmother: De vrais sauvages, je te jure.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832083
    m_Localized: 'Greatmother: Une fois, passe encore. Mais revenir encore et encore…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832084
    m_Localized: 'Greatmother: Ils n''ont vraiment honte de rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832085
    m_Localized: 'Greatmother: Oh, mon mignon. Ne laisse personne entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832086
    m_Localized: Est-ce qu'ils ont emmené des membres de ta famille ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832087
    m_Localized: Je veux te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832088
    m_Localized: 'Greatmother: Ohh… Ça fait un bail que personne ne m''a posé de questions sur ma famille, mon mignon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832089
    m_Localized: 'Greatmother: J''ai une grande famille. J''ai mis au monde toute une ribambelle de gosses.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832090
    m_Localized: 'Greatmother: Tellement de gosses…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832091
    m_Localized: 'Greatmother: Qu''on a du mal à tous tenir dans la maison aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832092
    m_Localized: 'Greatmother: Derrière ces portes fermées à clé, une pauvre petite âme se cache pour échapper à ces fichus tarés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832093
    m_Localized: Tu n'as pas répondu à la question.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832094
    m_Localized: Alors, est-ce qu'ils ont emmené ta famille ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832095
    m_Localized: 'Greatmother: Oh…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832096
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832097
    m_Localized: 'Greatmother: Désolée, mon chou, j''ai perdu le fil, je crois…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832098
    m_Localized: 'Greatmother: Ouais. Ces salauds en combinaison m''ont pris tout ce que j''avais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832099
    m_Localized: 'Greatmother: Mais ils ne vont pas s''en tirer comme ça, oh que non !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832100
    m_Localized: 'Greatmother: Et toi, ils t''ont pris quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832101
    m_Localized: J'ai pas de famille.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832102
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832103
    m_Localized: 'Greatmother: Oh…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832104
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832105
    m_Localized: 'Greatmother: Désolée, mon chou, j''ai perdu le fil, je crois…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832106
    m_Localized: 'Greatmother: Ouais. Ces salauds en combinaison m''ont pris tout ce que j''avais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832107
    m_Localized: 'Greatmother: Et toi, ils t''ont pris quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832108
    m_Localized: J'ai pas de famille.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832109
    m_Localized: Non.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832110
    m_Localized: 'Greatmother: Ah ouais ? Alors, pourquoi t''as une baraque aussi grande ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832111
    m_Localized: 'Greatmother: Tu vivais en colocation, ou quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832112
    m_Localized: 'Greatmother: Une baraque comme ça, d''habitude, c''est pour une grande famille, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832113
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832114
    m_Localized: 'Greatmother: D''accord, j''insiste pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832115
    m_Localized: 'Greatmother: J''aimerais juste récupérer ma famille… Ils sont là-bas, dans ces foutues zones…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832116
    m_Localized: 'Greatmother: Ils t''ont pas embarqué, toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832117
    m_Localized: 'Greatmother: Alors, ta famille, elle est passée où ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832118
    m_Localized: 'Greatmother: Un endroit comme ça, c''est pas fait pour vivre seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832119
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832120
    m_Localized: 'Greatmother: D''accord, j''insiste pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832121
    m_Localized: 'Greatmother: J''aimerais juste récupérer ma famille… Ils sont là-bas, dans ces foutues zones…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832122
    m_Localized: 'Greatmother: Oh, mon mignon. Ne laisse personne entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832123
    m_Localized: Et tu comptes faire comment pour récupérer ta famille ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832124
    m_Localized: Je veux te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832125
    m_Localized: 'Greatmother: Je vais pas lever le p''tit doigt, mon chou. Ils trouveront la sortie sans moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832126
    m_Localized: Qu'est-ce que tu veux dire par là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832127
    m_Localized: Tout seuls ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832128
    m_Localized: 'Greatmother: Ils vont ramper dans la terre. Sortir du sol, mais de l''autre côté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832129
    m_Localized: 'Greatmother: Ces foutues clôtures et ces fils ne les arrêteront pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832130
    m_Localized: 'Greatmother: Et s''ils peuvent pas passer par en dessous, ils détruiront cette zone. Ils laisseront personne derrière.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832131
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832132
    m_Localized: 'Greatmother: Ils arrivent. Je les entends.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832133
    m_Localized: Mais qu'est-ce que tu racontes, bon sang ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832134
    m_Localized: T'as perdu la tête ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832135
    m_Localized: Qu'est-ce que tu veux dire par là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832136
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832137
    m_Localized: 'Greatmother: Les murs finiront par tomber, quand l''heure viendra.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832138
    m_Localized: 'Greatmother: Il y aura des morts, tant de morts… Et lui, il viendra, assoiffé de sang.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832139
    m_Localized: 'Greatmother: Et ces enfoirés en combinaison ? Ils se soucieront plus de ma famille. Ils auront d''autres chats à fouetter…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832140
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832141
    m_Localized: 'Greatmother: Ils arrivent. Je les entends.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832142
    m_Localized: Mais qu'est-ce que tu racontes, bon sang ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832143
    m_Localized: T'as perdu la tête ou quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832144
    m_Localized: Qu'est-ce que tu veux dire par là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832145
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832146
    m_Localized: 'Greatmother: On écrasera vos trous à rats…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832147
    m_Localized: 'Greatmother: Les murs vont céder… et les rues vont se couvrir de sang… de montagnes de morts…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832148
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832149
    m_Localized: 'Greatmother: Je les entends ramper. Ils sont presque là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832150
    m_Localized: Qu'est-ce que ça veut dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832151
    m_Localized: Qui es-tu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832152
    m_Localized: Est-ce que tu es un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832153
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832154
    m_Localized: 'Greatmother: La viande brûlée, ça sent si bon…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832155
    m_Localized: 'Greatmother: Ça cuit si bien dans les combinaisons. Un peu trop croustillante, peut-être. Mais vraiment, juste un tout petit peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832156
    m_Localized: 'Greatmother: Tu as des cadavres, mon mignon. Beaucoup. Assez pour faire un bon festin. Ma famille va se régaler ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832157
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832158
    m_Localized: 'Greatmother: Je les entends ramper. Ils sont presque là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832159
    m_Localized: Qu'est-ce que ça veut dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832160
    m_Localized: Qui es-tu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832161
    m_Localized: Est-ce que tu es un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832162
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832163
    m_Localized: 'Greatmother: Cette maison, c''est un endroit agréable. Un endroit spécial.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832164
    m_Localized: 'Greatmother: Une grande maison, presque vide. Y a de la place pour tout le monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832165
    m_Localized: 'Greatmother: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832166
    m_Localized: 'Greatmother: Je les entends ramper. Ils sont presque là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832167
    m_Localized: Qu'est-ce que ça veut dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832168
    m_Localized: Qui es-tu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832169
    m_Localized: Est-ce que tu es un Visiteur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832170
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832171
    m_Localized: 'Greatmother: Espèce de petit merdeux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832172
    m_Localized: 'Greatmother: Ils vont venir te chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832173
    m_Localized: 'Greatmother: Les enfants, on a trouvé un nouvel abri. On va enfin pouvoir se reposer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832174
    m_Localized: 'Greatmother: Rampez par ici… Le mignon n''a plus besoin de cette maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832175
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832176
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832177
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832178
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832179
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832180
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832181
    m_Localized: 'Greatmother: Maman veut voir ses bébés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832182
    m_Localized: 'Greatmother: Venez ! Cette maison est parfaite pour nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832183
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832184
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832185
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832186
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832187
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832188
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832189
    m_Localized: 'Greatmother: Rampez, les enfants. Je suis là. Je nous ai trouvé une nouvelle maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832190
    m_Localized: 'Greatmother: Elle est si grande. Si belle. Il y a tellement d''espace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832191
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832192
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832193
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832194
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832195
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832196
    m_Localized: (La tuer)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832197
    m_Localized: 'Greatmother: Non. Donne-nous ta maison. Tu la détestes de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944319832198
    m_Localized: 'Greatmother: Tu veux qu''elle brûle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026368
    m_Localized: DONNE-LA À MAMAN !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026369
    m_Localized: 'Greatmother: Pourquoi résister ? Je sais ce que tu veux…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026370
    m_Localized: 'Greatmother: La mort…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944324026371
    m_Localized: 'Wolfhound: T''as quelque chose à dire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220672
    m_Localized: Pourquoi tu considères que les gens sont des animaux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220673
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220674
    m_Localized: 'Wolfhound: Laisse-moi te poser une question. Au fond, on est quoi, vraiment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220675
    m_Localized: 'Wolfhound: On tue, on mange ce qu''on tue, et ça ne nous empêche pas de dormir. C''est la loi de la nature.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220676
    m_Localized: 'Wolfhound: Mais la société a mis une laisse autour du cou. Heureusement pour nous, cette époque est révolue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220677
    m_Localized: Qu'est-ce que tu veux dire par là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220678
    m_Localized: T'es content de la tournure qu'ont prise les choses ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220679
    m_Localized: 'Wolfhound: C''est simple. Les règles à la con de la société ont volé en éclats. Maintenant, le champ est libre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220680
    m_Localized: 'Wolfhound: Il y a une meute. Et un chef. Ceux qui menacent la survie de la meute meurent. C''est un code que je peux respecter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220681
    m_Localized: 'Wolfhound: Mais le pire dans tout ça ? Ce sont les agneaux qui se déguisent en loups.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220682
    m_Localized: Tu penses qu'une meute, c'est mieux qu'une société ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220683
    m_Localized: Euh… Tu veux parler de loups qui se déguisent en moutons, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220684
    m_Localized: 'Wolfhound: Moi, je suis juste content que les gens aient arrêté de se cacher derrière des masques.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220685
    m_Localized: 'Wolfhound: Mais les moutons, ils gâchent tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220686
    m_Localized: 'Wolfhound: Ils se glissent dans des peaux de loup et jouent la comédie. Ils imitent les instincts des mecs qui trichent pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220687
    m_Localized: 'Wolfhound: Des lâches ! Ils creusent des trous dans la terre. Je préfère un combat loyal plutôt que de jouer au chat et à la souris.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220688
    m_Localized: 'Wolfhound: Mais si t''as réussi à te constituer une meute, c''est que t''as appris à démasquer les imposteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220689
    m_Localized: Tu penses que la meute, c'est mieux que la société ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220690
    m_Localized: Euh… Tu veux parler de loups qui se déguisent en moutons, non ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220691
    m_Localized: 'Wolfhound: Tu en doutes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220692
    m_Localized: 'Wolfhound: Dans la société d''avant, t''aurais jamais été fichu de repérer un de ces moutons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220693
    m_Localized: 'Wolfhound: Trop de blabla, trop de règles. Tu serais resté coincé dans des débats au lieu de faire ce qu''il y avait à faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220694
    m_Localized: 'Wolfhound: C''est pour ça qu''un chef, c''est vital. Pas de questions, pas de votes. Sa parole, c''est la loi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220695
    m_Localized: 'Wolfhound: Un chef DOIT montrer sa force. Y a que comme ça que la meute peut survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220696
    m_Localized: 'Wolfhound: Ouais, je parle bien de ces saloperies de lâches… les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220697
    m_Localized: 'Wolfhound: Ils se terrent dans le sol comme des rats, en attendant qu''on faiblisse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220698
    m_Localized: 'Wolfhound: Et maintenant, ils jouent avec nos sentiments, nos foutues valeurs humaines, pour qu''on n''ose plus les tuer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220699
    m_Localized: 'Wolfhound: C''est pour ça qu''on doit montrer les crocs. Leur rappeler qu''on reste des bêtes. Sinon, ils nous boufferont.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220700
    m_Localized: 'Wolfhound: T''as un truc à rajouter ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220701
    m_Localized: Pourquoi tu regardes mon flingue ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220702
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220703
    m_Localized: 'Wolfhound: Y a un vrai chef en toi. Tu fais en sorte que tout le monde soit dans les clous, tu sais prendre les choses en main.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220704
    m_Localized: 'Wolfhound: T''as une belle maison. Y a souvent du monde qui passe. En revanche, tes colocataires…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220705
    m_Localized: C'est quoi leur problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220706
    m_Localized: Tu penses qu'il y en a parmi eux qui sont des Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220707
    m_Localized: 'Wolfhound: T''as rassemblé des faibles. Des mauviettes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220708
    m_Localized: 'Wolfhound: Dis-moi… À quoi ils peuvent servir les vieux, les enfants, les malades ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220709
    m_Localized: 'Wolfhound: La meute, elle doit être composée d''éléments forts. C''est comme ça qu''on survit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220710
    m_Localized: Alors, qu'est-ce que tu veux que je fasse ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220711
    m_Localized: Tu veux que je les mette à la porte ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220712
    m_Localized: 'Wolfhound: C''est pas les loups déguisés en moutons qui m''inquiètent le plus. C''est les moutons qui se prennent pour des loups.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220713
    m_Localized: 'Wolfhound: Ta meute est bancale. Ça entre, ça sort, sans aucune loyauté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220714
    m_Localized: 'Wolfhound: Choisis les plus forts. Reste avec eux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220715
    m_Localized: Alors, qu'est-ce que tu veux que je fasse ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220716
    m_Localized: Tu veux que je les mette à la porte ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220717
    m_Localized: 'Wolfhound: Tu dois te débarrasser des faibles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220718
    m_Localized: 'Wolfhound: Tue-les. En public. Que tout le monde comprenne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220719
    m_Localized: 'Wolfhound: C''est comme ça qu''on prend le dessus. Qu''on montre qui commande.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220720
    m_Localized: 'Wolfhound: Et ceux qui ne bronchent pas quand les faibles tombent… C''est le genre de loup que tu veux dans ta meute…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220721
    m_Localized: 'Wolfhound: Eux, ils restent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220722
    m_Localized: Je ne suis pas un meurtrier.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220723
    m_Localized: Je ne tue que les Visiteurs.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220724
    m_Localized: 'Wolfhound: Si tu les laisses faire, c''est ton autorité qui s''écroule. Ils te verront comme un faible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220725
    m_Localized: 'Wolfhound: La pitié, c''est juste de la faiblesse déguisée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220726
    m_Localized: 'Wolfhound: Faut être impitoyable. Visiteur ? Tu tires. Faible, malade, vieux ? Pareil.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220727
    m_Localized: 'Wolfhound: C''est la peur qui fait régner l''ordre. Et le chef, c''est celui qu''on craint.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220728
    m_Localized: Je ne suis pas un meurtrier.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220729
    m_Localized: Je ne tue que les Visiteurs.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220730
    m_Localized: 'Wolfhound: Tu crois tromper qui ? Je le vois dans ton regard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220731
    m_Localized: 'Wolfhound: T''as déjà tué. Alors, fais pas comme si t''avais pas de sang sur les mains.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220732
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220733
    m_Localized: 'Wolfhound: C''est moi qui faisais la loi dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220734
    m_Localized: 'Wolfhound: Les gens me craignaient, ils me respectaient.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220735
    m_Localized: 'Wolfhound: Tu sais combien de temps faut pour pourrir jusqu''à l''âme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220736
    m_Localized: 'Wolfhound: Moi j''ai laissé le temps faire. J''ai laissé la pourriture s''installer. Tu comprends ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220737
    m_Localized: 'Wolfhound: Un jour, un chauffeur de taxi a refusé de me prendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220738
    m_Localized: 'Wolfhound: Si j''avais laissé passer ça, j''étais fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220739
    m_Localized: 'Wolfhound: Alors, j''ai brisé tous les os de son corps. Un par un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220740
    m_Localized: 'Wolfhound: Mais son gosse, lui, a compris la leçon. Et les gens ont continué à me respecter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220741
    m_Localized: 'Wolfhound: Tu ferais mieux d''arrêter de dorloter les faibles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220742
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220743
    m_Localized: 'Wolfhound: C''est moi qui faisais la loi dans la rue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220744
    m_Localized: 'Wolfhound: Les gens me craignaient, ils me respectaient.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220745
    m_Localized: 'Wolfhound: Tu sais combien de temps faut pour pourrir jusqu''à l''âme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220746
    m_Localized: 'Wolfhound: Moi j''ai laissé le temps faire. J''ai laissé la pourriture s''installer. Tu comprends ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220747
    m_Localized: 'Wolfhound: Un jour, un chauffeur de taxi a refusé de me prendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220748
    m_Localized: 'Wolfhound: Si j''avais laissé passer ça, j''étais fini.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220749
    m_Localized: 'Wolfhound: Alors, j''ai brisé tous les os de son corps. Un par un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220750
    m_Localized: 'Wolfhound: Mais son gosse, lui, a compris la leçon. Et les gens ont continué à me respecter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220751
    m_Localized: 'Wolfhound: T''as quelque chose à dire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220752
    m_Localized: T'arrêtes pas de parler de meutes. Pourquoi t'en as pas une à toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220753
    m_Localized: Je voudrais te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220754
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220755
    m_Localized: 'Wolfhound: Pourquoi t''as formé la tienne ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220756
    m_Localized: Pour que ce grand Visiteur pâle me tue pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220757
    m_Localized: J'essaie d'aider les gens.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220758
    m_Localized: J'aime bien avoir de la compagnie.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220759
    m_Localized: Parce que ces gens ont besoin d'un chef.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220760
    m_Localized: J'ai demandé en premier.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220761
    m_Localized: 'Wolfhound: Alors, t''as rassemblé tout ce monde juste pour sauver ta peau ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220762
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220763
    m_Localized: 'Wolfhound: T''as pas l''air d''un mâle alpha. Tu ressembles à un p''tit clébard apeuré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220764
    m_Localized: 'Wolfhound: Cette meute a besoin d''un chef fort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220765
    m_Localized: 'Wolfhound: On dirait bien que je vais devoir prendre ta place. T''es pas fait pour diriger.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220766
    m_Localized: 'Wolfhound: Ton objectif est tout honneur. Un peu naïf, peut-être.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220767
    m_Localized: 'Wolfhound: Tu pourras pas sauver tout le monde. À un moment, tu devras fermer la porte à quelqu''un.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220768
    m_Localized: 'Wolfhound: Mais tu parles comme un alpha. Je remettrai pas ton autorité en question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220769
    m_Localized: 'Wolfhound: C''est tout ? T''as juste peur d''être seul ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220770
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220771
    m_Localized: 'Wolfhound: C''est pas le discours d''un mâle alpha, ça. C''est de la lâcheté.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220772
    m_Localized: 'Wolfhound: Là, tu parles comme un homme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220773
    m_Localized: 'Wolfhound: Alors, je remettrai pas ton autorité en question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220774
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220775
    m_Localized: 'Wolfhound: Je répondrai pas à ça. Moins tu en sais, mieux c''est.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220776
    m_Localized: 'Wolfhound: Je t''en ai déjà dit plus que j''aurais dû. Maintenant, c''est à toi de jouer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220777
    m_Localized: 'Wolfhound: Si t''es pas capable de diriger, je prendrai ta place.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220778
    m_Localized: Va te faire foutre !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220779
    m_Localized: En quoi tu serais meilleur que moi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220780
    m_Localized: (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220781
    m_Localized: Casse-toi avant que je te tire dessus !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220782
    m_Localized: 'Wolfhound: LA FERME, LE TOUTOU. T''es plus rien pour moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220783
    m_Localized: 'Wolfhound: Si tu sais même pas pourquoi tu es en charge ? Pourquoi t''as endossé le rôle ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220784
    m_Localized: 'Wolfhound: Tu ferais mieux de décamper. Sinon je vais t''abattre comme un chien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220785
    m_Localized: 'Wolfhound: Moi, je connais les règles des meutes. Et je les applique.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220786
    m_Localized: 'Wolfhound: Si t''es tendre à ce point-là, alors t''es pas digne d''être un alpha.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220787
    m_Localized: 'Wolfhound: Tu ferais mieux de décamper. Sinon je vais t''abattre comme un chien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220788
    m_Localized: 'Wolfhound: Alors, c''est comme ça, hein.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220789
    m_Localized: 'Wolfhound: Tu crois que t''as une chance ? J''suis armé, tu le sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220790
    m_Localized: 'Wolfhound: Baisse ton flingue. Et qu''on en finisse, à la loyale.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220791
    m_Localized: (Lui tirer dessus)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220792
    m_Localized: (Baisser l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220793
    m_Localized: 'Wolfhound: Crève, sale bât—'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220794
    m_Localized: 'Wolfhound: Espèce de bâtard… T''as vraiment tiré.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220795
    m_Localized: 'Wolfhound: Bon chien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220796
    m_Localized: 'Wolfhound: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220797
    m_Localized: 'Wolfhound: Mais t''aurais dû finir le sale boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220798
    m_Localized: 'Wolfhound: (Il en profite pour dégainer son arme.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220799
    m_Localized: 'Wolfhound: (Il vous met en joue.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220800
    m_Localized: 'Wolfhound: (Heureusement, vous réussissez à attraper le fusil et vous tirez.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220801
    m_Localized: 'Doctor: Je vous écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220802
    m_Localized: Que s'est-il passé dans les hôpitaux ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220803
    m_Localized: Je dois vous ausculter.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220804
    m_Localized: 'Doctor: Ohhh… C''était un vrai cauchemar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220805
    m_Localized: 'Doctor: Dès le début, les gens se sont précipités dans les hôpitaux. Ils voulaient tous savoir s''ils n''étaient pas des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220806
    m_Localized: 'Doctor: On a essayé d''expliquer qu''on ne savait pas vraiment comment faire ce genre de diagnostics.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220807
    m_Localized: 'Doctor: Mais les gens ne voulaient rien entendre. Ils poussaient, ils bousculaient… On ne pouvait plus soigner les vrais malades.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220808
    m_Localized: 'Doctor: Finalement, la FEMA est arrivée. Ils ont décidé que la foule représentait un risque de contamination…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220809
    m_Localized: 'Doctor: Tout le monde a été envoyé dans des zones de quarantaine, et les hôpitaux… ont tout simplement fermé leurs portes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220810
    m_Localized: Alors vous avez perdu votre emploi à cause de la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220811
    m_Localized: Est-ce que c'est une erreur de la part de la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220812
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220813
    m_Localized: 'Doctor: Pour tout vous dire… dès que les hôpitaux ont fermé, je suis allé travailler dans les zones de quarantaine de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220814
    m_Localized: Pourquoi êtes-vous allé là-bas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220815
    m_Localized: Ah. Donc, vous êtes juste un autre enfoiré de la FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220816
    m_Localized: 'Doctor: Et vous pensez que c''était normal de parquer tout le monde comme ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220817
    m_Localized: 'Doctor: Mais ces soi-disant « symptômes » sont absurdes, non ? Ce sont des caractéristiques on ne peut plus ordinaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220818
    m_Localized: 'Doctor: C''est du grand n''importe quoi ! Alors, si on a les dents blanches, ça veut dire qu''on est un Visiteur ? Ben voyons…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220819
    m_Localized: 'Doctor: Moi, je vous le dis… Ils nous cachent quelque chose…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220820
    m_Localized: 'Doctor: Pour tout vous dire… dès que les hôpitaux ont fermé, je suis allé travailler dans les zones de quarantaine de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220821
    m_Localized: 'Doctor: J''espérais pouvoir en apprendre un peu plus sur les visiteurs et leurs signes. Mais… ça n''a rien donné.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220822
    m_Localized: Pourquoi êtes-vous allé là-bas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220823
    m_Localized: Ah. Donc, vous êtes juste un autre enfoiré de la FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220824
    m_Localized: 'Doctor: Je… Je voulais continuer à aider les gens. C''est ma vocation. Je ne peux pas m''en détourner comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220825
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220826
    m_Localized: 'Doctor: Peut-être… Non. Pardonnez-moi, je ne suis pas encore prêt à en parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220827
    m_Localized: 'Doctor: Vous avez tort de me traiter d''enfoiré. Vous ne connaissez pas toute l''histoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220828
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220829
    m_Localized: 'Doctor: Peut-être… Non. Pardonnez-moi, je ne suis pas encore prêt à en parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220830
    m_Localized: 'Doctor: Je vous écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220831
    m_Localized: Alors, qu'est-ce que vous vouliez me dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220832
    m_Localized: Je dois vous ausculter.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220833
    m_Localized: 'Doctor: Pourriez-vous me dire ce que vous pensez de la FEMA ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220834
    m_Localized: Je trouve que la FEMA fait du bon travail.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220835
    m_Localized: Je ne fais absolument pas confiance à la FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220836
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220837
    m_Localized: 'Doctor: C''est dommage. Je pense tout le contraire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220838
    m_Localized: 'Doctor: J''ai collaboré avec eux, et pourtant je n''ai aucune raison de leur faire confiance. Surtout après ce que j''ai vu là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220839
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220840
    m_Localized: 'Doctor: D''après mon expérience dans cette organisation, les médecins sont complètement dans le noir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220841
    m_Localized: 'Doctor: Vous leur faites confiance alors qu''ils ne peuvent expliquer d''où viennent ces signes ni ce qu''ils signifient ? Vraiment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220842
    m_Localized: 'Doctor: Après tout ça… comment pouvez-vous encore faire confiance à la FEMA ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220843
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220844
    m_Localized: 'Doctor: Je dois avouer que je vous croyais plus malin que ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220845
    m_Localized: 'Doctor: Tant mieux. Moi non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220846
    m_Localized: 'Doctor: Honnêtement, je ne comprends pas les motivations de la FEMA. Même après avoir travaillé avec eux pendant un certain temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220847
    m_Localized: 'Doctor: Mais quelles que soient leurs motivations, j''ai choisi d''aider les gens à ma manière, en dépit de leurs stupides règles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220848
    m_Localized: 'Doctor: Le problème, c''était la transparence. Il n''y en avait aucune. Absolument aucune.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220849
    m_Localized: 'Doctor: On ne nous a jamais dit d''où venaient ces « signes », ni ce qu''ils étaient censés signifier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220850
    m_Localized: 'Doctor: Ils nous ont simplement remis une liste de directives, pour savoir qui considérer comme Visiteur et qui laisser passer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220851
    m_Localized: 'Doctor: Après ça, j''avais plus l''impression d''être un soignant, mais plutôt une sorte de douanier qui tamponnait de la paperasse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220852
    m_Localized: 'Doctor: Alors, j''ai commencé à falsifier des rapports. J''ai aidé des gens à s''échapper.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220853
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220854
    m_Localized: 'Doctor: Je suis sûr que vous avez encore des questions. Mais si ça ne vous dérange pas, on en reparlera demain.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713912
    m_Localized: 'Doctor: Pardonnez-moi, mais je n''ai plus envie de parler aujourd''hui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713913
    m_Localized: 'Doctor: C''est à ce moment-là que j''ai décidé de quitter l''organisation.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220855
    m_Localized: 'Doctor: Je vous écoute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220856
    m_Localized: Pourquoi n'êtes-vous pas en zone de quarantaine ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220857
    m_Localized: Je dois vous ausculter.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220858
    m_Localized: 'Doctor: C''était… cet incident…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220859
    m_Localized: 'Doctor: Le soleil venait tout juste de se lever. J''allais rentrer chez moi quand un des agents de la FEMA m''a interpellé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220860
    m_Localized: 'Doctor: À ce moment-là, mon cœur s''est mis à battre à tout rompre, mes genoux ont failli se dérober sous moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220861
    m_Localized: 'Doctor: Il m''a ordonné d''un ton sec de me retourner. J''ai cru que j''allais mourir sur-le-champ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220862
    m_Localized: 'Doctor: Il a pointé son fusil sur mes jambes et m''a dit de ne pas bouger. Il a continué à me fixer, puis…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220863
    m_Localized: 'Doctor: Il m''a dit de tirer la langue pour vérifier si j''étais un Visiteur, ce que j''ai fait. J''étais terrifié à l''idée de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220864
    m_Localized: 'Doctor: Et il a ri. Il m''a dit que je devais être un mauvais médecin, car je ne savais même pas que la langue n''était pas un signe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220865
    m_Localized: 'Doctor: J''ai jamais eu aussi peur pour ma vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220866
    m_Localized: 'Doctor: À ce moment-là, je pensais plus à sauver la vie de qui que ce soit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220867
    m_Localized: 'Doctor: Je me suis enfui. Comme un lâche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220868
    m_Localized: 'Doctor: Quelle honte… c''est insupportable. J''ai honte d''avoir abandonné ceux qui sont là-bas. J''ai tellement honte de moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220869
    m_Localized: Je ne vous juge pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220870
    m_Localized: Mais, vous pouvez toujours aider les gens.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220871
    m_Localized: Vous n'êtes qu'un lâche pathétique. Sortez de chez moi.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220872
    m_Localized: 'Doctor: Merci de votre compréhension. Ça… ça me soulage un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220873
    m_Localized: 'Doctor: Je n''arrête pas de penser à toutes les vies que j''aurais pu sauver si j''étais resté là-bas jusqu''à la fin…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220874
    m_Localized: 'Doctor: J''ai peur de pas pouvoir faire grand-chose…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220875
    m_Localized: 'Doctor: Tout mon matériel est resté dans la zone de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220876
    m_Localized: 'Doctor: Et maintenant… Je suis totalement inutile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220877
    m_Localized: 'Doctor: Je sais que vous espériez obtenir un traitement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220878
    m_Localized: 'Doctor: Mais que peut faire un vieil homme comme moi avec rien d''autre que ses mains nues ? Presque rien…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220879
    m_Localized: 'Doctor: Je suis désolé si je vous ai déçu. J''ai bien peur d''être impuissant face à la menace des Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220880
    m_Localized: Ne vous inquiétez pas, vous pouvez rester malgré tout.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220881
    m_Localized: Dans ce cas… Attention à ne pas vous cogner la tête en sortant.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220882
    m_Localized: 'Doctor: Je suppose que vous avez raison. Je ferais mieux de partir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220883
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220884
    m_Localized: 'Doctor: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220885
    m_Localized: 'Doctor: Merci de votre compréhension. Ça… ça me soulage un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220886
    m_Localized: 'Doctor: De toute façon, la FEMA aurait fini par découvrir ces faux rapports tôt ou tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220887
    m_Localized: 'Doctor: Mais je reste hanté par l''idée que j''aurais dû sacrifier ma vie pour sauver plus de gens…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220888
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220889
    m_Localized: 'Doctor: Je porterai sans doute ce fardeau jusqu''à la fin de mes jours.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220890
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220891
    m_Localized: 'Doctor: Je suppose que vous avez raison. Un vieil homme comme moi n''a plus sa place dans ce nouveau monde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220892
    m_Localized: 'Doctor: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713914
    m_Localized: 'Doctor: Pourquoi cette question ? Vous cherchez à savoir pourquoi je ne fais pas confiance à la FEMA ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713915
    m_Localized: 'Doctor: Commençons par le commencement…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713916
    m_Localized: 'Doctor: Croyez-vous que les Visiteurs sont une sorte de virus ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713917
    m_Localized: Je ne pense pas qu'ils existent.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713918
    m_Localized: Non, mais j'ignore ce qu'ils sont réellement.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713919
    m_Localized: Oui, j'en suis convaincu.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713920
    m_Localized: 'Doctor: Si c''est ce que vous croyez, je ne comprends pas pourquoi vous vous donnez tant de mal avec tous ces tests.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713921
    m_Localized: 'Doctor: N''essayez pas de me berner.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713922
    m_Localized: 'Doctor: Bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713923
    m_Localized: 'Doctor: Je comprends. Malheureusement, j''ignore moi aussi ce que sont réellement les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713924
    m_Localized: 'Doctor: Mais une chose est sûre : ce n''est pas un virus.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713925
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713926
    m_Localized: 'Doctor: Eh bien, je crains de devoir vous décevoir. C''est très peu probable.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713927
    m_Localized: 'Doctor: Avez-vous déjà vu une personne en parfaite santé se transformer subitement en Visiteur ? Juste sous vos yeux ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713928
    m_Localized: 'Doctor: Non ? Voilà. Cela n''est jamais arrivé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713929
    m_Localized: 'Doctor: Il faut que vous compreniez que la FEMA ne contrôle pas la situation. Elle fait juste semblant.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713930
    m_Localized: 'Doctor: Elle a fermé les hôpitaux, envoyé tout le monde en quarantaine… Mais pour quoi faire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713931
    m_Localized: 'Doctor: Est-ce qu''elle aide les gens ? Est-ce que quelqu''un en est déjà revenu guéri ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713932
    m_Localized: 'Doctor: En réalité, la FEMA a parqué la population, refermé les grilles… Et désormais, elle peut agir à sa guise…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713933
    m_Localized: Pourquoi avez-vous travaillé pour la FEMA dans ce cas ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713934
    m_Localized: J'en ai assez entendu. Partez, vous et vos absurdités !
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713935
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713936
    m_Localized: 'Doctor: Je ne pouvais pas rester les bras croisés pendant que les gens se font tuer les uns après les autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713937
    m_Localized: 'Doctor: C''est pour ça que j''ai rejoint la FEMA… Pour aider ces malheureux à s''échapper des zones de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713938
    m_Localized: 'Doctor: Je les ai auscultés, posé mes diagnostics… et falsifié des papiers afin qu''ils retrouvent leur liberté.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713939
    m_Localized: Vous êtes fou ? Vous avez sans doute remis des Visiteurs en liberté !
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713940
    m_Localized: De quel incident parlez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713941
    m_Localized: Et dire que maintenant, c'est vous qui devez vous échapper d'ici…
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713942
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713943
    m_Localized: 'Doctor: C''est dommage que vous ne vouliez même pas m''écouter…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713944
    m_Localized: 'Doctor: Puisqu''il en est ainsi, je ne vais pas vous déranger plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713945
    m_Localized: 'Doctor: Au revoir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713946
    m_Localized: 'Doctor: Et qu''auriez-vous préféré ? Les laisser mourir là-bas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713947
    m_Localized: 'Doctor: J''ai prêté le serment d''Hippocrate. Je ferai tout ce qui est en mon pouvoir pour protéger la vie et la santé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713948
    m_Localized: 'Doctor: Mais au bout du compte… j''ai dû moi-même fuir une zone de quarantaine après un incident. Malheureusement.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713949
    m_Localized: 'Doctor: C''est arrivé dans le secteur où j''étais affecté.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713950
    m_Localized: 'Doctor: Quoi !?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713951
    m_Localized: 'Doctor: Vous pensez vraiment que j''aurais dû les abandonner à leur triste sort ? Et vous me jetez dehors pour ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713952
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713953
    m_Localized: 'Doctor: Mais vous êtes pire que la FEMA ! Eux, au moins, ils font semblant d''aider ceux qu''ils abritent…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713954
    m_Localized: 'Doctor: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713955
    m_Localized: 'Doctor: Je n''ai plus rien à faire ici. Je crains le pire pour ceux que vous gardez sous votre toit, sachez-le !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713956
    m_Localized: 'Doctor: Adieu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220893
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220894
    m_Localized: Alors, tu as coupé les ficelles autour de ta bouche ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220895
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220896
    m_Localized: 'Foreigner: C''ast in vroy coichamor !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220897
    m_Localized: 'Foreigner: Yls m''ent CEISI LO BEICHA ! Teit ço, jista porca qu''yls cemprannant ryan da ca qia ja dys.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220898
    m_Localized: Je ne comprends pas ce que tu dis.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220899
    m_Localized: Et toi ? Est-ce que tu comprends ce que je dis ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220900
    m_Localized: 'Foreigner: Ja na cemprands pos ca qia veis rocentaz. Qi''ast-ca qi''en pait foyra ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220901
    m_Localized: 'Foreigner: Cræar netra prepra longoga ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220902
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220903
    m_Localized: Comment est-ce qu'on est censés communiquer ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220904
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220905
    m_Localized: 'Foreigner: Ja soys ! Ja veys ræpætar ves mets, at veis, veis ræogyssaz ô ca qia ja dys.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220906
    m_Localized: 'Foreigner: Cemma ço, oi meyns, j''orryvaroy pait-âtra ô cemprandra ca qia mey ja dys.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220907
    m_Localized: 'Foreigner: Comment.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220908
    m_Localized: Comment quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220909
    m_Localized: Tu essaies de demander quelque chose ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220910
    m_Localized: 'Foreigner: Ja n''orryva teijeirs pos ô cemprandra. An teit cos, veis m''ovaz pesæ ina qiastyen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220911
    m_Localized: 'Foreigner: C''ætoyt pait-âtra in met yntarregotyf…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220912
    m_Localized: 'Foreigner: Ja n''orryva teijeirs pos ô cemprandra. An teit cos, veis m''ovaz pesæ ina qiastyen.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220913
    m_Localized: 'Foreigner: C''ætoyt pait-âtra in met yntarregotyf…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220914
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220915
    m_Localized: Hé, comment ça va ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944328220916
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414976
    m_Localized: 'Foreigner: (Vous lui tapotez l''épaule et pointez les blessures qui entourent sa bouche.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414977
    m_Localized: Tu vas bien ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414978
    m_Localized: Tu as mal ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414979
    m_Localized: 'Foreigner: Ast-ca qia veis peirriaz ræpætar ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414980
    m_Localized: 'Foreigner: Bh-ooon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414981
    m_Localized: 'Foreigner: Bhhh…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414982
    m_Localized: 'Foreigner: Bh-ooon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414983
    m_Localized: 'Foreigner: C''ast cemplyquæ, moys pait-âtra qia ço oydaro.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414984
    m_Localized: 'Foreigner: Ja ma damonda s''yl sa possa lo mâma chesa dons men pous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414985
    m_Localized: 'Foreigner: Qial coichamor…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414986
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414987
    m_Localized: Comment comptes-tu rentrer chez toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414988
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414989
    m_Localized: 'Foreigner: (Vous joignez vos mains en triangle au-dessus de votre tête, en imitant la forme d''un toit.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414990
    m_Localized: 'Foreigner: Mo moysen ? Veis ma damondyaz eï ast mo moysen ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414991
    m_Localized: 'Foreigner: J''ætoys vani randra vysyta ô in omy, at c''ast lô qia teit o cemmanæ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414992
    m_Localized: 'Foreigner: Lo sytiotyen ast cemplàtamant mardyqua. Dæselæ,, moys yl n''u o pos d''oitra met.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414993
    m_Localized: Comment je peux t'aider à rentrer chez toi ? En avion ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414994
    m_Localized: T'as regardé les billets de bateau ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414995
    m_Localized: 'Foreigner: (Vous balayez votre main vers le bas.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414996
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414997
    m_Localized: 'Foreigner: In ovyen ? Veis pansaz qu''yl u an o qiy velant ancera ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414998
    m_Localized: 'Foreigner: Ja davroys assouar da ma ransaygnar.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332414999
    m_Localized: 'Foreigner: Yl u o pait-âtra ancera in meuan da portyr d''ycy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415000
    m_Localized: 'Foreigner: (Vous bougez votre main en imitant les vagues.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415001
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415002
    m_Localized: 'Foreigner: Cemma… veuogar sir in botaoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415003
    m_Localized: 'Foreigner: Ast-ca qi''yl u an o ancera qiy prannant la lorga ? Ja voys ma ransaygnar, marcy !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415004
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415005
    m_Localized: Pourquoi as-tu l'air si excité ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415006
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415007
    m_Localized: 'Foreigner: (Vous souriez et pointez du doigt votre sourire, puis lui.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415008
    m_Localized: 'Foreigner: Eh, veis porlaz da ço.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415009
    m_Localized: 'Foreigner: Yls ent ræissy æ ma dyra qia las troyns cyrciloyant teijeirs ! Veis u creyaz ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415010
    m_Localized: 'Foreigner: (Il fait glisser sa main le long de son autre bras.)'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415011
    m_Localized: 'Foreigner: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415012
    m_Localized: Est-ce qu'il y a quelqu'un qui peut te ramener chez toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415013
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415014
    m_Localized: 'Foreigner: Ja na cemprands pos, men omy.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415015
    m_Localized: 'Foreigner: Damoyn, ja rantra chaz mey ! Ei di meyns, j''yroy ô lo gora.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415016
    m_Localized: 'Foreigner: Ja pors ca seyr. Oi raveyr !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415017
    m_Localized: 'Foreigner: Sahluuu !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415018
    m_Localized: Tu veux dire, le train ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415019
    m_Localized: Tu vas quelque part ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415020
    m_Localized: 'Foreigner: Ja n''oy pos cemprys, dæselæ.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415021
    m_Localized: 'Foreigner: Moys damoyn, j''yroy veyr por mey-mâma ô lo gora !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415022
    m_Localized: 'Foreigner: Pait-âtra qia ja peirroy anfyn rantrar chaz mey…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415023
    m_Localized: 'Foreigner: Bhonn hanse !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415024
    m_Localized: 'Edgar: Quel silence… troublant de sérénité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415025
    m_Localized: Comment va votre main ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415026
    m_Localized: Je dois vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415027
    m_Localized: 'Edgar: Je ne sens plus rien depuis un petit moment… Mais la douleur et le froid persistent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415028
    m_Localized: 'Edgar: Mais c''était à prévoir. J''aime faire durer les plaisirs les plus exquis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415029
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415030
    m_Localized: 'Edgar: J''ai aimé une jeune femme du plus profond de mon cœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415031
    m_Localized: 'Edgar: Je chérissais nos moments ensemble, en silence. Je croyais la comprendre sans un mot. C''est alors que j''ai compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415032
    m_Localized: 'Edgar: Je me berçais d''illusions. Je ne l''ai jamais vraiment connue. J''avais simplement envie d''y croire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415033
    m_Localized: 'Edgar: Et malgré tout, j''espère qu''un jour, je parviendrai à la comprendre. Sincèrement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415034
    m_Localized: 'Edgar: Quel silence… troublant de sérénité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415035
    m_Localized: Parlez-moi de cette jeune fille.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415036
    m_Localized: Je dois vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415037
    m_Localized: 'Edgar: Je pouvais voir le reflet froid de la lune dans ses yeux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415038
    m_Localized: 'Edgar: Elle était l''opposé même du cataclysme.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415039
    m_Localized: 'Edgar: Quand j''étais à ses côtés, j''étais hanté par un sentiment de mystère irrépressible.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415040
    m_Localized: 'Edgar: Et aujourd''hui encore, je brûle de percer ses secrets.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415041
    m_Localized: 'Edgar: À présent, elle est mon monument.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415042
    m_Localized: 'Edgar: Désormais, elle est devenue un monument dans ma mémoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415043
    m_Localized: 'Edgar: Quel silence… troublant de sérénité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415044
    m_Localized: Comment l'avez-vous rencontrée ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415045
    m_Localized: Je dois vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415046
    m_Localized: 'Edgar: Il y eut un moment où j''ai compris ce qui m''attendait. La septicémie allait finir par m''emporter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415047
    m_Localized: 'Edgar: Cette pensée m''a terrifié. J''ai compris que j''allais disparaître. Pas un jour, mais dans quelques mois à peine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415048
    m_Localized: 'Edgar: Et puis, alors que les Visiteurs rampaient hors de la terre… je l''ai trouvée, dans une maison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415049
    m_Localized: 'Edgar: Une jeune fille, drapée de lin blanc. Belle à en perdre la raison.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415050
    m_Localized: 'Edgar: Dans ce monde cruel, où chacun ne pense qu''à survivre, nul ne se souciait d''une telle grâce. Mais moi, si.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415051
    m_Localized: 'Edgar: Vous connaissez cette expression ? « Trop précieuse pour être refusée. Trop terrible pour être acceptée. »'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415052
    m_Localized: 'Edgar: Et pourtant… J''ai porté son corps fragile jusque chez moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415053
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415054
    m_Localized: 'Edgar: Lorsque la fin viendra, je pourrai dire que tout ce que j''ai fait, je l''ai fait avec amour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415055
    m_Localized: 'Edgar: Quel silence… troublant de sérénité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415056
    m_Localized: Où est cette jeune fille à présent ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415057
    m_Localized: Je dois vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415058
    m_Localized: 'Edgar: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415059
    m_Localized: 'Edgar: J''ai passé tant de temps à essayer de saisir sa beauté. La puissance de son silence.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415060
    m_Localized: 'Edgar: Mais ensuite…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415061
    m_Localized: 'Edgar: Des hommes sans visage, vêtus de jaune, ont fait irruption dans la pièce.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415062
    m_Localized: 'Edgar: Ils l''ont arrachée à moi. L''ont emmenée de force. Je crois que nous savons tous deux pourquoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415063
    m_Localized: 'Edgar: Quelle tragédie… Je ne l''ai jamais vraiment comprise.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415064
    m_Localized: 'Edgar: Et me voilà, à nouveau seul.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415065
    m_Localized: 'Edgar: Les hommes s''agitent pour sauver le monde, sans jamais s''accorder sur la manière. La réponse est pourtant simple.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415066
    m_Localized: 'Edgar: Elle réside dans le silence. Dans la beauté. Encore faut-il savoir la voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415067
    m_Localized: 'Edgar: Elle voulait me l''apprendre. Et ce que j''ai gardé, c''est cette paix étrange. Une forme de grâce au milieu des horreurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415068
    m_Localized: 'Edgar: Au moins maintenant… Je suis prêt à la rejoindre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415069
    m_Localized: 'TaxiDriver: Fais pas ton timide, mon vieux. Vas-y, pose ta question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415070
    m_Localized: Tu penses toujours que la FEMA est à tes trousses ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415071
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415072
    m_Localized: 'TaxiDriver: J''espère vraiment que non, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415073
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415074
    m_Localized: 'TaxiDriver: Ouais, c''était une connerie de me rendre à la FEMA comme ça. J''aurais dû me douter qu''ils tenteraient de m''arrêter aussi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415075
    m_Localized: 'TaxiDriver: Je pensais qu''ils emmèneraient juste le passager et me ficheraient la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415076
    m_Localized: 'TaxiDriver: Au lieu de ça, ils ont pris ma voiture et j''ai bien failli me faire tirer dessus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415077
    m_Localized: 'TaxiDriver: Mais réfléchis, mec, qu''est-ce que j''aurais pu faire d''autre ? Ce type, c''était un Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713957
    m_Localized: Mais… Et si c'était un humain ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713958
    m_Localized: T'as pas eu le choix…
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713959
    m_Localized: 'TaxiDriver: Oh… Dis pas des trucs pareil, vieux !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713960
    m_Localized: 'TaxiDriver: J''me sens déjà assez mal comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713961
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713962
    m_Localized: 'TaxiDriver: Bah… ouais, t''as raison, tu sais. Y avait pas vraiment d''autre solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713963
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713964
    m_Localized: 'TaxiDriver: C''était le bon vieux temps, l''époque où on pouvait se poser derrière le volant sans penser à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713965
    m_Localized: 'TaxiDriver: Mais avec ces Visiteurs, vieux… On sait jamais… Le prochain passager pourrait bien te coller une balle dans la tête.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713966
    m_Localized: 'TaxiDriver: Eh…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415078
    m_Localized: 'TaxiDriver: Fais pas ton timide, mon vieux. Vas-y, pose ta question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415079
    m_Localized: Tu es chauffeur de taxi depuis combien de temps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415080
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415081
    m_Localized: 'TaxiDriver: Ah, ça fait un bon bout de temps, tu sais. En ce moment, je bosse pas pour une boîte, je suis à mon compte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415082
    m_Localized: 'TaxiDriver: La FEMA, c''est pas vraiment la liberté de mouvement pour les civils.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415083
    m_Localized: 'TaxiDriver: Mais tout ce bordel, ça va bien finir par s''arrêter, non ? Et puis l''argent… c''est toujours bon à prendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415084
    m_Localized: 'TaxiDriver: Les gens sont plutôt généreux, surtout pour les trajets risqués.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415085
    m_Localized: 'TaxiDriver: Et conduire la nuit, ça me rappelle mon enfance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415086
    m_Localized: 'TaxiDriver: Tu sais, je suis devenu chauffeur de taxi à cause de mon père. Je voulais marcher dans ses pas, tu vois.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713967
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713968
    m_Localized: 'TaxiDriver: J''ai pas envie de finir sur le bord de la route, sans que personne en ait rien à faire…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713969
    m_Localized: 'TaxiDriver: Tout ce que j''espère, c''est que ma chance a pas encore tourné…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415087
    m_Localized: 'TaxiDriver: Fais pas ton timide, mon vieux. Vas-y, pose ta question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415088
    m_Localized: T'as l'air un peu abattu aujourd'hui.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415089
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415090
    m_Localized: 'TaxiDriver: Ouais, c''est juste que…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415091
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415092
    m_Localized: 'TaxiDriver: J''arrive pas à me faire à l''idée que ma voiture a disparu, tu sais…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713970
    m_Localized: T'avais quel genre de voiture ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713971
    m_Localized: En quoi elle était si spéciale ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713972
    m_Localized: 'TaxiDriver: C''était la plus belle voiture, vieux… Une classique…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713973
    m_Localized: 'TaxiDriver: Carrosserie jaune vif, jantes chromées brillantes, lignes élégantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713974
    m_Localized: 'TaxiDriver: Mais bon, c''est fini maintenant…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713975
    m_Localized: 'TaxiDriver: Foutue FEMA… Cette voiture, c''était tout pour moi ! Bande d''ordures.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713976
    m_Localized: 'TaxiDriver: C''était la caisse de mon père. Lui aussi, il était chauffeur de taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713977
    m_Localized: 'TaxiDriver: Quand j''étais môme, j''adorais rouler avec lui la nuit. Je m''endormais toujours à l''arrière. Mais après…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713978
    m_Localized: 'TaxiDriver: On peut dire que sa chance a tourné…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415096
    m_Localized: 'TaxiDriver: Fais pas ton timide, mon vieux. Vas-y, pose ta question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415097
    m_Localized: Qu'est-ce qui est arrivé à ton père ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415098
    m_Localized: Je dois te soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713979
    m_Localized: 'TaxiDriver: J''en parle pas souvent, mais… J''crois que j''peux t''faire confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713980
    m_Localized: 'TaxiDriver: Un jour, ma mère devait partir en voyage pour le boulot, alors mon père m''a emmené avec lui.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713981
    m_Localized: 'TaxiDriver: C''est là qu''on a pris un passager que j''oublierai jamais, vieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713982
    m_Localized: 'TaxiDriver: Costume bien taillé, crâne rasé, sourire de requin…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713983
    m_Localized: 'TaxiDriver: Tout le monde en ville savait qui c''était. Même moi, gamin. Dire non à un type comme ça ? Pas une option.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713984
    m_Localized: 'TaxiDriver: Mais mon père, c''était un bon. Un gars droit dans ses bottes. Et ce jour-là, il a dit non… ben, ça nous a tous plombés.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713985
    m_Localized: 'TaxiDriver: Le type en costard s''est assuré qu''on le regrette.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713986
    m_Localized: 'TaxiDriver: On a perdu la baraque. Après ça, on devait bouger tout le temps.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713987
    m_Localized: 'TaxiDriver: Et vu qu''on avait plus un rond, mon vieux a gardé son taxi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713988
    m_Localized: 'TaxiDriver: En vieillissant, avec les dettes qui s''empilaient, il s''est mis à dire qu''il aurait jamais dû la garder.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713989
    m_Localized: 'TaxiDriver: Qu''elle était maudite, qu''elle nous avait foutu toute cette poisse sur le dos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713990
    m_Localized: 'TaxiDriver: Mais il a jamais capté.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713991
    m_Localized: 'TaxiDriver: C''était pas la caisse le problème. C''était sa fierté. Et c''est ça qui nous a tout pris.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713992
    m_Localized: 'TaxiDriver: Et pourtant… même si ses choix m''ont forcé à bosser jeune pour nourrir la famille…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713993
    m_Localized: 'TaxiDriver: Je l''aime toujours.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713994
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713995
    m_Localized: 'TaxiDriver: Mon vieux me manque…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713996
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713997
    m_Localized: 'TaxiDriver: Si t''as deux minutes, tu crois que tu pourrais l''appeler ? J''te demande pas la lune, vieux…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713998
    m_Localized: 'TaxiDriver: Tiens, c''est son numéro : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713999
    m_Localized: 'TaxiDriver: Dis-lui juste que tout va bien. Je le ferais bien, mais… là, j''peux pas me permettre de balancer ma planque.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415106
    m_Localized: 'TaxiDriver: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415128
    m_Localized: 'Provocateur: Dans quel monde vivons-nous… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415129
    m_Localized: Et maintenant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415130
    m_Localized: Je vais devoir vous examiner.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415131
    m_Localized: 'Provocateur: On dirait que nous n''avons pas encore finalisé le contrat de location.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415132
    m_Localized: Et comment dois-je m'y prendre exactement ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415133
    m_Localized: C'est ça qui vous préoccupe en ce moment ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415134
    m_Localized: 'Provocateur: Ne me dites pas que vous n''avez même pas les documents sous la main ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415135
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415136
    m_Localized: 'Provocateur: Dans ce cas… Je vous suggère d''aller voir un notaire pour les récupérer. Franchement…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415137
    m_Localized: Vous plaisantez ? Où est-ce que je suis censé trouver un notaire à cette heure-ci ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415138
    m_Localized: Pourquoi vous n'y allez pas, vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415139
    m_Localized: 'Provocateur: Avec tout le respect que je vous dois, je vous prierais de vous adresser à moi poliment. « Monsieur » fera l''affaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415140
    m_Localized: 'Provocateur: Quel rustre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415141
    m_Localized: Si ça peut vous faire plaisir…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415142
    m_Localized: Foutez le camp d'ici, et plus vite que ça !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415143
    m_Localized: 'Provocateur: Vous savez vous servir d''une carte, non ? C''est pourtant pas compliqué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415144
    m_Localized: 'Provocateur: Et encore une fois, je vous prie de vous adresser à moi avec respect. Appelez-moi « Monsieur ».'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415145
    m_Localized: Si ça peut vous faire plaisir…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415146
    m_Localized: Foutez le camp d'ici, et plus vite que ça !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415147
    m_Localized: 'Provocateur: Et pourquoi devrais-je faire les allers-retours ? Et d''ailleurs, je vous prie de m''appeler « Monsieur » !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415148
    m_Localized: 'Provocateur: Je suis un citoyen respectable, pas un coursier.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415149
    m_Localized: Si ça peut vous faire plaisir…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415150
    m_Localized: Foutez le camp d'ici, et plus vite que ça !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415151
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415152
    m_Localized: 'Provocateur: Vous le faites exprès, c''est ça ? Vous pourriez au moins faire semblant d''être serviable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415153
    m_Localized: 'Provocateur: Surveillez votre langage. L''article 21 de la Constitution protège ma dignité humaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415154
    m_Localized: 'Provocateur: Je vous suggère donc vivement de me témoigner un minimum de respect avant que cela ne devienne… désagréable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415155
    m_Localized: 'Provocateur: Dans quel monde vivons-nous… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415156
    m_Localized: Vous ne pouvez pas vous détendre un peu ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415157
    m_Localized: Je vais devoir vous examiner.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415158
    m_Localized: 'Provocateur: J''attends toujours que vous finalisiez le contrat de location.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415159
    m_Localized: Je n'ai rien pour le finaliser !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415160
    m_Localized: C'est une blague ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415161
    m_Localized: 'Provocateur: Hum. C''est regrettable.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415162
    m_Localized: 'Provocateur: Je crains que cela ne constitue une violation de l''article 131.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415163
    m_Localized: Vous commencez sérieusement à m'agacer…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415164
    m_Localized: Vous n'en avez pas marre de citer des lois à tout bout de champ ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415165
    m_Localized: 'Provocateur: En vertu de l''article 131, ce contrat est obligatoire. Je suis un citoyen responsable qui respecte la loi, moi !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415166
    m_Localized: Vous commencez sérieusement à m'agacer…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415167
    m_Localized: Vous n'en avez pas marre de citer des lois à tout bout de champ ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415168
    m_Localized: 'Provocateur: Ah, nous y voilà ! Les insultes…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415169
    m_Localized: 'Provocateur: Soit dit en passant, cela relève de l''article 5.61 du Code administratif.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415170
    m_Localized: 'Provocateur: Continuez, je vous en prie. Vous en subirez les conséquences.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415171
    m_Localized: 'Provocateur: Et non, je ne me lasse pas de citer les articles de loi ou la Constitution.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415172
    m_Localized: 'Provocateur: Je connais mes droits ! Ce n''est pas parce que vous êtes ignorant que les autres ne peuvent pas appliquer la loi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415173
    m_Localized: 'Provocateur: Et pour la énième fois, adressez-vous à moi avec respect.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415174
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415175
    m_Localized: 'Provocateur: Vous ne retenez vraiment rien, pas vrai ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415176
    m_Localized: 'Provocateur: Dans quel monde vivons-nous… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415177
    m_Localized: Et alors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415178
    m_Localized: Je vais devoir vous examiner.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415179
    m_Localized: 'Provocateur: J''ai vu que vous aviez une arme à feu. Puis-je voir votre permis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415180
    m_Localized: Ce ne sont pas vos oignons.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415181
    m_Localized: Qu'est-ce que vous me voulez, à la fin ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415182
    m_Localized: 'Provocateur: Ah, je vois. Si vous ne montrez pas votre permis, c''est que vous n''en avez pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415183
    m_Localized: 'Provocateur: Vous pensez que vous pouvez faire la loi juste parce que vous avez une arme ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415184
    m_Localized: 'Provocateur: Que vous pouvez questionner tout le monde sans que personne n''ait son mot à dire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415185
    m_Localized: 'Provocateur: Vous vous trompez lourdement !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415186
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415187
    m_Localized: 'Provocateur: Vous connaissez le dicton : il y a toujours un plus gros poisson.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415188
    m_Localized: Ça suffit. J'ai bien assez de problèmes comme ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415189
    m_Localized: Vous comptez arrêter vos absurdités, ou pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415190
    m_Localized: 'Provocateur: Je cherche juste à comprendre qui vous êtes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415191
    m_Localized: 'Provocateur: Vous vous énervez… J''ai mis le doigt là où ça fait mal. Pas de licence, hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415192
    m_Localized: 'Provocateur: Vous pensez être au-dessus des règles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415193
    m_Localized: 'Provocateur: Vous vous donnez le droit d''enquêter sur tout le monde, mais personne n''a le droit de vous poser la moindre question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415194
    m_Localized: 'Provocateur: Vous vous trompez.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415195
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415196
    m_Localized: 'Provocateur: Vous connaissez le dicton : il y a toujours un plus gros poisson.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415197
    m_Localized: Ça suffit. J'ai bien assez de problèmes comme ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415198
    m_Localized: Vous comptez arrêter vos absurdités, ou pas ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415199
    m_Localized: 'Provocateur: C''est dur la vie, hein ? Oh, mon pauvre. Personne ne vous contredit, personne ne vous soupçonne d''être un Visiteur. Dur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415200
    m_Localized: 'Provocateur: Et dites-moi : qui vous a donné le droit de décider qui vit ou qui meurt ? Qui vous a confié cette autorité ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415201
    m_Localized: 'Provocateur: Nous, on est là, à prier pour ne pas être les prochains. Et vous voulez de ma compassion ? Vous plaisantez, j''espère.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415202
    m_Localized: 'Provocateur: Excusez mon langage, mais c''est vous qui servez des conneries à tout le monde avec vos tests.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415203
    m_Localized: 'Provocateur: À fouiller partout, à traiter chaque personne comme un tueur potentiel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415204
    m_Localized: 'Provocateur: Mais bien sûr, ne pointons surtout pas du doigt le vrai meurtrier ici. Et si les Visiteurs n''existaient même pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415205
    m_Localized: 'Provocateur: Alors… vous seriez quoi ? Un tueur en roue libre. Un fanatique qui se cache derrière le chaos pour tuer à sa guise.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415206
    m_Localized: 'Provocateur: Et les autres ? Ils entendent deux mots à la radio et courent chez vous comme des chiens affolés.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415207
    m_Localized: 'Provocateur: Dites-moi… Ceux qui sont venus dès le début… combien sont réellement repartis vivants ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415208
    m_Localized: 'Provocateur: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415209
    m_Localized: 'Provocateur: C''est bien ce que je pensais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415210
    m_Localized: 'Provocateur: Dans quel monde vivons-nous… ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415211
    m_Localized: Monsieur ? Vous êtes toujours là ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415212
    m_Localized: Je vais devoir vous examiner.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415213
    m_Localized: 'Provocateur: Remarquable… Vous vous êtes adressé à moi avec respect.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415214
    m_Localized: 'Provocateur: Dommage que ce soit arrivé un peu trop tard. Je vais signaler tout ça rapidement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415215
    m_Localized: Signaler quoi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415216
    m_Localized: À qui ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415217
    m_Localized: 'Provocateur: Votre petit jeu est terminé. Je sais exactement à qui j''ai affaire, désormais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415218
    m_Localized: 'Provocateur: Ce n''est pas votre maison. Vous avez assassiné son propriétaire. Vous avez pris sa place. Et je vais prévenir la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415219
    m_Localized: 'Provocateur: Oui, vous m''avez bien entendu. Ils vont venir vous chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415220
    m_Localized: Foutaises !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415221
    m_Localized: Vous allez la fermer pour de bon.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415222
    m_Localized: 'Provocateur: La Force d''Encadrement des Menaces Anormales. La FEMA pour faire court.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415223
    m_Localized: 'Provocateur: Au début, je ne me suis pas attardé sur le fait que vous n''étiez même pas capable de finaliser un vulgaire contrat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415224
    m_Localized: 'Provocateur: Mais plus je vous ai parlé, plus les choses sont devenues claires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415225
    m_Localized: 'Provocateur: À présent, tout s''explique. Vous n''êtes pas chez vous. Vous êtes un imposteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415226
    m_Localized: 'Provocateur: Vous êtes un VISITEUR !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415227
    m_Localized: 'Provocateur: Donc, faites vos valises. Ils vont venir vous chercher. Ce soir !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415228
    m_Localized: Foutaises !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415229
    m_Localized: Vous allez la fermer pour de bon.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415230
    m_Localized: 'Provocateur: Je vais signaler tout ça. Ils vont venir. Attendez voir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415231
    m_Localized: Je m'en fiche. Sortez !
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415232
    m_Localized: Vous êtes mort ! (Sortir l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415233
    m_Localized: 'Provocateur: Allez-y, essayez donc de me faire taire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415234
    m_Localized: 'Provocateur: Attendez, quoi ?! Vous êtes fou ?! C''est une infraction pénale !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944332415235
    m_Localized: 'Provocateur: Non, non, non. Vous ne vous en tirerez pas comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609280
    m_Localized: 'Provocateur: Je reste ici jusqu''à l''arrivée de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609281
    m_Localized: 'Provocateur: Je leur dirai tout ce que vous avez fait ! Je leur dirai à quel point vous êtes dangereux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609282
    m_Localized: 'Provocateur: Attendez, quoi ?! Vous êtes fou ?! C''est une infraction pénale !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609283
    m_Localized: 'Provocateur: Vous n''oseriez pas !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609284
    m_Localized: Vous feriez mieux de partir avant que je tire
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609285
    m_Localized: Je vais tirer si vous ne partez pas.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609286
    m_Localized: Vous ne me laissez pas le choix…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609287
    m_Localized: (Lui tirer dessus)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609288
    m_Localized: 'Provocateur: Je ne vous laisserai pas échapper à la FEMA. Pas tant que je serai en vie !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609289
    m_Localized: 'Provocateur: Ils finiront par vous attraper !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609290
    m_Localized: 'Provocateur: Vous non plus !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609291
    m_Localized: 'Provocateur: VOUS ÊTES UN VISITEUR ! UN MEURTRIER ! VOUS N''ÊTES PAS HUMAIN !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609292
    m_Localized: 'Provocateur: NON, NE FAITES PAS ÇA !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609293
    m_Localized: 'Provocateur: AAAAARGH !!!'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609294
    m_Localized: 'Marauder: Mec… Une belle trouvaille, ça serait vraiment le pied…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609295
    m_Localized: Comment ça se passe, ta carrière de dépouilleur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609296
    m_Localized: Il faut que je te soumette à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609297
    m_Localized: 'Marauder: Moi, j''croyais qu''ici y avait pas un rat, alors j''ai essayé de rentrer en douce… mais y a des gens qui vivent ici…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609298
    m_Localized: 'Marauder: Moi, j''vole rien aux vivants.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609299
    m_Localized: 'Marauder: Réfléchis deux secondes… Qu''est-ce qu''un macchabée peut bien faire d''un manteau ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609300
    m_Localized: 'Marauder: Le mec est mort. Ses affaires restent là. Moi ? J''respire encore. Ça pourrait me sauver la vie. Ou celle des miens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609301
    m_Localized: 'Marauder: Ose me dire que tu prendrais pas quelque chose sur un cadavre si ça pouvait sauver quelqu''un que t''aimes ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609302
    m_Localized: 'Marauder: Faudrait p''t-être arrêter de traiter tous les morts comme des saints. J''dis ça, j''dis rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609303
    m_Localized: 'Marauder: Mec… Une belle trouvaille, ça serait vraiment le pied…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609304
    m_Localized: Qu'est-ce qui t'a poussé à devenir un dépouilleur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609305
    m_Localized: Il faut que je te soumette à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609306
    m_Localized: 'Marauder: Qu''est-ce que j''pouvais faire d''autre ? J''voulais pas me mettre à faire du mal aux gens.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609307
    m_Localized: 'Marauder: Alors, j''ai choisi de faire profil bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609308
    m_Localized: 'Marauder: Les morts, ça riposte pas, tu sais ? Tout ce qui reste d''eux, c''est… leurs affaires.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609309
    m_Localized: 'Marauder: Moi, je suis pas là pour faire du mal aux autres. J''veux juste rester en vie. Et si j''peux aider les autres, tant mieux.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609310
    m_Localized: 'Marauder: Mec… Une belle trouvaille, ça serait vraiment le pied…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609311
    m_Localized: Qu'est-ce que t'as trouvé en dépouillant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609312
    m_Localized: Il faut que je te soumette à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609313
    m_Localized: 'Marauder: Mec… J''en ai vu trop pour tout te raconter…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609314
    m_Localized: 'Marauder: Laisse-moi réfléchir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609315
    m_Localized: 'Marauder: Un jour, j''ai trouvé une bibliothèque abandonnée. Des livres plein les étagères, comme si on allait revenir les prendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609316
    m_Localized: 'Marauder: Je suis tombé sur une expo de jeunes artistes. Les toiles étaient toujours là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609317
    m_Localized: 'Marauder: Et puis… une fois, j''ai vu un coucher de soleil. C''était exceptionnel… On aurait dit un tableau peint dans le ciel.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609318
    m_Localized: 'Marauder: Aujourd''hui, plus personne ose rester dehors pour admirer le ciel. Mais à l''époque…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609319
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609320
    m_Localized: 'Marauder: La vie d''avant me manque. Je me levais à l''aube. Les rues étaient calmes. Le brouillard flottait sur l''herbe humide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609321
    m_Localized: 'Marauder: Et le soleil… il brillait si fort quand il se levait, comme s''il te promettait une belle journée.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609322
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609323
    m_Localized: 'Marauder: Et regarde, maintenant. Le soleil, c''est devenu notre ennemi. Comment on en est arrivés là ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609324
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609325
    m_Localized: 'Marauder: J''aimerais que quelqu''un ait des réponses à toutes ces questions. Je respirerais peut-être plus facilement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609326
    m_Localized: 'Marauder: Mec… Une belle trouvaille, ça serait vraiment le pied…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609327
    m_Localized: Tu comptes arrêter de dépouiller les morts ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609328
    m_Localized: Il faut que je te soumette à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609329
    m_Localized: 'Marauder: Je continue. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609330
    m_Localized: 'Marauder: Une fois… Ouais… Une fois, ça m''a vraiment marqué…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609331
    m_Localized: 'Marauder: J''ai trouvé cette maison. Vide. Un corps sur le sol, rien d''inhabituel. Aucune menace.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609332
    m_Localized: 'Marauder: Le type avait le dos criblé de balles. Il était allongé sur quelque chose.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609333
    m_Localized: 'Marauder: Je me suis dit qu''il avait peut-être essayé de protéger un truc. Je me suis approché, je l''ai retourné et…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609334
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609335
    m_Localized: 'Marauder: Écoute, je te raconterai plus tard, d''accord ? J''ai pas envie de revivre ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609336
    m_Localized: 'Marauder: Mec… Une belle trouvaille, ça serait vraiment le pied…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609337
    m_Localized: Il y avait quoi sous le corps ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609338
    m_Localized: Il faut que je te soumette à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609339
    m_Localized: 'Marauder: OK…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609340
    m_Localized: 'Marauder: Je l''ai retourné et… elle était là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609341
    m_Localized: 'Marauder: Une gamine. Morte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609342
    m_Localized: 'Marauder: Avec des adultes… on s''y attend un peu. Mais une petite fille ? C''est différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609343
    m_Localized: 'Marauder: Quand je vois des enfants morts, j''ai la gorge qui se serre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609344
    m_Localized: 'Marauder: Elle serrait dans ses bras une petite peluche en forme de chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609345
    m_Localized: 'Marauder: Couverte de sang. Complètement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609346
    m_Localized: 'Marauder: Le visage de la petite fille était figé… Comme si elle avait vu la mort s''approcher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609347
    m_Localized: 'Marauder: L''espace d''une seconde, je te jure… On aurait dit qu''elle avait l''air d''avoir peur que je lui prenne son jouet.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609348
    m_Localized: 'Marauder: Comme si, même dans la mort, la cruauté des gens l''empêchait de trouver la paix.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609349
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609350
    m_Localized: 'Marauder: Ça m''a bouleversé… Plus que je veux bien l''admettre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609351
    m_Localized: 'Marauder: Ce jour-là, j''ai voulu arrêter… Laisser les morts en paix. Mais c''est trop tard maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609352
    m_Localized: 'Marauder: Tout ce que je peux faire, c''est continuer. Continuer à dépouiller. C''est ma seule chance de survivre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609353
    m_Localized: 'Marauder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609354
    m_Localized: 'Marauder: Tu sais ce qu''on dit… On peut pas échapper à son destin. Je crois que c''est vrai.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609355
    m_Localized: 'GraveDigger: J''voudrais tellement que ces Visiteurs retournent sous terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609356
    m_Localized: Pourquoi t'es-tu devenu fossoyeur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609357
    m_Localized: Je vais devoir te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609358
    m_Localized: 'GraveDigger: Hein ? Ah, ça ? J''en sais fichtre rien, comme toi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609359
    m_Localized: 'GraveDigger: Le cimetière, c''est comme… une bibliothèque. Sauf que les livres, on les lit pas… Ils restent juste là, tranquilles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609360
    m_Localized: 'GraveDigger: Avant, je connaissais tout des tombes. Qui était enterré où, les vêtements qu''ils portaient, leurs noms…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609361
    m_Localized: 'GraveDigger: Et puis un jour, je creuse un trou… Un jour normal, rien de bizarre. Un trou tout frais, assez profond. Et bim. Vide !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609362
    m_Localized: 'GraveDigger: Vide, je te jure ! Mais le journal disait qu''il y avait quelqu''un là-dessous. Un cadavre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609363
    m_Localized: 'GraveDigger: Un mort, c''est sûr. Il avait une moustache. Je m''en souviens. Mais pouf, disparu. Comme la rosée du matin.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609364
    m_Localized: 'GraveDigger: Alors… Si un mort disparaît… C''est comme s''il mourait une deuxième fois, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609365
    m_Localized: 'GraveDigger: J''voudrais tellement que ces Visiteurs retournent sous terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609366
    m_Localized: Qu'est-ce que t'as fait quand t'as vu que la tombe était vide ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609367
    m_Localized: Je vais devoir te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609368
    m_Localized: 'GraveDigger: Attends… J''me suis assis, les yeux dans le vide. Pis j''ai vu un type debout. Il regardait. Comme à un enterrement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609369
    m_Localized: 'GraveDigger: Il avait pas d''yeux. Et des dents blanches comme de la cire. Elles brillaient. Elles souriaient. Il restait planté là.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609370
    m_Localized: 'GraveDigger: J''ai failli me chier dessus, j''vais pas te mentir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609371
    m_Localized: 'GraveDigger: J''ai détalé comme un lapin. Vite. Ça, j''sais faire. Mais il m''a pas poursuivi. Il a juste… disparu. Volatilisé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609372
    m_Localized: 'GraveDigger: C''était complètement flippant. C''est à partir de là que tous ces problèmes avec les Visiteurs ont commencé…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609373
    m_Localized: 'GraveDigger: J''voudrais tellement que ces Visiteurs retournent sous terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609374
    m_Localized: À quoi bon creuser si on n'enterre plus les morts ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609375
    m_Localized: Je vais devoir te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609376
    m_Localized: 'GraveDigger: J''creuse plus. J''garde juste l''œil ouvert, hein. Mais après cette histoire ? J''ai un peu fouillé les tombes fraîches.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609377
    m_Localized: 'GraveDigger: J''ai fait très attention. Pas de bêtises.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609378
    m_Localized: 'GraveDigger: Et si un de ces monstres avait été enterré par erreur ? Ma pelle, c''était mon épée, prête à frapper tout ce qui bouge.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609379
    m_Localized: 'GraveDigger: Mais non… Les os étaient tous à leur place. Les cadavres restaient où ils étaient. Rien qui rampait hors de terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609380
    m_Localized: 'GraveDigger: J''me demande… Et si les Visiteurs, c''était pas les morts qui reviennent, mais les vivants qui auraient dû mourir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609381
    m_Localized: 'GraveDigger: J''voudrais tellement que ces Visiteurs retournent sous terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609382
    m_Localized: T'as pas creusé de nouvelles tombes, je suppose ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609383
    m_Localized: Je vais devoir te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609384
    m_Localized: 'GraveDigger: Moi ?! Pas question ! J''suis pas dingue. Écoute… J''ai côtoyé la mort toute ma vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609385
    m_Localized: 'GraveDigger: Avant, ça ne me dérangeait pas. On meurt, on est enterré. C''est tout. Mais maintenant ? Qui va t''enterrer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609386
    m_Localized: 'GraveDigger: Et même si on t''enterre, qui te dit que tu resteras là-dessous ? Cette tombe, je l''avais remplie… et elle était vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609387
    m_Localized: 'GraveDigger: Je l''avais enterré moi-même. Je le SAIS !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609388
    m_Localized: 'GraveDigger: Maintenant, je me dis… Peut-être que ma tombe aussi, elle sera vide.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609389
    m_Localized: 'GraveDigger: Peut-être… Peut-être que je suis déjà un Visiteur…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609390
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609391
    m_Localized: 'GraveDigger: Méh… Oublie ça, mec. Je raconte n''importe quoi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609392
    m_Localized: 'GraveDigger: J''voudrais tellement que ces Visiteurs retournent sous terre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609393
    m_Localized: À ton avis, d'où ils viennent, ces Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609394
    m_Localized: Je vais devoir te faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609395
    m_Localized: 'GraveDigger: T''as déjà remarqué… qu''ils ont l''air familiers ? Pas juste leurs visages… plus comme un souvenir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609396
    m_Localized: 'GraveDigger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609397
    m_Localized: 'GraveDigger: J''ai une théorie. Tu veux l''entendre ? Vraiment ? OK, voilà…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609398
    m_Localized: 'GraveDigger: Peut-être que les Visiteurs… ne sont pas morts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609399
    m_Localized: 'GraveDigger: Peut-être que ce sont des pensées. Celles que tu n''as pas réussi à enfouir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609400
    m_Localized: 'GraveDigger: Peurs, regrets, sentiments… Tout ce que t''oublies pas, ça s''entasse… et quand la terre devient trop calme, ça remonte.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609401
    m_Localized: 'GraveDigger: C''est pas la chair qu''ils veulent. Ce qu''ils veulent, c''est de l''attention.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609402
    m_Localized: 'GraveDigger: Plus t''as peur… plus ils se rapprochent. Parce que tu te souviens. Et ce dont on se souvient… Ça refuse de mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609403
    m_Localized: 'FormerFema: J''espère que je suis pas en train de faire une insolation…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609404
    m_Localized: T'es sûr que tu fais pas partie de la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609405
    m_Localized: Je dois te soumettre au sérieux.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609406
    m_Localized: 'FormerFema: Non, vraiment. Je fais pas partie de cette organisation. Je te l''ai dit, je réparais des frigos, avant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609407
    m_Localized: 'FormerFema: J''ai trouvé l''uniforme dans une voiture.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609408
    m_Localized: Tout à l'heure, t'as dit que tu l'avais pris sur un cadavre…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609409
    m_Localized: Tu ne serais tout de même pas en train de me mentir, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609410
    m_Localized: 'FormerFema: Eh bien… ouais… C''est ça…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609411
    m_Localized: 'FormerFema: Je l''ai trouvé dans une voiture, sur un cadavre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609412
    m_Localized: 'FormerFema: Je me suis dit que la combi me protégerait des Visiteurs. Les agents de la FEMA en portent pour une bonne raison, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609413
    m_Localized: 'FormerFema: Je te mens pas. C''est juste que je suis perturbé à cause du stress, c''est pas si bizarre que ça, non ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609414
    m_Localized: 'FormerFema: Crois-moi, si t''avais vu ce que j''ai vu… tu comprendrais.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609415
    m_Localized: 'FormerFema: J''ai failli mourir en venant ici… avec tous ces cadavres qui continuaient à se tortiller par terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609416
    m_Localized: 'FormerFema: J''espère que je suis pas en train de faire une insolation…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609417
    m_Localized: Tu crois pas que c'est une mauvaise idée de porter une combinaison de la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609418
    m_Localized: Je dois te soumettre au sérieux.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609419
    m_Localized: 'FormerFema: Quoi ? Eh bien… non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609420
    m_Localized: 'FormerFema: Je veux dire… Bien sûr, certaines personnes n''aiment pas la FEMA, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609421
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609422
    m_Localized: 'FormerFema: Oh, tu veux dire que je risque d''avoir des problèmes avec la FEMA, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609423
    m_Localized: 'FormerFema: Écoute, je… Je pense que si je leur explique tout, ils devraient comprendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609424
    m_Localized: 'FormerFema: Inutile de les diaboliser. C''est pas comme s''ils faisaient partie d''une société secrète.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609425
    m_Localized: 'FormerFema: J''espère que je suis pas en train de faire une insolation…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609426
    m_Localized: Montre-moi ce qu'il y a dans tes poches.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609427
    m_Localized: Je dois te soumettre au sérieux.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609428
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609429
    m_Localized: 'FormerFema: Hé ! Pourquoi est-ce que tu veux me fouiller ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609430
    m_Localized: Je cherche ton badge FEMA.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609431
    m_Localized: Quoi ? Tu as quelque chose à cacher ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609432
    m_Localized: 'FormerFema: Quoi ? Quel badge ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609433
    m_Localized: 'FormerFema: Je te jure, j''ai rien sur moi…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609434
    m_Localized: Sois gentil et vide tes poches.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609435
    m_Localized: (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609436
    m_Localized: 'FormerFema: Qui ça ? Moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609437
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609438
    m_Localized: 'FormerFema: Non.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609439
    m_Localized: Sois gentil et vide tes poches.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609440
    m_Localized: (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609441
    m_Localized: 'FormerFema: D''accord, d''accord. Pas besoin d''être violent…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609442
    m_Localized: 'FormerFema: Voilà. T''es content maintenant ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609443
    m_Localized: 'FormerFema: C''est bon, t''as gagné. Je travaillais vraiment pour la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609444
    m_Localized: 'FormerFema: Mais pitié, n''en parle pas aux autres.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609445
    m_Localized: 'FormerFema: Oh, bon sang…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609446
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609447
    m_Localized: 'FormerFema: Voilà. Ne tire pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609448
    m_Localized: 'FormerFema: Oui… Je travaillais vraiment pour la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609449
    m_Localized: 'FormerFema: Mais il vaut mieux que personne ne le sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491072
    m_Localized: Pourquoi est-ce que tu t'es caché alors que tu bossais pour la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491073
    m_Localized: Et c'était quoi cette mascarade ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491074
    m_Localized: 'FormerFema: Tu comprends pas, vraiment ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491075
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491076
    m_Localized: 'FormerFema: Tu me poses cette question sérieusement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491077
    m_Localized: 'FormerFema: Si les gens apprennent que je travaillais pour la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491078
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491079
    m_Localized: 'FormerFema: Écoute, je bosse plus pour la FEMA. Dis-toi que j''ai démissionné.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491080
    m_Localized: 'FormerFema: Écoute, je bosse plus pour la FEMA. Dis-toi que j''ai démissionné.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491081
    m_Localized: 'FormerFema: Ouais, j''ai dû faire des trucs pas cool.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491082
    m_Localized: 'FormerFema: Embarquer des gens, les mettre en quarantaine…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491083
    m_Localized: 'FormerFema: Mais bon, c''était mon boulot, d''accord ? Moi, je faisais juste ce qu''on me disait de faire.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491084
    m_Localized: 'FormerFema: Ça sert à rien de me poser des questions sur ceux qu''on a emmenés. Je décidais pas, c''était les supérieurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491085
    m_Localized: 'FormerFema: Et c''est ridicule de me traiter d''assassin ou je sais pas quoi d''autre…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491086
    m_Localized: 'FormerFema: Comment tu peux dire qu''un mec qui neutralise un tueur est un assassin, sérieusement ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609450
    m_Localized: 'FormerFema: J''espère que je suis pas en train de faire une insolation…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609451
    m_Localized: Pourquoi avoir caché que tu travaillais pour la FEMA ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609452
    m_Localized: Je dois te soumettre au sérieux.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491087
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491088
    m_Localized: 'FormerFema: Une fois, j''ai pris en charge un gars qui montrait des symptômes de Visiteur.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491089
    m_Localized: 'FormerFema: Bref, son état s''est dégradé dans la zone et il a fini par crever. Ça arrive, tu sais.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491090
    m_Localized: 'FormerFema: Sa femme a débarqué, elle voulait qu''on le laisse sortir. On lui a expliqué qu''il n''y avait plus personne à sortir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491091
    m_Localized: 'FormerFema: Elle est restée figée, puis a commencé à gueuler, à nous traiter de meurtriers, à exiger qu''on lui rende la dépouille.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491092
    m_Localized: 'FormerFema: On lui a dit que le règlement l''interdisait. Mais elle a pas lâché.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491093
    m_Localized: 'FormerFema: Elle a campé juste devant la grille.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491094
    m_Localized: 'FormerFema: On lui a rendu le corps. Et puis ils ont viré tous ceux qui avaient enfreint le protocole. Moi y compris.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491095
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491096
    m_Localized: 'FormerFema: Elle tenait absolument à récupérer ce foutu corps. Cette cinglée m''a coûté mon boulot.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491097
    m_Localized: 'FormerFema: Et maintenant j''ai nulle part où aller…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491098
    m_Localized: 'FormerFema: Et au lieu de l''enterrer, elle trimballe le cadavre avec elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491099
    m_Localized: 'FormerFema: Ouais… Super idée… Ça valait vraiment la peine qu''on se fasse tous virer, tu trouves pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491100
    m_Localized: Vous, les types de la FEMA, vous êtes vraiment des salopards.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491101
    m_Localized: Tant pis pour moi, hein ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491102
    m_Localized: 'FormerFema: Pardon ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491103
    m_Localized: 'FormerFema: Je fais mon boulot, mon devoir, et je me fais virer à cause d''une cinglée…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491104
    m_Localized: 'FormerFema: Et tu oses m''insulter ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491105
    m_Localized: 'FormerFema: Tu sais quoi ? J''en ai marre de ton refuge. Je me tire d''ici.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491106
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491107
    m_Localized: 'FormerFema: J''y crois pas… Est-ce que tout le monde a perdu la boule ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491108
    m_Localized: 'FormerFema: Non, non ! C''est exactement ce qui s''est passé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491109
    m_Localized: 'FormerFema: Depuis que le soleil est parti en vrille et que les infections ont commencé, tout le monde est devenu fou.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491110
    m_Localized: 'FormerFema: Est-ce que ce foutu corps valait vraiment le coup de risquer nos boulots ? T''en penses quoi, toi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491111
    m_Localized: C'est une bonne chose qu'elle ait retrouvé son mari.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491112
    m_Localized: Vous auriez pas dû lui donner le corps.
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491113
    m_Localized: 'FormerFema: T''es en train de dire que c''est bien qu''on se soit fait virer ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491114
    m_Localized: 'FormerFema: Vous, les civils, vous comprenez vraiment rien à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491115
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491116
    m_Localized: 'FormerFema: On aurait dû la buter, comme son mari.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491117
    m_Localized: Qu'est-ce que tu viens de dire ?
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491118
    m_Localized: (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491119
    m_Localized: 'FormerFema: Pourquoi tu me regardes comme ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491120
    m_Localized: 'FormerFema: D''après le protocole, si un civil contaminé est en mauvais état…'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491121
    m_Localized: 'FormerFema: Il faut régler le problème sur place pour éviter de mettre un Visiteur en quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491122
    m_Localized: (Le laisser partir)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491123
    m_Localized: (Empoigner l'arme)
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491124
    m_Localized: 'FormerFema: Merci pour ta compréhension.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491125
    m_Localized: 'FormerFema: Je ne suis pas un assassin. J''ai juste suivi les ordres.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491126
    m_Localized: 'FormerFema: Bon sang, qu''est-ce que tu fais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491127
    m_Localized: 'FormerFema: Calme-toi, enfin ! C''était un Visiteur ! Et il était en mauvais état ! On pouvait pas le laisser partir comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491128
    m_Localized: 'FormerFema: Tire pas, putain… J''ai juste suivi les ordres.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491129
    m_Localized: 'FormerFema: Je suis d''accord. On aurait dû suivre le protocole.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491130
    m_Localized: 'FormerFema: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491131
    m_Localized: 'FormerFema: Je vais pas t''embêter plus longtemps. Merci de m''avoir laissé entrer tout en sachant que je faisais partie de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491132
    m_Localized: 'FormerFema: Si jamais je récupère mon boulot, je me souviendrais de ta coopération.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609476
    m_Localized: 'Intruder: Je me demande… Est-ce que les Visiteurs rêvent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609477
    m_Localized: T'as réussi à dormir ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609478
    m_Localized: Je peux vérifier quelque chose sur toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609479
    m_Localized: 'Intruder: Hum ? Non. J''ai pas vraiment essayé de dormir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609480
    m_Localized: 'Intruder: J''espère simplement qu''il y a encore quelqu''un ici qui rêve, c''est tout.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609481
    m_Localized: 'Intruder: Mais… Personne n''a encore partagé ses rêves avec moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609482
    m_Localized: 'Intruder: Peut-être que je n''inspire pas confiance.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609483
    m_Localized: 'Intruder: Peut-être qu''ils finiront par s''ouvrir à moi plus tard.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609484
    m_Localized: 'Intruder: Je me demande… Est-ce que les Visiteurs rêvent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609485
    m_Localized: Pourquoi est-ce que les rêves t'obsèdent autant ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609486
    m_Localized: Je peux vérifier quelque chose sur toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609487
    m_Localized: 'Intruder: Pourquoi tu dis que je suis obsédé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609488
    m_Localized: 'Intruder: C''est bizarre d''en arriver à une telle conclusion.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609489
    m_Localized: 'Intruder: T''es même pas un peu curieux de savoir ce que ton subconscient essaie de te dire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609490
    m_Localized: 'Intruder: Qu''est-ce qui se cache dans ta tête ? On a tous des secrets qu''on se cache à soi-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609491
    m_Localized: 'Intruder: Toi, par exemple. Si tu évites les gens… C''est parce que quelque chose t''a blessé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609492
    m_Localized: 'Intruder: C''est exactement ça qui m''intéresse.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609493
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609494
    m_Localized: 'Intruder: Tu sais quoi ? Je vais te raconter mon dernier rêve.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609495
    m_Localized: 'Intruder: J''étais poursuivi par un énorme train noir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609496
    m_Localized: 'Intruder: Mes jambes étaient clouées au sol. J''ai crié et je me suis réveillé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609497
    m_Localized: 'Intruder: Me voilà debout sur les rails… et je conduisais le train. Je fonçais droit sur moi-même, incapable de l''arrêter.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609498
    m_Localized: 'Intruder: Je me demande… Est-ce que les Visiteurs rêvent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609499
    m_Localized: Et toi ? Qu'est-ce que tu caches dans tes rêves ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609500
    m_Localized: Je peux vérifier quelque chose sur toi ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609501
    m_Localized: 'Intruder: Et moi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609502
    m_Localized: 'Intruder: Ça fait des jours que j''ai pas dormi.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609503
    m_Localized: 'Intruder: Mais bon, je vais te dire un truc. Si t''en parles, personne va te croire de toute façon.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609504
    m_Localized: 'Intruder: Je peux VOIR les rêves des autres. Et c''est… fascinant.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609505
    m_Localized: 'Intruder: Je saurais pas te dire comment ça marche.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609506
    m_Localized: 'Intruder: Mais depuis que tout ça a commencé, les rêves… ils se sont tus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609507
    m_Localized: 'Intruder: C''est comme si tout le monde retenait son souffle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609508
    m_Localized: 'Intruder: Et moi, j''arrive plus à dormir non plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609509
    m_Localized: 'Intruder: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609510
    m_Localized: 'Intruder: Vas-y, essaie de deviner si je te dis la vérité ou si je te fais marcher.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609511
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609512
    m_Localized: Mais vous êtes qui ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609513
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609514
    m_Localized: 'Cultist1: Des âmes perdues. Tout comme tous les autres habitants de cette misérable terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609515
    m_Localized: 'Cultist1: Nous aspirons à la paix et à la tranquillité. Et nous savons comment y parvenir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609516
    m_Localized: 'Cultist1: La mort…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609517
    m_Localized: 'Cultist1: Pourquoi la craindre ? Est-ce la peur de l''inconnu ? Ou de la punition que nous ont inculquée les religions ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609518
    m_Localized: 'Cultist1: Pendant des millénaires, nous avons cherché un sens à la vie. Mais la réponse était si simple…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609519
    m_Localized: 'Cultist1: La mort, c''est notre raison d''être. Nous ? Nous sommes ses disciples.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609520
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609521
    m_Localized: Pourquoi vénérez-vous la mort ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609522
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609523
    m_Localized: 'Cultist1: Parce que la mort est l''incarnation même de la miséricorde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609524
    m_Localized: 'Cultist1: Tout le monde la craint, certes… Mais cette crainte est-elle justifiée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609525
    m_Localized: 'Cultist1: Pensez-y… Notre monde c''est un purgatoire où nous sommes tourmentés. Mais dans quel but ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609526
    m_Localized: 'Cultist1: Toute cette peur, cette douleur, cette souffrance… Vous ne croyez pas que nous méritons la paix ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609527
    m_Localized: 'Cultist1: La mort, c''est un paradis que nous ne pouvons pas comprendre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609528
    m_Localized: 'Cultist1: Les religions simplifient l''idée du paradis, car c''est plus facile pour tout le monde. Mais la vie… Est-elle simple ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609529
    m_Localized: 'Cultist1: Il en va de même pour la mort. On ne peut pas la comprendre tant qu''on ne l''a pas vécue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609530
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609531
    m_Localized: Pourquoi avoir choisi ma maison ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609532
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609533
    m_Localized: 'Cultist1: Votre maison ? Elle a un lien avec la mort comme aucune autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609534
    m_Localized: 'Cultist1: Au début, je ne comprenais pas pourquoi notre maître avait choisi cet endroit. Mais maintenant, tout est clair.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609535
    m_Localized: 'Cultist1: Ces murs portent les traces de la mort. Si elles sont invisibles, elles n''en sont pas moins palpables.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609536
    m_Localized: 'Cultist1: Le béton brut empeste le sang répandu.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609537
    m_Localized: 'Cultist1: On ne vous demande pas de tuer, contrairement à ce que vous pourriez croire. Vous prenez déjà votre lot de vies.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609538
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609539
    m_Localized: 'Cultist1: Je crois que votre lien avec la mort est plus fort que n''importe qui d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609540
    m_Localized: 'Cultist1: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609541
    m_Localized: À quoi servent ces feux de joie que vous allumez, dehors ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609542
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609543
    m_Localized: 'Cultist1: L''heure est venue.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609544
    m_Localized: 'Cultist1: Les anges venus d''en dessous emporteront nos cendres, ces offrandes pour ouvrir le passage dans le royaume de la Mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609545
    m_Localized: 'Cultist1: Voilà comment nous gagnerons sa faveur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609546
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609547
    m_Localized: Vous avez l'air terrorisé. Vous avez peur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609548
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609549
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609550
    m_Localized: 'Cultist2: Vous êtes très observateur, cher propriétaire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609551
    m_Localized: 'Cultist2: Contrairement à mes frères de foi, je suis encore en proie à la peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609552
    m_Localized: 'Cultist2: Mes doutes me tourmentent. Qu''y a-t-il après la vie ? Que ressent-on ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609553
    m_Localized: 'Cultist2: Notre maître proclame qu''il ne s''agit ni du paradis ni de l''enfer. C''est autre chose. Mais j''ai du mal à comprendre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609554
    m_Localized: 'Cultist2: Si même lui ne comprend pas tout à fait la mort, comment pouvons-nous espérer nous faire une idée un jour ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609555
    m_Localized: 'Cultist2: Et si l''effleurer ne suffisait pas ? Et si tout cela dépassait complètement notre entendement…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609556
    m_Localized: 'Cultist2: Et pourtant, je n''ose pas douter de notre maître. Ses yeux reflètent la certitude et une connaissance profonde.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609557
    m_Localized: 'Cultist2: Il nous demande d''embrasser la foi avec détermination. Il nous demande d''être prêts.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609558
    m_Localized: 'Cultist2: Il n''y a que comme ça que nous pourrons traverser les fleuves des morts et les montagnes d''os. Pour enfin atteindre…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609559
    m_Localized: 'Cultist2: La mort.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609560
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609561
    m_Localized: Pourquoi vénérez-vous la mort ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609562
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609563
    m_Localized: 'Cultist2: Je vous prie, cher propriétaire, de parler de la Mort avec respect.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609564
    m_Localized: 'Cultist2: Elle méprise ceux qui la traitent d''injustifiée. Elle les punit sévèrement.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944336609565
    m_Localized: 'Cultist2: Sa nature m''effraie, mais notre maître affirme que la Mort est peut-être la plus bienveillante de toutes les divinités.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803584
    m_Localized: 'Cultist2: Elle vient, dénuée de famine, de peste, de guerre. Elle vient, et elle n''offre que le repos.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803585
    m_Localized: 'Cultist2: Et c''est à nous de la trouver.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803586
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803587
    m_Localized: Pourquoi avez-vous tellement hâte de mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803588
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803589
    m_Localized: 'Cultist2: Ce voyage, on ne l''a pas choisi. C''est la volonté de la Mort elle-même.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803590
    m_Localized: 'Cultist2: Elle nous a appelés. Elle nous veut dans son royaume.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803591
    m_Localized: 'Cultist2: Notre maître dit que c''est pour cela que le soleil brûle si fort en ce moment. Il cherche à nous chasser de la surface.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803592
    m_Localized: 'Cultist2: La Mort, elle, offre le silence, la paix et l''unité. C''est dans son Royaume que nous nous reverrons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803593
    m_Localized: 'Cultist2: Nous pleurons les morts en vain. Nous oublions que nous les reverrons un jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803594
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803595
    m_Localized: Que comptez-vous faire ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803596
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803597
    m_Localized: 'Cultist2: L''heure est venue…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803598
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803599
    m_Localized: 'Cultist2: J''ai peur… Mon corps n''arrête pas de trembler… Mais je dois garder la foi. Je dois rester déterminé.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803600
    m_Localized: 'Cultist2: Notre maître croit en moi. Je ne peux décevoir personne.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803601
    m_Localized: 'Cultist2: Mais la peur… Elle continue de me ronger…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803602
    m_Localized: 'Cultist2: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803603
    m_Localized: 'Cultist2: Qu''on nous laisse partir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803604
    m_Localized: 'Cultist2: Qu''on nous laisse partir… Qu''on nous laisse partir !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803605
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803606
    m_Localized: Combien de temps comptez-vous rester ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803607
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803608
    m_Localized: 'Cultist3: Ne vous inquiétez pas, cher propriétaire. Nous ne vous causerons pas d''ennuis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803609
    m_Localized: 'Cultist3: Merci pour votre hospitalité. Pour rien au monde, nous ne voudrions vous froisser. Vous avez déjà tant fait pour nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803610
    m_Localized: 'Cultist3: Nous allons nous contenter de cette pièce pour prier en silence.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803611
    m_Localized: 'Cultist3: Il faut que nous nous reposions. Notre voyage s''annonce long et difficile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803612
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803613
    m_Localized: Où comptez-vous aller ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803614
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803615
    m_Localized: 'Cultist3: Vers la terre des étrangers.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803616
    m_Localized: 'Cultist3: La vie humaine est éphémère. Nous ne faisons que passer sur cette terre. Nous venons et nous partons.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803617
    m_Localized: 'Cultist3: Les étrangers doivent s''approprier cette terre. S''y installer.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803618
    m_Localized: 'Cultist3: Ils ne sont pas venus ici par hasard. Ils ont répondu au même appel que celui qui nous a poussés à partir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803619
    m_Localized: 'Cultist3: C''est la mort qui les a convoqués.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803620
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803621
    m_Localized: Qu'est-ce qui vous fait croire que c'est la mort qui a convoqué les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803622
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803623
    m_Localized: 'Cultist3: La Mort ne fait aucune distinction : humains, bêtes, étrangers…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803624
    m_Localized: 'Cultist3: La Mort est la même pour tous et nous sommes tous égaux face à elle.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803625
    m_Localized: 'Cultist3: Elle a attendu le moment opportun, et le voilà qui approche à grands pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803626
    m_Localized: 'Cultist3: Il faut que nous nous préparions pour le rituel…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803627
    m_Localized: 'Cultist3: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803628
    m_Localized: De quel genre de rituel parlez-vous ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803629
    m_Localized: Je vais vous soumettre à un test.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803630
    m_Localized: 'Cultist3: L''heure est venue de passer de l''autre côté… De changer de demeure.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803631
    m_Localized: 'Cultist3: Nous devons rejoindre la Mort… Entrer dans son royaume de paix et de sérénité éternelles.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803632
    m_Localized: 'Cultist3: L''heure est venue de partir…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803633
    m_Localized: 'FatalDame: Oui, mon chéri ? Y a quelque chose qui te tracasse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803634
    m_Localized: Tu te plais ici ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803635
    m_Localized: Je peux te regarder de plus près ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803636
    m_Localized: 'FatalDame: C''est plutôt douillet. Je ne m''y attendais pas, vu les circonstances.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803637
    m_Localized: 'FatalDame: C''est gentil de m''accueillir, merci. Sans toi, j''aurais fini à la rue avant le lever du jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803638
    m_Localized: 'FatalDame: Et toi, comment tu te sens ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803639
    m_Localized: Plutôt anxieux
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803640
    m_Localized: Ça va. Survivre, c'est tout ce qui compte.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803641
    m_Localized: 'FatalDame: Je te comprends.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803642
    m_Localized: 'FatalDame: Ces jours-ci, ça vaut pas la peine de se projeter plus de quatre mois dans le futur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803643
    m_Localized: 'FatalDame: On peut pas prévoir ce qui va nous arriver : le soleil, des fous furieux ou les Visiteurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803644
    m_Localized: 'FatalDame: D''un autre côté, l''humanité a déjà survécu à des catastrophes bien pires que ça. Et la Terre, j''en parle même pas…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803645
    m_Localized: 'FatalDame: Je pense qu''on laissera quelque chose derrière nous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803646
    m_Localized: 'FatalDame: Il y aura quelqu''un pour trouver des traces de notre passage.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803647
    m_Localized: 'FatalDame: Le monde continuera de tourner.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803648
    m_Localized: 'FatalDame: J''aime ta façon d''être. Ça te va bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803649
    m_Localized: 'FatalDame: Mais ne garde pas tout pour toi. Les émotions, ça peut ressortir quand on s''y attend le moins…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803650
    m_Localized: 'FatalDame: … Juste quand tu t''y attends le moins.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803651
    m_Localized: 'FatalDame: Tu n''as pas à avoir honte d''en parler.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803652
    m_Localized: 'FatalDame: Et si tu ne veux pas avec moi, alors parles-en à quelqu''un d''autre. N''importe qui.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803653
    m_Localized: 'FatalDame: Promets-le-moi. D''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803654
    m_Localized: 'FatalDame: Oui, mon chéri ? Y a quelque chose qui te tracasse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803655
    m_Localized: J'ai vu quelque chose de bizarre hier soir.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803656
    m_Localized: Je peux te regarder de plus près ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803657
    m_Localized: 'FatalDame: Hmm ? De quoi tu parles ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803658
    m_Localized: Ton ventre. Il est un peu plus gros…
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803659
    m_Localized: J'ai l'impression d'avoir vu quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803660
    m_Localized: 'FatalDame: Tu insinues que… je suis enceinte ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803661
    m_Localized: 'FatalDame: C''est pas grave. Je suis contente que tu dises ce que tu as sur le cœur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803662
    m_Localized: 'FatalDame: J''imagine que tu ressens ça parce que tu es responsable d''autres personnes en ce moment. Et ça te fait peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803663
    m_Localized: 'FatalDame: Je comprends. Chaque jour risque d''être le dernier… C''est déjà assez difficile de s''occuper de soi, alors des autres…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803664
    m_Localized: 'FatalDame: Tu ne sais même pas si tu seras encore en vie demain.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803665
    m_Localized: Oui… ça me fait peur.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803666
    m_Localized: Non, je crois pas que ce soit ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803667
    m_Localized: 'FatalDame: Mais quelque chose te tracasse, je me trompe ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803668
    m_Localized: 'FatalDame: C''est pas grave. La peur nous ronge tous.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803669
    m_Localized: 'FatalDame: Je t''ai vu. Tu te lèves la nuit. Tu fais des rondes.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803670
    m_Localized: 'FatalDame: C''est pas anodin. T''as beau être timide, tu tiens vraiment aux personnes que tu fais entrer dans ta vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803671
    m_Localized: 'FatalDame: C''est… intéressant. Tu es bourré de contradictions.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803672
    m_Localized: 'FatalDame: Ou peut-être que c''est juste des insomnies. La peur est une bien mauvaise compagne, tu sais…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803673
    m_Localized: Ouais… Ça me fait peur.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803674
    m_Localized: Non, je pense pas que ce soit ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803675
    m_Localized: 'FatalDame: Il faut du courage pour le dire à voix haute.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803676
    m_Localized: 'FatalDame: Mais que peut-on faire face à la peur, au juste ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803677
    m_Localized: 'FatalDame: Es-tu capable d''accepter l''idée que tout ça va prendre fin ? Tout le monde finit par mourir.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803678
    m_Localized: 'FatalDame: Ce qui compte, c''est la façon dont tu trouves ton salut. Mais peux-tu encore le sauver ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803679
    m_Localized: 'FatalDame: D''accord.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803680
    m_Localized: 'FatalDame: Quoi qu''il en soit… Je me fais du souci pour toi. Écoute ton cœur, d''accord ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803681
    m_Localized: 'FatalDame: Je veux que tu te sentes en sécurité. Après tout, on vit sous le même toit.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803682
    m_Localized: 'FatalDame: Mais si tu perds un boulon, on va tous déboulonner…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803683
    m_Localized: 'FatalDame: … Excuse le mauvais jeu de mots ! *petit rire*'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803684
    m_Localized: 'FatalDame: Ça t''a quand même fait rire ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803685
    m_Localized: 'FatalDame: Oui, mon chéri ? Y a quelque chose qui te tracasse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803686
    m_Localized: Je sais que je t'ai vue enceinte hier soir. Explique-moi ça.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803687
    m_Localized: Je peux te regarder de plus près ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803688
    m_Localized: 'FatalDame: Tu commences à me faire un peu peur.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803689
    m_Localized: 'FatalDame: Tu es sûr d''avoir VRAIMENT vu quelque chose hier soir ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803690
    m_Localized: 'FatalDame: Pourquoi tu ne m''as pas réveillée ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803691
    m_Localized: 'FatalDame: C''est encore la peur qui te fait parler ? La mort… ou la responsabilité de t''occuper de quelqu''un ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803692
    m_Localized: 'FatalDame: C''est à cause de moi ? Ou est-ce que quelqu''un d''autre t''obsède ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803693
    m_Localized: Joue pas avec mes nerfs.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803694
    m_Localized: Je… Je suis sûr d'avoir vu quelque chose.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803695
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803696
    m_Localized: 'FatalDame: Tu as parlé de ton père l''autre jour.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803697
    m_Localized: 'FatalDame: On n''en a pas reparlé depuis. Je sais pas grand-chose, en réalité.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803698
    m_Localized: 'FatalDame: Mais là… J''ai l''impression que t''es exactement comme lui. T''es son portrait craché.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803699
    m_Localized: 'FatalDame: Ça te fait peur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803700
    m_Localized: 'FatalDame: D''être coincé dans son ombre ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803701
    m_Localized: 'FatalDame: Il est mort pour toi. Pourquoi est-ce que continue à ressasser le passé ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803702
    m_Localized: 'FatalDame: Tu le retrouveras pas dans l''au-delà.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803703
    m_Localized: 'FatalDame: Je ne pense pas que tu finiras au même endroit. Ne t''inquiète pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803704
    m_Localized: 'FatalDame: Arrête de chercher toutes les réponses en même temps. Les routes se construisent pavé par pavé, mon chéri. Tu me suis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803705
    m_Localized: 'FatalDame: Et par pitié… Me parle plus jamais comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803706
    m_Localized: 'FatalDame: Ça fait mal. De te voir tout ce qui t''arrive.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803707
    m_Localized: 'FatalDame: Mais faut pas que t''aies peur de la mort. Ni des responsabilités. Ni de la promiscuité. Ni de quoi que ce soit d''autre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803708
    m_Localized: 'FatalDame: Tout ça, ça fait partie de la vie.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803709
    m_Localized: 'FatalDame: Arrête de chercher toutes les réponses en même temps. Les routes se construisent pavé par pavé, mon chéri. Tu me suis ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803710
    m_Localized: 'FatalDame: Tu sais… ça peut rassurer de se dire qu''on disparaît pas complètement quand le rideau tombe.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803711
    m_Localized: 'FatalDame: Avant, je croyais au paradis et à l''enfer. Maintenant ? Je n''en suis plus si sûre.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803712
    m_Localized: 'FatalDame: Peut-être s''agit-il de quelque chose de complètement différent.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803713
    m_Localized: 'FatalDame: Et toi, tu en penses quoi ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803714
    m_Localized: 'FatalDame: Oui, mon chéri ? Y a quelque chose qui te tracasse ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803715
    m_Localized: Tu es enceinte et tu vas bientôt accoucher, pas vrai ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803716
    m_Localized: Je peux te regarder de plus près ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803717
    m_Localized: 'FatalDame: Oh.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803718
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803719
    m_Localized: 'FatalDame: T''es désespéré, c''est ça ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803720
    m_Localized: 'FatalDame: Tout ce en quoi tu croyais s''écroule… Et tu te sens impuissant face à ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803721
    m_Localized: 'FatalDame: Est-ce que c''est parce que tu ne veux pas aller là où on va ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803722
    m_Localized: 'FatalDame: Ou est-ce que c''est parce que… tu trouves plus ta place dans ce monde ? Ou dans n''importe quel monde ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803723
    m_Localized: C'est pas de ça que je parle. Tu es enceinte.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803724
    m_Localized: Mais… Tu n'as pas peur ?
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803725
    m_Localized: 'FatalDame: Mon chéri… Je peux pas accoucher aussi vite. J''ai même pas de ventre !'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803726
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803727
    m_Localized: 'FatalDame: Je peux te demander un truc ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803728
    m_Localized: 'FatalDame: Si ce bébé est réel…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803729
    m_Localized: 'FatalDame: Et si, comme tu dis, il va bientôt arriver…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803730
    m_Localized: 'FatalDame: Tu vas faire quoi ? Tu vas essayer de le retrouver ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803731
    m_Localized: Ça ne devrait pas être possible.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803732
    m_Localized: Je n'ai pas encore pris de décision.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803733
    m_Localized: 'FatalDame: Hmm. Bonne question.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803734
    m_Localized: 'FatalDame: Mourir, c''est terrifiant, c''est sûr.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803735
    m_Localized: 'FatalDame: Surtout parce que je ne sais pas ce qui va se passer après.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803736
    m_Localized: 'FatalDame: Le paradis ? La réincarnation ? Quelque chose de complètement différent ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803737
    m_Localized: 'FatalDame: Personne n''est revenu pour le dire.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803738
    m_Localized: 'FatalDame: Mais à propos de ta vision…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803739
    m_Localized: 'FatalDame: Si cet Enfant existe vraiment…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803740
    m_Localized: 'FatalDame: Et si, comme tu le dis, il arrive bientôt…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803741
    m_Localized: 'FatalDame: Qu''est-ce que tu vas faire ? Est-ce que tu vas essayer de le trouver ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803742
    m_Localized: Ça ne devrait pas être possible.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803743
    m_Localized: Je n'ai pas encore pris de décision.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803744
    m_Localized: 'FatalDame: Parfois, l''instinct cherche à préserver ce qui nous est familier… Même si ça ne nous est plus utile.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803745
    m_Localized: 'FatalDame: Peut-être…'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803746
    m_Localized: 'FatalDame: Peut-être qu''il est temps de s''ouvrir à quelque chose de nouveau ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803747
    m_Localized: 'FatalDame: À moins que l''inconnu te fasse trop peur ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803748
    m_Localized: Je vais retrouver cet enfant.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803749
    m_Localized: C'est pour bientôt. Je le sais.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803750
    m_Localized: 'FatalDame: Faut pas avoir peur de lâcher prise. Surtout pour des trucs qui te servent plus à rien.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803751
    m_Localized: 'FatalDame: Parfois, on s''accroche à quelque chose juste parce qu''on y est habitué.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803752
    m_Localized: 'FatalDame: Et oui, c''est dur de changer ses habitudes… Mais qui sait où ça peut mener ?'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803753
    m_Localized: Je vais retrouver cet enfant.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803754
    m_Localized: C'est pour bientôt. Je le sais.
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803755
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803756
    m_Localized: 'FatalDame: Si tu le dis.'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803757
    m_Localized: 'FatalDame: …'
    m_Metadata:
      m_Items: []
  - m_Id: 31163944340803758
    m_Localized: 'FatalDame: Dis-moi ce que tu auras trouvé… le moment venu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713856
    m_Localized: 'Neighbour: Allez, c''est tout pour moi, je crois.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713857
    m_Localized: 'Neighbour: Ah si, j''allais oublier.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713858
    m_Localized: 'Neighbour: J''ai prévu de rentrer demain soir. Prends mon numéro, on vient d''installer la ligne fixe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713859
    m_Localized: 'Neighbour: {0}. On pourra garder contact par téléphone.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713860
    m_Localized: 'Neighbour: Bon… Je crois que c''est vraiment tout cette fois.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173118713861
    m_Localized: 'Neighbour: Ouvre-toi une bonne bière et va te coucher.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491133
    m_Localized: 'Cat: Miaou !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491134
    m_Localized: Caresser le chat
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491135
    m_Localized: Prendre le chat
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491136
    m_Localized: Lui donner une conserve (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491137
    m_Localized: 'Cat: (Vous tendez la main et caressez le chat.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491138
    m_Localized: 'Cat: (De toute évidence, ça n''a pas l''air de lui déplaire.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491139
    m_Localized: 'Cat: Miaou !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491140
    m_Localized: Caresser le chat
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491141
    m_Localized: Prendre le chat
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491142
    m_Localized: Lui donner une conserve (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491143
    m_Localized: 'Cat: (Vous décidez de caresser le chat.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491144
    m_Localized: 'Cat: (Il a l''air de bien aimer ça.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491145
    m_Localized: 'Cat: (Il n''est pas aussi farouche que vous le pensiez.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491146
    m_Localized: 'Cat: (On dirait qu''il commence à s''habituer à vous.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491147
    m_Localized: 'Cat: Miaou !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491148
    m_Localized: Caresser le chat
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491149
    m_Localized: Prendre le chat
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491150
    m_Localized: Lui donner une conserve (x{0})
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491151
    m_Localized: 'Cat: (Le chat a vraiment l''air d''aimer qu''on le caresse souvent.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491152
    m_Localized: 'Cat: (On dirait qu''il se penche vers vous pour que vous continuiez.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491153
    m_Localized: 'Cat: (Mais comment résister à une boule de poils aussi adorable ?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491154
    m_Localized: 'Cat: Miaou ! MIAOU ! Miaou !'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491155
    m_Localized: 'Cat: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491156
    m_Localized: 'Cat: (Difficile de deviner ce qui se passe dans sa petite tête, mais vous êtes presque sûr qu''il est heureux.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491157
    m_Localized: 'Cat: (Vous avez l''étrange impression que vous allez passer une nuit tranquille.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491158
    m_Localized: 'Cat: (Comme si votre compagnon à quatre pattes vous avait offert une de ses neuf vies pour vous remercier.)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887173135491159
    m_Localized: 'Cat: (Qui sait ? Peut-être que la mort épargnera votre maison cette nuit.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547465932800
    m_Localized: 'Teacher: Les pauvres petits…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292928
    m_Localized: Un problème ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292929
    m_Localized: Je dois vous faire passer un test.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292930
    m_Localized: 'Teacher: Hein ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292931
    m_Localized: 'Teacher: Je… Je me demandais juste…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292932
    m_Localized: 'Teacher: Et si jamais ce n''était pas une extinction de masse ? Et si nous survivions ? Qu''est-ce qui nous attendra alors ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292933
    m_Localized: 'Teacher: Quel avenir nous restera-t-il ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292934
    m_Localized: Vous avez peur de ne pas trouver votre place dans le monde à venir ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292935
    m_Localized: Les cœurs tendres ne font pas long feu de nos jours. Vous feriez mieux de trouver quelqu'un à qui vous accrocher.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292936
    m_Localized: 'Teacher: Un cœur tendre…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292937
    m_Localized: 'Teacher: Je… Je ne peux pas vivre dans une telle violence.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292938
    m_Localized: 'Teacher: Je ne sais plus où est ma place… dans… Comment avez-vous dit ? Dans ce… « monde à venir ».'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292939
    m_Localized: Donc, vous pensez qu'il faut se résigner et se laisser mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292940
    m_Localized: Et que proposez-vous à la place ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292941
    m_Localized: Le monde a déjà traversé des heures sombres… Ça n'a rien de nouveau.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292942
    m_Localized: 'Teacher: Mais, moi… Je ne veux pas de ça. Même si je trouve quelqu''un pour me protéger…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292943
    m_Localized: 'Teacher: Les massacres continueront. La barbarie ne disparaîtra pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292944
    m_Localized: Donc, vous pensez qu'il faut se résigner et se laisser mourir ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292945
    m_Localized: Et que proposez-vous à la place ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292946
    m_Localized: Le monde a déjà traversé des heures sombres… Ça n'a rien de nouveau.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292947
    m_Localized: 'Teacher: Je me sens tellement perdue.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292948
    m_Localized: 'Teacher: C''est ça la vie maintenant ? On va vraiment vivre entourés de meurtriers ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292949
    m_Localized: 'Teacher: On va vraiment laisser des meurtriers dispenser leur éducation à nos enfants ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292950
    m_Localized: On n'a pas le temps de se morfondre…
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292951
    m_Localized: RESSAISISSEZ-VOUS !
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292952
    m_Localized: 'Teacher: Je ne sais pas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292953
    m_Localized: 'Teacher: Je n''ai plus rien à offrir.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292954
    m_Localized: 'Teacher: Je veux juste que tout ça s''arrête.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292955
    m_Localized: 'Teacher: Je… Je n''en peux plus.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292956
    m_Localized: 'Teacher: Oui, c''est vrai. Mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292957
    m_Localized: 'Teacher: Comment peut-on vivre désormais ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292958
    m_Localized: 'Teacher: Les gens sont devenus fous… Ils tuent tous ceux qui leur semblent… différents.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292959
    m_Localized: 'Teacher: Ils se contrefichent de ce qui se dresse sur la route.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292960
    m_Localized: On n'a pas le temps de se morfondre…
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292961
    m_Localized: RESSAISISSEZ-VOUS !
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292962
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292963
    m_Localized: 'Teacher: Et pourquoi je pourrais pas ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292964
    m_Localized: 'Teacher: Peut-être que c''est votre cœur de pierre vous fait tenir, vous. Mais moi, je ne fonctionne pas comme ça.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292965
    m_Localized: 'Teacher: Si vous aviez vu ce que j''ai vu…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292966
    m_Localized: 'Teacher: Ce sera à jamais gravé dans ma mémoire.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292967
    m_Localized: 'Teacher: Le feu… Ces cris… Les visages terrifiés… Les visages enragés… Les maisons dévastées…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292968
    m_Localized: 'Teacher: Je ne suis pas comme vous. Je ne suis pas forte comme vous.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292969
    m_Localized: 'Teacher: Pour moi… il n''y a plus qu''une seule solution.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292970
    m_Localized: 'Teacher: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292971
    m_Localized: 'Teacher: (La femme tressaille et vous dévisage avec crainte.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292972
    m_Localized: 'Teacher: (Sa confusion lui a permis d''oublier sa hantise, mais seulement le temps d''un instant.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292973
    m_Localized: 'Teacher: (Elle plonge son visage dans ses mains et se met à sangloter, doucement.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292974
    m_Localized: 'Teacher: (Vous ne savez pas quoi faire. Personne ne vous a jamais montré.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292975
    m_Localized: 'Teacher: (Vous posez délicatement une main sur son épaule et vous restez ainsi un moment.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547495292976
    m_Localized: 'Teacher: (Il vaut probablement mieux la laisser seule.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487232
    m_Localized: 'Mother: Hé, vous savez quoi ? Vous feriez peut-être mieux de l''appeler. {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487233
    m_Localized: 'Mother: Faites-lui savoir ce que vous pensez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487234
    m_Localized: 'Mother: C''est aussi ses gosses, après tout. Lui aussi, il devrait aider à les chercher.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487235
    m_Localized: 'Anger: Si ça sonne, tu m''appelles, d''accord ? {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487236
    m_Localized: 'Anger: Dis-lui juste… Dis-lui que je me souviens de tout… Et que j''ai toujours envie de me faire sauter la cervelle.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487237
    m_Localized: 'Anger: Ou si tu préfères, tu peux lui hurler dessus… pour moi. Je sais pas… Peut-être que ça me soulagera un peu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547499487238
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875840
    m_Localized: 'FortuneTeller: Et dans certains cas… Eh bien, on a parfois besoin d''une aide venue… d''ailleurs.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875841
    m_Localized: 'FortuneTeller: Certaines personnes… très compétentes… savent comment purifier les ténèbres.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875842
    m_Localized: 'FortuneTeller: Je peux vous mettre en contact si vous voulez. Ça pourrait vous être utile…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875843
    m_Localized: 'FortuneTeller: Je vais écrire leur numéro pour vous : {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547507875844
    m_Localized: 'FortuneTeller: N''oubliez pas de préciser que c''est moi qui vous envoie…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547533041664
    m_Localized: 'Alkonost: Vous pourriez peut-être lui passer un coup de fil, si c''est pas trop vous demander ? {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235968
    m_Localized: 'Foreigner: (Il vous tend un bout de papier sur lequel est inscrit un numéro de téléphone : {0}.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547537235969
    m_Localized: 'Foreigner: (C''est peut-être le numéro de l''ambassade de son pays.)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818880
    m_Localized: 'Jacob: Bon sang… Je meurs d''envie de boire un verre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818881
    m_Localized: Comment ça, immortel ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818882
    m_Localized: Je veux vous tester.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818883
    m_Localized: 'Jacob: Hé bien… Vous pourriez vous tirer une balle dans la tête et voir ça par vous-même…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818884
    m_Localized: 'Jacob: Mais j''éviterais si j''étais vous…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818885
    m_Localized: 'Jacob: Bien sûr qu''on n''est pas immortels dans le sens où vous l''entendez…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818886
    m_Localized: 'Jacob: Une fois mort, on se réincarne et on recommence à vivre…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818887
    m_Localized: 'Jacob: Je sais que ça paraît fou, mais si vous aviez vu ce que j''ai vu… vous comprendriez…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818888
    m_Localized: 'Jacob: Si ça se trouve… Les Visiteurs étaient des humains avant de… renaître.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818889
    m_Localized: 'Jacob: Je n''en suis pas complètement sûr. Je sais pas comment ça marche…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818890
    m_Localized: 'Jacob: Mais ce que je sais, c''est que la nature garde plein de secrets.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818891
    m_Localized: 'Jacob: Et je finirai par retrouver ma fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818892
    m_Localized: 'Jacob: Peut-être pas dans cette vie… Mais je vais la retrouver.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818893
    m_Localized: 'Jacob: Parce qu''en fait… on meurt jamais.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818894
    m_Localized: 'Jacob: Bon sang… Je meurs d''envie de boire un verre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818895
    m_Localized: Pourquoi est-ce que la FEMA vous recherche ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818896
    m_Localized: Je veux vous tester.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818897
    m_Localized: 'Jacob: J''étais à l''endroit même où toute cette histoire a commencé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818898
    m_Localized: 'Jacob: Dans la zone où ces choses ont rampé hors de terre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818899
    m_Localized: 'Jacob: Vous vous souvenez de ces légendes urbaines débiles ? Sur les démons qui vivaient dans les banlieues ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818900
    m_Localized: 'Jacob: C''est sans importance… Plus personne s''en rappelle maintenant.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818901
    m_Localized: 'Jacob: Mais le fait est que… c''étaient pas du tout des légendes. La FEMA était au courant depuis le début.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818902
    m_Localized: 'Jacob: Ils ont fait comme s''il ne se passait rien de surnaturel là-bas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818903
    m_Localized: 'Jacob: Et maintenant… Tout le monde est en train de rôtir au soleil…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818904
    m_Localized: 'Jacob: Tandis que des monstres surgissent des profondeurs pour trucider les survivants !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818905
    m_Localized: 'Jacob: En gros, la FEMA s''est rendu compte qu''elle avait foiré…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818906
    m_Localized: 'Jacob: Et maintenant, tout ce qu''ils cherchent à faire, c''est dissimuler leur incompétence.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818907
    m_Localized: 'Jacob: Moi ? J''étais juste au mauvais moment au mauvais endroit.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818908
    m_Localized: 'Jacob: Bon sang… Je meurs d''envie de boire un verre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818909
    m_Localized: Mais comment avez-vous survécu ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818910
    m_Localized: Je veux vous tester.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818911
    m_Localized: 'Jacob: Je suis immortel. Vous avez déjà oublié ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818912
    m_Localized: 'Jacob: Je sais pas trop…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818913
    m_Localized: 'Jacob: Moi aussi, je me pose la question…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818914
    m_Localized: 'Jacob: Peut-être que j''ai de la chance. Ou peut-être qu''une puissance supérieure me protège…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818915
    m_Localized: 'Jacob: Dieu… Ou peu importe ce en quoi vous croyez.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818916
    m_Localized: 'Jacob: Ou peut-être que je suis déjà mort et que c''est ma nouvelle vie. Je sais pas trop…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818917
    m_Localized: 'Jacob: C''est une bonne question.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818918
    m_Localized: 'Jacob: Dommage que j''aie pas d''arme, je vous retournerai la question.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818919
    m_Localized: 'Jacob: Et dommage que vous n''ayez que de la bière.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818920
    m_Localized: 'Jacob: Si j''avais un alambic, je vous préparerais une bonne cuvée.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818921
    m_Localized: 'Jacob: Bon sang… Je meurs d''envie de boire un verre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818922
    m_Localized: Et sinon, qu'est-ce que vous savez faire d'autre ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818923
    m_Localized: Je veux vous tester.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818924
    m_Localized: 'Jacob: Je connais toute l''organisation de la FEMA sur le bout des doigts…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818925
    m_Localized: 'Jacob: Qui est responsable de qui, qui fait quoi, qui entube qui…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818926
    m_Localized: 'Jacob: Ces enfoirés… Ils étaient au courant pour les Visiteurs… Ils savaient à quel point ils étaient dangereux…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818927
    m_Localized: 'Jacob: Mais ils les ont quand même laissés s''infiltrer dans la ville.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818928
    m_Localized: 'Jacob: Parce qu''eux, ils en avaient rien à faire de la sécurité.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818929
    m_Localized: 'Jacob: Tout ce qu''ils faisaient, c''était blanchir l''argent du gouvernement.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818930
    m_Localized: 'Jacob: Et les rares témoins de leur incompétence ? Tous sont devenus des victimes.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818931
    m_Localized: 'Jacob: L''organisation ne voulait pas que ça se sache.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818932
    m_Localized: 'Jacob: Et tout ça, c''était bien avant les zones de quarantaine.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818933
    m_Localized: 'Jacob: J''ai failli y laisser ma peau.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818934
    m_Localized: 'Jacob: Vous voulez des infos top secrètes ? Alors, écoutez bien…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818935
    m_Localized: 'Jacob: Tout est de la faute de la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818936
    m_Localized: 'Jacob: Ce qu''ils racontent à la télévision ? Que des bobards…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818937
    m_Localized: 'Jacob: S''il y a bien quelque chose de pire que les Visiteurs…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818938
    m_Localized: 'Jacob: C''est la FEMA.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818939
    m_Localized: 'Jacob: Bon sang… Je meurs d''envie de boire un verre.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818940
    m_Localized: D'où ils viennent, les Visiteurs ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818941
    m_Localized: Je veux vous tester.
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818942
    m_Localized: 'Jacob: Des banlieues.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818943
    m_Localized: 'Jacob: Ouais, je sais… Les zones de quarantaine sont pas à côté…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818944
    m_Localized: 'Jacob: Mais j''en suis sûr et certain.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818945
    m_Localized: 'Jacob: Je suis pas superstitieux, mais…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818946
    m_Localized: 'Jacob: Les gens parlaient déjà de ces mêmes démons il y a deux ans.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818947
    m_Localized: 'Jacob: Je ne sais pas comment ils sont entrés dans la ville…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818948
    m_Localized: 'Jacob: Mais je sais qui les a laissés entrer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818949
    m_Localized: 'Jacob: C''est la FEMA…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818950
    m_Localized: 'Jacob: Les Visiteurs ne sont pas des extraterrestres, contrairement à ce que la plupart des gens imaginent…'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818951
    m_Localized: 'Jacob: Ce sont des créatures, tout comme vous et moi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818952
    m_Localized: 'Jacob: Ils sont nés ici !'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818953
    m_Localized: 'Jacob: …'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818954
    m_Localized: 'Jacob: Je ne peux pas rester ici plus longtemps.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818955
    m_Localized: 'Jacob: Je dois retrouver ma fille.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219547549818956
