%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 1290f85681bd44940af0abf2b1b05504, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377515769856
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Đây, chú xem... *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Nhìn chả khác gì hai thanh củi cháy đen, cắm thêm vài cành cây đen kịt. Thế mà móng tay vẫn sạch bong, buồn cười nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Được.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Thấy không? *khụ* Đỏ quạch như hai cục than cháy vậy. Do khói bám lâu đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Chú chắc chưa? Anh nói trước là trông gớm lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Da anh bong từng mảng ra như vỏ cây ấy. Nếu không cần thì anh chẳng muốn phải giơ tay lên thế này đâu. Đau muốn chết luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Ừ, sao cũng được. Trông anh có khác gì cái xác chết cháy đâu. Đằng nào cũng vậy rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Chú thấy sao? *khụ*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Chú chẳng kiểm tra được gì đâu. Tai anh bị lửa ăn tới tận sụn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Sớm muộn gì anh cũng điếc đặc thôi. Mà có khi vậy lại tốt hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Chú muốn thì cứ bắn đi. Cơ mà đừng bắn vào răng nhé, đằng nào nó cũng hỏng hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Tùy chú. Anh đây điếc chả sợ súng nữa. Nếu chú thấy dễ thở hơn thì cứ bắn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Cũng tốt. Có khi như thế anh lại được giải thoát...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Chú có tưởng tượng được đôi tay này đã phải trải qua những gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Nếu phải chết vì một bức ảnh thì cũng *khụ* đành kệ. Anh có sống được nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Vạn vật rồi cũng về với cát bụi... Chắc sắp đến lượt anh rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Kể chú nghe, *khụ* trước anh chả bao giờ nhắc được mấy đứa nhà anh đi đánh răng. Giờ chẳng còn ai để mà mắng chúng nó nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Đôi tay anh *khụ* từng cứu được rất nhiều người. Giờ thì cái cốc anh còn đéo nhấc nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Thế đấy, đời anh chỉ đến đây thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Đến lúc yên nghỉ rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Chú thử tưởng tượng xem... *khụ* cả vạt rừng cháy đổ từng mảng xuống. Lúc ấy mình chỉ biết bất lực đứng nhìn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Đêm đêm, vết nứt trên da cứ rỉ máu làm anh ngủ không nổi. Có làm gì cũng chẳng bớt đau. *khụ* Ngọn lửa đã cướp đi tất cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Có chăng là còn giữ được ký ức. Chẳng sớm thì muộn cái thân này cũng hóa thành tro.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Đứng giữa biển lửa cháy rực, bỗng dưng những khoảnh khắc bình lặng mới ùa về. Bên tai có thể ồn ã, nhưng trong tâm thì tĩnh lặng vô cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Ừa, cứ kiểm tra thiệt kỹ vô. Kiểu gì tui cũng qua trót lọt à!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Nè nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Ông thấy bộ hàm nào hoang dã như vầy chưa? Nguyên một rương báu trong miệng tui đó nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Nó còn hổng phải răng nữa, mà là vàng ròng, vàng nguyên chất nha! Dĩ nhiên hông phải cái nào cũng vậy. Nhưng rồi tui cũng lắp thêm à.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Giờ khui lon bia bằng răng cửa dễ như ăn cháo luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: Đéo cần đồ mở chai nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Ê, tính ra trong cái rủi còn có cái may. Vẫn còn giữ được hai bàn tay này.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Chứ giờ mà mất luôn tay là nghỉ đua luôn á ba!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Ủa xí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Ngón tay tui mất tiêu rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Hôm qua mới mất một ngón thui mà. Còn mấy ngón kia đâu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: Mà thôi, đằng nào chả mọc lại. Hổng sớm thì muộn thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Ngón tay tui mất tiêu rùi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Chuyện nhỏ xíu hông có gì, nhưng mà tui cũng hơi rầu á.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: Ê MÀ MÓNG TAY TUI MỌC LẠI MỘT XÍU NÈ, THẤY CHƯA?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Vậy là kiểu gì chân tui cũng hết què! Chỉ cần chờ thêm xíu nữa thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Ông muốn tui nhìn đi đâu? Nhìn vô mặt ông hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Tui có cái tật mắt hay bị giựt giựt á. Kệ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Hồi còn rồ ga được, tui hổng thể nhìn chăm chú vô cái gì hết trơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Đam mê tốc độ đúng là khó bỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Ờ, được thôi... Ủa đậu, HÁ HÁ HÁ, khứa này hài!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Công nhận ông giỡn đỉnh thiệt. Đúng là trùm thách thức danh hài.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Tầm này bà con ai ai cũng thi nhau vạch nách ra coi. Điên thiệt chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: Trong khi ngoài kia thế giới chìm trong biển lửa, cứ như cả vũ trụ đang dồn hết sức lực để càn quét tụi mình dị.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Đã dị còn khuyến mãi thêm tụi Dị Khách nữa, nó lùng sục giết cho bằng hết từng người một.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: Vậy mà ông chỉ biết hô "Giở cái nách lên coi nào!"'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: HÁ HÁ HÁ HÁ!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Ông muốn chụp tui một tấm hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Tui hổng khoái lên hình đâu, mà thôi kệ, sao cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Chết mẹ, lỡ chớp mắt rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: HÁ HÁ HÁ HÁ! Ô-sờ-kê sếp!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Vậy là ông cũng coi trúng cái tin siêu dị đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Ờ, hài quãi ông ha? ...Hả? Sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: ...Khoan, từ từ. Ông chưa coi hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Ê nha... Vậy thì đéo ổn xíu nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Rồi rồi, tui hổng uống bia của ông nữa đâu. Đừng giận mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Ông biết mấy người cứ hay tức giận rồi căng thẳng như ông sẽ gặp chuyện gì hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: Là cặp cẳng thăng luôn đó. Rồi cuối cùng ngồi xe lăn giống tui nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Ông mà cứ tính nóng như kem dị, thì thử ngồi lên chở tui đi một vòng đi rồi biết mùi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: Ông làm vậy chi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Có giúp được gì cho tui đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Mà cũng hổng lợi lộc miếng nào cho ông. Vậy ông bắn tui để làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: Tui hông dò đường đạn bằng mắt thường được đâu. Để thử né coi sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Tui chả hiểu người ta cạo lông nách làm chi luôn á. Lông mọc để bảo vệ cơ thể mình mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Ông thấy cái vết đỏ tấy kia hông? Tui đang trồng mấy ngón tay ở đó. Hàng dự phòng đó ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: Chời, tui còn nhiều câu hài bể bụng hơn nữa kìa. Để từ từ tui kể hết cho nghe!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Sao lại ra nông nỗi này bạn tui ơi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Ai thèm quan tâm mấy tấm hình nhảm nhí đó chớ? Ôi bạn hiền, cuộc đời có bao lâu đâu mà lo phiền!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Ý tui là...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Thôi, để tui đi đi mà, nha ông?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Ờ thì cuộc sống mà, ai mà hổng tới lúc phải lên đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Sớm muộn gì ông trời cũng kêu tới tên mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Nhưng mà còn khuya tui mới chịu ngủm trong câm lặng nha! MÉO BAO GIỜ! ÁÁÁÁÁÁÁÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Cơ thể mình là mấy cái bị thịt sản xuất theo lô, lập trình sẵn hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Mới nãy còn cười giỡn vui vẻ, giờ đã quay ra bắn nhau lủng đầu. Theo lô mà, ai chả vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Tui phải chuẩn bị tinh thần cho chuyến đi cuối đời...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Động cơ đã sẵn sàng. Chỉ cần tay là nổ máy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: Còn côn xe là cái gì? Ăn được hơm?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Cơ mà nói thiệt, cứ nghĩ lỡ mai này bị mất luôn tay là tui rén ngang. Tới lúc đó biết tính sao đây chời?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Phải ở yên một chỗ riết, hổng có cách gì đi lại được, tui chịu sao nổi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Nói thiệt, cái chết nghe còn đỡ sợ hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Rồi ai cũng sẽ tới cái tuổi bị tụt lại phía sau, cố cách mấy cũng hông bắt kịp được với thời đại.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Ông có thấy khi mình càng già, thời gian trôi qua càng lẹ hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: Hồi nhỏ mình thấy đời dài ơi là dài, cứ lững lờ trôi. Cái gì cũng đơn giản. Hổng phải lo toan, quyết đoán, hay gánh vác trách nhiệm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: Mà giờ, có vắt giò lên cổ mà chạy cũng hổng theo nổi dòng đời ngược xuôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Má, tự nhiên nói cái xụi lơ luôn. Hết cười giỡn gì nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Ông thì kiểm tra tới kiểm tra lui, còn người ta ngoài kia đi dập lửa hoài...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Ai mà hổng muốn cứu thế giới. Mà chín người mười ý, có chịu đoàn kết tìm hướng đi chung đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: Mà làm vậy có được cái gì hông chớ? Nhiều khi mình cứ thong thả, đừng lo nghĩ quá là nó sẽ qua thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Ê nói chứ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Hành trình nắm tay nhau cất bài ca "Trái Đất này là của chúng mình" sắp kết thúc mẹ rồi. Ông có thấy dị hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Mình đi tới cuối đường rồi. Hết tiền, tất cả chuẩn bị xuống tàu thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: Reng reng! Đã tới trạm cuối, mời quý khách nhảy ra khỏi cửa sổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Nhưng mà ông sẵn sàng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Tui là tui nghĩ vầy nè... Cơ mà tui nói xong ông đừng có giận nghen?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Nếu như... tới ông còn hông tin nổi cái dấu hiệu này, thì sao mà tui tin được chớ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Có khi cả đống này đều là dấu hiệu Dị Khách, có khi không! Ai mà biết được?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: Làm người ai chả có lúc lầm lỡ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Nhưng nhiều khi sai lầm đó sẽ để lại hậu họa khôn lường.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Bây giờ... ông mà đổi qua tin cái dấu hiệu này, thì mấy cái trước đem bỏ sọt rác hết à? Sao tui tin được nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Có khi cái mớ đó cũng là ba láp ba xàm hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Mình là con người mà ông. Lầm lỡ là chuyện thường tình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Nhưng mấy sai lầm này có khi dẫn tới hậu họa khôn lường đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Cũng như ông thôi... Sai một li là đi luôn một mạng. Cầm súng hông chắc là có người lủng đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Nhưng nếu ông tự tin mình chọn đúng tới vậy thì... Tui cũng ganh tị với ông thiệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Ờ, cứ kiểm tra thoải mái. Chị có giấu gì em đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Đây nha em.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Trước giờ chị cũng chả để tâm chăm sóc răng miệng lắm. Tại làm gì có thời gian. Mà giờ... chị lại thấy hối hận.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Nè, em coi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: Nhìn hổng ra tay luôn, như hai cái xẻng vậy. Tại phải chăm mấy đứa nhỏ riết á.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Nè, nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Thấy hai quầng thâm to đùng này hông? Tại thiếu ngủ nó mới vậy đó em...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Em cứ coi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Chị ngồi xuống được hông? Hay phải đứng?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Lâu lắm rồi chị hông có ngoáy tai. Có khi ráy nó vón cục cả đống trong trỏng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Mà nói chứ, nội nghe tụi nhỏ la hét thôi chị cũng sắp điếc tới nơi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Mấy nay hễ chị đánh răng là nướu nó lại chảy máu. Bị từ tuần trước rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: Mà đánh xong vẫn vàng khè. Do hút thuốc đó em, xì chét với mấy đứa nhỏ quá thì phải vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: Cứ phải ngâm hóa chất riết nên tay chị bị nổi mẩn. Mà chả có rảnh được lúc nào để đi khám hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Tay này làm ra được cơm ngày ba bữa đó! Còn em nhìn lại tay mình đi, hở tí là cầm súng...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Hờ. Em có ném bom cho tan xác đi nữa thì từng mảnh thịt của chị cũng hổng bao giờ được ngon giấc.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: Cái gì, mày định bắn chị chỉ vì chị hôi ấy hả? Giỡn mặt với chị à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Nè. Bộ lên hình chị xấu như quỷ lắm hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Chỉ vì cái lỗ tai mà đòi bắn chị thì mày điên thiệt rồi. Không thích chứ gì? Để chị đội nón vô là được!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Cuối cùng cũng được nghỉ ngơi... Không có ai quấy rầy mình được nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: ...Buồn quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Nhà chị có một đứa răng trắng đẹp lắm. Vậy mà nó chả bao giờ cười. Hổng lẽ hông phải do răng ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Chị... thường dùng bàn tay này để che chở con cái, quán xuyến việc nhà, rồi ôm hôn chồng chị. Mà em coi, một lời cám ơn còn hổng có.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Địt mẹ, thật à? Thôi được rồi... nhưng làm nhanh nhanh hộ cái!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Muốn làm cái mẹ gì thì làm. Đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Vàng khè luôn đúng không? Kệ bố nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Răng trắng? Biết sao trắng không? Vệ sinh hằng ngày đó thằng mặt lồn!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Tôi thấy kiểu gì răng mình cũng nát hết cả lũ, nên thôi mạ mẹ một cái cho rồi. Mạ vàng như mấy thằng giang hồ trong phim ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Ừ rồi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Đây nhìn cho sướng con mắt đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Biết bà tôi hay nói gì không? Tay rắn rỏi như này thì nên đi bổ củi... chứ không phải làm mấy việc đâu đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Mà ở đây thì chẳng có củi để bổ, thôi trút giận lên chỗ khác vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Đó nhìn đi, cho nhìn bao lâu cũng được luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Thấy cặp mắt xanh quyến rũ này không? Gái thấy là tự khắc đổ rạp theo hàng. Hà hà!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Thích làm mẹ gì thì làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Ừ tôi cạo lông, thế được chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Chứ để nó mọc thì khó chịu bỏ mẹ ra. Đéo hiểu tạo hóa thiết kế kiểu lồn gì lông mọc dưới nách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Sao rồi thằng mặt lồn?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Nhìn đéo gì mà nhìn? Chụp xong thấy gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Địt mẹ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Nhìn cái gì mà nhìn? Tai tôi dính lẹo à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Mày điên mẹ nó rồi à? Bố mày vừa cho kiểm tra răng đó thây!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Mày tin mày chưa kịp bóp cò đã bị tao đấm bay con mẹ nó hàng tiền đạo trong mồm không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Mày ngáo chó à? Thấy mắt bố mày đẹp nên ghen ăn tức ở hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Đéo hiểu sao lúc nào cũng thấy ngứa vãi lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Gãi đến chảy cả máu mới thấy đỡ ngứa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Mày xàm cái lồn gì thế? Máu dồn hết lên não rồi hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Địt mẹ mày nhìn mấy cái ảnh linh tinh xong đòi bắn tao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Này cầm hàng nóng cho cẩn thận vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Mỗi cái kiểm tra tai thôi mà bắn nhầm người thì chết dở.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Mẹ cái thằng tâm thần trốn trại. Đấy, muốn bắn thì bắn đi con đĩ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Thằng chó đẻ. Mày là thứ khốn nạn không có tình người.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Chết mẹ mày đi con đĩ chó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: Bà tôi có cái răng vàng bóng lộn. Từ bé đến giờ tôi cũng ước có một cái.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Nhìn cứ như kiểu mặt trời tỏa sáng trong miệng vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Bà bảo người ta trồng răng vàng lên mấy cái răng sâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Tôi bèn tự nhủ: "Vãi chưởng, hay phết! Sau này phải thử mới được".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: Rồi sau này cũng đến, mà chả có cái răng mạ vàng nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: Thế là mồm tôi chẳng được tỏa sáng. Nó chỉ thối hoắc, vàng khè như màu nước đái vẩn đục.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Thấy hai bàn tay này không? Bùn đất, máu me đủ các kiểu, nhưng đích thị là tay tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Thi thoảng ngứa tay vãi mà chỉ muốn cào rách da. Không thì đấm vào tường. Có khi làm cả hai luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Tôi không muốn làm hại người khác, nhưng cũng chẳng tài nào kiềm chế nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Thấy mấy ngón tay này không? Bùn đất, máu me đủ các kiểu, nhưng đích thị là tay tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Thi thoảng ngứa tay vãi mà chỉ muốn cào rách da. Không thì đấm vào tường. Có khi làm cả hai luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Gặp người ta thì chắc đã vừa lo vừa sợ vãi cả đái. Nhưng còn tôi thì đéo quan tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Bà tôi toàn gọi tôi là Thiên Thần Bé Bỏng. Tại mắt tôi đẹp á, tin được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: Vậy mà giờ thằng cháu bà đứng một góc, nhìn qua khung cửa sổ bẩn thỉu, trống hoác rồi tự nhẩm: "Đéo hiểu thằng này thì thiên thần nỗi gì"?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Bà tôi mà trông thấy cảnh này... chắc sẽ thất vọng não nề.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Biết gì không, mấy con dao cạo sắc lắm... nhưng đéo dễ dùng chút nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Cạo kiểu đéo gì cũng cứa vào da thịt. Giờ mỗi lần cạo là cảm giác dao không cắt lông, mà cắt vào tâm trí tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Nhưng mà tôi vẫn cạo đó thôi, tại tôi chúa ghét lông mọc lởm chởm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: Tôi còn chả có lấy một tấm ảnh của bà. Tại bà đéo thích chụp ảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Bà bảo mỗi lần chụp là linh hồn sẽ bị giam cầm vĩnh viễn trong bức ảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Má nghe mà cười lăn cười bò. Xong tôi hỏi: "Làm gì có bà ơi, sao bà mê tín thế"?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: Rồi bà đáp lại: "Chừng nào bà chết, cháu hãy nhìn ảnh bà rồi đoán xem bà có lên thiên đường hay không".'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Biết thế đéo nào được. Ảnh không có, mà bà cũng đi mất rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Thỉnh thoảng tôi cứ nắm cái dái tai rồi véo véo, mà chỉ khi thấy rát vãi lồn thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Tôi tưởng đó là triệu chứng lo âu hay gì ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: Rồi tôi mới nhận ra là do tôi muốn xé rách mẹ cái tai, kiểu cho đỡ vướng...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Chẹp, tôi đâu có điên đến mức đấy đâu nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: NHỈ?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Ôi cưng ơi, chị biết năng lượng của em sẽ kháng cự. Nhưng chúng ta cứ làm kiểm tra. Dù gì chị cũng nhìn thấu gan ruột của em thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Nhìn thử đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Vũ trụ trong ta phản chiếu qua đôi mắt, không phải hàm răng. Em có muốn thấy vận mệnh của mình trong đó không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Vũ trụ trong ta phản chiếu qua đôi mắt, không phải hàm răng. Em muốn tìm thấy điều gì ở đó nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Em cứ nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Cơ mà nhẹ nhẹ thôi, tay chị vẫn còn mấy vết dằm lúc làm bùa đuổi bắt giấc mơ ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Mắt chị à? Dĩ nhiên là màu nâu rồi em.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Kệ mấy cái nốt đỏ đó đi. Tại bà chị Hằng Nga mà ra đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ôi chao, vũ trụ đúng là đẻ ra cho chị quá nhiều thử thách... Thôi em cứ nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: Em biết rồi đấy, tình hình như này thì khó mà chăm sóc bản thân chu đáo được...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Cẩn thận. Hào quang của chị chói mù cả mắt đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Sao? Em thấy như nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Cứ kiểm tra, cơ mà cẩn thận. Tai chị nghe thấy tất tần tật, kể cả suy nghĩ của em đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Sao? Em có tìm được đáp án nào không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Em muốn bắn chị chỉ vì bộ nhá ư? Em phải cảm nhận được chị là người chứ? Có gì lạ đâu, Sao Hỏa Sao Kim cãi nhau ỏm tỏi thôi mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Em đùa đó hả? Định bắn chị chỉ vì mấy vết dằm ư? Từ chính chiếc bùa đuổi bắt giấc mơ yêu dấu của chị nữa chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Mày điên rồi hả em?! Có biết bà mụ Hằng Nga đang giở trò thôi không? Lần theo chuyển động bà ấy khó hơn cả lên trời!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Mày điên rồi hả em?! Có biết bà mụ Hằng Nga đang giở trò thôi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Này mà chiêm tinh nỗi gì, thần kinh thì có! Bỏ súng xuống đi em ơi, để chị bật mí cho mày vài bí quyết hay! Chả tốn xu nào!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Nào! Chói quá em không chịu nổi thì đâu phải lỗi của chị đâu cưng!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Em dẹp cây súng đi được không? Soát tai thì nhìn ra cái nỗi gì? Con người ta phải có tai mới nghe được lời hay ý đẹp chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Mày mà bắn chị đi là mày sẽ bị...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: ...tiêu chảy mãn kiếp!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Em biết không, có lần chị gặp một người đàn ông với hàm răng đều tăm tắp.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Chị bảo hắn: "Mọi thứ đều ổn, chỉ có linh hồn anh là mục nát thôi!" Đấy, quan trọng ở đây là cái gì? Em thử nghĩ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Có lần chị dành cả đêm kéo dằm sau khi cử hành nghi thức. Đau khiếp cơ, mà mỗi cái đều là bài học của vũ trụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Đôi mắt là cánh cổng dẫn vào thế giới khác. Chị có gặp một người, mắt hắn rực sáng như lửa đỏ. Bảo là vì yêu, mà thật ra do hắn mạng Hỏa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Em biết không, chị từng sống khổ hạnh suốt ba tuần, chỉ nghĩ về ước mơ của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Suy nghĩ là cách ta gieo ý niệm, biến ước ao thành sự thật. Rồi chị chỉ cần đặt điều ước cho phù hợp là xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Lạ thay, chị lại bất chợt nhớ đến điều đó, ngay tại khoảnh khắc này.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Chị từng được chụp ảnh một lần. Lúc đó chị nghĩ: "Tín hiệu từ các vì sao đã đến!" Rồi chị nhận ra đó chỉ là ánh đèn chớp.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Chị từng nghe được thanh âm... cứ như vũ trụ đang tìm cách trò chuyện với mình. Cơ mà chị nghĩ đấy là huyền cơ gì thâm sâu lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Chị từng nghe được thanh âm... cứ như vũ trụ tìm cách trò chuyện với mình. Hóa ra chỉ là tiếng gió thoảng. Cơ mà cũng vui lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Vâng, anh muốn kiểm tra gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: K-Khoan, từ từ... anh định khám răng em mà kết luận á? Ừ-Ừm thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Chẳng là em mới đi làm răng ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Cơ mà, thú thật thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Em còn chẳng nhớ mình có tới chỗ nha sĩ không nữa. Ủa mình đi khi nào ấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Trời ơi, run lắm rồi, chả nhớ nổi hôm qua có ăn gì chưa luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: A-Anh muốn xem thử móng tay của em hở? Kiểm tra gì lạ quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Mà thôi... Đây anh kiểm đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Bị dính gì vậy nhỉ? Dính đất hả? Vô lý...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: E-Em đâu nhớ mình có đi đào đất hay gì đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Cái đống này chui vào móng tay em bằng đường nào vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Anh muốn kiểm tra mắt em ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Em sợ chết lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Bạn bấm máy chụp một bức)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Tại sao vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Cứ bắn em luôn đi không phải dễ hơn à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Em là người mà? Anh nhỉ? Xin anh đó, nói em là người đi mà! Đi mà anh!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Hớ hớ hớ! Đằng nào cũng rút súng ra thì thôi còn đòi kiểm làm gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Chắc anh thích làm nhục người khác lắm chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Chú muốn kiểm tra cái gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Muốn xem hàm răng tôi à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: OK, vậy nhìn đi. Hít cho đã cái mùi thuốc lá và thảm sầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Vàng vàng, đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Xong rồi thì dẹp mẹ cái trò kiểm tra giùm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Tôi đếch phải Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Mà chúng nó từ đâu tới vậy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Chú bảo móng tay nó dính đất, nhìn phát là biết ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Thế thì rửa tay là xong chứ gì!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: Giờ chẳng lẽ dân làm vườn, cày cuốc thì nghiễm nhiên là Dị Khách à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Xàm chó vừa thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Đây kiểm móng tay tôi đi này.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Rồi sao? Tôi có phải Dị Khách không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Ừ đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: Mỗi ngày lại bày thêm một trò quái đản khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: Lỡ tôi bị thiếu ngủ? Khóc khô mắt thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Riết rồi chả hiểu cái mô tê gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: Rồi giả sử tìm thấy một hay nhiều dấu hiệu, thì khi đó chú tính sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: "Esenin: Tối nay tôi biến cha nó thành \nDị Khách luôn cho rồi."
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Để ngồi nhớ lại quãng đời tươi đẹp rồi khóc cạn nước mắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Hết kiểm tra kiểm triết rồi tới mấy thằng cha áo vàng...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Thật sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: ...Đúng là đời như lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Chú có bao giờ linh cảm là mọi chuyện sẽ đi đến kết cục thảm khốc, kinh hoàng lắm không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Miệng thì bô bô "tất cả đều trong tầm kiểm soát", vậy mà nhìn quanh toàn thấy loạn là loạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Chụp gì thì chụp mẹ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Bạn bấm máy chụp một bức)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Dáng anh ta ngồi điềm tĩnh, không nằm trọn trong khung hình nhưng cũng không có gì bất thường)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Nói chung là tôi sợ, sợ điều gì sẽ xảy đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Vãi cứt, chú giỡn mặt hả? Có bị đần không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: Bộ cái đám Thảm Hại kia làm não chú nhão hết ra rồi à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Hay chú xỉn quắc cần câu rồi? Tưởng nhà này không còn rượu bia gì nặng đô nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: OK, chú thích thì tôi chiều, này thì xem đi nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Vừa lòng chú rồi chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Ngửi cho sướng cái lỗ mũi chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Đội ơn chú đã không đòi thọc đít tôi luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Làm lẹ cho xong giùm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Cái gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Ừm... Thôi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Kiểm xong chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Giờ cho tôi xin chút bình yên với được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Cậu muốn kiểm tay hả...? Chờ chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Tay tôi nó chai sạn hết rồi... Tại phải xách theo một mạng người mà tụi Thảm Họa nhẫn tâm bỏ mặc đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Nè, dẹp luôn cái trò nhảm lồn này đi được chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Muốn bắn thì bắn đại đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: Tôi cũng chả còn sức nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Cậu muốn tìm cái gì? Xem coi mắt tôi có đỏ không à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Cần thì kiểm đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Giờ mà có cảm xúc thì bị coi là Dị Khách hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Tôi nói thẳng với cậu nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Ờ. Sao hông bắn tôi luôn đi cho rồi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Giờ ở cái xã hội này con người có còn được khóc không? Chứ cười là bị cấm luôn rồi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Mày điên hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Nói tao nghe, MÀY BỊ ĐIÊN RỒI PHẢI KHÔNG?!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: Giờ giả sử mấy con quỷ kia có xúi mày nhảy lầu, chắc mày cũng xung phong đi đầu luôn chứ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Mày... Đụ m– Tao muốn cạn lời với mày luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: Giờ sao? Sẵn tiện thì rút súng ra luôn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Tổ cha mày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Thôi bắn tao giùm luôn. Tụi Thảm Họa đã bóp chết linh hồn tao rồi. Mày xử nốt luôn đi cho xong.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Chú em muốn kiểm tra gì nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Mày bị điên à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Má, chó rách ăn c...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Ê cái lồn gì vậy, bờ-rô? Anh mày là nam nhi bình thường mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Đàn ông con trai làm đéo gì có chăm với giũa móng đâu, nhìn nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Chú muốn kiểm tra gì á?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Răng hở? Chú muốn xem răng con á?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Chi dị chú? Con còn mấy cái răng sữa nè. Ba con nói dị đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Giờ con hông khóc nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Đó, đây nè chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Vậy tức là sao ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Bình thường mà chú ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: Giờ con biết tự cắt móng tay òi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Nhưng mà cắt còn hơi lem nhem...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Đây. Chú coi nè!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Cũng gọn gàng ghê chú ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Con tự cắt hết luôn đó. Hổng cần nhờ ai. Chỉ có... mình con.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Hoi con đi đây. Giờ con muốn ở một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: Chú tính nhìn vô mắt con coi có gì trong trỏng hông hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Hổng biết chú có đọc được suy nghĩ của con luôn hong ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Nếu mà được thiệt, thì con sẽ ráng suy nghĩ cho thiệt kỹ nè, chú khỏi lo ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Con m-m-muốn uống g-gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: Ừm... Dị giờ con phải làm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Mắt nhìn cô bé, bạn chợt nhận ra hành vi này đi quá xa rồi)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Chú muốn coi con như nào hoi hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Giờ con mệt lắm òi. Cho con tự chơi một mình được chưa chú?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Chụp một bức hở?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: Đó giờ con cũng ít khi chụp ảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Chụp xong chú cho con coi với nha?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Bạn bấm máy chụp một bức)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (Bức hình trông có hơi nhòe một chút)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Bé chưa đợi chụp xong thì đã háo hức phi thẳng tới chỗ bạn)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Hừmmm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: ...Mơn chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Thôi con hổng thích đâu. Đừng có kêu con chụp nữa à nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: Ừ, cháu cứ nhìn thoải mái đi rồi kiểm tra. Toàn mấy thứ bình thường như cân đường, hộp sữa thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Cháu muốn xem răng ngoại à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: Aaaaaaa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Răng người già ấy mà... Giời ạ, hồi đó ngoại chẳng ưa gì cái bộ hàm này đâu. Chỉ muốn nhổ sạch từng cái răng cho bõ ghét.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Nhìn ngón tay ngoại đi. Chẳng dùng để cân, đo, đong, đếm cho chuẩn được nữa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Nhưng vẫn đủ để ngoại sống thoi thóp qua ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Ôi cháu à... Cháu chắc chưa đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Đôi mắt là cửa sổ tâm hồn. Cửa sổ soi sáng căn nhà, soi tỏ sự thật ẩn trong con người ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Nhưng nhà của ngoại cũ nát rồi... Kính thì vỡ... Rèm cửa thì bị lũ ngài ngấu nghiến nát bươm...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Đừng nhìn vào đấy làm gì, cháu à. Chẳng có gì trong đó đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Giời ạ! Ai đời lại bắt bà già giơ cánh tay lên... Mày không thấy xấu hổ hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Mà thôi, ngoại là khách, sao dám cãi. Chủ nhà muốn gì cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: Sao hả cháu giai?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Chụp bà già phí cả phim ra cháu ạ. Phim đã hiếm thì chớ... Nhất định phải chụp à? Đấy, chụp đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: ...Thấy sao hả cháu?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: Hừ! Cháu muốn vậy chứ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Tai ngoại bình thường như bao người khác. Vẫn còn nghe được. Cơ mà... đôi lúc ngoại thấy mình có vẻ cũng lãng lãng xa xăm rồi cháu ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: Như thể người ta chỉ nhòm được ngoại qua cửa sổ trời thôi. Mà nhiều lúc còn chẳng thấy gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Nào cháu... sao lại chĩa cái thứ già khọm đó vào mặt ngoại vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Ngoại nhăn nheo gần đất xa giời rồi, mà mày còn muốn ngoại rụng hết răng về nơi chín suối à!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Mày tưởng ngoại sợ hả con giai? Sợ mất đôi tay già cỗi này cơ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Biết bao lần tay ngoại chỉ bấu víu lấy khoảng không. Đến nỗi mấy ngón tay cũng thừa biết nó chẳng níu giữ được điều gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Hóa ra đời ngoại chỉ có vậy thôi sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Cháu không tin ngoại à? Muốn kiểm tra à? Đây, cháu nhìn cho rõ nhé...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Hồi ấy ngoại cũng hay nhìn sâu vào mắt người ta lắm. Ôi những tháng ngày xưa cũ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Kìa, minh chứng của tuổi già mà cháu. Ai may phước thọ được đến tầm này đều được ban cho một bầy lúc nhúc. Cháu không biết sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: Nấm này có biết đau là gì đâu. Cũng chẳng đòi ăn đòi uống. Nó cứ mọc ở đấy thôi. Giống như ngoại vậy, hè hè hè.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Ôi chà, cháu chụp được tấm ảnh xong là chụp mũ ngay, rồi bảo ngoại là Dị Khách à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Sao vậy cháu? Nhìn tai ngoại xong là biết được gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: Giời ạ... ngoại chả quan tâm. Còn gì nữa đâu hả cháu. Ngoại muốn khuất núi từ lâu lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: Chỉ là...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Ngoại đi nha sĩ, bảo người ta nhổ hết răng cho rảnh nợ, cơ mà không nhổ một phát cả hàm được.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Mỗi buổi đến đấy chỉ được nhổ có một hai cái... Chưa kịp làm nốt cho xong. Giờ thì còn nha sĩ nào làm việc nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Đấy, thế là trong mồm ngoại bây giờ còn sót vài cái răng lưa thưa. Cục nợ này ngoại mang xuống mồ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Tay mình là để người ta nắm. Mà lâu lắm rồi ngoại chẳng còn được nắm tay ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Bảo ngoại chìa tay ra hả? Giời ạ! Sao cháu không tự đi mà cầm lấy tay ngoại?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: Tới túp lều của kẻ sáu ngón giả dối... Bước chân vào cái lồng chim nhỏ hẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Cháu nghĩ mình là ai mà thoát được số phận? Đứa nào chết sớm thì may ra. Mà nói thế thôi, mày đừng làm chuyện dại dột nhá!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: Mặt mũi xinh giai đáng yêu thế này! Mất đi thì tiếc lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: Hồi ngoại còn trẻ, chỉ bọn nhà giàu mới có mấy món đồ nghề xịn như thế. Mà giờ thì nhan nhản!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Ngoại chán chả muốn nói nữa! Mày toàn giở trò mèo với ngoại. Người đây ngay thẳng mà cứ bị làm phiền... Giời ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733828
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733829
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733830
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733831
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733832
    m_Localized: 'Mother: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733836
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733837
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733838
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733839
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733840
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752330928128
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752335122433
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752335122434
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752335122435
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341250
    m_Localized: 'Theorist: Cứ tự nhiên. Cơ mà tôi cảnh báo... Kiểm tra tôi mà phát hiện ra sự thật kinh hoàng gì thì hối cũng không kịp đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341251
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341252
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341253
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341254
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341255
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341256
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341257
    m_Localized: 'Theorist: Đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341258
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341259
    m_Localized: 'Theorist: Tôi có tật xấu là cắn bút chì ấy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341260
    m_Localized: 'Theorist: Cắn đến nứt răng chảy máu... Ừ thì biết là hại, nhưng thói quen khó bỏ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341261
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341262
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341263
    m_Localized: 'Theorist: Được thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341264
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341265
    m_Localized: 'Theorist: Chú thấy vết mực này không? Nó dính vào móng tay, da thịt, ngấm sâu vào từng lỗ chân lông. Cái giá phải trả để đổi lấy tri thức đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341266
    m_Localized: 'Theorist: Chú thấy vết mực này không? Nó dính vào móng tay, da thịt, ngấm sâu vào từng lỗ chân lông. Ấy là dấu vết của tri thức... Là cái giá tôi phải trả.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341267
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341268
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341269
    m_Localized: 'Theorist: À ừ, kiểm tra mắt nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341270
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341271
    m_Localized: 'Theorist: Mắt tôi còn xanh. Thế là ổn rồi. Tôi vẫn chưa bị bọn nó biến đổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341272
    m_Localized: 'Theorist: Khi truy tìm sự thật, mắt phải mở thật to, nhìn cho thật rõ, kẻo con mắt lại đánh lừa chính mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341273
    m_Localized: 'Theorist: Đôi mắt tôi nhìn thấu bản chất của thế giới này, không mờ ảo, không chút pha tạp. Còn chú thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341274
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341275
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341276
    m_Localized: 'Theorist: Nách hả? Cái này... mới lạ đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341277
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341278
    m_Localized: 'Theorist: Lớp lông này là hàng rào chắn tự nhiên đấy. Vừa có tác dụng làm chậm quá trình bay hơi, vừa giữ lại chất điện giải.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341279
    m_Localized: 'Theorist: Cạo bỏ lông nách chỉ tổ giúp tuyến mồ hôi làm chủ mình, khiến cho cơ thể càng dễ bị tổn thương.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341280
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341281
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341282
    m_Localized: 'Theorist: Chụp hình à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341283
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341284
    m_Localized: 'Theorist: Đừng có tin ảnh chụp. Thời đại này ảnh dễ bị cắt ghép, xóa bỏ lắm. Chỉ duy nhất khoảnh khắc này... là không máy móc nào có thể can thiệp được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341285
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341286
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341287
    m_Localized: 'Theorist: Tai hả? Rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341288
    m_Localized: 'Theorist: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341289
    m_Localized: 'Theorist: Vậy là chú cũng biết lựa tin mà nghe đấy. Trên TV tràn lan tin giả, có đúng tin này là chuẩn thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341290
    m_Localized: 'Theorist: Tìm dấu hiệu à? Lo gì, tôi có biện pháp bảo vệ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341291
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341292
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341293
    m_Localized: 'Theorist: Ừ thì bắn đi. Nhưng nhớ coi chừng mấy thứ thực phẩm chức năng. Bọn nó tẩy não người bằng đồ ăn đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341294
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341295
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341296
    m_Localized: 'Theorist: Chú e sợ những kẻ muốn truy tìm chân lý à? Thế thì đâu phải sợ tôi... Chú sợ chính mình ấy chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341297
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341298
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341299
    m_Localized: 'Theorist: Lẽ ra chú phải ngộ ra rằng, vũ khí cũng chỉ là công cụ để con người kiểm soát nhau chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341300
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341301
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341302
    m_Localized: 'Theorist: Giơ tay lên ư? Chú đã bao giờ ngẫm xem tại sao ở mọi nền văn hóa, giơ tay đều có nghĩa là đầu hàng chưa? Ai đặt ra quy chuẩn này vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341303
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341304
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341305
    m_Localized: 'Theorist: Chú muốn xóa sổ bức ảnh này ư? Hay là người trong ảnh? Thử nghĩ xem ai đang xui khiến chú phải làm vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341306
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341307
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341308
    m_Localized: 'Theorist: Bắn tôi rồi nghe tiếng súng vang cũng là một cách nhận biết hay... nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341309
    m_Localized: 'Theorist: ...Sao chú không ngắm vào Dị Khách ấy. Tần số âm thanh đảm bảo khác hẳn luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341310
    m_Localized: 'Theorist: Chú muốn bịt miệng tôi hả? Chú nghĩ như vậy sẽ dễ dàng hơn sao? Sự im lặng cũng là một chiêu trò để chúng nó kiểm soát ta đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341311
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341312
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341313
    m_Localized: 'Theorist: Tôi biết ở một số nước, người ta còn giấu ăng-ten mini bên trong vật liệu trám răng. Thật luôn đó, không tin chú tìm hiểu mà xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341314
    m_Localized: 'Theorist: Đem soi dưới kính hiển vi, ta sẽ thấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341315
    m_Localized: 'Theorist: ...Dấu vết của Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341316
    m_Localized: 'Theorist: Có người bảo tôi "Nếu cứ ôm khư khư sự thật, coi chừng có kẻ tới lấy". Nhưng tôi không buông tay đâu! Phải giữ thật kỹ đến phút giây cuối cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341317
    m_Localized: 'Theorist: Cứ nghiền ngẫm soi vào thật lâu, rồi sự thật sẽ phản chiếu lại. Thấy nó hiện rõ trong mắt tôi chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341318
    m_Localized: 'Theorist: Người ta hay sợ mùi hôi, nhưng đó mới là trạng thái tự nhiên. Mùi hương nhân tạo cũng là cách để chúng nó kiểm soát ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341319
    m_Localized: 'Theorist: Chúng làm ta phân tâm. Tìm cách giấu nhẹm sự thật. Đã là hiện thực ắt phải bốc mùi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341320
    m_Localized: 'Theorist: Ảnh chụp là bến bờ, neo đậu ta về chốn hiện thực. Là minh chứng rằng ta tồn tại, ta hiện hữu. Chính vì vậy nên chúng mới nguy hiểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341321
    m_Localized: 'Theorist: Chúng nó điều khiển ta bằng âm thanh, tần số, sóng hạ âm... Đó là cách chúng thao túng tâm trí ta. Ta phải cắt bỏ tiếng ồn nhiễu loạn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341322
    m_Localized: 'Theorist: Kể cả tôi có chết đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341323
    m_Localized: 'Theorist: ...Thì sự thật vẫn luôn còn mãi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341399
    m_Localized: 'Raskolnikov: Ui, dạ, được thôi. Anh muốn kiểm tra, em hiểu mà. T-Thấy anh kỹ tính như rứa cũng ngầu đó chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341400
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341401
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341402
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341403
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341404
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341405
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341406
    m_Localized: 'Raskolnikov: Răng á? À dạ, đây nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341407
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341408
    m_Localized: 'Raskolnikov: U là trời... Anh đừng hiểu lầm nha, em hổng phải như "tụi nó" mô. Kiểu... tại em cũng ít khi quan tâm tới ngoại hình của mình thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341409
    m_Localized: 'Raskolnikov: U là trời... Anh đừng hiểu lầm nha, em hổng phải kiểu tự kiêu hay ái kỷ mô. Tại... em hay quan tâm tút tát cho ngoại hình của mình thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341410
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341411
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341412
    m_Localized: 'Raskolnikov: À... dạ. Anh cứ kiểm tra thoải mái đi. Đây nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341413
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341414
    m_Localized: 'Raskolnikov: Dạ... em cũng biết là nhìn nó gớm lắm. H-Hồi trước em toàn giấu nhẹm đi thôi... mà chừ có giấu cũng hổng để chi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341415
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341416
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341417
    m_Localized: 'Raskolnikov: Ừa thì... suốt ngày em toàn phải chạy với trốn, thời gian mô mà phá mấy cái tay này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341418
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341419
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341420
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341421
    m_Localized: 'Raskolnikov: Anh... đừng có sợ nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341422
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341423
    m_Localized: 'Raskolnikov: E-Em hổng có khóc nhè mô! Tại dạo này em kiểu, mất ngủ, ngủ hông ngon thui à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341424
    m_Localized: 'Raskolnikov: Hồi xưa mắt em loạn xì ngầu, nhạy lắm anh ơi, cứ như con chuột nhắt tìm đường thoát bẫy... Mà chừ tụi nó chỉ biết mỏi mệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341425
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341426
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341427
    m_Localized: 'Raskolnikov: U là trời... C-Có cần thiết phải rứa hông ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341428
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341429
    m_Localized: 'Raskolnikov: Đó anh, bình thường mà đúng hông? Em ít khi ra mồ hôi lém... Chắc tại em sợ quá, hổng dám tỏa ra mùi chi để người ta đánh hơi được luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341430
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341431
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341432
    m_Localized: 'Raskolnikov: Anh muốn chụp hình em á?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341433
    m_Localized: 'Raskolnikov: Ờm, kiểu, em xin từ chối được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341434
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341435
    m_Localized: 'Raskolnikov: Ý trời ơi, đừng có chĩa súng vô mặt em mà! Thôi thôi được rồi, em nghe, anh cứ chụp đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341436
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341437
    m_Localized: 'Raskolnikov: A-Anh lựa góc mô cho đẹp nha. Hông thì cũng đừng... lấy góc hèn quá hay xí quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341438
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341439
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341440
    m_Localized: 'Raskolnikov: D-Dạ oke... Nhưng răng mà lại kiểm tra tai rứa? Anh đừng có mong tìm được cái chi... ghê quá nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341441
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341442
    m_Localized: 'Raskolnikov: C-Chuyện chi trên đời em cũng nghe lọt hết... kể cả những chuyện hông nên luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341443
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341444
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341445
    m_Localized: 'Raskolnikov: U là trời, quỷ thần ơi... E-Em hổng ngờ anh chiến dữ rứa luôn á.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341446
    m_Localized: 'Raskolnikov: M-Mà chắc phải mạnh tay rứa mới được... Thà giết nhầm còn hơn bỏ sót...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341447
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341448
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341449
    m_Localized: 'Raskolnikov: A-Anh thấy tay của em nguy hiểm lắm hay sao ạ? ...Em thì thấy nó thảm hại quá chừng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341450
    m_Localized: 'Raskolnikov: Thôi anh cứ bắn đi. Đại luôn đi. Em cũng chả còn chi để mà níu kéo nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341451
    m_Localized: 'Raskolnikov: K-Khoan anh ơi! E-Em...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341452
    m_Localized: 'Raskolnikov: ...Em xin lỗi. Đôi tay này chưa làm nên trò trống chi, chưa giúp đỡ được ai hết... E-Em đáng bị rứa lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341453
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341454
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341455
    m_Localized: 'Raskolnikov: ...Dạo này em chả mấy khi chợp mắt nữa. Anh soi xong là thấy mà ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341456
    m_Localized: 'Raskolnikov: N-Nên là... anh giúp em được hông á?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341457
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341458
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341459
    m_Localized: 'Raskolnikov: Em hổng phải người dễ sợ chi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341460
    m_Localized: 'Raskolnikov: N-Nhưng hổng có ai lại bình chân như vại được khi bị, bị súng chĩa vô mặt hết, anh à!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341461
    m_Localized: 'Raskolnikov: Rồi sẽ có ngày, anh gặp trúng kẻ... vừa to xác, vừa xấu tính. Tới lúc đó... đời mình coi như tàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341462
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341463
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341464
    m_Localized: 'Raskolnikov: U là trời... B-Bộ anh... phát hiện thấy cái chi bất thường trong hình chụp hở...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341465
    m_Localized: 'Raskolnikov: Đ-Đã rứa thì... thôi anh cứ bóp cò luôn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341466
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341467
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341468
    m_Localized: 'Raskolnikov: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341469
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341470
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341471
    m_Localized: 'Raskolnikov: Hồi còn đi học, em rén mấy ông nha sĩ lắm. Sợ tới nỗi người run cầm cập, mồ hôi mồ kê lạnh toát.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341472
    m_Localized: 'Raskolnikov: Rồi một ngày nớ, có thằng nhóc xấu tính nó đấm gãy răng em... A-Anh biết lúc đó em làm chi hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341473
    m_Localized: 'Raskolnikov: Hổng chi hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341474
    m_Localized: 'Raskolnikov: Em hổng làm chi hết trơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341475
    m_Localized: 'Raskolnikov: Em... còn hổng dám đánh trả, để tự bảo vệ bản thân. Em hèn quá, sợ mà run như cầy sấy luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341476
    m_Localized: 'Raskolnikov: Nên em mới suy nghĩ kiểu, mình đã yếu như sên rồi, chi bằng ráng bù đắp bằng cách chăm chút bản thân cho thiệt đẹp...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341477
    m_Localized: 'Raskolnikov: Em cố gắng giữ răng sạch bong, làm như đó là áo giáp của em vậy. Như thể giá trị con người em đặt hết vô trỏng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341478
    m_Localized: 'Raskolnikov: Nghe dở hơi thiệt anh ha. Biết rứa mình dành thời gian học cái khác, có phải hơn hông...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341479
    m_Localized: 'Raskolnikov: Cứ mỗi khi em đứng hình... hay để mất cơ hội đánh trả... Em lại đấm phát vô tường. Đấm hoài, đấm hoài, tới khi khớp tay tóe máu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341480
    m_Localized: 'Raskolnikov: Như kiểu, làm rứa thì sẽ đánh bay được cái yếu hèn ra khỏi người em... Thì em sẽ cứng cáp hơn, nếu cứ tự trừng phạt bản thân.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341481
    m_Localized: 'Raskolnikov: ...Rốt cuộc khỏe hơn không hổng thấy, chỉ thấy đất cát chui hết vô móng tay, đâm ra nhiễm trùng thấy ớn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341482
    m_Localized: 'Raskolnikov: Thôi thì, em cũng đáng bị rứa mà. Em chả hơn chi tụi nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341483
    m_Localized: 'Raskolnikov: Hồi trước... em toàn nắm chặt bàn tay, tới khi khớp tay trắng hếu. Như kiểu mình mà kiểm soát được dây thần kinh, thì dư sức đập tan nỗi sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341484
    m_Localized: 'Raskolnikov: Rứa mà chừ em chỉ giấu hai tay đi. Kiểu để... không ai thấy được em đang run cầm cập.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341485
    m_Localized: 'Raskolnikov: T-Tự nhiên em nhớ lại, cái ông điên trong hẻm nớ... Ổng cũng nhìn em như cách anh nhìn em bây chừ. Kiểu như soi thấu tâm can em á.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341486
    m_Localized: 'Raskolnikov: Rồi em lại nghĩ... Phải chi mà hồi đi học mình có được ánh mắt như rứa, ch-chắc tụi nó đã hổng dám ăn hiếp mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341487
    m_Localized: 'Raskolnikov: Có khi em đã dám đứng lên, tự bảo vệ bản thân...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341488
    m_Localized: 'Raskolnikov: U là trời... E-Em xin lỗi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341489
    m_Localized: 'Raskolnikov: ...Chắc anh hổng muốn nghe em càm ràm mô.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341490
    m_Localized: 'Raskolnikov: H-Hồi xưa á, em chỉ ước mong được làm người bình thường. Để hông bị ai chú ý, ngó ngàng. Hông có mùi kỳ kỳ, hông làm trò dại dột.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341491
    m_Localized: 'Raskolnikov: M-Mà kiểu, tới chừ em mới hiểu... Mình mà tàng hình thì kiểu chi cũng bị xơi tái đầu tiên. Nên em... muốn trở thành người khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341492
    m_Localized: 'Raskolnikov: U là trời... Cảm giác khuôn mặt của mình được lưu lại chỗ mô đó, nó kỳ thiệt. Hả? Hào quang? Rứa anh... thấy được bản chất của em á...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341493
    m_Localized: 'Raskolnikov: Nói em nghe, e-em có còn cơ hội chi để tốt lên hông? Mạnh mẽ hơn hông? Liệu em là Dị Khách, hay suốt đời chỉ mãi là kẻ yếu hèn...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341494
    m_Localized: 'Raskolnikov: Có lần em nghe một ông nói, tất cả chúng ta đều là "phi nhân loại", tức là hổng phải con người. Làm em suy nghĩ mãi. Biết mô... ổng nói đúng?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341495
    m_Localized: 'Raskolnikov: Có khi em hổng phải người hay Dị Khách. Mà là một thứ chi đó... bất toàn. X-Xin anh cho em cơ hội để hoàn thiện, còn không thì... giết em luôn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341496
    m_Localized: 'Raskolnikov: Coi bộ kiếp này, mình chỉ cứ yên phận...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341497
    m_Localized: 'Raskolnikov: ...làm con mồi mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341498
    m_Localized: 'Nun: Có vẻ không chỉ mình Đức Chúa muốn thử thách ta...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341499
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341500
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341501
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341502
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341503
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341505
    m_Localized: 'Nun: Hừ, tùy con đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341506
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341507
    m_Localized: 'Nun: Chớ có hãi sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341509
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341511
    m_Localized: 'Nun: Kiểm cho nhanh đi nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341512
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341514
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341516
    m_Localized: 'Nun: Nào, làm đi. Mau lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341517
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341520
    m_Localized: "Nun: Con làm sao biết được ta đã tận mắt chứng kiến những thứ tội lỗi \nđáng khinh đến nhường nào!"
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341521
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341523
    m_Localized: 'Nun: Lạy Chúa! Nhà ngươi mất trí rồi hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341524
    m_Localized: 'Nun: Nghĩ mà hãi hùng! Ngươi nỡ ép một bà lão ốm yếu phải nâng cánh tay lên, rồi để lộ thân thể mình trước một kẻ như... ngươi sao!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341525
    m_Localized: 'Nun: Tuyệt đối không được!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341526
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341527
    m_Localized: 'Nun: Đồ vô liêm sỉ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341528
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341529
    m_Localized: 'Nun: ...Xem ra ngươi chẳng muốn để ta yên đâu nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341530
    m_Localized: "Nun: Thôi vậy... Nếu như đây là ý của \nĐức Cha, thì cứ làm đi."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341531
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341532
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341534
    m_Localized: 'Nun: Chụp ảnh ư? Hừ! Có mỗi thứ vớ vẩn ấy mà phải phiền đến ta à!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341535
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341536
    m_Localized: 'Nun: Ngươi thực sự tin rằng chân lý sẽ hiển lộ thông qua mấy tấm ảnh này ư? Lạy Chúa... Đám bồ câu ta nuôi ở tu viện còn sáng suốt hơn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341537
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341539
    m_Localized: 'Nun: Muốn kiểm tra tai ta à?! Sao ngươi dám!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341540
    m_Localized: 'Nun: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341541
    m_Localized: 'Nun: Ta chẳng phải hạng trâu bò để ngươi muốn làm gì thì làm đâu nhé!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341542
    m_Localized: 'Nun: Vậy là ngươi đã mất hết liêm sỉ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341543
    m_Localized: 'Nun: Không biết hổ thẹn hay sao mà lại đi đe dọa một bà lão tội nghiệp như ta?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341544
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341545
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341547
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341550
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341553
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341557
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341561
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341579
    m_Localized: 'Fugitive: Cậu cứ thoải mái. Tôi chẳng có gì để giấu... mỗi cái số kiếp ẩm ương vãi cả đái thôi. Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535552
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535553
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535554
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535555
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535556
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535557
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535558
    m_Localized: 'Fugitive: Được, nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535559
    m_Localized: 'Fugive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535560
    m_Localized: 'Fugitive: Cười xấu như ma đúng không? Lũ chó áo vàng đó chỉ có đánh người chứ làm gì cho người đánh răng. Ừ đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535561
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535562
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535563
    m_Localized: 'Fugitive: Cứ thoải mái. Tay tôi cũng tàn tạ lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535628
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535629
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535630
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535631
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535632
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535633
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535634
    m_Localized: 'Bestson: Ơ... Bộ tệ dữ vậy luôn hả anh? Dạ... Ừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535635
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535636
    m_Localized: 'Bestson: Ba mẹ lúc nào cũng nói em, ờm... có gen tốt đồ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535638
    m_Localized: 'Bestson: Đó giờ em cũng hông quan tâm vụ này cho lắm... Từ hồi em còn nhỏ xíu, mẹ vẫn hay nhắc em nhớ đánh răng trước khi đi ngủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535639
    m_Localized: 'Bestson: Nhưng giờ hổng có mẹ thì... em cứ quên hoài luôn. Thỉnh thoảng em bò lên giường rồi nằm nhắm mắt lại, cầu mong họ sớm quay về...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535640
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535641
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535642
    m_Localized: 'Bestson: À... Dạ đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535643
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535644
    m_Localized: 'Bestson: Tay em bình thường mà. Ờm, đó là em thấy vậy. Chắc thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535645
    m_Localized: 'Bestson: Lâu nay em có quan tâm tay nó phải nhìn như nào đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535646
    m_Localized: 'Bestson: Em chỉ biết là nó... nằm đó thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535649
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535650
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535651
    m_Localized: 'Bestson: Ủa? Mắt em thì sao á?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535652
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535653
    m_Localized: 'Bestson: Mắt xanh lục. Này là bình thường... mà ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535655
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535656
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535657
    m_Localized: 'Bestson: Ờm... Dạ thì đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535658
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535659
    m_Localized: 'Bestson: Trước giờ em chưa từng cạo lông nách gì hết trơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535660
    m_Localized: 'Bestson: Tại ba mẹ hổng có nhắc em làm, nên là... em cũng chả quan tâm luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535661
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535662
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535663
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535665
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535666
    m_Localized: 'Bestson: Tấm hình này nhìn lạ thật sự. Bộ anh chụp bằng camera đặc biệt gì đó hay sao á?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535667
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535668
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535669
    m_Localized: 'Bestson: Hở? À ừm... dạ đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535670
    m_Localized: 'Bestson: …'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535671
    m_Localized: 'Bestson: Em còn hổng biết anh đang tìm cái gì luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535672
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535673
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535674
    m_Localized: 'Bestson: Ê nha anh... Thôi mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535677
    m_Localized: 'Bestson: Nhưng chắc hông phải dấu hiệu đang bị gì đó... đâu ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535678
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535679
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535680
    m_Localized: 'Bestson: Thôi mà, có gì đâu... Cái này bình thường hết mà anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535681
    m_Localized: 'Bestson: Từ từ bình tĩnh anh... Em là người mà! Chỉ tại em hơi... lo lắng thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535682
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535683
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535684
    m_Localized: 'Bestson: Khoan! Tại... Tại em lo quá thôi mà, chứ có gì đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535685
    m_Localized: 'Bestson: Khoan! Tại em bị mất ngủ thôi mà, chứ có gì đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535686
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535687
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535688
    m_Localized: 'Bestson: Thôi đi nha... Đừng nói là anh tính làm thật nhá?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535689
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535690
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535691
    m_Localized: 'Bestson: Đừng mà... em lạy anh đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535692
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535693
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535694
    m_Localized: 'Bestson: Từ từ... Bộ cái này quan trọng dữ vậy luôn hả anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535695
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535696
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535697
    m_Localized: 'Bestson: Mẹ còn giỡn là em hút hết canxi của mẹ nữa. Kiểu, từ cái lúc mẹ còn cho em bú á.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535698
    m_Localized: 'Bestson: Nên tại em mà răng mẹ mới xấu đi như vậy, còn răng em thì... lại trắng đẹp phết! À, trừ cái nướu ra thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535699
    m_Localized: 'Bestson: Có khi ba mẹ em mà ở đây thì chuyện đã khác rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535700
    m_Localized: 'Bestson: Hai người sẽ nhắc nhở em, rồi bắt em chăm sóc bản thân đồ... Nếu vậy thì em đã chẳng bỏ bê mình tới nước này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535701
    m_Localized: 'Bestson: ...Nhưng ba mẹ đi mất rồi còn đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535702
    m_Localized: 'Bestson: Bỏ lại mình em... chỉ một đứa như em.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535703
    m_Localized: 'Bestson: Có những lúc em nhìn tay mình rồi ngẫm lại... Mẹ từng nói là em thừa hưởng ngón tay của mẹ, vừa dài vừa thon.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535735
    m_Localized: 'Bestson: Cho con xin lỗi, mẹ ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535736
    m_Localized: 'Buddy: Kiểm tra hả? Ờ, cứ thoải mái đi bạn tui ơi. Tui hổng giấu gì anh đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535737
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535738
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535739
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535740
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535741
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535742
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535743
    m_Localized: 'Buddy: Đây, dòm đi nè...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535745
    m_Localized: 'Buddy: Thấy chưa? Nửa hàm thì trắng bóc, ngay hàng thẳng lối. Nửa còn lại thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535746
    m_Localized: 'Buddy: Rơi rụng bớt mấy cái rồi, hề hề.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535747
    m_Localized: 'Buddy: Thôi biết sao được... Đời là dị đó bạn ơi, được cái này thì mất cái kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535748
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535749
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535750
    m_Localized: 'Buddy: Đây, anh dòm đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535751
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535752
    m_Localized: 'Buddy: Vừa to bự, vừa chắc khỏe hen? Tay này sinh ra là để nặn bánh với xây nhà đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535753
    m_Localized: 'Buddy: Dị mà đời đẩy đưa sao, giờ tui toàn đi bật nắp bia rượu với đập phá đồ. Đúng là đâu ai biết trước được chữ ngờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535754
    m_Localized: 'Buddy: Dị mà đời đẩy đưa sao, giờ tui toàn đi bật nắp bia rượu. Đúng là đâu ai biết trước được chữ ngờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535755
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535756
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535757
    m_Localized: 'Buddy: Ô kê anh bạn, dòm đi nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535758
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535759
    m_Localized: 'Buddy: Mắt nâu soi tỏ đêm thâu. Siêu đại trà luôn anh bạn. Thế giới chắc cũng phải hơn nửa số người là có màu mắt này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535760
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535761
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535762
    m_Localized: 'Buddy: Úi... Anh bạn chắc chưa đó? Thôi muốn coi thì coi đi nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535763
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535764
    m_Localized: 'Buddy: Có gì đáng dòm đâu hen. Lông vừa dày vừa rậm, lại còn nuôi cả rừng nấm. Chắc tại tui hay ôm chó cưng ngủ chung ý mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535765
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535766
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535767
    m_Localized: 'Buddy: À rồi, chụp tấm làm kỷ niệm cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535768
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535769
    m_Localized: 'Buddy: Thiệt ra đó giờ tui ít khi chụp hình lắm. Kiểu hông quen ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535770
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535771
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535772
    m_Localized: 'Buddy: Đây nha... tai người bình thường thui, hông đẹp cũng hổng xấu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535773
    m_Localized: 'Buddy: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535774
    m_Localized: 'Buddy: Đó có gì lạ đâu hen? Mà anh thích thì rờ thử thoải mái.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535775
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535776
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535777
    m_Localized: 'Buddy: Úi kìa anh bạn, tại răng tui bị làm sao hở...? Nói nghe anh đừng nóng chớ, ai lại đi giết người chỉ vì ba cái răng lợi này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535778
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535779
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535780
    m_Localized: 'Buddy: Anh bạn biết hông... Tui tâm niệm là có điều chờ đợi mình sau khi chớt. Biết đâu lúc sang thế giới bên kia, tui sẽ được đoàn tụ với cục vàng của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535781
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535782
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535783
    m_Localized: 'Buddy: Ê nha, bình tĩnh... Anh bạn thông cảm, tui vừa mới mất đi người bạn trân quý trên đời mà. Mắt tui có đỏ hoe cũng là chiện thường thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535784
    m_Localized: 'Buddy: Có dị thôi mà anh muốn bắn chớt tui hả? Chỉ tại tui biết khóc, tại tui sống tình cảm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535785
    m_Localized: 'Buddy: Thôi thì nếu đã phải bắn... Anh làm ơn né cái mắt tui ra nha? Đi mà anh bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535786
    m_Localized: 'Buddy: Tui chỉ muốn được chứng kiến gì đó đẹp đẽ trong giây phút cuối đời mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535787
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535788
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535789
    m_Localized: 'Buddy: Ờ thì tui cũng muốn đi khám lắm chớ... Nhưng giờ này còn khám làm gì nữa hả anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535791
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535792
    m_Localized: 'Buddy: Đâu, chụp xong có gì cho tui coi với. Chắc hổng tới nỗi nào đâu ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535793
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535794
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535795
    m_Localized: 'Buddy: Anh bạn cù nhây với tui đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535796
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535797
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535798
    m_Localized: 'Buddy: Hồi trước tui đi khám răng á, có ông nha sĩ kêu là răng tui đẹp như vầy nên đi đóng quảng cáo, hông thì uổng phí.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535799
    m_Localized: 'Buddy: Cái rồi trời xui đất khiến kiểu gì mà đúng tối hôm đó, tui bị người ta đấm sái quai hàm luôn. Tại tui nhe răng cười thôi á, má nó hài.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535800
    m_Localized: 'Buddy: Tui còn chưa kiếm chiện gì với người ta nữa. Chẳng qua tui lỡ cười hông đúng lúc đúng chỗ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535801
    m_Localized: 'Buddy: Nhớ hồi cục cưng của tui còn sống... tui vẫn hay ôm nựng nó bằng chính đôi bàn tay này. Lông nó mềm ơi là mềm, rờ đã ơi là đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535802
    m_Localized: 'Buddy: Tui nhớ nó dữ lắm anh bạn à. Anh hông hiểu được đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535803
    m_Localized: 'Buddy: Xưa ngoại tui vẫn hay biểu: "Ngoại thấy mắt con nhìn ngoại như kiểu đang muốn nói lời chia ly rồi".'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535804
    m_Localized: 'Buddy: Mà hồi đó tui còn nhỏ quá, nào đã hiểu ý ngoại.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535805
    m_Localized: 'Buddy: Giờ tui mới thấm thía lời ngoại nói... thì đã muộn màng rồi. Ngoại đâu còn đây nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535806
    m_Localized: 'Buddy: Đêm cuối cùng bữa đó... tui túc trực bên cạnh cục cưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535807
    m_Localized: 'Buddy: Tui chỉ muốn giữ ấm cho nó, xoa dịu cơn đau giày vò... Chắc đây là món quà lưu niệm nó để lại cho tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535808
    m_Localized: 'Buddy: Nghĩ có mắc cười hông chớ? Giờ nó đi xa rồi... nhưng hình bóng nó vẫn kè kè sát tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535809
    m_Localized: 'Buddy: Hồi trước tui chụp quá trời ảnh chó cưng luôn. Chụp bao nhiêu cũng hông đủ. Đi đâu tui cũng muốn khoe với người ta hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535810
    m_Localized: 'Buddy: Nhưng tới phiên chụp tui thì ngại lắm. Nhất là mấy buổi chụp ảnh kỷ yếu á, người ta ăn mặc đẹp đẽ chỉnh tề đồ... còn tui thì lủi lủi đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535811
    m_Localized: 'Buddy: Tui nhớ có bữa người ta bắn pháo hoa ngay sát nhà. Cục vàng của tui, nó sợ quá... nên là cứ rúc rúc cọ cọ vô người tui.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535812
    m_Localized: 'Buddy: Tội nó quá trời... Tui chỉ biết ôm nó thiệt chặt rồi vuốt ve cho đỡ sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535813
    m_Localized: 'Buddy: Xong tui bất giác tủi thân, kiểu... "Phải chi có ai bên cạnh an ủi mình giống dị. Để mình biết mình hông cô đơn mỗi khi hoảng sợ".'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535814
    m_Localized: 'Buddy: Dị... là chấm hết rồi sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535815
    m_Localized: 'Buddy: Hở anh bạn...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535816
    m_Localized: 'Fatman: Thật hả mày? Anh là bộ trưởng đấy? Xùy... Thôi được rồi, soi đi, soi cho kỹ vào...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535817
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535823
    m_Localized: 'Fatman: Rồi sao, lát nữa bắt anh chổng mông lên cho xem luôn chứ gì? Bộ trưởng nhà bao việc mà cứ bắt đi làm trò.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535824
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535825
    m_Localized: 'Fatman: Chú mày dai như đỉa ấy nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535826
    m_Localized: 'Fatman: Chẹp. Thôi được rồi, đấy. Nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535827
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535828
    m_Localized: 'Fatman: Sao? Nhìn thấy sướng chưa? Xời... Nói cho mày biết. Hút thuốc không chỉ thư thái đầu óc đâu, nó còn thử thách bản lĩnh con người nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535994
    m_Localized: 'Dude: Ô kê con dê, hông thành vấn đề. Tới công chiện luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536001
    m_Localized: 'Dude: Há há há, coi đi nè!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536002
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536011
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536017
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536024
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536033
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536038
    m_Localized: 'Dude: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536084
    m_Localized: 'Dude: Uầy, chán vậy broooo... Tưởng hai đứa mình anh em chill chill chứ... Hóa ra lại là anh em cây khế.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536085
    m_Localized: 'Dude: Bro à...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729856
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729857
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729858
    m_Localized: 'Wheelchair: À ờ. Sao hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729859
    m_Localized: 'Wheelchair: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729860
    m_Localized: 'Wheelchair: Nếu như... tới ông còn hông tin nổi cái dấu hiệu này, thì sao mà tui tin được chớ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729861
    m_Localized: 'Wheelchair: Có khi cả đống này đều là dấu hiệu Dị Khách, có khi không! Ai mà biết được?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729862
    m_Localized: 'Wheelchair: Làm người ai chả có lúc lầm lỡ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729863
    m_Localized: 'Wheelchair: Nhưng nhiều khi sai lầm đó sẽ để lại hậu họa khôn lường.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729864
    m_Localized: 'Ballerina: Kiểm tra tôi? Ừ, được. Cho chắc... ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729871
    m_Localized: 'Ballerina: Răng?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729872
    m_Localized: 'Ballerina: Cậu cắn đứt lương tâm để lại?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729873
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729874
    m_Localized: 'Ballerina: Ăn hết đi. Lương tâm ngon, cắn miếng to vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729875
    m_Localized: 'Ballerina: ...Lương tâm là gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729878
    m_Localized: 'Ballerina: Thì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729879
    m_Localized: 'Ballerina: Tôi múa. Sao bắt tay ngừng múa để nhìn?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729880
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729881
    m_Localized: 'Ballerina: Bé mèo...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729882
    m_Localized: 'Ballerina: Hắn bảo mèo phải sống... Mèo may.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729883
    m_Localized: 'Ballerina: Nó làm đau tay... đau cả đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729886
    m_Localized: 'Ballerina: À à à, đến phần thú vị đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729887
    m_Localized: 'Ballerina: Có chữ viết trong mắt. Thấy không...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729888
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729889
    m_Localized: 'Ballerina: Bi kịch thay.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729890
    m_Localized: 'Ballerina: Cậu sống một mình nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729891
    m_Localized: 'Ballerina: Vậy thấy sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729894
    m_Localized: 'Ballerina: HÁ HÁ HÁ HÁ! Nhìn. Ngửi. Còn gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729895
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729896
    m_Localized: 'Ballerina: Thích không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729899
    m_Localized: 'Ballerina: Là cái gì? Tôi đâu biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729900
    m_Localized: 'Ballerina: Thử thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729901
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729902
    m_Localized: 'Ballerina: ỜMMMMM...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729903
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729904
    m_Localized: 'Ballerina: Không ai nói tôi cái này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729905
    m_Localized: 'Ballerina: Do múa đẹp?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729906
    m_Localized: 'Ballerina: Làm tôi sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729909
    m_Localized: 'Ballerina: Àààà, dấu hiệu tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729910
    m_Localized: 'Ballerina: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729911
    m_Localized: 'Ballerina: Thế nói tôi nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729912
    m_Localized: 'Ballerina: Ai tốt, ai xấu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729915
    m_Localized: 'Ballerina: HÁ HÁ HÁ! Bắn súng đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729918
    m_Localized: 'Ballerina: Muốn máu đỏ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729919
    m_Localized: 'Ballerina: Tôi cũng muốn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729920
    m_Localized: 'Ballerina: Chưa có cho tôi... chưa thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729923
    m_Localized: 'Ballerina: Không thích máu đỏ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729924
    m_Localized: 'Ballerina: Cậu đổ nhiều, từng ngày từng giờ. Mà không thích à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729925
    m_Localized: 'Ballerina: Thích hay không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729928
    m_Localized: 'Ballerina: Gì? Mất cơ hội rồi. Không cho ngửi lần hai.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729929
    m_Localized: 'Ballerina: Tại tôi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729930
    m_Localized: 'Ballerina: Chỉ đứa ngu nhiều mới vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729933
    m_Localized: 'Ballerina: Đến lúc múa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729934
    m_Localized: 'Ballerina: Tùy ý cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729937
    m_Localized: 'Ballerina: Quyết định sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729938
    m_Localized: 'Ballerina: Bằng tai?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729941
    m_Localized: 'Ballerina: Đổi ý? Muốn dấu hiệu nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729942
    m_Localized: 'Ballerina: Cần thêm à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729943
    m_Localized: 'Ballerina: Lên, xuống, xuống, lên... Sao lại làm vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729944
    m_Localized: 'Ballerina: Quyết định không được?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729945
    m_Localized: 'Ballerina: Nhìn từ đây thấy ngu, HÁ HÁ HÁ HÁ HÁ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729946
    m_Localized: 'Ballerina: Bọn ta khát máu đỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729947
    m_Localized: 'Ballerina: Có chắc Dị Khách không phải CẬU?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729948
    m_Localized: 'Ballerina: Cậu muốn đường chết rõ ràng. Như bọn ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729949
    m_Localized: 'Ballerina: ...Cậu NGU lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729950
    m_Localized: 'Ballerina: Múa thì cậu gắt? Múa gắt gỏng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729952
    m_Localized: 'Ballerina: Còn cậu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729953
    m_Localized: 'Ballerina: Biết tất cả đi đâu không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729954
    m_Localized: 'Ballerina: Hề rạp xiếc, cả ngày cười trong nhà bóng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729955
    m_Localized: 'Ballerina: Tiện.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729956
    m_Localized: 'Ballerina: Tai nè. Hì hì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729957
    m_Localized: 'Ballerina: Tai tải tài tai tái tại.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729958
    m_Localized: 'Balleria: Bà ta muốn vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729959
    m_Localized: 'Ballerina: Không ngờ bà thích đứa ngu to.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729960
    m_Localized: 'Ballerina: Không ngờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729963
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729964
    m_Localized: 'Anger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729965
    m_Localized: 'Anger: Này cầm hàng nóng cho cẩn thận vào!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729966
    m_Localized: 'Anger: Tao không muốn bị ăn một phát vào sọ chỉ vì cái tai có vấn đề đâu, địt mẹ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729967
    m_Localized: 'Couple: À ừ, được chứ. Mà mong chú đừng làm phiền vợ yêu của tôi. Em ấy mệt rã rời rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729975
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729976
    m_Localized: 'Couple: Chắc chú cũng hiểu ngoài kia khó khăn thế nào mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729977
    m_Localized: 'Couple: Răng tôi cũng chẳng đẹp đẽ gì, nhưng biết làm sao giờ. Hồi đi học toàn bị trêu suốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729978
    m_Localized: 'Couple: Không biết lũ bắt nạt ấy giờ sao rồi nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729979
    m_Localized: 'Couple: Chắc đang nằm phơi xác vất vưởng nơi xó xỉnh nào đó, bị lũ tàn ác hệt như bọn nó hồi xưa đánh cho chết ngắc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729983
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729984
    m_Localized: 'Couple: Nói chứ, thời buổi này cũng phải chăm sóc bản thân cho cẩn thận mới được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729985
    m_Localized: 'Couple: Tôi mà lăn ra ốm thì lấy ai bảo vệ cục nợ đời tôi bây giờ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729990
    m_Localized: 'Couple: Được, chú cho tôi xem trước đi đã!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729991
    m_Localized: 'Couple: Xin lỗi... Tôi hơi căng thẳng tí... Mà ai chả vậy? Mình không giấu gì nhưng bị kiểm tra thì vẫn sợ chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729992
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729993
    m_Localized: 'Couple: Rồi tôi thú thật, tôi đang căng như dây đàn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729994
    m_Localized: 'Couple: Nhưng biết sao được, tại chú đang đe dọa tính mạng của tôi với bé bi yêu dấu mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729997
    m_Localized: 'Couple: Ê ê ê, đừng có khôn lỏi nhá, chỗ này để mình tôi kiểm tra thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729998
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729999
    m_Localized: 'Couple: Đàn bà thì cạo lông nách là chuyện bình thường. Anh em mình cũng phải cạo luôn chứ nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730000
    m_Localized: 'Couple: Cạo cho nó mát, trời nóng chết đi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730001
    m_Localized: 'Couple: Chỗ anh em với nhau... Chú hiểu ý tôi nói gì mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730002
    m_Localized: 'Couple: Đàn bà thì cạo lông nách là chuyện bình thường. Chứ tôi thì sao phải cạo?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730003
    m_Localized: 'Couple: Tôi chỉ có nhiệm vụ bảo vệ em ấy khỏi thế giới đầy yêu ma quỷ quái này thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730006
    m_Localized: 'Couple: Từ từ, đây cũng là kiểm tra ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730007
    m_Localized: 'Couple: Không chụp choẹt gì hết nhá. Tôi không chụp, em ấy cũng không chụp.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730008
    m_Localized: 'Couple: Nhưng mà... kiểu gì chú cũng lấy lý do này để nghi ngờ chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730009
    m_Localized: 'Couple: Từ từ, cho tôi suy nghĩ tí...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730010
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730011
    m_Localized: 'Couple: Thôi được rồi. Chụp nhanh lên. Nhưng xong thì phải đưa ảnh cho tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730012
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730013
    m_Localized: 'Couple: Đưa đây!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730016
    m_Localized: 'Couple: Tôi thấy cái này chả liên quan gì đến Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730017
    m_Localized: 'Couple: Nhưng được thôi, đây chẳng giấu gì. Chú nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730018
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730019
    m_Localized: 'Couple: Sao? Thấy gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730020
    m_Localized: 'Couple: Vợ yêu, em nghe ai bảo tai cũng là dấu hiệu phát hiện Dị Khách bao giờ chưa? Sao cứ im lìm như thóc thế!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730021
    m_Localized: 'Couple: Ơ vậy à? Hừm. OK... Anh hiểu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730022
    m_Localized: 'Couple: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730023
    m_Localized: 'Couple: Hay ho đấy. Kết quả thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730026
    m_Localized: 'Couple: Xin chú, thiếu tôi thì làm sao vợ tôi sống nổi. Mình cứ hạ súng xuống rồi nói chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730029
    m_Localized: 'Couple: Rồi sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730030
    m_Localized: 'Couple: Làm thế đâu giúp gì được cho tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730031
    m_Localized: 'Couple: Cũng chẳng lợi gì cho chú. Giơ cái súng lên làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730032
    m_Localized: 'Couple: Chú em cũng được lợi lộc gì đâu mà. Giơ súng lên làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730035
    m_Localized: 'Couple: Chú nhầm rồi. Không kiểm tra được là chú nhanh nhảu rút súng ra vậy luôn hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730036
    m_Localized: 'Couple: Tôi thề, em ấy là người mà. Phải không em yêu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730037
    m_Localized: 'Couple: Chúng tôi thu ghém đồ đạc xong xuôi, chuẩn bị đi rồi. Em ấy lề mề vãi cả ra, nhưng đâu có nghĩa bọn tôi là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730040
    m_Localized: 'Couple: Không tin nổi chú lại về phe lũ quái vật đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730041
    m_Localized: 'Couple: Chú định giết bọn tôi chỉ vì mấy sợi lông nách ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730048
    m_Localized: 'Couple: Ừ thì phải xem móng tay, vì lũ Dị Khách bò từ dưới đất lên. Cái này tôi công nhận.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730049
    m_Localized: 'Couple: Xem mắt cũng dễ hiểu. Xem nách cũng hợp lý đi. Cơ mà tai thì liên quan gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730050
    m_Localized: 'Couple: Xem mắt cũng dễ hiểu. Xem nách cũng hợp lý đi. Cơ mà tai thì liên quan gì? Do gần não bộ hay sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730170
    m_Localized: 'Luka: Nếu điều này giúp cậu an tâm, thì cứ kiểm đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730171
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730172
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730173
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730174
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730175
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730176
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730177
    m_Localized: 'Luka: Đây, cậu xem nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730178
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730179
    m_Localized: 'Luka: Cái răng là gốc con người mà. Chắc cũng nói lên nhiều điều về chúng ta nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730180
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730181
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730182
    m_Localized: 'Luka: Đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730183
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730184
    m_Localized: 'Luka: Dù đã mất hết tất cả... ít ra tớ vẫn còn bàn tay trắng!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730185
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730186
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730187
    m_Localized: 'Luka: Được chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730188
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730189
    m_Localized: 'Luka: Đôi mắt có thể ghi dấu biết bao điều.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730190
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730191
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730192
    m_Localized: 'Luka: Phải kiểm tra cả chỗ đó nữa sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730193
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730194
    m_Localized: 'Luka: Trông cũng bình thường thôi mà, đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730195
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730196
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730197
    m_Localized: 'Luka: Oki nha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028730198
    m_Localized: 'Luka: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924161
    m_Localized: 'FortuneTeller: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924162
    m_Localized: 'FortuneTeller: Chị từng nghe tiếng gì bên tai... cứ như vũ trụ đang thì thầm với mình. Cơ mà chị nghĩ đấy là huyền cơ gì đó thâm sâu lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924306
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924307
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924308
    m_Localized: 'Anxiety: Nếu hóa ra em là Dị Khách thật... thì em có đi tàn sát người ta không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924309
    m_Localized: 'Anxiety: Rồi em sẽ biến thành hiểm họa ư? Hay... vốn dĩ từ đầu em đã là họa rồi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924310
    m_Localized: 'Anxiety: Có... Có khi nào em đã giết người luôn rồi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924311
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924312
    m_Localized: 'Anxiety: Hớ hớ hớ, tin được không chứ trời? Vậy... là thật ư?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924313
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924314
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924315
    m_Localized: 'Anxiety: S-Sao mà có nhiều dấu hiệu quá vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924316
    m_Localized: 'Anxiety: MÀ CÁI NÀO EM CŨNG DÍNH CHẤU LÀ SAO?! HỚ HỚ HỚ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924317
    m_Localized: 'Anxiety: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924318
    m_Localized: 'Anxiety: EM CÒN CHẢ HIỂU NHƯ VẬY LÀ THẾ NÀO NỮA!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924319
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924320
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924333
    m_Localized: 'Anxiety: Anh còn chờ gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924334
    m_Localized: 'Anxiety: Nào... cứ bắn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924335
    m_Localized: 'Anxiety: C-Chết rồi thì ít ra chẳng còn phải run rẩy mỗi ngày nữa... Cũng không cần biết lần này anh ghét tôi chỗ nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924340
    m_Localized: 'Esenin: Hết kiểm tra kiểm triết rồi tới mấy thằng cha áo vàng...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924341
    m_Localized: 'Esenin: Thật sự...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924342
    m_Localized: 'Esenin: ...Đúng là đời như lồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924343
    m_Localized: 'Esenin: Chú có bao giờ linh cảm là mọi chuyện sẽ đi đến kết cục thảm khốc, kinh hoàng lắm không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924344
    m_Localized: 'Esenin: Miệng thì bô bô "tất cả đều trong tầm kiểm soát", vậy mà nhìn quanh toàn thấy loạn là loạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924345
    m_Localized: 'Esenin: Chụp gì thì chụp mẹ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924346
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924347
    m_Localized: 'Esenin: Nói chung là tôi sợ, sợ điều gì sẽ xảy đến.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924348
    m_Localized: 'Esenin: Mà chú có biết mình đang tìm gì không đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924349
    m_Localized: 'Esenin: Biết cần dè chừng cái gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924350
    m_Localized: 'Esenin: Nhìn chú lóng nga lóng ngóng thế kia... là tôi quá hiểu tình hình toang đến mức nào rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924351
    m_Localized: 'Esenin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924352
    m_Localized: 'Esenin: Lỡ mai người ta kêu chú đi mổ xẻ con nít, chắc chú cũng nhắm mắt làm luôn. Dám lắm chứ đùa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924353
    m_Localized: 'Esenin: Đéo mẹ gì vậy chứ... Sao tôi lại phải lâm vào tình cảnh ác mộng này?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924354
    m_Localized: 'Cold: Cậu muốn k-kiểm tra gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924361
    m_Localized: 'Cold: Ờm, r-r-răng nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924362
    m_Localized: 'Cold: Ừ... C-Cứ nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924363
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924364
    m_Localized: 'Cold: Thi thoảng tôi lại tự cắn môi đến ch-chảy máu... Chỉ để cảm nhận hơi ấm từ dòng m-m-máu túa ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924365
    m_Localized: 'Cold: Để còn biết là mình vẫn đ-đang sống...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924368
    m_Localized: 'Cold: M-Móng tay à? Ừ, để tôi cho cậu xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924369
    m_Localized: 'Cold: Hừm. Tôi nh-nhổ hết ra mất rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924370
    m_Localized: 'Cold: Nhưng cậu muốn thì cứ việc nh-nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924371
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924372
    m_Localized: 'Cold: M-M-Móng tay tôi có khớp với mô tả về Dị Khách không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924375
    m_Localized: 'Cold: Thời buổi này... Đôi mắt là cửa sổ địa ngục, chứ chẳng phải t-tâm hồn nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924377
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924378
    m_Localized: 'Cold: Đ-Đồng tử tôi co lại ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924379
    m_Localized: 'Cold: Chắc do l-l-lạnh quá nên da thịt tôi nhăn nhúm lại...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924380
    m_Localized: 'Cold: Tiếc là mặt trời vẫn th-thiêu đốt tôi như bao người.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924381
    m_Localized: 'Cold: Ít ra khi da thịt cháy sém thì vẫn ấ-ấm lên được một chút...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924384
    m_Localized: 'Cold: Ừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924385
    m_Localized: 'Cold: Đợi... Đợi tôi một l-lát.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924386
    m_Localized: 'Cold: R-Rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924387
    m_Localized: 'Cold: ...Đây. Nhìn đi. Nh-Nhanh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924388
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924389
    m_Localized: 'Cold: Ừm. Khó chịu thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924390
    m_Localized: 'Cold: Nhưng vì n-nể cậu... nên tôi vẫn cắn răng mà chịu đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924393
    m_Localized: 'Cold: Chụp ảnh thì ch-chứng minh được gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924394
    m_Localized: 'Cold: Cậu không thấy l-lạ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924395
    m_Localized: 'Cold: M-M-Mà... tôi thì nói được gì. C-Có phải tôi quyết đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924396
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924397
    m_Localized: 'Cold: Cậu thấy gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924398
    m_Localized: 'Cold: Ch-Cho tôi xem với.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924401
    m_Localized: 'Cold: C-Cơ thể người chi chít toàn lỗ là lỗ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924402
    m_Localized: 'Cold: Bảo sao c-c-con người ta biến mất dễ vậy. Quay đi quay lại đã thấy mất hút rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924403
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924407
    m_Localized: 'Cold: Ch-Chắc là tôi cũng chẳng cần biết nữa đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924415
    m_Localized: 'Cold: Bản năng gi-giết chóc của cậu nổi lên đấy à? Mắt tôi có đ-đỏ đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924416
    m_Localized: 'Cold: C-Cứ kệ tôi đi. Chờ đợi thế này còn khổ hơn là ch-ch-chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924419
    m_Localized: 'Cold: Bị n-nấm hả? Chắc do tôi toát mồ hôi dưới l-lớp áo này đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924420
    m_Localized: 'Cold: Cơ thể tôi đang ch-ch-chống cự... Nhưng chẳng biết để làm gì nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924423
    m_Localized: 'Cold: T-Tôi giữ lại tấm ảnh đó được không? Chưa ai ch-ch-chụp ảnh tôi bao giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924424
    m_Localized: 'Cold: C-Cũng vui phết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924427
    m_Localized: 'Cold: Nh-Nhìn vào hư không, cậu thấy gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924428
    m_Localized: 'Cold: C-Có thấy gợi nhớ về bản thân mình không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924431
    m_Localized: 'Cold: C-Cảm ơn cậu đã tin tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924432
    m_Localized: 'Cold: Hy vọng tôi sẽ gi-giúp được gì cho cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924433
    m_Localized: 'Cold: Có thứ gì đó đang ăn mòn tâm trí tôi, nhưng tôi chưa thể n-nói rõ ra được...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924434
    m_Localized: 'Cold: Nói thật, tôi ch-chán sống như thế này lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924435
    m_Localized: 'Cold: Mà cậu lại chọn không gi-giết tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924436
    m_Localized: 'Cold: Nh-Nh-Nhưng ngay lúc này, ở đâu đó ngoài kia, có người đang bị g-giết trong chính căn nhà của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924437
    m_Localized: 'Cold: Cậu có bao giờ tự hỏi tại sao chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924438
    m_Localized: 'Cold: Đôi mắt tôi từ lâu đã trở nên v-vô hồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924439
    m_Localized: 'Cold: Giờ đây chỉ còn lại nỗi c-cô đơn bất tận.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924440
    m_Localized: 'Cold: Tôi chẳng làm thân được với ai. Chỉ tổ đ-đau đớn... khổ sở mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924441
    m_Localized: 'Cold: Tôi nh-nhớ ngày xưa yên bình biết mấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924445
    m_Localized: 'Cold: Nói tôi nghe... Còn bao nhiêu dấu hiệu nữa thì m-mới có được gi-gi-giải pháp thật sự đây?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924446
    m_Localized: 'Cold: Tại sao chúng ta lại phải ch-chết?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924447
    m_Localized: 'Cold: Hay vốn dĩ ch-chẳng cần thiết phải vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924448
    m_Localized: 'Cold: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924449
    m_Localized: "Cold: Xin... Xin lỗi nếu tôi có hỏi nhiều câu \nt-tế nhị quá."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924450
    m_Localized: 'Cold: C-Cậu cứ việc bơ đi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924453
    m_Localized: 'Cold: Biết sao không...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924454
    m_Localized: 'Cold: Hình như mãi tôi cũng hiểu được vì sao người mình lại l-l-lạnh vậy rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931032924493
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118466
    m_Localized: 'Scammer: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118586
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118587
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118588
    m_Localized: 'NotTrue: Ôi giời ơi, cháu đi phí ảnh chỉ để chụp ngoại à? Hay đáo để!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118589
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118590
    m_Localized: 'NotTrue: Sao rồi cháu ơi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118591
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118592
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118593
    m_Localized: 'NotTrue: Ối giời, tha cho ngoại! Cháu muốn kiểm cái đấy thật à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118594
    m_Localized: 'NotTrue: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118595
    m_Localized: 'NotTrue: Hồi đấy, tai ngoại thính đến mức nghe được cả tiếng kim rơi. Vậy mà giờ... ngoại như tàn phai đi mỗi ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118596
    m_Localized: 'NotTrue: Ngoại dần chẳng khác gì người vô hình. Ngay cả ánh sáng chói lọi cũng chưa chắc soi chiếu được ngoại.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118597
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118598
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118599
    m_Localized: 'NotTrue: Giời đất thánh thần ơi, ngoại đã già rồi mà mày vẫn không tha à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118600
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118601
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118602
    m_Localized: 'NotTrue: Sao rồi cháu giai? Có tìm thấy gì ở đôi tai già cỗi này không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118603
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118604
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118605
    m_Localized: 'NotTrue: Thời của ngoại ấy, máy ảnh là thứ xa xỉ, họa chăng bọn nhà giàu may ra mới có. Giờ thì thanh thiếu niên đứa nào cũng sắm một cái!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931037118606
    m_Localized: 'NotTrue: Giời ạ! Ngoại chả còn gì muốn nói với mày. Mày cứ đi lo bò trắng răng... Làm ngoại đây sợ chết khiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312866
    m_Localized: 'Foreigner: Glr pslmt srvf. Zms nflm glr ozn tr xl?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312874
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312875
    m_Localized: 'Foreigner: Tr mfz wzb?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312878
    m_Localized: 'Foreigner: Gzb glr z? Wflx gslr.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312879
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312880
    m_Localized: 'Foreigner: Hzl zms ozr wr ozn xzr gil mzb? Gsrxs DZIẾK TRÓK TROA DZUI ezb wl sz?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312883
    m_Localized: 'Foreigner: Nzg f?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312884
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312889
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312894
    m_Localized: 'Foreigner: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312916
    m_Localized: 'Foreigner: Ha ha...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312930
    m_Localized: 'Edgar: Xác thân mình đã hoá nên câu chuyện từ lâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312931
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312932
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312933
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312934
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312935
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312936
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312937
    m_Localized: 'Edgar: Mình còn nhớ khuôn miệng nàng lấp lánh sắc ngọc sáng ngời... Ôi, mình yêu mãi nụ cười ấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312938
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312939
    m_Localized: 'Edgar: Còn hàm răng mình thì... tựa lá rụng mùa thu, tan thành mùn đất vào mưa tháng Mười.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312940
    m_Localized: 'Edgar: Hỡi ôi... ấy chính là cái giá của tình yêu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312941
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312942
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312943
    m_Localized: 'Edgar: Đôi tay nàng mới thật mềm mại, êm ái làm sao. Nhưng nhiều lúc mình lo sợ, rằng chúng sẽ tan biến vào tay mình tựa bóng ma...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312944
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312945
    m_Localized: 'Edgar: Bàn tay phải không còn là của mình nữa. Sự mục ruỗng đã gặm nhấm nó... từng chút một.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312946
    m_Localized: 'Edgar: Nhưng tay trái vẫn ra sức níu giữ. Cậu xem móng tay này. Gọn gàng. Sạch sẽ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312947
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312948
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312949
    m_Localized: 'Edgar: Ngay cả ký ức về đôi mắt nàng cũng khiến tâm mình bấn loạn... À xin lỗi, cậu đang muốn kiểm tra mắt mình nhỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312950
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312951
    m_Localized: 'Edgar: Người ta vẫn thường nói, kẻ rơi lệ nhiều sẽ nhìn nhận thế giới sâu sắc hơn. Nhưng đã lâu rồi mình không khóc nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312952
    m_Localized: 'Edgar: Mình chẳng còn kiếm tìm gương mặt nàng. Bài học khó nhất quả thực là học cách chấp nhận.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312953
    m_Localized: 'Edgar: Nhưng rồi, như một thói quen, mình vẫn ngóng trông bóng hình nàng thoáng qua nơi khóe mắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312954
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312955
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312956
    m_Localized: 'Edgar: Vâng, được chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312957
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312958
    m_Localized: 'Edgar: Thân thể mình căm ghét sự tĩnh tại... Nó đã bị giam cầm quá lâu. Ban đầu, mình cố giữ tấm thân trong sạch để dâng trọn cho nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312959
    m_Localized: 'Edgar: Nhưng điều đó giờ chẳng còn ý nghĩa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312960
    m_Localized: 'Edgar: Thân thể mình căm ghét sự tĩnh tại... Nó đã bị giam cầm quá lâu. Hỡi ôi, mình đâu còn cách nào khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312961
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312962
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312963
    m_Localized: 'Edgar: Được thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312964
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312965
    m_Localized: 'Edgar: Thế nào... trông mình ra sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312966
    m_Localized: 'Edgar: Hay nói đúng hơn là... cậu đã nhìn thấy gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312967
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312968
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312969
    m_Localized: 'Edgar: Những gì còn sót lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312970
    m_Localized: 'Edgar: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312971
    m_Localized: 'Edgar: Một trong số ít những thứ còn vẹn nguyên như ngày đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312972
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312973
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312974
    m_Localized: 'Edgar: Cậu muốn dọa mình khiếp sợ? Ôi, bạn thân mến à. Xác thịt này chỉ còn là lớp vỏ, ngày qua ngày dần rơi rụng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312975
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312976
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312977
    m_Localized: 'Edgar: Thú thật, mình đã từng ao ước được thiếp đi trong màn đêm vĩnh cửu, bằng chính ý nguyện của mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312978
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312979
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312980
    m_Localized: 'Edgar: Để mình tự bước đi đoạn đường cuối. Đừng phí hoài mấy viên đạn của cậu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312981
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312982
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312983
    m_Localized: 'Edgar: Khi nằm cạnh ai đó một thời gian... ta sẽ hấp thụ tinh túy của họ. Vì thế, nàng đã quyện hòa làm một với xác thịt, linh hồn của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312984
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312985
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312986
    m_Localized: 'Edgar: Thú vị thật...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312987
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312988
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312989
    m_Localized: 'Edgar: Thôi thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312990
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312991
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312992
    m_Localized: 'Edgar: Nàng luôn hôn mình say đắm, như thể lo sợ lần nào cũng là lần cuối. Giờ mình đã hiểu vì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312993
    m_Localized: 'Edgar: Suốt lâu nay, mình luôn cố giữ lấy bàn tay này...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312994
    m_Localized: 'Edgar: Thầm mong rằng chỉ cần một phần thân thể còn tinh tươm, thì mình sẽ luôn nhớ đến nàng. Nhưng giờ... còn nghĩa lý gì cơ chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312995
    m_Localized: 'Edgar: Tốt quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312996
    m_Localized: 'Edgar: Khi soi vào biển hồ trong mắt nàng, mình từng trông thấy cả thiên đường phản chiếu nơi ngân hà sâu thẳm ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312997
    m_Localized: 'Edgar: Nhưng giờ thì... trống rỗng. Hố đen ngày càng cuốn mình vào vực sâu. Chỉ còn lại những tiếng vọng trong đáy mắt vô hồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312998
    m_Localized: 'Edgar: Giọng nói xa xăm. Ngôn từ lạ lẫm. Người chết giờ đã lên tiếng thay nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312999
    m_Localized: 'Edgar: Lạ lùng thay... Người đời vẫn cảnh báo: kẻ sống mà ở gần người chết quá lâu, sớm muộn gì cũng mang họ theo mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313000
    m_Localized: 'Edgar: Nhưng giả sử ngược lại thì sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313001
    m_Localized: 'Edgar: Nhiếp ảnh chỉ lưu giữ chân dung, chứ không phản ánh tâm hồn. Nếu là họa sĩ, mình sẽ vẽ nàng trên một tấm toan.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313002
    m_Localized: 'Edgar: Nhưng hỡi ôi, mình chẳng hơn gì một kẻ khờ mộng mơ... Nàng chỉ còn sống trong ký ức của mình, đến khi mình cũng tan biến vào hư vô.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313003
    m_Localized: 'Edgar: Nàng thích ghé tai mình những lời mật ngọt, nhưng mình chưa bao giờ hiểu thấu được ý nàng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313004
    m_Localized: 'Edgar: Phải chăng, sự ngọt ngào ấy là do mình mơ tưởng mà thôi. Vì nàng đã không còn trên cõi đời...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313005
    m_Localized: 'Edgar: Anh đến với em đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313006
    m_Localized: 'Edgar: Hỡi người yêu dấu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313007
    m_Localized: 'TaxiDriver: Ờm, ê chú, nói ra chú đừng hiểu lầm nghen, nhưng mà á... Ý là hông phải tui từ chối hay gì... Mà thôi, chú tự coi đi là biết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313008
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313009
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313010
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313011
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313012
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313013
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313014
    m_Localized: 'TaxiDriver: Răng thôi mà. Có cái chi đặc biệt đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313015
    m_Localized: 'TaxiDriver: Xưa giờ tui ý thức giữ răng kỹ lắm. Hồi nhỏ còn đi làm trắng răng nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313016
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313017
    m_Localized: 'TaxiDriver: Tía má vẫn hay nhắc tui phải để ý nụ cười, tạo ấn tượng đầu tốt đẹp để người ta nhìn vô có thiện cảm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313018
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313019
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313020
    m_Localized: 'TaxiDriver: Đây chú coi đi... Cũng hổng đẹp đẽ gì cho cam.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313021
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313022
    m_Localized: 'TaxiDriver: Tay tui nó bình thường thôi chú ơi. Mần nghề này căng thẳng lắm, tui mà hông hút thuốc là đã cà cà móng tay tới tóe máu rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313023
    m_Localized: 'TaxiDriver: Tay tui nó bình thường thôi chú ơi. Chẳng qua móng bị dơ á. Tại mỗi lần kẹt xe là tui lại cà cà bấu bấu vô cái vô lăng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313024
    m_Localized: 'TaxiDriver: Làm dị cho nó kiềm chế, chứ hông tui sôi máu là tui rồ ga phóng bất chấp luôn. Khách lại ba chân bốn cẳng chạy hết thì khổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313025
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313026
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313027
    m_Localized: 'TaxiDriver: Mắt tui cứ hay bị mỏi kiểu chi á. Mà cũng khó nhắm lâu lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313028
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313029
    m_Localized: 'TaxiDriver: Chắc tại tui... quen mở mắt dòm chừng tứ phía rồi. Phải để ý coi ai lái sau lưng, ai đang nhìn chằm chằm, ai im phăng phắc hổng nói một câu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313030
    m_Localized: 'TaxiDriver: Bệnh nghề nghiệp ý mà. Khó bỏ lắm, nên giờ đâm ra tui bị mất ngủ luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313031
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313032
    m_Localized: 'TaxiDriver: Từ hồi tụi nó cướp mất xe tui, đêm đêm tui toàn trằn trọc vỗ gối.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313033
    m_Localized: 'TaxiDriver: Bệnh nghề nghiệp ý mà. Phải để ý coi ai lái sau lưng, ai đang nhìn chằm chằm, ai im phăng phắc hổng nói một câu... Thói quen khó bỏ lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313034
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313035
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313036
    m_Localized: 'TaxiDriver: Nách có chi mà đặc biệt đâu chú ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313037
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313038
    m_Localized: 'TaxiDriver: Mà riêng mấy bữa tui lái xe lâu quá thì có chuyện. Cái vai nó đau quá trời quá đất luôn chú. Đau mà nhiều khi nhấc cái tay lên hổng nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313039
    m_Localized: 'TaxiDriver: Nhưng hổng sao đâu, tui cũng quen rồi á. Nhất là dạo này...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313040
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313041
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313042
    m_Localized: 'TaxiDriver: Tui chuẩn bị xong rồi. Chụp đi chú.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313043
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313044
    m_Localized: 'TaxiDriver: Sao... Chú thấy cái chi? Chắc có mình tui thôi hén? Quá là bình thường.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313045
    m_Localized: 'TaxiDriver: Hồi trước, tui hay đem theo hình chụp tía với tui trên xe lắm. Mà giờ chỉ có mấy thằng cớm mới đi chụp hình ghi sổ tui thôi à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313046
    m_Localized: 'TaxiDriver: Giờ có thêm chú nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313047
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313048
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313049
    m_Localized: 'TaxiDriver: Tai tui hả? Cũng như bao người thôi. Có cái chi lý thú đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313050
    m_Localized: 'TaxiDriver: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313051
    m_Localized: 'TaxiDriver: Mà cái tai này tui xài nhiều lắm. Khách người ta cũng hay mở lời tâm sự, tui chỉ nghe thôi chứ hổng ngắt lời. Vừa nghe vừa ghi nhớ trong đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313052
    m_Localized: 'TaxiDriver: Nhưng mà lâu lâu cũng lỡ nghe nhiều quá, kiểu vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313053
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313054
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313055
    m_Localized: 'TaxiDriver: K-Kìa chú, tui có bị khùng đâu! Kiểu tại... tui hơi bị ám ảnh từ đó tới giờ thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313056
    m_Localized: 'TaxiDriver: Cứ dòm thấy răng là tui lại nhớ tới thằng cha đó. Người chi đâu ác như quỷ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313057
    m_Localized: 'TaxiDriver: Nói nghe chớ, tía tui với cha này từng đụng độ nhau một lần...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313058
    m_Localized: 'TaxiDriver: Kể từ bữa đó là tui bắt đầu hút thuốc... Má răng tui đã vàng sẵn rồi, hít cái quỷ sứ đó vô còn hại thêm nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313059
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313060
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313061
    m_Localized: 'TaxiDriver: Hờ hờ... Chú giỡn hả? Chuyến nào cầm lái cũng như trải kiếp nạn, thử thách lòng kiên nhẫn hết. Chắc chú cũng hiểu ý tui mà nhở.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313062
    m_Localized: 'TaxiDriver: Có người tức mình đập tay lái, người thì chửi bới, kẻ lại nhào vô oánh lộn luôn. Tài xế ai cũng có cách xả riêng, nên là chú bớt cà khịa giùm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313063
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313064
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313065
    m_Localized: 'TaxiDriver: Kìa chú. Tui đâu ngu dữ vậy. Chú đang tưởng tui là Dị Khách chớ gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313066
    m_Localized: 'TaxiDriver: Nhưng mà chú lộn rồi nghen. Bộ hổng lẽ chú tính bắn chết dân lao động thiện lành thiệt hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313067
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313068
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313069
    m_Localized: 'TaxiDriver: Chú đã muốn vậy thiệt thì... thôi tui cũng chả thèm cản. Từ xưa giờ, có ai thèm đứng về phía tui đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313070
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313071
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313072
    m_Localized: 'TaxiDriver: Chú mới coi sơ ba cái ảnh xàm xí mà đã vội kết án tui thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313073
    m_Localized: 'TaxiDriver: Tui mặc kệ luôn, chú thích mần chi thì mần. Tới nước này rồi, tui còn chi để mà nói nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313074
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313075
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313076
    m_Localized: 'TaxiDriver: Bình tĩnh đi chú, có chi cần chia sẻ thì cứ nói, tui nghe mà. Sở trường của tui đó. Tui cũng hổng còn mấy chuyện để kể nữa rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313077
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313078
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041313079
    m_Localized: 'TaxiDriver: Chắc chú đang thắc mắc sao tui biết hút thuốc hại răng mà vẫn hổng chịu bỏ, phải hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507072
    m_Localized: 'TaxiDriver: Chắc chú đang thắc mắc sao tui lại đi tẩy trắng răng, đúng hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507073
    m_Localized: 'TaxiDriver: Có lẽ... tại tui muốn dòm giống một người khác. Ê mà, hổng phải như tụi Dị Khách đâu nghen. Kiểu kiểu, ờ thì, nó là dị đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507074
    m_Localized: 'TaxiDriver: Túm lại là, hồi đó có một ông giang hồ sừng sỏ ở xóm tui. Ai ai cũng biết. Tới thằng nhóc hỉ mũi chưa sạch như tui còn biết mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507075
    m_Localized: 'TaxiDriver: Ngó qua thì thằng chả dòm cũng bình thường. Mà có cái là nhả khói phì phèo như nhà máy di động.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507076
    m_Localized: 'TaxiDriver: Ngó qua thì thằng chả dòm cũng bình thường. Mà hàm răng của chả... cười lên cái là trắng như sứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507077
    m_Localized: 'TaxiDriver: Bữa đó tía tui phạm phải sai lầm trí mạng, mần cả nhà lãnh đủ. Từ đó tụi tui sống lay lắt như chuột nhắt. Không nhà cửa, không đồng xu cắc bạc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507078
    m_Localized: 'TaxiDriver: Hồi xưa, tui cứ tưởng bàn tay ta mần nên tất cả, sỏi đá cũng thành cơm. Lái được xe, ghì cương được cuộc đời... Mà giờ còn nghĩa lý chi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507079
    m_Localized: 'TaxiDriver: Mắt tui như là mắt cú vọ, lúc nào cũng liếc ngang liếc dọc, dòm trước ngó sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507080
    m_Localized: 'TaxiDriver: Luôn dò dẫm kiếm khách, trong lòng tự hỏi mấy người này có thiệt sự là người hay hông.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507081
    m_Localized: 'TaxiDriver: Ghê quá hả chú? Xin lỗi nghen. Mà giờ con xe mất rồi, chắc cũng tới lúc phải bỏ cái thói kể chuyện hù người khác này đi thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507082
    m_Localized: 'TaxiDriver: Nhiều lúc tui cứ băn khoăn... Nếu mà mình có bờ vai để nương tựa, chắc đã chả phải lăn lộn ngoài kia để kiếm khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507083
    m_Localized: 'TaxiDriver: Chả phải rước thằng cha đó lên xe. Chả phải chịu cảnh mất trắng...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507084
    m_Localized: 'TaxiDriver: Vậy là chú cũng còn thấy được phần người trong tui...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507085
    m_Localized: 'TaxiDriver: Ừa thì tui lắm tật, còn nhiều thiếu sót. Nhưng thiệt sự, cũng ráng lắm rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507086
    m_Localized: 'TaxiDriver: Chú biết đáng sợ nhất trên đời là chi hông? Là gặp trúng khách cứ ngồi một chỗ, im thin thít hổng nói hổng rằng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507087
    m_Localized: 'TaxiDriver: Ngồi trong im lặng quá lâu, mình nghe được tiếng suy nghĩ của mình luôn. Át cả tiếng đài radio. Hông tắt được, mà cũng hổng tránh được...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507088
    m_Localized: 'TaxiDriver: Cứ để gió cuốn bay tro tàn tui đi ha. Dù gì tui cũng hổng muốn lưu lại xác thịt mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507089
    m_Localized: 'TaxiDriver: Trong lớp đất này đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507407
    m_Localized: 'Intruder: Hừm. Để xem qua một đêm có gì đổi khác không nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507408
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507409
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507410
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507411
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507412
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507413
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507414
    m_Localized: 'Intruder: Rồi, chờ chút, tôi cho anh xem ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507415
    m_Localized: 'Intruder: Tôi mệt quá rồi, nên là cũng hay quên.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507416
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507417
    m_Localized: 'Intruder: Tôi thấy chi bằng mình bớt để ý mấy thứ cỏn con đi. Để mấy chuyện kiểm tra này... đỡ kỳ cục hơn chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507418
    m_Localized: 'Intruder: Đúng là trí nhớ tôi kém thật, nhưng chưa tới mức quên đánh răng đàng hoàng đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507419
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507420
    m_Localized: 'Intruder: Quan trọng là phải biết chăm sóc bản thân. Để mấy chuyện kiểm tra này... cảm giác bình thường hơn chút.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507421
    m_Localized: 'Intruder: Không biết... mình có thể nhận diện Dị Khách qua giấc mơ của họ không nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507422
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507423
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507424
    m_Localized: 'Intruder: Đôi tay này luôn sẵn sàng gạt phăng mọi vật cản ngáng đường tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507425
    m_Localized: 'Intruder: Phải chăng đó là cách tôi vùng vẫy để vươn tới giấc mơ của chính mình?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507426
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507427
    m_Localized: 'Intruder: ...Mình đang chống lại thứ gì vậy không biết?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507428
    m_Localized: 'Intruder: Tôi phải tìm cách mơ thôi, đúng không anh...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507429
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507430
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507431
    m_Localized: 'Intruder: Tôi có nghe phong thanh là bị mất ngủ sẽ khiến mắt mờ đục đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507432
    m_Localized: 'Intruder: Có đúng không nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507433
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507434
    m_Localized: 'Intruder: Hừm. Hồi trước mắt tôi trắng dã cơ. Giờ thành đỏ lòm luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507435
    m_Localized: 'Intruder: Anh cũng biết rồi chứ nhỉ? Đã từ rất lâu... tôi không hề ngủ được tí nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507436
    m_Localized: 'Intruder: Thế sao mắt tôi không bị đỏ nhỉ? Lạ thật...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507437
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507438
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507439
    m_Localized: 'Intruder: Không hiểu sao chỗ này lại đau nữa, cứ như bị sưng tấy vậy. Thật kỳ quái...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507440
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507441
    m_Localized: 'Intruder: Thế nào? Có gì không ổn à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507442
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507443
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507444
    m_Localized: 'Intruder: Tò mò quá. Không biết nó sẽ trông như nào nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507445
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507446
    m_Localized: 'Intruder: À, ra không phải loại ảnh bình thường. Đây là ảnh chụp kiểu... hào quang đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507447
    m_Localized: 'Intruder: Trông cứ... rỗng tuếch làm sao ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507448
    m_Localized: 'Intruder: Anh có chắc kiểm tra như này hiệu quả không vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507449
    m_Localized: 'Intruder: Ý là... hào quang có thật không? Anh thấy tận mắt bao giờ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507450
    m_Localized: 'Intruder: Giấc mơ thì có nhé. Ít ra ngày xưa chúng từng tồn tại. Nhưng còn hào quang thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507451
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507452
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507453
    m_Localized: 'Intruder: Hửm? Chưa nghe nói vụ này bao giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507454
    m_Localized: 'Intruder: Thôi thì cứ thử xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507455
    m_Localized: 'Intruder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507456
    m_Localized: 'Intruder: Sao... Anh phán như nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507457
    m_Localized: 'Intruder: ...Mà anh có biết mình đang cần tìm gì không thế?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507458
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507459
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507460
    m_Localized: 'Intruder: Nói thật chứ, lâu lắm rồi tôi không hề ngủ, thành ra bây giờ cũng chẳng phân biệt được đây là thực... hay là mơ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507461
    m_Localized: 'Intruder: ...Thảo nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507462
    m_Localized: 'Bắn bỏ '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507463
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507464
    m_Localized: 'Intruder: Hừm. Thú vị thật. Giả sử nhân loại vẫn còn nằm mơ, thì liệu tôi có thể xâm nhập vào giấc mơ của ai khác được không nhỉ...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507465
    m_Localized: 'Bắn bỏ '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507466
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507467
    m_Localized: 'Intruder: Tôi chỉ đang cố tìm chỗ ngủ mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507468
    m_Localized: 'Intruder: Dù thân xác tôi đã rệu rã, đôi mắt này vẫn cứ mở thao láo, ngày càng liếc ngang ngó dọc nhiều hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507469
    m_Localized: 'Intruder: Từ từ... Đừng bảo là tôi có dấu hiệu Dị Khách nhé? Mấy cái mà người ta hay nói trên TV ấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507470
    m_Localized: 'Intruder: Có gì mà anh nghi ngờ thế nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507471
    m_Localized: 'Intruder: Tôi chẳng hiểu nổi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507472
    m_Localized: 'Bắn bỏ '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507473
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507474
    m_Localized: 'Intruder: Hửm? Thật luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507475
    m_Localized: 'Intruder: Do bị mất ngủ nên da tôi mới khô nứt thế thôi. Anh không bị giống vậy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507476
    m_Localized: 'Bắn bỏ '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507477
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507478
    m_Localized: 'Intruder: Từ từ, khoan bắn đã... Xin hãy lắng nghe... thỉnh cầu... của tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507479
    m_Localized: 'Bắn bỏ '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507480
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507481
    m_Localized: 'Intruder: Anh có thể nào bắn nát cả người tôi được không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507482
    m_Localized: 'Intruder: Để lỡ tôi có sống lại, thì cũng chẳng thể chui vào xác được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507483
    m_Localized: 'Intruder: Như vậy, xác thịt này sẽ không tìm về với tôi ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507484
    m_Localized: 'Intruder: Hãy để tôi được thong thả ở thế giới bên kia, dù chỉ một lát thôi cũng được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507485
    m_Localized: 'Intruder: Dẫu không còn thể xác, tôi vẫn tự tìm cách xoay xở được thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507486
    m_Localized: 'Bắn bỏ '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507487
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507488
    m_Localized: 'Intruder: Hừmmm, tôi thấy Dị Khách răng bẩn thì hợp lý hơn chứ nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507489
    m_Localized: 'Intruder: Bởi nếu chúng nó bò lên từ dưới lòng đất, thì lúc chui lên miệng phải dính đất cát chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507490
    m_Localized: 'Intruder: Sao anh lại nghĩ móng tay của tôi bẩn?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507491
    m_Localized: 'Intruder: Chỉ là tôi đang cố vùng vẫy hết sức để vươn tới giấc mơ thôi mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507492
    m_Localized: 'Intruder: Khi đã chạm đến chúng rồi, tôi sẽ thôi không hành hạ chính mình nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507493
    m_Localized: 'Intruder: ...Vì khi đó, cơn đau cũng chẳng còn ý nghĩa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507494
    m_Localized: 'Intruder: Hừmmm... Sao mắt tôi lại đục ngầu vậy nhỉ? '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507495
    m_Localized: 'Intruder: Lẽ ra phải khô khốc vì mở căng trong thời gian dài chứ? Tôi cứ tưởng nó sẽ bóng bóng lờ đờ cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507496
    m_Localized: 'Intruder: Hừmmm... Sao mắt tôi lại không đỏ ngầu nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507497
    m_Localized: 'Intruder: Lẽ ra phải khô khốc vì mở căng trong thời gian dài chứ? '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507498
    m_Localized: 'Intruder: Lâu lắm rồi tôi không ngủ được tí nào mà. Lạ quá đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507499
    m_Localized: 'Intruder: Vậy là có mình tôi bị thế à? Kỳ lạ nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507500
    m_Localized: 'Intruder: Nếu mình mất ngủ lâu ngày, người mình sẽ bắt đầu lạnh toát... rồi ít lâu trở nên khô kiệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507501
    m_Localized: 'Intruder: Sau đó, lại có thêm một cơn sốt dần dần tích tụ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507502
    m_Localized: 'Intruder: Rồi cứ thế ngày một trầm trọng hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507503
    m_Localized: 'Intruder: Anh nghe từ đâu mà biết về dấu hiệu này vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507504
    m_Localized: 'Intruder: À, biết trên TV ấy hả? Lạ thế...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507505
    m_Localized: 'Intruder: Chỉ là tôi... không biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507506
    m_Localized: 'Intruder: Mấy cái khác tôi còn hiểu. Chứ riêng hào quang thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507507
    m_Localized: 'Intruder: Dạo gần đây có cả đống người phát cuồng vì mấy chuyện siêu nhiên, làm tôi sợ khiếp đi được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507508
    m_Localized: 'Intruder: Trong khi mình còn chưa khám phá hết thế giới tự nhiên nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507509
    m_Localized: 'Intruder: Bản tin mà anh nói có vẻ thú vị nhỉ. Những lời nghe như nửa tỉnh, nửa mơ. Nửa thực, nửa ảo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507510
    m_Localized: 'Intruder: Nhưng anh có chắc là mình thấy thật không? '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507511
    m_Localized: 'Intruder: Biết đâu tất cả chỉ là giấc chiêm bao.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507512
    m_Localized: 'Intruder: Mà như vậy thì... tôi phải hiểu được chứ. Lạ thật.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507513
    m_Localized: 'Intruder: Người ta bảo sao là anh răm rắp nghe theo à? Sẵn sàng đi giết người luôn? Buồn cười nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507514
    m_Localized: 'Intruder: ...À mà thực ra đáng sợ hơn là đáng cười.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507515
    m_Localized: 'Intruder: Thế giới đảo điên... Thiếu vắng giấc mộng... Tôi thì lìa đời...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507516
    m_Localized: 'Intruder: Hay chỉ chìm vào giấc ngủ thật dài...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507517
    m_Localized: 'Cultist1: Rồi Tử Thần sẽ sưởi ấm chúng ta bằng vòng tay lạnh giá của Ngài.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507524
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507529
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507534
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507535
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507536
    m_Localized: 'Cultist1: Tôi đã phát chán công cuộc chuẩn bị rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507539
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507540
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507541
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507544
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507545
    m_Localized: 'Cultist1: Anh đã quyết như thế, thì cứ kiểm đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507546
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507547
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507550
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507551
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507552
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507555
    m_Localized: 'Cultist1: Vẫn chưa phải lúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507558
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507561
    m_Localized: 'Cultist1: Anh muốn thế này thật sao? Nghĩ cho kỹ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507564
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507567
    m_Localized: 'Cultist1: Rồi anh làm thế thì có ích lợi gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507570
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507573
    m_Localized: 'Cultist1: Nào, anh nói tôi nghe... Sao anh cứ tự làm khó mình bằng mấy trò kiểm tra này chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507574
    m_Localized: 'Cultist1: Đến lúc rồi thì cứ bình thản chấp nhận mà đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507575
    m_Localized: 'Cultist1: Tôi chẳng biết anh cứ chần chừ để làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507576
    m_Localized: 'Cultist: Tôi cũng không còn gì để nói.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507577
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507578
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507579
    m_Localized: 'Cultist1: Đã từ rất lâu rồi, bóng hình của tôi chẳng được lưu dấu thiên cổ trong ảnh chụp.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507580
    m_Localized: 'Cultist1: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507581
    m_Localized: 'Cultist1: Rồi ngươi sẽ phải trả giá cho hành động này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507582
    m_Localized: 'Cultist1: Ngươi đã phạm phải sai lầm khủng khiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507590
    m_Localized: 'Cultist2: Ồ, được chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507592
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507593
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507596
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507597
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507602
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507606
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507607
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507613
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507617
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507618
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507619
    m_Localized: 'Cultist2: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507625
    m_Localized: 'Cultist2: Vẫn... Vẫn còn sớm mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507628
    m_Localized: "Cultist2: Tôi... Tôi chưa sẵn sàng ra đi ngay \nlúc này."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507631
    m_Localized: 'Cultist2: Ờm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507637
    m_Localized: 'Cultist2: ...Còn chưa đến lúc mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507638
    m_Localized: 'Cultist2: Làm ơn, đừng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507641
    m_Localized: 'Cultist2: Cảm ơn anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507650
    m_Localized: 'Cultist2: Cảm ơn nhé, người anh em.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507654
    m_Localized: 'Cultist2: ...Địt mẹ! T-Tôi chưa muốn ch–!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507655
    m_Localized: 'Cultist3: Anh muốn làm sao thì làm. Miễn đừng cản trở con đường chúng tôi đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507663
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507668
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507673
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507677
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507678
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507679
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701379
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701380
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701383
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701397
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701403
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701408
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701412
    m_Localized: 'Cultist3: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701413
    m_Localized: 'Cultist3: Dại dột quá, người anh em. Quá ư là dại dột.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701414
    m_Localized: "Cultist3: Thế nào giáo hội của tôi cũng thiêu rụi thân xác anh. Rồi Tử Thần sẽ ngoảnh mặt \ntừ bỏ anh."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701415
    m_Localized: 'FatalDame: Có bao giờ cưng thấy lo sợ không? Sợ rằng chị không phải là con người ấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931049701416
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Cũng được. *Khụ* Chẳng giấu gì chú. Người anh có cái gì thì cũng bị lửa thiêu hết rồi còn đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Chú xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Đừng có *khụ* làm căng quá. Hít cả bể khói vào phổi thì răng sạch kiểu gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
