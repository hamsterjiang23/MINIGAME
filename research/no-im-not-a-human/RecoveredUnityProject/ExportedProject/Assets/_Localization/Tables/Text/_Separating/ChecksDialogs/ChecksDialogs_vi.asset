      m_Items: []
  - m_Id: 41582931041312910
    m_Localized: 'Foreigner: Crm wfmt! Glr oz mtflr gf gv, gsv oflm! Gzr szr yvm pslmt srvf mszf gslr nz!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312911
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312912
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312913
    m_Localized: 'Foreigner: Mzb zms lr! Wfmt ozr wr! Zms wrvm ozn ilr wzb!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312914
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312915
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312917
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312918
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312919
    m_Localized: 'Foreigner: Ilr zms grms ozn tr mfz?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312920
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312921
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312922
    m_Localized: 'Foreigner: Zms yrvg glr yr pszf nrvmt ilr nz. Trl zms ozr wr xsrz XÚNG DZIẾK mtflr gz.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312923
    m_Localized: 'Foreigner: Xszx glr mvm wr ifz gzb gslr...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312924
    m_Localized: 'Foreigner: Xl nlr wlr nzg gslr nz hzl kszr sf glr tsv gsv?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312925
    m_Localized: 'Foreigner: Trl mtflr gz yzg wzf KYỂM TROA wflr mzb oflm... Xlr yl pslmt lm gr mzl...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312926
    m_Localized: 'Foreigner: Glr gsrxs xsfk srms ozn. Msfmt zms gsr xszmt fz tr nzb msr?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312927
    m_Localized: 'Foreigner: Glr msl ml jfz wr gslr. Xsr xzm wflx tzk ozr ml oz xsfbvm tr glr xfmt ozn. THÙY XEAO, xl ezm wv tr pslmt ezb?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312928
    m_Localized: 'Foreigner: Wlr oz gsv wzb. Xsr er pslmt srvf mszf nz wzn iz hl hvg, ilr xflr xfmt...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931041312929
    m_Localized: 'Foreigner: ... trvg xslx ozm mszf.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507090
    m_Localized: 'Provocateur: Anh xem TV miết rồi tin ba cái vụ Dị Khách luôn chứ gì? Được thôi, anh cứ kiểm tra đi. Nhưng đừng hòng xâm phạm nhân quyền của tôi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507091
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507092
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507093
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507094
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507095
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507096
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507097
    m_Localized: 'Provocateur: Anh định mò xem trong miệng tôi còn sót cơm thừa canh cặn gì để vơ vét, đúng chửa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507098
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507099
    m_Localized: 'Provocateur: Sao, hài lòng rồi chứ? Hay anh định giết người diệt khẩu luôn, vì tôi đây biết giữ vệ sinh răng miệng hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507100
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507101
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507102
    m_Localized: 'Provocateur: Anh muốn xem tay tôi hả? Để làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507103
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507104
    m_Localized: 'Provocateur: Công tâm mà nói, móng tay có dính tí đất cũng đâu chứng minh được gì, đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507105
    m_Localized: 'Provocateur: Công tâm mà nói, vài ba móng tay chưa được cắt tỉa cũng đâu chứng minh được gì, đúng không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507106
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507107
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507108
    m_Localized: 'Provocateur: Anh xem mắt làm gì hửm? Tìm mắt đỏ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507109
    m_Localized: 'Provocateur: Anh muốn soi thấy gì hửm? Xem thử ánh nhìn của tôi có giống ác quỷ không à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507110
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507111
    m_Localized: 'Provocateur: Thấy chưa, có đỏ đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507112
    m_Localized: 'Provocateur: Sao rồi? Thấy gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507113
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507114
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507115
    m_Localized: 'Provocateur: Sao cơ? Giơ cái nách lên à?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507116
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507117
    m_Localized: 'Provocateur: Ơ hay, chẳng lẽ tôi ghét mồ hôi ẩm ướt thì lại phán tôi là Dị Khách? Thế thôi cán bộ bỏ tù tôi luôn đi, mồ hôi thành tội đáng tử hình rồi này!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507118
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507119
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507120
    m_Localized: 'Provocateur: Hay tôi cười một cái cho anh hài lòng nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507121
    m_Localized: 'Provocateur: Chắc đó cũng là dấu hiệu... rõ ràng gì đấy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507122
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507123
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507124
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507125
    m_Localized: 'Provocateur: Ôi trời, TV nói gì là anh tin sái cổ luôn hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507126
    m_Localized: 'Provocateur: Thế giờ họ bảo Dị Khách có lông mu thì anh tính sao hửm? Bắt bọn tôi tụt quần ra để anh tự tiện khám xét, làm nhục một cách trơ trẽn à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507127
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507128
    m_Localized: 'Provocateur: Muốn chơi trò bác sĩ khám người hửm? Sao rồi Thần Y Tái Thế, tiên lượng của tôi thế nào vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507129
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507130
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507131
    m_Localized: 'Provocateur: Chà, nói thật chứ, cái loại như anh là tôi biết thừa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507132
    m_Localized: 'Provocateur: Thoải mái! Anh coi luật pháp như rác rưởi mà! Thêm nốt tội "giết người vì răng quá sạch" vào án tích luôn đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507133
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507134
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507135
    m_Localized: 'Provocateur: Ái chà, hay quá nhỉ. Anh quy chụp tôi là kẻ xấu vì móng tay có dính đất tí ti thôi đấy hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507136
    m_Localized: 'Provocateur: Thế thì nói xem, tôi vi phạm điều gì nào? Nói trước, luật pháp tôi nhớ từng câu từng chữ đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507137
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507138
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507139
    m_Localized: 'Provocateur: Anh đùa tôi đấy hả?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507140
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507141
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507142
    m_Localized: 'Provocateur: Thật ra thì, tôi có hơi giật mình lúc anh chụp hình đấy. Thế thì ANH mới là kẻ đáng nghi ở đây chứ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507143
    m_Localized: 'Provocateur: Bà con lại đây mà xem! Ảo diệu thế cơ chứ! Anh vừa bảo có thể nhìn thấu được... "hào quang" của tôi... chỉ bằng ảnh chụp á?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507144
    m_Localized: 'Provocateur: Chẳng thà anh tung đồng xu luôn đi, ngửa thì tha, sấp thì bắn. Nghe còn khoa học hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507145
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507146
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507147
    m_Localized: 'Provocateur: Chẳng có điều luật nào trong hiến pháp nghiêm cấm người dân cạo lông nách cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507148
    m_Localized: 'Provocateur: Nói thế tức là mấy kẻ "Dị Khách" kia đều chăm chút tỉa tót lông nách của mình ở dưới lòng đất đấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507149
    m_Localized: 'Provocateur: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507150
    m_Localized: 'Provocateur: Hoan hô! Quá là sáng suốt! Thiên tài lỗi lạc! Hợp lý như đi bằng đầu vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507151
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507152
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507153
    m_Localized: 'Provocateur: Tôi nói thế này anh đừng buồn nhé, làm người phải biết tư duy một chút, đừng có TV bảo gì là mình cũng răm rắp nghe theo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507154
    m_Localized: 'Provocateur: Thấy gì sai sai tí là đã rút súng chĩa người ta rồi. Hay Thần Y đây muốn nói thuốc hoa cải chính là tiên dược, chữa được cả bệnh ráy tai?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507155
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507156
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507157
    m_Localized: 'Provocateur: Ô, bất ngờ ghê luôn! Hoá ra cái đầu rỗng tuếch của anh vẫn còn chút chất xám!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507158
    m_Localized: 'Provocateur: Nếu muốn bắn bỏ người khác thì anh cho họ vào nhà trú để làm gì? Anh đang VI PHẠM LUẬT THUÊ NHÀ đấy, biết chửa!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507159
    m_Localized: 'Provocateur: Đâu thể cứ gặp vấn đề cỏn con gì là ngay lập tức phạm tội hình sự! Thậm chí vấn đề có lớn cũng không luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507160
    m_Localized: 'Provocateur: Anh đúng là đã mất hết năng lực hành vi dân sự. Chẳng có người tỉnh táo nào lại giơ súng lên, sau đó hạ súng xuống như chưa có gì xảy ra cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507161
    m_Localized: 'Provocateur: Thôi ngay cái trò hề này đi! Làm gì có thứ gọi là "Dị Khách"!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507162
    m_Localized: 'Provocateur: Anh mà còn làm vậy nữa chắc tôi tổn thọ quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507163
    m_Localized: 'Provocateur: Anh... bảo tôi phải ngưng cạo lông nách ấy hả? Thế tôi mà nuôi được nhúm lông thì anh có thôi trò giết chóc đi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507164
    m_Localized: 'Provocateur: Đúng là hết nói nổi luôn…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507165
    m_Localized: 'Provocateur: Đừng tưởng tôi sẽ quỳ xuống tạ ơn anh chỉ vì anh không bắn lủng đầu tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507166
    m_Localized: 'Provocateur: Lại trò hề này nữa sao? Ráy tai là dấu hiệu của đôi tai khoẻ mạnh, mà giờ nó biến tướng thành cái quái gì vậy? Xã hội này loạn thật rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507167
    m_Localized: 'Provocateur: Khoan... A-Anh định bóp cò thật hả? N-Nói cho mà biết, đó là hành vi vi phạm hình sự nghiêm trọng đấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507168
    m_Localized: 'Provocateur: KHÔNG! D-DỪNG LẠI NGAY! ANH ĐÃ VI PHẠM PHÁP LUẬT!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507169
    m_Localized: 'Provocateur: KHÔÔÔÔÔNG!!!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507170
    m_Localized: 'Marauder: Ờ, cậu cứ kiểm tra đi. Tui bị người ta nghi miết mà quen luôn rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507171
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507172
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507173
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507174
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507175
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507176
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507177
    m_Localized: 'Marauder: Đây, răng đây. Với để tui khuyến mãi cho cậu nghe một câu chuyện.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507178
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507179
    m_Localized: 'Marauder: Ủa, làm mặt dẫy là sao? Ờ, đó giờ tui hổng có quánh răng. Thì có sao hông? Tui thích sống dẫy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507180
    m_Localized: 'Marauder: Quánh hay hông thì người ta vẫn né tui như né tà thâu. Tui là tui thà uống nước, còn hơn là lấy nước súc miệng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507181
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507182
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507183
    m_Localized: "Marauder: Bàn tay năm ngón, mà hổng có \nkiêu sa."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507184
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507185
    m_Localized: 'Marauder: Móng tay tui... hổng được sạch sẽ cho lắm. Trước sau gì cũng dơ lại thâu, rửa làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507186
    m_Localized: 'Marauder: Cậu thấy rầu đó... Móng tay tui hổng được sạch sẽ gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507187
    m_Localized: "Marauder: Đúng là trớ trêu thiệt. Tay tui nó đã chạm vô đủ thứ ngọc ngà châu báu, vàng bạc hột xoàn cầm nắm \nđủ hết rầu."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507188
    m_Localized: 'Marauder: Dẫy mà giờ đây, chỉ còn lại hai bàn tay trắng. Thâu thì, ít ra vẫn còn giữ được cái mạng quèn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507189
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507190
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507191
    m_Localized: "Marauder: Mắt người ta như nào thì mắt tui \ndẫy thâu."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507192
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507193
    m_Localized: 'Marauder: Cậu dòm đi, có gì khác thường đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507194
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507195
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507196
    m_Localized: 'Marauder: Đậu má... Dẫy mà tui tưởng mình mới là thằng cha kém văn minh nhứt trong cái nhà này chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507197
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507198
    m_Localized: 'Marauder: Ờ, nách tui bị nổi mẩn. Mà đau nữa. Suốt ngày lang thang ngoài đường thì chịu thâu chớ biết làm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507199
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507200
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507201
    m_Localized: 'Marauder: Gì dẫy trời? Giỡn hả ba?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507202
    m_Localized: 'Marauder: Thâu được rầu. Cậu là chủ mà, cậu nói gì khách nghe đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507203
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507204
    m_Localized: 'Marauder: Trời quơi... Hổng biết cái máy của cậu có chớp được trong người tui hông ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507205
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507206
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507207
    m_Localized: "Marauder: Tai tui thường thâu, hổng có tàn tạ tơi tả như đám mèo hoang \nngoài đường."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507208
    m_Localized: 'Marauder: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507209
    m_Localized: 'Marauder: Vừa lòng chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507210
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507211
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507212
    m_Localized: 'Marauder: Hờ hờ, té ra răng xấu cũng là tội đáng chết hen? Thông cảm, tui người rừng, chưa có biết luật này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507213
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507214
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507215
    m_Localized: 'Marauder: Cậu tính bắn cha già ốm đói này chỉ vì lấy đồ hổng ai xài dẫy na? Thiệt sự luôn? Má nó hài.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507216
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507217
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507218
    m_Localized: 'Marauder: Trời quơi sao dẫy, bộ cậu thấy gì lạ hả? Có gì bình tĩnh nói chuyện cái được hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507219
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507220
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507221
    m_Localized: "Marauder: Nói chớ, tui mà lụm được thuốc bôi nách là tui cũng bán rầu, chớ hổng \nxài đâu."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507222
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507223
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507224
    m_Localized: 'Marauder: Mới coi có tấm hình thâu mà đã vội quánh giá người ta rầu. Thâu bắn mợ luôn đi, chịu thua cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507225
    m_Localized: 'Marauder: Ít ra tui cũng được giải thoát. Kiếp này khổ quá rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507226
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507227
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507228
    m_Localized: 'Marauder: Gì dẫy na? Tai tui bị làm sao?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507229
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507230
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507231
    m_Localized: 'Marauder: Hầu đó, tui có một ông bạn. Suốt ngày cà giựt, bồn chồn vì bị tróc mất miếng trám răng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507232
    m_Localized: 'Marauder: Xong rầu một bữa, ổng mất mợ nó cái đầu luôn. Lúc đó còn tâm trí đâu mà nghĩ tới răng lợi nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507233
    m_Localized: 'Marauder: Có lần tui lén vô một căn nhà, dòm trống hoác trống huơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507234
    m_Localized: 'Marauder: Tui thó được cái đồng hồ quả quýt cũ trên kệ, dòm cũng được giá. Mới vừa lấy xong thì chợt nghe tiếng bước chân trên lầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507235
    m_Localized: 'Marauder: Sợ hồn vía lên mây luôn. Tui co giò chạy thục mạng ra ngoài. Hổng cần biết có ai ở đó thiệt hông.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507236
    m_Localized: 'Marauder: Tự nhiên giờ tui mới thắc mắc... hổng biết cái đồng hồ có còn ở chỗ cũ hông nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507237
    m_Localized: 'Marauder: Đó, dẫy có phải hơn hông.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507238
    m_Localized: 'Marauder: À nhắc mới nhớ. Tui có lụm được cặp kiếng nhỏ này. Cỡ này chắc con nít đeo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507239
    m_Localized: 'Marauder: Trên tròng dính đầy vân tay luôn nè. Tui cứ tưởng tượng cảnh đứa nhóc này dòm nguyên thế giới qua cặp kiếng...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507240
    m_Localized: 'Marauder: Mà giờ mất kiếng rầu, chắc nó khổ sở lắm. Có khi hổng còn thấy gì hết trọi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507241
    m_Localized: 'Marauder: Khỏi lo, tui hổng sao hết. Nách có ngứa, có rát thì cũng tầm dăm ba bữa là hết. Bị miết chớ đâu. Quen rầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507242
    m_Localized: 'Marauder: Số tui là số khổ hoài. Từ xưa tới giờ, từ rày dìa sau cũng dẫy. Chịu thêm tí nữa cũng hổng chết được. Có tiền vẫn tốt hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507243
    m_Localized: 'Marauder: Có bữa... tui lụm được một tấm hình gia đình bốn người: hai vợ chồng, hai đứa con. Cả nhà cười tươi rói.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507244
    m_Localized: 'Marauder: Tui cứ bâng quơ nghĩ: Hổng biết nhà này có ai còn sống hông? Hay là hình này thành ảnh thờ luôn rầu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507245
    m_Localized: 'Marauder: Ở một mình lâu quá, tai mình bắt đầu nghe thấy tiếng thì thầm. Dù hổng có người xung quanh, nó vẫn cứ căng ra mà nghe... để phòng hờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507246
    m_Localized: 'Marauder: Biết dẫy đừng nên tới đây làm gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507247
    m_Localized: "Marauder: Biết dẫy đừng đi tin cái thằng \nkhốn nạn như cậu..."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507248
    m_Localized: 'GraveDigger: Chẹp… Thôi được, cậu cứ kiểm tra đi. Ngừ tui hông có gì để giấu... bao nhiêu ruột gan lộn hết ra ngoài rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507249
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507250
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507251
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507252
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507253
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507254
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507255
    m_Localized: 'GraveDigger: Lúc đào xuống quá sâu… thì lâu lâu mình cũng tìm thấy thứ khác ngoài hài cốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507256
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507257
    m_Localized: 'GraveDigger: Mấy cái răng trắng là của tui đó. Hàng thiệt trăm phần trăm! Còn vàng vàng bóng lộn thì... cứ coi như là nhặt được của rơi, tạm thời bỏ miệng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507258
    m_Localized: "GraveDigger: Tại để tụi nó nằm không dứ đất thì uổng. Mà vô tay tui cái xài lại thì \nngon ơ!"
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507259
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507260
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507261
    m_Localized: 'GraveDigger: Nhờ có hai bàn tay này mà tui mới kiếm ăn được qua ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507262
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507263
    m_Localized: 'GraveDigger: Ngón tay gồ ghề thô ráp như rễ cây, móng thì đen thui đen thít. Đất cát bám đầy trên đó, như ký ức hổng bao giờ rửa trôi được...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507264
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507265
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507266
    m_Localized: 'GraveDigger: Nghề tui chuyên làm ca đêm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507267
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507268
    m_Localized: 'GraveDigger: Ban ngày ngừ ta được thấy mặt trời, còn cú đêm như tui chỉ thấy cái đèn lập lòe trên đầu, với đống bóng đen lù lù dứ mộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507269
    m_Localized: "GraveDigger: Kể từ cái ngày định mệnh đó, lòng tui cứ nơm nớp lo sợ. Mắt thì dáo dác láo liên, lúc nào cũng sợ Dị Khách hù \nmột phát. Cực lắm cậu ơi."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507270
    m_Localized: 'GraveDigger: Ban ngày ngừ ta được thấy mặt trời, còn cú đêm như tui chỉ thấy cái đèn lập lòe trên đầu, với đống bóng đen lù lù dứ mộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507271
    m_Localized: 'GraveDigger: Thôi có khi như vậy lại là phước. Cả đời hông quen, hông biết ông mặt trời là ai hết...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507272
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507273
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507274
    m_Localized: "GraveDigger: Ờm, cách kiểm tra của cậu ngộ \nquá ha...?"
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507275
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507276
    m_Localized: 'GraveDigger: Nách tui nó ngứa thấy mẹ luôn, như kiểu đất cát mần tổ lúc nhúc ở đó. Mà tui thì suốt đêm bận đào, lấy thì giờ đâu mà cạo.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507277
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507278
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507279
    m_Localized: "GraveDigger: Hình chụp nguy hiểm lắm cậu ơi. Cũng như tấm gương vậy, thấy cái gì \nlà nó bắt lại cái đó."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507280
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507281
    m_Localized: 'GraveDigger: Hờ hờ... Dòm cũng thú vị ha. Cứ như mấy bóng đen á. Mà chắc là do ống kính bám bụi thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507282
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507283
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507284
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507285
    m_Localized: 'GraveDigger: Tai thôi cậu ơi, có gì đặc biệt đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507286
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507287
    m_Localized: 'GraveDigger: Quá xá bình thường luôn. Hổng bị cháy nắng hay rớt ra từng miếng. Vẫn còn ngon lành... có điều tui hổng muốn nghe gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507288
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507289
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507290
    m_Localized: "GraveDigger: Muốn bắn thì bắn luôn đi. Mà chừa mấy cái răng vàng cho tui nghen, không là tui phải hiện hồn \ndìa đòi đó... HùùÚÚùù..."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507291
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507292
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507293
    m_Localized: 'GraveDigger: Thôi, chắc cũng tới số rồi... Đôi tay này đã chạm vô quá nhiều xác chết. Giờ tụi nó rước tui theo cũng đúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507294
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507295
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507296
    m_Localized: 'GraveDigger: Thà mình bị mù, có khi còn tốt hơn…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507297
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507298
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507299
    m_Localized: "GraveDigger: Mới coi nách sơ sơ mà cậu đã sợ, thì tốt nhất đừng dòm vô suy nghĩ \ntrong đầu tui."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507300
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507301
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507302
    m_Localized: 'GraveDigger: Sao... Bộ cậu thấy gì trong đó hả? Mấy bóng hình mờ ảo sau lưng tui... Chắc là khói thôi mà, khói thôi cậu hen...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507303
    m_Localized: 'GraveDigger: Cái gì đó cậu? Ma hả? Tro bụi hả? Hay là miếng thịt treo lủng lẳng?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507304
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507305
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507306
    m_Localized: 'GraveDigger: Cậu có nghe thấy hông? Mặt đất đang thì thầm đó. Xì... xào... xì... xào...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507307
    m_Localized: 'GraveDigger: Nè, bóp cò đi. Bắn xong chắc nó sẽ im bặt luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507308
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507309
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507310
    m_Localized: "GraveDigger: Hồi trước, tui cứ cho là mần vậy mang tội lắm. Nhưng rồi... thấy cái xác cứ nằm im, há miệng, \nlộ hàm răng sáng lấp lánh..."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507311
    m_Localized: 'GraveDigger: Ui trời ơi, tui cầm lòng sao đặng. Chết rồi thì kệ xác bây, người sống cần hơn chớ. Chắc ngừ ta ở dứ... cũng giận tui lắm đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507312
    m_Localized: "GraveDigger: Lúc thì xài xẻng, lúc thì phải đào bằng tay không, tại mặt đất đóng băng, cứng như đá. Ngón tay chảy máu \ntừa lưa, mà vẫn phải đào."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507313
    m_Localized: 'GraveDigger: Đào tiếp, đào nữa, đào hoài, đào miết. Tại vì khi đào... đất sẽ thì thầm với mình... những tiếng mà cả đời cũng không thể quên được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507314
    m_Localized: 'GraveDigger: Có khi vừa lấp mộ xong, thì tui lại nghe tiếng sột soạt dưới đất. Dòm xuống thì hông thấy gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507315
    m_Localized: 'GraveDigger: Mắt tui cay xè hổng phải do thiếu ngủ. Mà vì những thứ tui đã chứng kiến, vì nỗi sợ khiến tui phải căng mắt coi chừng, không thì chạm mặt nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507316
    m_Localized: 'GraveDigger: Có khi vừa lấp mộ xong, thì tui lại nghe tiếng sột soạt dưới đất. Dòm xuống thì hông thấy gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507317
    m_Localized: 'GraveDigger: Mắt tui cay xè... hổng phải do thiếu ngủ. Mà vì những thứ tui đã chứng kiến, đã lỡ nhìn thấy quá nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507318
    m_Localized: 'GraveDigger: Có lần tui đi khiêng quan tài. Bữa đó đang hè, mồ hôi ướt áo mà ngứa nữa. Cái có thằng giỡn là: "Cứ như mình đi đào hố chôn chính mình vậy".'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507319
    m_Localized: 'GraveDigger: Xong tui chợt nghĩ... Chà, có khi vậy thiệt. Ngày qua ngày, tui đang dần chôn từng miếng, từng miếng của thân mình trong đống xác chết này.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507320
    m_Localized: 'GraveDigger: Lâu lâu, tui cứ lo là nó vẫn còn ở dứ đó... chỗ ông kia nằm. Chính tay tui đã chôn ổng mà, chắc chắn luôn... Thôi kệ đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507321
    m_Localized: 'GraveDigger: Hình chụp cũng như một khắc liên thông, nối liền hai cõi. Nó cho mình thấy những ngừ chưa về nơi chín suối, mà có khi lại ra đi quá sớm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507322
    m_Localized: 'GraveDigger: Hồi xưa ngừ ta có quan niệm, hình chụp sẽ cướp mất linh hồn. Giờ nghĩ lại... có lẽ nó chỉ lấy đi hơi ấm trong con ngừ mình thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507323
    m_Localized: 'GraveDigger: Thân tui từ lâu đã cứng ngắc cứng đờ, dòm cái hình thôi cũng thấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507324
    m_Localized: 'GraveDigger: Có đôi khi tui nằm xuống, ghé tai sát mặt đất. Kể từ cái ngày đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507325
    m_Localized: 'GraveDigger: Tui luôn nghe thấy tiếng ai gọi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507326
    m_Localized: 'GraveDigger: Chắc do tui thần hồn nát thần tính thôi. Mà nghĩ lại... có khi nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507327
    m_Localized: 'GraveDigger: Tụi Dị Khách đang núp lùm dứ đất, chờ ngày bò lên từng đứa một...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507328
    m_Localized: "GraveDigger: Tới lúc rồi... Để coi thế giới bên kia \ncó gì hông."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507329
    m_Localized: 'GraveDigger: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507330
    m_Localized: 'FormerFema: Ờ, anh cứ kiểm đi... Nhưng mà làm nhanh lên.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507331
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507332
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507333
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507334
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507335
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507336
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507337
    m_Localized: 'FormerFema: Anh kiểm tra coi bộ kỹ lưỡng phết ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507338
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507339
    m_Localized: 'FormerFema: Nói nghe cái... Trước còn đỡ, bây giờ thì mọi chuyện nát quá rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507340
    m_Localized: 'FormerFema: Có lần tụi tôi bắt được thằng cha này. Chỉ huy nhìn vào mồm chả, phán luôn đây là Dị Khách, vậy thôi là... ĐÙNG!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507341
    m_Localized: 'FormerFema: Nên tốt nhất anh đừng nên soi răng miệng kỹ quá. Để khỏi bị hỏi han lung tung ấy mà, hiểu hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507342
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507343
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507344
    m_Localized: 'FormerFema: Anh nói tôi phải tháo găng tay ra á? Không được, nguy hiểm lắm. Tôi chỉ cho anh kiểm tra khi đeo găng thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507345
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507346
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507347
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507348
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507349
    m_Localized: 'FormerFema: Ê, tôi thích phần kiểm tra này nè. Đôi mắt là cửa sổ tâm hồn, là nơi đẹp nhất mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507350
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507351
    m_Localized: 'FormerFema: Mắt đỏ á? Ờ thì... tại đeo cái mặt nạ dưỡng khí này nhiều quá nó vậy đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507352
    m_Localized: 'FormerFema: Làm mắt tôi yếu đi, tầm nhìn cũng hẹp lại. Cảm giác như phải nhìn qua lỗ soi cửa 24/24 á, có cởi mặt nạ ra cũng vậy luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507353
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507354
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507355
    m_Localized: 'FormerFema: Anh muốn kiểm chỗ đó thiệt hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507356
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507357
    m_Localized: 'FormerFema: Gớm lắm đúng hông…?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507358
    m_Localized: 'FormerFema: Này là do suốt ngày bận bộ đồ đó. Mồ hôi ướt nhẹp, da thì rạn nứt, còn thối rữa nữa. Cơ mà nhằm nhò gì, tôi trải qua nhiều chuyện tệ hơn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507359
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507360
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507361
    m_Localized: 'FormerFema: Tôi nói trước nhá, hình chụp ra có thể... hơi bị bất thường đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507362
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507363
    m_Localized: 'FormerFema: Người ta nói tôi là tiếp xúc với Dị Khách càng lâu, hào quang của mình sẽ càng quái dị hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507364
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507365
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507366
    m_Localized: 'FormerFema: Thiệt hả? Hông biết mấy đội khác như nào, chứ đội của tôi thì chưa từng có vụ kiểm tra chỗ này luôn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507367
    m_Localized: 'FormerFema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507368
    m_Localized: 'FormerFema: Tai tôi bình thường mà, có gì đâu mà xem. Kiểm làm gì cho phí thời gian.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507369
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507370
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507371
    m_Localized: 'FormerFema: Ê, từ từ đã, đừng mà. Răng tôi chắc chắn bình thường, đừng có bắn. Anh làm gì vậy hả?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507372
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507373
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507374
    m_Localized: 'FormerFema: Anh muốn tôi tháo găng tay ra chứ gì? Được rồi, chờ tôi một xíu đã... Không tháo luôn bây giờ được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507375
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507376
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507377
    m_Localized: 'FormerFema: Đôi mắt này đã phải chứng kiến quá nhiều. Có lẽ... tới lúc khép lại được rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507378
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507379
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507380
    m_Localized: 'FormerFema: Tôi biết là nó dị lắm, nhưng anh phải nghe tôi nói đã...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507381
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507382
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507383
    m_Localized: 'FormerFema: Đó tôi báo trước rồi mà. Anh tự chụp một tấm rồi soi lại hào quang của mình đi. Coi xong rồi hẵng chĩa súng vào tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507384
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507385
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507386
    m_Localized: 'FormerFema: Anh kiểm tra sai chỗ rồi đó, biết không hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507387
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507388
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507389
    m_Localized: 'FormerFema: Tôi không sao quên được ngày hôm đó. Cả nhóm chả thèm kiểm tra tử tế gì. Cứ đùng một phát mà tiễn người ta về chầu ông bà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507390
    m_Localized: 'FormerFema: Chưa chắc cha đó là Dị Khách nữa. Nên giờ tôi cũng chả buồn kiểm tra răng nữa, lỡ đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507391
    m_Localized: 'FormerFema: Ngày nào cũng phải bận đồ bảo hộ nực nội, mồ hôi như tắm, tay thì thối um... mà không cởi ra được! Cứ như nó là một phần của mình luôn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507392
    m_Localized: 'FormerFema: Chỉ cần bỏ găng tay ra... là cảm giác như đó không còn là tay của mình nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507393
    m_Localized: 'FormerFema: Ban đầu, tôi chỉ làm theo lệnh. Rồi tôi chợt nhận ra, mình chả nhìn người ra người nữa. Trước mặt chỉ còn là những bóng hình mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507394
    m_Localized: 'FormerFema: Rồi thì khói lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507395
    m_Localized: 'FormerFema: Rồi thì... trống rỗng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507396
    m_Localized: 'FormerFema: Tôi cứ nai lưng ra làm, tin tưởng rằng các sếp vẫn quan tâm đến an nguy của mình. Vậy mà hóa ra...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507397
    m_Localized: 'FormerFema: Hóa ra đách có thằng nào quan tâm mình cả. Muốn sống khỏe thì phải tự mình đấu tranh thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507398
    m_Localized: 'FormerFema: Không đấu tranh thì sẽ quen dần với cái khổ. Sống chung với nó hoài, rồi nó sẽ đeo theo mình tới chết...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507399
    m_Localized: 'FormerFema: Tôi hỏi chứ... Anh bày mấy trò này để làm gì? Tại sao lại cho người khác trú nhờ, rồi còn mất công kiểm tra từng người nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507400
    m_Localized: 'FormerFema: Lỡ đâu anh thấy mến ai đó, mà người đó lại là Dị Khách, thì anh có chịu được cảnh... phải giết chết người mình quý không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507401
    m_Localized: 'FormerFema: Không phải cứ thấy cái gì là cũng tin được đâu. Phải biết nghi ngờ mọi thứ, phải học cách phân biệt thật giả.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507402
    m_Localized: 'FormerFema: Đặc biệt, càng phải cảnh giác với tivi báo đài. Thời buổi này tin giả tràn lan, bị mua chuộc thao túng hết r...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507403
    m_Localized: 'FormerFema: Mà thôi, giờ còn tin ai được nữa chứ? Sao xã hội này nó phức tạp dữ vậy trời?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507404
    m_Localized: 'FormerFema: Ai mà đứng ra làm cho mọi thứ đơn giản đi, chắc sẽ được thiên hạ phong làm thánh đó. Hờ hờ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507405
    m_Localized: 'FormerFema: Ê, anh lầm to rồi! Đừng có dại dột!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931045507406
    m_Localized: 'FormerFema: TÔI LÀ NGƯỜI CỦA CƠ QUAN PHÒNG CHỐNG ĐÓ!!!'
    m_Metadata:
      m_Items: []
