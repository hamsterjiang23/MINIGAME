    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112389
    m_Localized: 'Alkonost: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112390
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112391
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112392
    m_Localized: 'Alkonost: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112393
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112394
    m_Localized: Tha mạng
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112395
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112396
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112397
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112398
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112399
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112400
    m_Localized: 'Sirin: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112401
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112402
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112403
    m_Localized: 'Sirin: Hồi kết đã điểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 23515512964112404
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 23515512968306688
    m_Localized: Tha mạng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341248
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341249
    m_Localized: 'Firefighter: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341324
    m_Localized: 'Wifefema: Hả? Kiểm tra chị á? Ờ, mà làm nhanh gọn thôi. Chị đây bận lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341325
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341326
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341327
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341328
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341329
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341330
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341331
    m_Localized: 'Wifefema: Đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341332
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341333
    m_Localized: 'Wifefema: Thấy chưa? Trắng như sữa, thẳng như cột. Cứ như là búp bê ấy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341334
    m_Localized: 'Wifefema: Lợi hơi chảy máu tí... Cơ mà bình thường thôi. Do hút thuốc nhiều ấy mà. Xì trét đó cưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341335
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341336
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341337
    m_Localized: 'Wifefema: Được thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341338
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341339
    m_Localized: 'Wifefema: Chú mày thấy sao? Cả nước đang lâm nguy thế này thì chị cũng chẳng có thời gian đi làm móng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341340
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341341
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341342
    m_Localized: 'Wifefema: Trong này khô không khốc lên được... Nên chị mới phải chớp mắt nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341343
    m_Localized: 'Wiffefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341344
    m_Localized: 'Wifefema: Xanh chưa, mắt chị đấy. Còn thế này là chị khóc vì vui sướng. Bởi chồng chị được làm bên Phòng Chống mà!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341345
    m_Localized: 'Wifefema: Nghe mà sướng hết cả người chú mày ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341346
    m_Localized: 'Wifefema: Xanh là phải rồi. Cơ mà mày nói mắt chị mờ hả? Không có đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341347
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341348
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341349
    m_Localized: 'Wifefema: Ông tướng cụp hộ tôi cái pha xuống nhá, không thì đừng có trách!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341350
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341351
    m_Localized: 'Wifefema: Hôm nọ vừa ôm tạm biệt ông xã, mà ngay hôm sau đã ngứa ngáy hết cả người.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341352
    m_Localized: 'Wifefema: Chẳng nhẽ lão già dẩm lồn này lây cho mình bọ chét?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341353
    m_Localized: 'Wifefema: Chị có đi đóng quảng cáo đâu mà phải tạo dáng với mày! Miễn đi cưng!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341354
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341355
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341356
    m_Localized: 'Wifefema: Mày đã nói vậy thì... đừng có để ông xã của chị thấy là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341357
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341358
    m_Localized: 'Wifefema: Ui giời... Mày còn muốn thế nào nữa? Chị có phải siêu mẫu đâu mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341359
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341360
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341361
    m_Localized: Đây, chú cứ xem.
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341362
    m_Localized: 'Wifefema: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341363
    m_Localized: 'Wifefema: Sao, khuyên tai chị á? Gớm, chị em phụ nữ muốn đeo trang sức làm đẹp mà cũng là cái tội à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341364
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341365
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341366
    m_Localized: 'Wifefema: Ô cái thằng giời đánh này?! Chị nhe ra cho chú mày chiêm ngưỡng hàm răng trắng bóc, mà mày lại chĩa nguyên khẩu súng vào mặt chị luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341367
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341368
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341369
    m_Localized: 'Wifefema: Ô hay! Móng tay chị thì làm sao?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341370
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341371
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341372
    m_Localized: 'Wifefema: Mắt chị thế này mà còn chưa đủ trắng à? Hờ! Chú mày được đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341373
    m_Localized: 'Wifefema: Không phải gu của mày hả? Hờ! Chú mày được đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341374
    m_Localized: 'Wifefema: Thôi, cất đồ chơi mà làm việc tiếp đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341375
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341376
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341377
    m_Localized: 'Wifefema: Giời ơi là giời! Da chị nổi mẩn thôi, đi mà hỏi thằng chồng chị ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341378
    m_Localized: 'Wifefema: Chú mày đừng có giở trò nhá...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341379
    m_Localized: 'Wifefema: Mày nhớ đấy, ông xã chị mà tóm được là chú mày biết tay! Cứ liệu hồn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341380
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341381
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341382
    m_Localized: 'Wifefema: Bố cái thằng dâm dê này nữa! ...Hay mày sợ ông xã chị phát hiện ra bộ sưu tập biến thái của mày?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341383
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341384
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341385
    m_Localized: 'Wifefema: Ô hay, các bà các cô làm đẹp thì động chạm gì đến mày à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341386
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341387
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341388
    m_Localized: 'Wifefema: Nụ cười là niềm kiêu hãnh của phái nữ đấy. Còn chảy máu nướu thì ai mà chả bị!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341389
    m_Localized: 'Wifefema: Răng chị thì làm sao? Mày liệu mà cất cây súng đi đi, may ra còn giữ được cái răng của mày!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341390
    m_Localized: 'Wifefema: Tay chị là bàn tay lao động chứ không phải để trưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341391
    m_Localized: 'Wifefema: Lo mà kiếm việc gì có ích cho đời đi... Lấy bản mặt khó ưa đấy đi lau sàn chẳng hạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341392
    m_Localized: 'Wifefema: Phải chi bên Phòng Chống nó tuyển chị! Đứng từ xa chị đã biết ngay ai là Dị Khách rồi! Còn cái ngữ như mày á, chị búng tay phát là bẹp dí ngay.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341393
    m_Localized: 'Wifefema: Đàn ông cứ thích bảo phụ nữ làm đẹp cơ. Chị mày đéo quan tâm. Tao muốn mặc đồ bảo hộ chứ đâu có muốn lên sân khấu trình diễn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341394
    m_Localized: 'Wifefema: Eo ôi, sợ quá!! Bớ làng nước ơi cứu tôi! Nó chụp ảnh tôi kìa! Xời ơi, có mỗi thế mà đòi bóp cò! Làm như mình quyền thế lắm!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341395
    m_Localized: 'Wifefema: Chính ra mấy thứ nhỏ nhặt này mới là quan trọng. Như cái đôi khuyên tai chết tiệt này. Đeo vào chị mới nhớ ra thân phận của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341396
    m_Localized: 'Wifefema: Mình là phụ nữ. Là con người. Còn chú mày... cứ đứng đấy làm như mình cao siêu lắm. Coi chị chả khác gì súc vật. Mày thì là cái thá gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341397
    m_Localized: 'Wifefema: Mày đúng là rách việc thật đấy. Ước gì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341398
    m_Localized: 'Wifefema: ...ông xã mình có ở đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341504
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341508
    m_Localized: "Nun: Tội lỗi không phải là thứ để nhâm nhi, thưởng thức đâu... Mà là ta sẽ \nnuốt trộng hết, con ạ."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341510
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341513
    m_Localized: 'Nun: Do tuổi già và thuốc diệt gián đấy. Mấy vết mẩn đỏ bám dai y như lũ vô thần… mà so với bọn chúng, thế này vẫn còn dễ chịu hơn nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341515
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341518
    m_Localized: 'Nun: Có vấn đề gì sao? Chỉ là năm tháng nhọc nhằn in vết trên đôi mắt ta thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341519
    m_Localized: 'Nun: Có vấn đề gì sao? Chỉ là tháng ngày mỏi mệt in vết trên đôi mắt ta thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341522
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341533
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341538
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341546
    m_Localized: 'Nun: Có mỗi khẩu súng cỏn con mà cũng đòi khiến ta xưng tội à? Dăm ba viên đạn ấy không thể nào thanh tẩy được cuộc đời tội lỗi của ngươi đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341548
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341549
    m_Localized: "Nun: Ta chẳng hề trông thấy bóng hình Đức Chúa trong ánh mắt ngươi. Điều đó làm ta khiếp sợ hơn bất kỳ thứ \nvũ khí nào của con người."
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341551
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341552
    m_Localized: 'Nun: Ngài luôn chứng kiến và phán xét tất cả. Mau nhìn lại cách ngươi đối xử với bà lão tội nghiệp này... mà lấy làm xấu hổ đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341554
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341555
    m_Localized: "Nun: Quỷ tha ma bắt ngươi đi! Ngươi tưởng máu ta đổ sẽ rửa trôi được tội lỗi của mình sao? Sao lại có thể \nvô minh như vậy chứ?"
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341556
    m_Localized: 'Nun: Ngươi hành xử như kẻ ngu dại mà vẫn điềm nhiên như không! Thực trắng trợn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341558
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341559
    m_Localized: 'Nun: Con à. Ta đã chứng kiến những nỗi kinh hoàng đủ để thiêu đốt linh hồn con. Thứ con đang vung vẩy kia, dưới mắt Chúa Trời, chỉ là món đồ chơi vớ vẩn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341560
    m_Localized: 'Nun: Hỡi ôi, con chiên mù quáng nghe lời thời sự dẫn dụ... để rồi chĩa mũi dùi tàn nhẫn vào chính đồng loại của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341562
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341563
    m_Localized: 'Nun: Ngươi cứ thử sống đến từng này tuổi mà không rụng mất cái răng nào xem!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341564
    m_Localized: 'Nun: Cứ nhét vào miệng toàn mấy thứ rác rưởi đi, rồi răng ngươi sẽ rụng trước cả ta đấy! ...Ấy là nếu Ngài cho phép chúng ta sống đến ngày đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341565
    m_Localized: 'Nun: Người ta vẫn thường nói, muốn biết cuộc đời ai đó ra sao thì cứ nhìn vào bàn tay họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341566
    m_Localized: 'Nun: Đời ta có gì? Chỉ toàn khổ đau...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341567
    m_Localized: 'Nun: Đôi mắt là cửa sổ tâm hồn. Nhưng con ơi... Soi vào mắt con, ta chỉ thấy mỗi một màn đêm bao phủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341568
    m_Localized: 'Nun: Ánh sáng chân tín đã rời bỏ con, cũng giống như lũ báng bổ đã xua đuổi ta khỏi nơi trú ngụ linh thiêng của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341569
    m_Localized: 'Nun: Cầu cho con nhận lấy hình phạt: vĩnh viễn lạc lối trong bóng đêm, bởi trong ánh mắt con đã không còn hiện hữu ân sủng hay đức tin nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341570
    m_Localized: 'Nun: Con có "kiểm tra" bao nhiêu lần cũng vậy thôi. Chân lý vốn chẳng nằm ở cái vỏ bên ngoài, mà ngự trong tâm mỗi chúng ta cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341571
    m_Localized: 'Nun: Lạy Cha chúng con ở trên cao! Xin hãy soi đường để tôi tớ của Ngài, kẻ đã lạc bước vì cám dỗ quyền năng, về với ánh sáng chính đạo…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341572
    m_Localized: 'Nun: Mấy bức ảnh ngươi chụp chẳng khác gì mớ giấy lộn! Nhảm nhí vô cùng!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341573
    m_Localized: 'Nun: Khi người ta chết đi rồi, những vật tùy thân lúc sinh thời chẳng còn có ai ngó ngàng chăm sóc!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341574
    m_Localized: 'Nun: Đó là di sản duy nhất chúng ta để lại. Cả ngươi cũng sẽ trôi vào quên lãng. Vậy mà giờ ngươi vẫn đứng đây, mồm miệng huyên thuyên như kẻ ngốc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341575
    m_Localized: 'Nun: Đức Chúa nhân từ đã ban cho ta đôi tai thính nhạy... Thế mà ta phải kẹt ở xó này với một kẻ ngu dại, vui mừng chỉ vì hắn được... được...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341576
    m_Localized: "Nun: ...Có Trời mới biết hắn được cái gì! Cứ vung vẩy khẩu súng chết giẫm, \nnhư thể ý mình là tối thượng!"
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341577
    m_Localized: 'Nun: Cầu Cha thương xót… Con không muốn phải chứng kiến thứ gì tàn nhẫn như con người lần nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931020341578
    m_Localized: 'Nun: Ôi lạy Chúa nhân từ… Xin hãy đón nhận lấy…'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535564
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535565
    m_Localized: 'Fugitive: Nhìn bẩn lắm đúng không? Tại tôi rơi xuống vũng nước lúc đang chạy trốn bọn chó đấy. Đã vậy trước đó còn bị cứa vào dây kẽm gai nữa cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535566
    m_Localized: 'Fugitve: Ừ, cậu cứ nhìn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535567
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535568
    m_Localized: 'Fugitive: Nhìn bẩn lắm đúng không? Tại tôi rơi xuống vũng nước lúc đang chạy trốn bọn chó đấy. Mà ý cậu không phải nói đất bùn đâu nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535569
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535570
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535571
    m_Localized: 'Fugitive: Được thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535572
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535573
    m_Localized: 'Fugitive: Giờ tôi biết phải cẩn thận cái mắt mình rồi, lỡ mà liếc nhầm con chó điên nào đấy lại dính một quả thì toi. Bài học xương máu đấy cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535574
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535575
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535576
    m_Localized: 'Fugitive: Vãi cả chưởng... Có giỡn mặt tôi không đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535577
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535578
    m_Localized: 'Fugitive: Thì phải cạo cho sạch chứ, không lại để nó lan ra cả rừng à? Đến lúc đấy thì ai chịu giúp tôi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535579
    m_Localized: 'Fugitive: Ừ tôi đéo cạo lông nách đấy, được chưa? Lo chạy bán sống bán chết, còn bị bắn nữa thì thời gian đâu mà cạo? '
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535580
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535581
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535582
    m_Localized: 'Fugitive: Ờ thì... OK. Giờ cũng còn người chụp ảnh cơ à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535583
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535584
    m_Localized: 'Fugitive: Trước giờ tôi vốn chả thích chụp ảnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535585
    m_Localized: 'Fugitive: Sao... thế nào rồi? Ê khoan... đừng có lấy cái này mà bán đứng tôi cho bọn Thảm Hại nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535586
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535587
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535588
    m_Localized: 'Fugitivie: Thật luôn? Cậu không thấy mấy "dấu hiệu" này chỉ tổ khiến dân mình thêm hoang mang hơn à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535589
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535590
    m_Localized: 'Fugitive: Bẩn lắm nhỉ? Ừ phải rồi. Cứ làm việc quần quật mà không tắm rửa thì ai chả thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535591
    m_Localized: 'Fugitive: Thật luôn? Cậu nghĩ kiểm tai thôi mà truy ra được Dị Khách ngay á? Thế thì kiểm con mẹ nó đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535592
    m_Localized: 'Fugitive: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535593
    m_Localized: 'Fugitive: Bẩn lắm phải không? Ừ thì dăm ba chuồng lợn của bọn Thảm Hại đéo có vòi nước nóng hay bông ngoáy tai đâu. Phục vụ dân thế đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535594
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535595
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535596
    m_Localized: 'Fugitive: Đừng có làm trò dại dột. Tôi xơi một viên kẹo đồng là ngán lắm rồi, éo muốn xơi nữa đâu nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535597
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535598
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535599
    m_Localized: 'Fugitive: Cậu định giết tôi chỉ vì hai bàn tay này ấy hả? Thế thì ra ngoài mà tàn sát cả thành phố luôn cho nó vuông.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535600
    m_Localized: 'Fugitive: Cậu định giết tôi chỉ vì hai bàn tay bẩn ấy hả? Thế thì ra ngoài mà tàn sát cả thành phố luôn cho nó vuông.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535601
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535602
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535603
    m_Localized: 'Fugitive: Đời tao đã kinh qua đủ thứ tâm thần, rồ dại, dị hợm các kiểu rồi. Mà giờ mày cũng đéo hơn gì chúng nó!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535604
    m_Localized: 'Fugitive: Ít ra mày không đem người khác ra làm thí nghiệm... Công đức vô lượng mẹ luôn, thằng kiệt lặc!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535605
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535606
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535607
    m_Localized: 'Fugitive: Này nhé. Cậu bảo tôi làm gì là tôi làm theo răm rắp rồi. Còn muốn cái đéo gì nữa?!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535608
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535609
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535610
    m_Localized: 'Fugitive: Cái gì? Cậu định lấy ảnh này làm ảnh thờ tôi luôn đấy hả? Chu đáo quá thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535611
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535612
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535613
    m_Localized: 'Fugitive: Địt mẹ tha hộ cái. Muốn tôi ngoáy tai cho sạch thì ngoáy đây! Đừng có dí súng vào mặt người ta nữa!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535614
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535615
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535616
    m_Localized: 'Fugitive: Bọn chó áo vàng đâu có lắp gương trong chuồng. Làm gì có ai muốn thấy mặt mình lúc mình bị biến thành kiếp trâu lợn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535617
    m_Localized: 'Fugitive: Địt mẹ, cậu càng ngày càng giống lũ chó áo vàng. Cứ hễ nghi nghi cái gì là cầm súng bắn tại chỗ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535618
    m_Localized: 'Fugitive: Này nhá, gặp tôi hiền tôi còn bỏ qua cho, chứ người khác thì... còn khuya. Người ta ghim đấy. Đến lúc bị ăn đạn trả thù thì đừng có trách.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535619
    m_Localized: 'Fugitive: Mấy con chó Thảm Hại đéo bao giờ nhìn vào mắt ai. Dù là dân nó bắt hay chính đồng nghiệp, nó cũng đều lảng tránh. Cậu có biết tại sao không? Hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535620
    m_Localized: 'Fugitive: Trong chuồng cách ly có thằng này tội vãi, cứ lấy tay gãi gãi đến khi không gãi được nữa thì thôi. Tại bị nấm hay gì ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535621
    m_Localized: 'Fugitive: Trong chuồng cách ly có thằng này tội vãi, cứ lấy tay gãi gãi đến khi không gãi được nữa thì thôi. Tại bị căng thẳng hay gì ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535622
    m_Localized: 'Fugitive: Lúc mới đến khu cách ly, bọn chó Thảm Hại cũng bắt tụi tôi chụp ảnh. Để "ghi hồ sơ" hay cái mẹ gì ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535623
    m_Localized: 'Fugitive: ...Nhỡ chúng nó đến đây giơ ảnh ra, bảo tìm tôi thì đừng có giao tôi ra nhé? Tôi đéo muốn về đấy đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535624
    m_Localized: 'Fugitive: Người ta bảo là sống mãi trong thinh lặng, tai mình sẽ bắt đầu nghe thấy ảo giác. Tôi từng trải luôn rồi, lúc còn sống trong chuồng cách ly ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535625
    m_Localized: 'Fugitive: Vãi lồn... Tránh vỏ dưa lại gặp vỏ dừa. Thoát được lũ chó điên này... lại gặp phải thằng hâm khác...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535626
    m_Localized: 'Fugitive: ...Chết mẹ mày đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535627
    m_Localized: 'Bestson: Ừm... Dạ rồi... Xong thì anh hứa với em mọi chuyện đều ổn hết nha anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535637
    m_Localized: 'Bestson: Chỉ là... lâu lâu nướu em bị chảy máu á. Chắc tại bệnh tiểu đường, hoặc cũng có thể do... em hay bị căng thẳng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535647
    m_Localized: 'Bestson: Úi chết... Quên mất tiêu vụ cắt móng tay luôn. Ba hay dặn em cắt móng, mà hổng bao giờ em thành thói được hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535648
    m_Localized: 'Bestson: Còn khớp tay em thì... Ừm, hông có gì quan trọng đâu anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535654
    m_Localized: 'Bestson: Kiểu, em thấy nó có sao đâu... Nói chứ dạo này em cũng hơi cay mắt một xíu, chắc do... dính bụi thôi á. Hoặc bị dị ứng này nọ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535664
    m_Localized: 'Bestson: Anh muốn chụp một tấm hở? À thì... dạ anh cứ chụp đi. Chụp xong... hứa với em là hông có vấn đề gì hết nha anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535675
    m_Localized: 'Bestson: Cũng có người bị tật bứt tóc hay cắn móng tay mà... Còn em thì chắc là... hay móc răng. Nhưng mà... đâu tới nỗi nào đâu ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535676
    m_Localized: 'Bestson: Thôi mà... Em cũng biết răng mình không được chắc khoẻ gì lắm...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535704
    m_Localized: 'Bestson: Còn ba thì cười, nói em thừa hưởng nắm đấm cứng cáp của ba. Lực y như ba hồi trẻ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535705
    m_Localized: 'Bestson: Nhưng giờ ngắm nghía lại nó thì... em hông hiểu sao nữa. Hổng thể nhớ nổi tay ba mẹ nhìn như nào hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535706
    m_Localized: 'Bestson: Giờ cứ mỗi khi em đụng khớp tay là nó lại đau. Đó, dù biết vậy là sai lắm, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535707
    m_Localized: 'Bestson: Những lúc em ở một mình á... ngóng trông cả nhà trở về... mà hông ai về hết... thì em cũng hổng biết làm sao nữa anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535708
    m_Localized: 'Bestson: Thành ra lâu lâu em cứ siết chặt nắm đấm, rồi đấm thật mạnh vào tường. Thà vậy còn hơn là cứ cắn môi ngồi không.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535709
    m_Localized: 'Bestson: Có mỗi chuyện này thì đâu đáng để chê trách em, đúng hông anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535710
    m_Localized: 'Bestson: Mỗi khi mẹ nói chuyện với em, mẹ sẽ nhìn một con mắt trước, rồi nhìn mắt còn lại. Mà nhanh như cắt ý! Liếc qua liếc lại cái vèo!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535711
    m_Localized: 'Bestson: Còn ba thì... chọn đúng một mắt thôi. Chỉ nhìn thẳng vào nó, hông quay đi đâu hết. Hổng biết... giờ ba sẽ nhìn vào mắt nào nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535712
    m_Localized: 'Bestson: Ừm... anh làm vậy cũng đúng. Tại em khóc nhiều lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535713
    m_Localized: 'Bestson: Sao mà không khóc được hở anh, khi em còn có một mình? Khi hổng ai chịu nghe máy? Khi ba mẹ... biến mất không tăm hơi?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535714
    m_Localized: 'Bestson: Thật tình ý, em hổng có muốn khóc đâu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535715
    m_Localized: 'Bestson: Chỉ tại... em hông biết làm sao chịu nổi cảnh cô độc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535716
    m_Localized: 'Bestson: Lúc nào em cũng tin là chỉ cần làm đúng y như những gì được dạy, thì chuyện sẽ trơn tru trót lọt vậy thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535717
    m_Localized: 'Bestson: Người ta dặn mình rửa mặt, thì mình rửa. Kêu hông được nói leo, thì hông nói thôi. Như vậy có gì sai đâu ha anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535718
    m_Localized: 'Bestson: Nhưng mà... bây giờ... hổng còn ai chỉ bảo em phải làm gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535719
    m_Localized: 'Bestson: Không còn ai chỉ em... thì em phải tự thân quyết định hả anh? Nhưng lỡ rồi em chọn sai thì sao anh ơi...?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535720
    m_Localized: 'Bestson: Chắc sẽ có người thấy lạ lắm, nhưng nói thật với anh... em chưa bao giờ để ý mấy tới ngoại hình của mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535721
    m_Localized: 'Bestson: Chỉ cần ba mẹ khen em đẹp trai thôi là đủ rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535722
    m_Localized: 'Bestson: Giờ không còn ba mẹ thì... em... cũng hỏng buồn quan tâm luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535723
    m_Localized: 'Bestson: Em hổng thích tấm hình này anh ơi. Cụ thể sai chỗ nào thì em hông rõ, nhưng mà nhìn nó...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535724
    m_Localized: 'Bestson: Cứ như đang có gì đè nặng em xuống á anh. Vậy có được bình thường hông nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535725
    m_Localized: 'Bestson: Hào quang của mình có ẩn chứa ý nghĩa gì thật hở anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535726
    m_Localized: 'Bestson: Thật tình em cũng hổng biết nữa... Đó giờ em chưa từng thấy cái gì như vậy hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535727
    m_Localized: 'Bestson: Nhưng mà lỡ như hào quang của em không giống ba mẹ... thì có khi nào em khác xưa rồi hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535728
    m_Localized: 'Bestson: Rồi biết đâu tại em thay đổi, nên ba mẹ nhìn hổng ra em nữa luôn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535729
    m_Localized: 'Bestson: Em cứ ngóng trông tiếng họ gõ cửa, chờ hoài chờ hoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535730
    m_Localized: 'Bestson: Để được nghe giọng nói ba mẹ, tiếng bước chân thân thương của cả nhà...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535731
    m_Localized: 'Bestson: ...Nhưng rồi chỉ có tĩnh lặng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535732
    m_Localized: 'Bestson: Thời gian cứ trôi đi tuồn tuột, còn em thì dần cảm giác như...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535733
    m_Localized: 'Bestson: Cảm giác như mình chẳng hề tồn tại vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535734
    m_Localized: 'Bestson: Tại mình hết... Mình lại làm chuyện bung bét hết nữa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535790
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535818
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535819
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535820
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535821
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535822
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535829
    m_Localized: 'Fatman: Có đứa mới rít một hơi đã lăn quay ra. Còn anh á? Anh phê suốt cả đời rồi nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535830
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535831
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535832
    m_Localized: 'Fatman: Chú nhìn kỹ vào đây này...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535833
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535834
    m_Localized: 'Fatman: Đây nhé, di vật vang bóng một thời đó. Bàn tay anh từng mân mê bao nhiêu ly rượu rồi xì gà, e hèm, từng lèo lái cả một đất nước. Thế mà giờ đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535835
    m_Localized: 'Fatman: Nhiều lúc muốn nhấc tay lên cũng không nổi. Làm cái gì cũng mệt nhọc, khó khăn lắm mày ạ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535836
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535837
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535838
    m_Localized: 'Fatman: Rồi, rồi, đợi tí...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535839
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535840
    m_Localized: 'Fatman: Sao nào? Thấy gì không? Tưởng anh mày nát rượu phỏng? Éo nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535841
    m_Localized: 'Fatman: Sao nào? Thấy gì không? Tưởng anh mày nát rượu phỏng? Éo nhá. Chỉ là đời mà không rượu thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535842
    m_Localized: 'Fatman: ...Ầy, thôi dẹp. Mày thỏa mãn chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535843
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535844
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535845
    m_Localized: 'Fatman: Hừm. Kiểm tra kiểu gì mà cổ lỗ sĩ phết.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535846
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535847
    m_Localized: 'Fatman: Chú mày hèn thế, đây nhằm nhò gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535848
    m_Localized: 'Fatman: Hờ. Anh từng nghe người ta bảo lông nách là biểu tượng của, à hèm, sức mạnh đấy nhá.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535849
    m_Localized: 'Fatman: Được vậy thì một mình anh bằng ba sức người. Thế mà lúc cần anh lại đéo thấy đâu nhỉ? Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535850
    m_Localized: 'Fatman: Bố tổ, đúng là cuộc đời đảo điên...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535851
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535852
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535853
    m_Localized: 'Fatman: Ô kê. Đợi anh mày đứng dậy cái đã... Nhớ hồi xưa quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535854
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535855
    m_Localized: 'Fatman: Sao? Trông ổn không? Không khác gì chứ? Hà hà!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535856
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535857
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535858
    m_Localized: 'Fatman: Trong ấy có gì mà nhìn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535859
    m_Localized: 'Fatman: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535860
    m_Localized: 'Fatman: Đấy, đôi tai của bộ trưởng đó nhá. Đã nghe qua hết mọi âm thanh trên đời rồi. Hết tiếng thì thầm... rồi, ừm, tiếng gào thét...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535861
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535862
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535863
    m_Localized: 'Fatman: Ái chà chà, thằng này gan nhở. Bắn đi xem nào. Rồi xem mày sống ra sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535864
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535865
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535866
    m_Localized: 'Fatman: Căng thẳng vãi lồn... đang hút mà lỡ tay bóp nát điếu thuốc lúc nào không hay. Tàn thuốc dính hết vào móng tay, khó chịu thực sự.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535867
    m_Localized: 'Fatman: Sao? Ở nhà mày có luật đéo được làm thế à? Hửm?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535868
    m_Localized: 'Fatman: Tay như này thì anh cũng chết trong lòng từ lâu rồi. Thôi chú bắn đi... cho anh được giải thoát.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535869
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535870
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535871
    m_Localized: 'Fatman: Ờ, bắn đi xem nào. Chậc... Ông cũng dí cặc quan tâm mọi chuyện kết thúc ra sao nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535872
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535873
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535874
    m_Localized: 'Fatman: Chậc... Cái nách làm rách con người! Ở đời ai chả có vấn đề này nọ, mày lắm chuyện!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535875
    m_Localized: 'Fatman: Nào, bóp cò luôn đi. Bắn xong trái đất vẫn quay đều đều nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535876
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535877
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535878
    m_Localized: 'Fatman: Nếu ảnh này buộc tội anh thì anh chấp nhận. Hồi trước anh cũng toàn quyền sinh sát người khác. Thôi chú mày xử gọn luôn đi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535879
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535880
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535881
    m_Localized: 'Fatman: Mày đang đùa anh đấy à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535882
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535883
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535884
    m_Localized: 'Fatman: Hồi trước nha sĩ chỗ anh bảo: "Anh càng hút thuốc thì sau này răng càng rụng đấy". Thế là anh bật lại: "Mày biết bố mày là ai không?!"'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535885
    m_Localized: 'Fatman: Giờ anh soi gương rồi tự nghĩ... hóa ra chịu bao nhiêu căng thẳng thế cũng chả đáng gì. Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535886
    m_Localized: 'Fatman: Ngày trước, anh chỉ cần ký một cái là cả đời người lên hương ngay! ...Giá mà có ai cũng làm vậy với anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535887
    m_Localized: 'Fatman: Mày đang đùa anh kiểu gì nữa đây? Nhìn thì trừng trừng, rồi rút súng chực bắn. Sao mà đần thế chứ! Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535888
    m_Localized: 'Fatman: Trước kia mắt anh tinh lắm... sáng lắm. Còn giờ... tối đen như mực. Cũng tại bụi trần cuộc sống. Anh chả thèm lau nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535889
    m_Localized: 'Fatman: Mày thì sao biết được anh đổ mồ hôi, sôi nước mắt biết bao nhiêu. Muốn đi bác sĩ mà cũng chả có thời gian. Bận tối mắt tối mũi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535890
    m_Localized: 'Fatman: Mày làm sao mà hiểu được những gì anh phải trải qua chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535891
    m_Localized: 'Fatman: Hồi anh còn trẻ, anh có biết một thằng... à hèm, sở hữu bộ "vi-ô-lông" dưới nách như anh đây. Nó bảo lông nó dài như công chúa tóc mây luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535892
    m_Localized: 'Fatman: Rồi có đứa "hoàng tử" xáp lại đòi quyết tử với nó. Rốt cuộc thằng đấy có phải công chúa đâu, vẫn chết như thường. Lông mấy cũng chả cứu nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535893
    m_Localized: 'Fatman: Mày biết không... Có mấy lần, người ta muốn, e hèm, "xóa sổ" anh mày rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535894
    m_Localized: 'Fatman: Nào đốt ảnh, nào xé giấy, thậm chí có lần còn dí anh suýt chết cơ. Đó mà mày xem, anh mày vẫn sống sờ sờ đấy thôi? Hờ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535895
    m_Localized: 'Fatman: Cuối cùng vẫn còn dấu vết chứ sao mà xóa hết được... Thằng tù nhân thì nhớ tên thằng thẩm phán, âu cũng là lẽ thường tình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535896
    m_Localized: 'Fatman: Đôi khi... chỉ mong đời im lặng một chút. Nhưng nào có yên cho nổi. Không ai nói gì thì trong đầu mình vẫn văng vẳng tiếng ồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535897
    m_Localized: 'Fatman: Địa ngục cũng chỉ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535898
    m_Localized: 'Fatman: Đến thế này thôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535899
    m_Localized: 'Blind: Cậu cứ thoải mái kiểm tra tôi. Nhưng... sẽ chẳng có gì thay đổi. Vạn vật chỉ là phù du.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535900
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535901
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535902
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535903
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535904
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535905
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535906
    m_Localized: 'Blind: Mà cậu biết không... hàm răng của tôi là nhân chứng cuối cùng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535907
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535908
    m_Localized: 'Blind: Tôi nhai ngấu sự thật rồi mắc nghẹn, đến khi ứ đầy cổ họng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535909
    m_Localized: 'Blind: Tôi siết chặt nắm tay đến trắng hếu từng khớp xương, trong lúc ánh nhìn lướt qua NÓ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535910
    m_Localized: 'Blind: Giờ đôi tay tôi chỉ còn nắm lấy hư vô, chờ cho tới lúc được sà vào lòng thần chết, để người xóa sạch mọi ám ảnh khỏi tâm trí.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535911
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535912
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535913
    m_Localized: 'Blind: Bàn tay tôi có cử động không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535914
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535915
    m_Localized: 'Blind: May quá... Vậy là NÓ vẫn chưa rút cạn hết sự sống trong tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535916
    m_Localized: 'Blind: Nhưng tôi... tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535917
    m_Localized: 'Blind: Tôi ngấu nghiến, gào thét, nôn mửa, xé nát thân mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535918
    m_Localized: 'Blind: Sọ tôi nứt toạc. Não văng tung tóe lên những bức tường.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535919
    m_Localized: 'Blind: Trên tường, cửa sổ, cửa ra vào... Đâu đâu cũng có mặt NÓ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535920
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535921
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535922
    m_Localized: 'Blind: Ha ha ha ha... Chẳng có gì khác thường ở đây cả!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535923
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535924
    m_Localized: 'Blind: NÓ rất thích được người ta nhìn thấy. Tôi không thể mô tả NÓ, vì tâm trí người phàm khó mà gánh chịu nỗi kinh hoàng NÓ gây ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535925
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535926
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535927
    m_Localized: 'Blind: Buồn cười nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535928
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535929
    m_Localized: 'Blind: Cậu có biết bóng đen bệnh tật bao trùm lên gì trước tiên không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535930
    m_Localized: 'Blind: Không à?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535931
    m_Localized: 'Blind: Giờ tôi biết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535932
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535933
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535934
    m_Localized: 'Blind: Cứ dùng đèn chớp đi. Tôi chẳng quan tâm.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535935
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535936
    m_Localized: 'Blind: Cậu còn không cho tôi xem tấm hình đấy như nào à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535937
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535938
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535939
    m_Localized: 'Blind: Cậu nghe thấy không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535940
    m_Localized: 'Blind: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535941
    m_Localized: 'Blind: Yên ắng quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535942
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535943
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535944
    m_Localized: 'Blind: Vũ khí cũng không nhằm nhò gì... với NÓ đâu. Trên đời này chắc chẳng có thứ gì làm NÓ suy suyển nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535945
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535946
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535947
    m_Localized: 'Blind: Trong mơ, tôi tưởng như chạm được vào NÓ... Cảm nhận dáng hình ấy, sức nặng ấy... Và rồi... NÓ tan biến. Chỉ để lại nỗi khiếp sợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535948
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535949
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535950
    m_Localized: 'Blind: Mắt ta cứ dán chặt vào NÓ. Muốn nhìn đi chỗ khác cũng không xong... chỉ còn nước móc hẳn mắt ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535951
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535952
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535953
    m_Localized: 'Blind: Nỗi đau nhói râm ran lan đến từng thớ thịt. Làn da tôi thét gào đòi được róc bỏ... cảm giác kinh khủng không chịu được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535954
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535955
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535956
    m_Localized: 'Blind: Hồi trước tôi mê chụp ảnh lắm. Thích tìm tòi khám phá từng chút một...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535957
    m_Localized: 'Blind: Mà giờ thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535958
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535959
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535960
    m_Localized: 'Blind: Phải chi mà cậu nghe được cái cách NÓ trườn bò...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535961
    m_Localized: 'Blind: Nhịp chân của NÓ và cậu đan xen, trộn lẫn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535962
    m_Localized: 'Blind: Không khí xung quanh run lên bần bật khi NÓ nếm thử mùi hương của cậu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535963
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535964
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535965
    m_Localized: 'Blind: Đã bao giờ cậu nghe tiếng thứ gì nhai ngồm ngoàm... mà không ăn, không nuốt chút nào chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535966
    m_Localized: 'Blind: Rồi chậm rãi thưởng thức từng mùi hương, giọng nói, từng cái run rẩy của cậu?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535967
    m_Localized: 'Blind: NÓ là như vậy đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535968
    m_Localized: 'Blind: Luôn chực chờ... đến khi tôi cũng bắt đầu nhai nuốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535969
    m_Localized: 'Blind: Rồi... cơn đau ập đến. Tôi tỉnh dậy ướt đẫm mồ hôi. Bàn tay bịt lấy miệng mình như muốn kìm nén tiếng thét.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535970
    m_Localized: 'Blind: NÓ chẳng hề hãi sợ ánh nhìn đăm đăm. Trái lại còn thèm khát nữa là.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535971
    m_Localized: 'Blind: NÓ lan ra khắp đồng tử.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535972
    m_Localized: 'Blind: NÓ run rẩy dưới hàng mi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535973
    m_Localized: 'Blind: NÓ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535974
    m_Localized: 'Blind: Thực xin lỗi... bỗng dưng tôi thấy không được khỏe...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535975
    m_Localized: 'Blind: Khi NÓ trườn đến...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535976
    m_Localized: 'Blind: Khi NÓ bò khắp cơ thể, ngấm sâu vào tận xương tủy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535977
    m_Localized: 'Blind: Khoảnh khắc NÓ chạm vào người, ta sẽ cảm nhận được NÓ len lỏi dưới lớp da thịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535978
    m_Localized: 'Blind: Và rồi... làn da chẳng còn là của ta nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535979
    m_Localized: 'Blind: Mà ta... cũng không còn là chính bản thân mình...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535980
    m_Localized: 'Blind: Ấy là nỗi đau đớn tột cùng...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535981
    m_Localized: 'Blind: Nếu chẳng may... sinh vật đó có bao giờ tìm thấy cậu...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535982
    m_Localized: 'Blind: Làm gì thì làm, TUYỆT ĐỐI đừng tìm cách thu lại hình ảnh của NÓ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535983
    m_Localized: 'Blind: Như vậy chỉ càng khiến NÓ hung hãn... Tiếp thêm sức mạnh để NÓ nuốt trọn người phàm chúng ta!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535984
    m_Localized: 'Blind: Tôi đã nghe thấy NÓ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535985
    m_Localized: 'Blind: Không phải ngay lúc tôi nhìn thấy NÓ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535986
    m_Localized: 'Blind: Mà trước đó cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535987
    m_Localized: 'Blind: Trước khi NÓ đến kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535988
    m_Localized: 'Blind: Một tiếng dao động rất khẽ... tựa như ai đó đang bám theo sau lưng, chỉ cách độ mười bước...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535989
    m_Localized: 'Blind: Rồi năm bước...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535990
    m_Localized: 'Blind: Và khi ta quay đầu lại... thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535991
    m_Localized: 'Blind: Thực xin lỗi. Điều này chỉ mình tôi biết là đủ. Tin tôi đi, cậu đừng nên nghĩ về nó thì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535992
    m_Localized: 'Blind: NÓĐẾNRỒINÓĐẾNRỒINÓĐẾNRỒINÓĐẾNRỒINÓĐẾNRỒINÓĐẾNRỒINÓĐẾNRỒI!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535993
    m_Localized: 'Blind: NÓ... đến rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535995
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535996
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535997
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535998
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024535999
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536000
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536003
    m_Localized: 'Dude: Nhìn bộ hàm như kiểu, cả đời tui toàn cắn bắp cắn mía chứ hông ăn cơm ăn cháo ha?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536004
    m_Localized: 'Dude: Bro, coi vậy thôi chứ răng tui cứng như đá, khỏe như trâu luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536005
    m_Localized: 'Dude: Có lần tui lấy răng bật nắp chai bia... Mém xíu thì cắn lưỡi, nhưng bia mát lạnh nó cứ tuôn chảy vô họng. Trời má nó đããããã.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536006
    m_Localized: 'Dude: Kiểu... phê như hút cần luôn ông à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536007
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536008
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536009
    m_Localized: 'Dude: Ê kể nghe, trước tui chơi trò, kiểu, đi đào kho báu á. Thành ra tay nó dính đất. Thường thôi mà bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536010
    m_Localized: 'Dude: Ái ui!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536012
    m_Localized: 'Dude: Có lần á, tui phê quắc cần câu luôn... Cứ nhìn ngón tay xong kiểu, ê, tay mình trước giờ nó dị dị vậy đó hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536013
    m_Localized: 'Dude: Tui cử động mấy đốt tay rồi ngắm tụi nó ngoe nguẩy ngọ nguậy... Ảo xoắn não luôn bạn ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536014
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536015
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536016
    m_Localized: 'Dude: Kiểm lẹ lẹ nha bro, mở mắt ra nhìn lâu là tui dễ xì choét lắm ông ơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536018
    m_Localized: 'Dude: Đồng tử tui á? Kệ nó đi ông ơi, người ta suốt ngày săm soi bắt bẻ tui vụ này ở cửa hàng. Ngán lắm rồi bro à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536019
    m_Localized: 'Dude: Nó bị đỏ lòm hả? Kệ đi ông ơi, người ta suốt ngày săm soi bắt bẻ tui vụ này. Ngán lắm rồi bro à.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536020
    m_Localized: 'Dude: Ây yo, để bữa nào tui kể con vợ nghe chuyện đó cho, đảm bảo sốc tới tận óc.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536021
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536022
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536023
    m_Localized: 'Dude: Chờ xíu nha bro... Coi show lột đồ khỏa thân trước chứ hả, hề hề.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536025
    m_Localized: 'Dude: Ngứa quá trời ngứa luôn. Nghe đâu là do hông chịu giặt đồ á... Thôi kệ đi con vợ ơi, cứ hồn nhiên như cây cỏ, ở dơ mới sống lâu chớ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536026
    m_Localized: 'Dude: Mượt như mông em bé luôn. Ờ thì cũng gần gần vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536027
    m_Localized: 'Dude: Con vợ nghĩ thử coi... Ngày nay mà để lông nách mọc lởm chởm thì được ích lợi gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536028
    m_Localized: 'Dude: Thời hiện đại rồi chứ có phải thời đồ đá nữa đâu bro.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536029
    m_Localized: 'Dude: Đâu còn ngủ giữa rừng nữa mà sợ kiến bọ nó tha, sợ thời tiết rét lạnh. Ờ, tui là tui hông có thít.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536030
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536031
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536032
    m_Localized: 'Dude: Ô kê luôn con vợ!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536034
    m_Localized: 'Dude: Sao, thấy hào quang của tui nó như nào? Chói lắm hả? Uầy, chất chơi người dơi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536035
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536036
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536037
    m_Localized: 'Dude: Được luôn nha bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536039
    m_Localized: 'Dude: Tai gì mà dài thòng vậy ha? Brooooo... Ông hông biết chứ hồi xưa tui đeo khuyên nhìn bảnh ác luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536040
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536041
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536042
    m_Localized: 'Dude: Xí xí! Xì tốp nào! Chill đi con vợ ơi! Làm điếu cho vui cửa vui nhà ha!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536043
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536044
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536045
    m_Localized: 'Dude: Vãi chưởng, chiến đét vậy bro. Kiểu, ông có cảm thấy cây súng nó đi liền với thân mình luôn hông? Đúng ảo ma sicula!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536046
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536047
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536048
    m_Localized: 'Dude: Uầy, chuyện bánh cuốn thiệt mà bro. Gì đâu mà căng dữ vậy!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536049
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536050
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536051
    m_Localized: 'Dude: Bình tĩnh con vợ ơi! Hờn trách chi cuộc đời! Để tự nhiên dẫn lối! Về cát bụi mà thôi!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536052
    m_Localized: 'Dude: Từ từ bình tĩnh! Ý kiến cá nhân thôi, ông cứ để nguyên hông cạo cũng được mà! Muốn sống sao thì sống! Đừng manh động vậy bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536053
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536054
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536055
    m_Localized: 'Dude: Ông ơi, tui đang phêêê thấy mẹ đây. Mà ông kiểu, phá hết hứng của tui rồi á. Đúng là bủh bủh lờ mao.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536056
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536057
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536058
    m_Localized: 'Dude: Muốn nghe kể sự tích cái khuyên hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536059
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536060
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536061
    m_Localized: 'Dude: Má, hồi trước tui kiểu, cứ nghĩ răng người nó bình thường, nhạt nhẽo, chả có gì ý.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536062
    m_Localized: 'Dude: Xong một hôm thằng cốt tiết lộ: "Ông ơi, đấy là XƯƠNG của ông đó!"'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536063
    m_Localized: 'Dude: Tui kiểu, vãi òn luônnnn! Mình mọc XƯƠNG trong miệng mới ghê. Má ớn dễ sợ kinh khủng khiếp, cho vàng cũng đéo dám đụng vô đâu!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536064
    m_Localized: 'Dude: Uầy, ngón tay người nó ảo vãi đái...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536065
    m_Localized: 'Dude: Kiểu, mình xài hoài ý chứ... Nhưng ông đã bao giờ ngẫm coi nó là CÁI GÌ chưa? Có lần tui bay lên chín tầng mây rồi suy nghĩ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536066
    m_Localized: 'Dude: Cái xong từ đó tới giờ, cứ thấy tay là tui lại hốt con mẹ nó hền luôn á bro!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536067
    m_Localized: 'Dude: Tui ngồi thẫn thờ ngắm tay rồi kiểu... Lỡ nó HỔNG PHẢI TAY MÌNH thì sao? Má đá quá rồiiiii, xuống lẹ mày ơi, xuống lẹ.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536068
    m_Localized: 'Dude: Đồng tử càng to thì càng cutoe hột me nha. Như trong phim ý... Phim gì mà có con mèo đi hia với lại thằng ú xanh lè.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536069
    m_Localized: 'Dude: Đảm bảo mấy em gái chết mê chết mệt luôn!'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536070
    m_Localized: 'Dude: Đây ông hình dung thử nhá.. Đang phê lâng lâng mà đi dạo phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536071
    m_Localized: 'Dude: Tui kiểu, lỡ xui mà bị cớm bắt gặp, nó hỏi mình phê thuốc à. Mình chỉ cần đáp: "Đâu anh ơi, nhỏ lớn giờ nhìn mặt em nó vậy á".'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536072
    m_Localized: 'Dude: Má xong nó bắt tui thiệt: "Sao mắt chú đỏ thế? Từ bé đến giờ bị như này à?" Cái tui kiểu: "Đâu, phê cần đó anh ơi".'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536073
    m_Localized: 'Dude: Bro ơi, ông thử xách cái nách lông lá mà đi ngoài đường coi. Lại chả ngứa thí mẹ ra.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536074
    m_Localized: 'Dude: Kiểu, có ai trên đời đã mở miệng nói câu "Lông đít làm tao mê tít" bao giờ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536075
    m_Localized: 'Dude: Lông nách hay lông đít cũng vậy thôi... Vướng víu như nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536076
    m_Localized: 'Dude: Chả hiểu cần cái thứ đó làm gì luôn ý... Đằng nào mình cũng mặc đồ che hết mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536077
    m_Localized: 'Dude: Ê con vợ hông biết chứ... Lâu lâu tui cảm nhận được hào quang của chính mình đó nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536078
    m_Localized: 'Dude: Kiểu, tui biết bao quanh mình có một vầng gì đó mà ông hông nhìn thấy được.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536079
    m_Localized: 'Dude: Mà nhất là khi tui phêêêê chữ "ê" kéo dài... À đâu, khi tui mệt chứ, cái hào quang nó giở chứng, nhìn sợ vãi òn luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536080
    m_Localized: 'Dude: Chứ bình thường cháu nó chill lắm. Tui vibe với nó rất mượt nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536081
    m_Localized: 'Dude: Nè nhá, hồi trước tui xỏ cái khuyên chà bá lửa, cháy khét lẹt luôn. Họa tiết nhìn như con mắt khổng lồ với con ngươi bự chảng.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536082
    m_Localized: 'Dude: Chả hiểu kiểu gì lại để mất, tiếc hùi hụi luôn. Cứ như bị mất một mảnh hồn vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536083
    m_Localized: 'Dude: Giờ ai cũng thấy cái lỗ trên tai tui. Mà tui nhìn vô chỉ thấy vực thẳm không đáy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536086
    m_Localized: 'Teacher: Em cần làm gì thì cứ làm đi. Đằng nào cô cũng mất hết rồi... chẳng còn gì để che giấu nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536087
    m_Localized: Răng
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536088
    m_Localized: Bàn Tay
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536089
    m_Localized: Mắt
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536090
    m_Localized: Nách
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536091
    m_Localized: Ảnh Chụp
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536092
    m_Localized: Tai
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536093
    m_Localized: 'Teacher: Em thấy không?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536094
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536095
    m_Localized: 'Teacher: Hàm răng trắng... đẹp không tì vết. Mỗi tội...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536096
    m_Localized: 'Teacher: Có chỗ này họ đánh cô... Trói cô vào cây cột, ép cô phải đứng nhìn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536097
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536098
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536099
    m_Localized: 'Teacher: Đây em...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536100
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536101
    m_Localized: 'Teacher: Cô đã cố... cố hết sức để mở cửa, phá tan cửa sổ. Nhưng mà ngọn lửa... nó lan ra nhanh quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536102
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536103
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536104
    m_Localized: 'Teacher: Em nhìn đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536105
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536106
    m_Localized: 'Teacher: Cô... Cô nhìn thấy hết. Tụi nhỏ bám víu vào nhau lúc ngọn lửa lan đến gần...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536107
    m_Localized: 'Teacher: Tụi nó nhìn quanh quất tìm cô, mong chờ cô tới giúp... Trời ơi, làm sao mà cô chịu nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536108
    m_Localized: 'Teacher: Đến giờ cô vẫn sợ nhắm mắt lại, vì biết thể nào cũng nhìn thấy gương mặt tụi nó hiện về... Cái nhìn bất lực, bốc cháy, biến dạng đầy đau đớn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536109
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536110
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536111
    m_Localized: 'Teacher: Mấy cái này... có cần thiết không em? Cô thấy sao mà rối rắm khó chịu quá...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536112
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536113
    m_Localized: 'Teacher: Do cô quen rồi em ạ. Khi chăm sóc mấy đứa nhỏ thì bản thân mình cũng phải thường xuyên giữ gìn vệ sinh cẩn thận.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536114
    m_Localized: 'Teacher: Ngày ngày cô đều hướng dẫn tụi nó rửa mặt, đánh răng... Mà giờ chẳng còn đứa bé nào để dạy nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536115
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536116
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536117
    m_Localized: 'Teacher: Nếu thực sự cần thiết thì thôi đành...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536118
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536119
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536120
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536121
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536122
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536123
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536124
    m_Localized: 'Teacher: Hồi xưa cô có đeo bông tai... Nhỏ nhỏ xinh xinh mà đính mấy viên ngọc bé xíu. Mấy đứa nhóc khen là chúng lấp lánh như sao trời vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536125
    m_Localized: 'Teacher: Nhưng đeo hoài đau quá, nên cô gỡ ra rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536126
    m_Localized: Bỏ qua
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536127
    m_Localized: Rút súng ra
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536128
    m_Localized: 'Teacher: Em muốn xử nốt cả người cuối cùng còn sống sót sao? Thời buổi như này thì cô cũng chẳng bất ngờ nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536129
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536130
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536131
    m_Localized: 'Teacher: Em cứ bắn đi... Đôi tay này cũng chẳng còn cứu giúp được ai nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536132
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536133
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536134
    m_Localized: 'Teacher: Nếu như em thấy được những điều cô đã chứng kiến... thì em sẽ bóp cò ngay tắp lự. Nếu em còn biết thế nào là khoan dung.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536135
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536136
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536137
    m_Localized: 'Teacher: Bắn đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536138
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536139
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536140
    m_Localized: 'Teacher: Em cứ bắn đi...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536141
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536142
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536143
    m_Localized: 'Teacher: Em nghĩ một viên đạn có thể chấm dứt nỗi đau à? Được vậy thì tốt biết bao...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536144
    m_Localized: Bắn bỏ
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536145
    m_Localized: Nghe người ta nói đã
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536146
    m_Localized: 'Teacher: Hồi dạy đánh răng, cô từng nói với tụi nhỏ rằng chỉ cần một nụ cười tươi là đủ để thế giới trở nên rạng ngời.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536147
    m_Localized: 'Teacher: Mấy đứa nó cười vang, hớn hở khoe hàm răng tí xíu... Còn bây giờ... cô chỉ thấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536148
    m_Localized: 'Teacher: Xin lỗi em...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536149
    m_Localized: 'Teacher: Bàn tay của cô từng tận tình thắt bím tóc, băng bó đầu gối trầy xước, dạy những ngón tay bé xíu cách cột dây giày...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536150
    m_Localized: 'Teacher: Vậy mà giờ đây... mọi thứ đều trở nên vô nghĩa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536151
    m_Localized: 'Teacher: Cứ phải cố gắng để làm gì hả em? Khi mà luôn có những kẻ mạnh hơn, tàn ác hơn ra tay định đoạt số phận của mình?'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536152
    m_Localized: 'Teacher: Phải chi lúc đó cô phá cửa... tìm được đường khác để xông vào thì sao? Dạo này, cô cứ chợp mắt là ngọn lửa đó lại phừng lên trong tâm trí.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536153
    m_Localized: 'Teacher: Cô hay nhắc nhở tụi nhỏ phải ráng giữ vệ sinh để luôn khỏe mạnh. Nhưng rốt cuộc, cái làm hại tụi nó lại chẳng phải vi khuẩn... mà là con người.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536154
    m_Localized: 'Teacher: Cô luôn cố gắng níu giữ hình ảnh của mấy đứa nhỏ, từ khuôn mặt, giọng nói đến tiếng cười thân thương...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536155
    m_Localized: 'Teacher: Nhưng thời gian càng qua đi, ký ức lại ngày một phai nhòa.'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536156
    m_Localized: 'Teacher: Dần dần, những kỷ niệm đẹp đẽ đó bị nhấn chìm bởi những gương mặt méo mó, hòa lẫn tiếng khóc than rối bời, đau đớn và sợ hãi tột cùng...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536157
    m_Localized: 'Teacher: Nhiều lúc, cô khẽ chạm vào tai mình, rồi chợt nhớ tới chuyện một bé gái đã thích bông tai của cô như nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536158
    m_Localized: 'Teacher: Bé còn nói khi nào lớn lên cũng muốn có một đôi giống cô. Vậy mà giờ đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536159
    m_Localized: 'Teacher: Bé đã không còn...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536160
    m_Localized: 'Teacher: Cuối cùng... mọi chuyện cũng sẽ chấm dứt...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536161
    m_Localized: 'Teacher: Xin hãy... tha thứ cho cô...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931024536162
    m_Localized: 'Teacher: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 41582931028729865
