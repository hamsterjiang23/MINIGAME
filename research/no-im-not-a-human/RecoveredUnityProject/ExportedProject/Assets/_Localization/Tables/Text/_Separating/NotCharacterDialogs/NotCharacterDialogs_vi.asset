%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: Tin mới nhận!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: Vào lúc 6:28 sáng hôm nay, mặt trời đã phát ra một luồng năng lượng cực mạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Đợt bùng phát này có quy mô lớn hơn rất nhiều so với dự đoán của các nhà khoa học.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: Do đó, nhiệt độ ngoài trời đã lên đến mức báo động.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Chính phủ đã ban bố tình trạng khẩn cấp.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Quý vị chú ý không nên ra ngoài trong ngày hôm nay.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: Chuyển sang phần–'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Xin chờ một chút…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: Chúng tôi vừa nhận được tin báo khẩn liên quan đến một hiện tượng lạ xuất hiện gần đây, gọi là "Dị Khách".'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Theo các nhân chứng mô tả, đây là các sinh vật có thể bắt chước vẻ ngoài và hành vi của con người.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Quý vị tuyệt đối tránh tiếp xúc với chúng. Hiện tại đã phát hiện một cá thể Dị Khách nhờ một dấu hiệu đặc trưng…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Đó là hàm răng trắng đều.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Các báo cáo trước đây cũng nhắc đến chi tiết tương tự.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Cụ thể, họ đã bắt gặp một đối tượng vô gia cư có hàm răng trắng bóng, đầy đặn. Đối tượng sau đó được xác nhận là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Quý vị hãy hết sức bình tĩnh và tránh ra khỏi nhà vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: Chúng tôi xin tiếp tục với một tin vui!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Chào mừng quý vị đến với dự báo thời tiết buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: Nhiệt độ có thể đạt ngưỡng kỷ lục chưa từng có, do một luồng không khí nóng đang tràn vào khu vực.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Theo đài khí tượng, hiện tượng này sẽ còn kéo dài trong tuần tới, khiến nhiệt độ liên tục tăng cao.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Đồng thời, chỉ số tia cực tím cũng sẽ cao hơn do ảnh hưởng từ mặt trời tăng mạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Nhiệt độ này có thể khiến nguy cơ say nắng tăng đáng kể.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: Để đảm bảo an toàn, quý vị vui lòng không tắm nắng.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: Hiện tại, vẫn chưa xác định được liệu ánh nắng này có gây hại đến sức khỏe hay không.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Tuy nhiên, để tránh nguy cơ bị bỏng cấp độ ba, quý vị vui lòng hạn chế ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Các loại kem chống nắng ở mọi cấp độ sẽ không còn đủ sức để bảo vệ quý vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Tiếp theo là chương trình ca nhạc "Khiêu vũ cùng Thiên nga"...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Một dàn vũ công ba lê đang trình diễn. Bước nhảy của họ trông thật mạnh mẽ mà cũng đầy uyển chuyển, thanh thoát.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: Màn biểu diễn tuy rất thanh lịch, nhưng lại làm dấy lên trong lòng bạn những mối lo khó tả.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Như thể đây là chiêu trò đánh lạc hướng, khiến bạn quên đi tình hình thế giới ngoài kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Chẳng hiểu chuyện gì đang diễn ra nữa. Phải chi có ai giải thích được thì tốt biết bao...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: Ảnh hưởng từ mặt trời vẫn tiếp tục gia tăng mỗi ngày, đồng thời tỷ lệ phạm tội cũng đạt kỷ lục mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: Theo thông tin mới nhận, số vụ giết người trong những đêm gần đây đã vượt mức trung bình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Các chuyên gia cho rằng, nguyên nhân là do người dân ngày càng cảm thấy lo lắng, bất an về vấn đề Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: Tin vui là chúng tôi vừa nhận được thêm thông tin, có thể giúp quý vị nhận biết những kẻ song trùng này…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Đó là dưới móng tay có dính đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: Theo các chuyên gia, dấu hiệu này sẽ giúp nhận biết những Dị Khách vừa trồi lên từ lòng đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Quý vị hãy hết sức bình tĩnh và tránh ra khỏi nhà vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: Sau đây là tin khẩn cấp về một đối tượng gọi là "gã điên da tái nhợt". Chúng tôi sẽ tiếp tục sau vài phút quảng cáo…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Bạn từng phải chạy đôn chạy đáo đến cửa hàng chỉ để mua đồ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: Giờ đây với dịch vụ ForRest, chỉ cần nhấc máy là bạn đã có tất cả trong tay!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Hãy gọi ngay cho XXX-XXX-XXXX, thực phẩm bạn yêu cầu sẽ được giao đến nhà chỉ trong một ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: ForRest – ngon, rẻ, khỏe, giao tận nơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: Theo nguồn tin gần đây, có một "gã điên da tái nhợt" bắt đầu xuất hiện ở ngoài phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Cảnh sát đã tiến hành điều tra, lấy lời khai và nhận thấy các nạn nhân có một điểm chung: tất cả đều ở một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: Ngoài ra, đối tượng cũng thường trò chuyện với nạn nhân trước khi ra tay sát hại.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: Đây là bản phác thảo đối tượng do cảnh sát tổng hợp từ lời kể của nhân chứng.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: Đối tượng là một người đàn ông trung niên, có làn da nhợt nhạt, tóc đen, dáng người mảnh khảnh và chỉ mặc một chiếc quần.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Một số báo cáo còn cho biết, đối tượng đôi khi cũng khoác lên mình bộ da của một người khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Tuy nhiên, thông tin này vẫn chưa được xác thực.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Nếu bắt gặp đối tượng, quý vị tuyệt đối đừng mở cửa, hay nói rằng quý vị đang ở một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: Nhiệt độ vẫn tiếp tục tăng cao, và các cuộc tấn công của Dị Khách vẫn chưa có dấu hiệu dừng lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: Để đối phó với tình trạng này, chính phủ đã ra quyết định thành lập một tổ chức mới...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: ...mang tên Cơ quan Phòng, chống thảm họa Liên bang, gọi tắt là CQPCTHLB.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Nhân viên thuộc CQPCTHLB sẽ mặc đồ bảo hộ màu vàng và đeo mặt nạ phòng độc.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Chỉ vài ngày sau khi thành lập, Cơ quan đã phát hiện thêm một dấu hiệu nhận biết Dị Khách…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Đó là đôi mắt đỏ ngầu như máu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: Theo báo cáo từ CQPCTHLB, dấu hiệu này được tìm thấy ở các Dị Khách bị bắt giữ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: Hiện tượng này là do chúng nhạy cảm với ánh sáng hơn người thường, khiến mắt bị viêm và chuyển sang màu đỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Quý vị hãy hết sức bình tĩnh và tránh ra khỏi nhà vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: Trước khi chuyển sang phần thông báo từ CQPCTHLB, sau đây là vài phút quảng cáo từ các nhà tài trợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Hỗn loạn, kinh hoàng và thống khổ, tất cả đều do Dị Khách gây ra...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Giữa hồi nước sôi lửa bỏng, những lời cầu cứu tưởng chừng không ai nghe thấu…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: THÌ KHI ĐÓ: NHỮNG NGƯỜI HÙNG XUẤT HIỆN, DẸP TAN MỌI THẢM HỌA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: "TV: Cơ quan Phòng, chống thảm họa Liên bang luôn sẵn sàng ứng cứu, với sứ mệnh bảo vệ người dân \nkhỏi nạn Dị Khách xâm lăng."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: Tính đến thời điểm hiện tại, Cơ quan đã phát hiện hơn 27.000 đối tượng bị tình nghi là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: Quý vị luôn có thể góp sức bằng cách thông báo cho Cơ quan, nếu phát hiện hành tung đáng ngờ ở gần mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Chỉ cần gửi giấy triệu tập từ CQPCTHLB cho đối tượng bị tình nghi là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: Trong trường hợp nghi ngờ bản thân là Dị Khách, hãy gọi đến đường dây nóng của chúng tôi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Giúp chúng tôi cũng là giúp chính bạn. Hãy cùng CQPCTHLB chung tay đẩy lùi thảm họa Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: CQPCTHLB là gì? Họ có vai trò như thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: Cơ quan Phòng, chống thảm họa Liên bang là tổ chức chuyên biệt do chính phủ thành lập, thực hiện nhiệm vụ ứng phó các thảm họa cận kề.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Cơ quan hiện đang tích cực hỗ trợ công tác ứng phó các cuộc tấn công của Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: Dù chưa rõ Cơ quan sẽ triển khai các biện pháp gì…'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Nhưng chúng tôi vẫn tin chắc rằng, họ sẽ bảo vệ tương lai của nhân loại.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: CQPCTHLB quy tụ đội ngũ chuyên gia từ đa dạng ngành nghề và lĩnh vực, bao gồm cả các nhà khoa học lỗi lạc cùng nhà nghiên cứu có tên tuổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Nếu có nhân viên của Cơ quan đến nhà, quý vị hãy chủ động hợp tác và tuân thủ các chỉ dẫn từ nhân viên.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Giúp chúng tôi cũng chính là giúp bạn. Hãy cùng CQPCTHLB chung tay đẩy lùi thảm họa Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: CQPCTHLB đã triển khai các biện pháp mới nhằm ứng phó tình hình Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Hiện Cơ quan đã khoanh vùng cách ly, nhằm giam giữ các đối tượng có khả năng gây nguy hiểm cho xã hội.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: CQPCTHLB cũng đã phát hiện thêm một dấu hiệu nhận biết Dị Khách từ các đối tượng bị bắt:'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Vùng dưới cánh tay không có lông.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: Theo báo cáo, vùng nách của Dị Khách hoàn toàn sạch lông, giúp dễ dàng nhận biết được chúng.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: Cơ quan khuyến nghị người dân nên hợp tác và tuân thủ theo lệnh di chuyển đến khu cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Quý vị hãy hết sức bình tĩnh và tránh ra khỏi nhà vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: Tiếp theo sau đây: Nên làm gì khi phát hiện Dị Khách?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: Theo CQPCTHLB, Dị Khách có thể tiềm tàng nguy cơ lây nhiễm, hoặc ẩn chứa mối hiểm họa sinh học chưa được tiết lộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Vì vậy, người dân cần báo ngay cho Cơ quan khi phát hiện Dị Khách để có biện pháp xử lý kịp thời.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Nếu không thể giao Dị Khách đến khu cách ly ngay lập tức, hãy đưa họ giấy triệu tập từ CQPCTHLB.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: Trong đợt truy bắt Dị Khách tiếp theo, nhân viên Cơ quan sẽ áp giải các đối tượng có giấy này đến khu cách ly để tiến hành khám xét.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Tiếp theo là vài phút quảng cáo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: "Window: Căn nhà của bác hàng xóm nằm trơ trọi giữa \ncánh đồng rơm."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: Cửa sổ tối om, không thấy sáng đèn. Chắc nhà bác ấy đi ngủ hết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: Một chú chó gầy nhom đứng trên con đường mòn xuyên qua cánh đồng.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Nó dò dẫm nhìn quanh với dáng vẻ buồn thiu, hình như là đang mò tìm thức ăn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: Vài tên nhậu say bét nhè đang nằm sõng soài ra đường.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Họ ngủ mê mệt trên nền đất lạnh lẽo, cứng đơ. Rượu vào là thấy yêu đời lên hẳn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: Xa xa, bạn thấp thoáng trông thấy ngôi nhà của bác hàng xóm vừa ghé chỗ bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: Ánh sáng chiếu rọi từ trong nhà, hắt ra khung cửa sổ. Có vẻ gia đình bác đang chong đèn chờ bác về.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Bạn thấy vài đứa nhóc độ thiếu niên đang chơi ngoài sân.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Bọn nó ngồi tám chuyện say sưa, chẳng màng thế sự, mà cũng không để ý gì đến bạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: Bên ngoài lặng im như tờ, ám mùi chết chóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: Không có lấy một bóng người.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: "Window: Ngay cả các bợm nhậu cũng chẳng dám \nbước chân ra đường. "
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: Hay là họ lo sợ thứ gì đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: "Window: Qua cửa sổ, bạn trông thấy bác hàng xóm\ncùng đứa con gái."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Họ chơi đùa vui vẻ, như thể cố quên đi những mối đe dọa đang rình rập ngoài kia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Dù chỉ trong khoảnh khắc ngắn ngủi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: "Window: Thi thể của đám thiếu niên nằm la liệt\ntrên mặt đường lạnh cóng."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Có kẻ đã sát hại bọn nhỏ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: "Window: Vụ án dường như chỉ mới xảy ra thôi.\nVết máu còn vương lại chưa khô."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: Sừng sững trên con đường mòn là một gã trông nhợt nhạt như xác chết. '
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: Làn da của hắn đầy những nếp nhăn quái dị. '
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: Cứ như thể da thịt hắn bị lộn từ trong ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: "Window: Dù đứng từ đây không thấy mắt hắn đâu,\nbạn vẫn có cảm giác hắn đang nhìn mình chằm chặp."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: "Window: Bất thình lình bạn thấy lạnh hết cả sống lưng.\nChỉ cầu mong sao cho tên Dị Khách ghê rợn kia đi khuất."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: "Window: Một tốp nhân viên bên Phòng Chống Thảm Họa\nđang tụ tập tại nhà bác hàng xóm."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Không biết họ đang nói chuyện gì nhỉ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: Có lẽ họ đang thu thập mẫu đất?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: Hay tìm vị trí thích hợp để dựng trại?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: "Window: Thi thể cháy đen của đám thiếu niên\nnằm la liệt trên mặt đất."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Có vẻ chúng đã ở đấy cả ngày rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Hai nhân viên Phòng Chống Thảm Họa đang đứng kế bên ghi chép gì đó. '
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: "Window: Bạn thầm nghĩ, may mà họ có mặt để \ndọn dẹp đống xác chết."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Chứ để xác thịt thối rữa vất vưởng quanh đây thì có khác nào ổ dịch, rất dễ lây bệnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: Bạn trông thấy một toán lính mang vũ trang đứng bên ngoài cửa sổ.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Có vẻ tiểu đội này được thành phố đặc phái tới đây để bảo vệ các nhân viên Phòng Chống Thảm Họa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: Bạn nghe phong thanh được vài thông tin về một kẻ da nhợt, thân trần.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: Phải chăng họ muốn truy lùng dấu vết của tên Dị Khách đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: Căn nhà của bác hàng xóm vừa được sơn phết trắng tinh, giờ đã bị nhuộm đen dưới lớp tro tàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Xem chừng ngọn lửa vừa được dập tắt cách đây không lâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: Hay là có kẻ đã cố tình châm ngòi phóng hỏa?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: Không biết gia đình bác ấy ra sao rồi?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: Có còn ai sống sót không?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Tâm trí tràn ngập những mối lo, bạn thấy lòng mình trĩu nặng vì nỗi tuyệt vọng, bất lực, không sao hiểu nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: Kẻ nhợt nhạt dị hợm kia đang đứng bên ngoài với nụ cười ớn lạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Trên tay hắn cầm cái đầu của ai đó bị chặt đứt lìa trong chiếc mũ bảo hiểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: Chính là đầu một anh lính, nét mặt vẫn còn hằn vẻ khiếp sợ, hãi hùng trước phút ra đi. '
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: Bạn không rõ lúc đó anh ta run sợ điều gì hơn... gã Dị Khách trước mặt, hay cái chết cận kề.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Cả đội lính hôm qua vừa mới tập kết... nay đã chết sạch không còn một ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Trông chẳng khác gì một vụ thảm sát.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Thi thể nằm rải rác chất đầy đường, trong đó có một cái bị mất đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: Lẽ nào tên da nhợt quái dị kia chính là thủ phạm?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: Dịch vụ hỗ trợ khẩn cấp xin nghe. Anh chị đang gặp vấn đề gì ạ? "Có người... đang bốc cháy".
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: Anh chị vui lòng mô tả chi tiết hơn được không? Có hỏa hoạn ạ? "K-Không phải, tại mặt trời ấy. Người ta ra nắng là cháy phừng phừng".
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: Đừng ra ngoài vào ban ngày. "Nhưng đêm đến tên đó lại lảng vảng. Cái tên da tái nhợt ấy... chắc chắn không phải con người".
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: 'Tiếp theo sau đây là chương trình mới: "Hồn Người, Da Người".'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'Thể lệ rất đơn giản: Bạn chỉ cần gửi ảnh chân dung, chúng tôi sẽ xác định bạn có đúng là người không, từ trong ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'Vui lòng gửi ảnh của bạn tới địa chỉ mail: honnguoid@nguoi.coquanxacthuc, còn lại cứ để chúng tôi lo liệu.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Chú ý chỉ gửi ảnh chụp mắt, răng và móng tay thôi nhé. Chúng tôi không nhận ảnh khác.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: Bạn bị đỏ mắt, trắng răng, móng tay bỗng dưng có đất bất thường?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: Đó chính là dấu hiệu bị vong nhập. Bạn đã hóa thành Dị Khách!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: 'Đừng để tà ma quỷ quái chiếm lấy xác bạn! Hãy gọi ngay cho chuyên gia của chúng tôi theo số: 777-460.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Họ sẽ hỗ trợ trừ tà, thanh tẩy thân xác và xua tan oán khí, đồng thời giúp bảo vệ bạn tốt hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: Chào mừng bạn đến với chương trình "Bạn Kể Tôi Tin", nơi chúng tôi lật mở những bí ẩn và âm mưu chính phủ rúng động.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Hôm nay, chúng ta sẽ vén màn sự thật về Dị Khách cùng khách mời đặc biệt. Ông là Tiến sĩ khoa học kiêm nhân viên đáng kính của–
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: Hả, cái gì?! Không tới được là sao...?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: ...Thế quái nào mà chúng nó lấy SẠCH tư liệu của ổng hay vậy? Cả ĐỐNG thông tin quý trong đó chứ đùa!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: Mẹ nó. Biết ngay mà. Sức mấy mà nó cho mình tiết lộ bí mật động trời. Cái đ–
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Trước mắt bạn từng là ngôi nhà của bác hàng xóm, nay đã thành đống đổ nát tan hoang.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Mới đây thôi, một gia đình đầm ấm còn sinh sống ở nơi đó. Vậy mà bây giờ, chỉ còn sót lại những mảng vụn vỡ.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Bỗng dưng, một cảm giác khó tả xâm chiếm cõi lòng bạn. Cứ như thể bạn đã thấy trước kết cục này...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: "Window: ...Rằng chẳng bao lâu sau, cái chết rồi sẽ gõ cửa \ncăn nhà ấy."
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Bạn trông thấy một cái đầu lâu còn đội mũ bảo hiểm, được treo trên giàn như vật trưng bày.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: Da thịt nó đã cháy thành tro, còn hàm răng thì như bị kẻ nào giật ra mất.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: Hẳn là cái đầu được treo ở đó cả ngày rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: Bạn rùng mình lo sợ rằng tác phẩm gớm ghiếc này chính là lời cảnh báo, do tên Dị Khách da tái nhợt kia cố tình để lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Lực lượng Phòng Chống Thảm Họa đang tiến hành điều tra hiện trường vụ thảm sát vừa rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Họ đang thu thập toàn bộ trang thiết bị và vũ khí của những người lính đã chết, để không ai thừa cơ lấy trộm.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Chắc họ cũng không ngờ rằng, một mình tên Dị Khách da nhợt lại đủ cân hết cả đội lính với trang bị đầy đủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Bây giờ lại xuất hiện thêm vài túi xác nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin thời tiết buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: Một luồng không khí nóng đang tràn vào khu vực, nhiệt độ có thể sẽ đạt ngưỡng kỷ lục chưa từng có.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: Theo đài khí tượng, hiện tượng này sẽ còn kéo dài trong tuần tới, khiến nhiệt độ liên tục tăng cao.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Đồng thời, chỉ số tia cực tím cũng sẽ cao hơn do ảnh hưởng từ mặt trời tăng mạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Nhiệt độ này có thể khiến nguy cơ say nắng tăng đáng kể.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: Để đảm bảo an toàn, quý vị vui lòng không tắm nắng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: Hiện tại, vẫn chưa xác định được liệu ánh nắng này có gây hại đến sức khỏe hay không.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Tuy nhiên, để tránh nguy cơ bị bỏng cấp độ ba, quý vị vui lòng hạn chế ra ngoài.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Các loại kem chống nắng ở mọi cấp độ sẽ không còn đủ để bảo vệ quý vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Một dàn vũ công ba lê đang trình diễn. Bước nhảy của họ trông thật mạnh mẽ mà cũng đầy uyển chuyển, thanh thoát.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: Màn biểu diễn tuy rất thanh lịch, nhưng lại làm dấy lên trong lòng bạn những mối lo khó tả.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Như thể từng động tác chỉ muốn đánh lạc hướng bạn, khiến bạn quên đi tình hình thế giới ngoài kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Chẳng hiểu chuyện gì đang diễn ra nữa. Phải chi có ai giải thích được thì tốt biết bao...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Bạn từng phải chạy đôn chạy đáo đến cửa hàng chỉ để mua đồ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: Giờ đây với dịch vụ ForRest, chỉ cần nhấc máy là bạn đã có tất cả trong tay!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: Hãy gọi ngay cho {0}, thực phẩm bạn yêu cầu sẽ được giao đến nhà chỉ trong một ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: ForRest – ngon, rẻ, khỏe, giao tận nơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: Theo nguồn tin gần đây, có một "gã điên da tái nhợt" bắt đầu xuất hiện ở ngoài phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: Cảnh sát đã tiến hành điều tra, lấy lời khai và nhận thấy các nạn nhân có một điểm chung: tất cả đều ở một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: Ngoài ra, đối tượng cũng thường trò chuyện với nạn nhân trước khi ra tay sát hại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: Đây là bản phác thảo đối tượng do cảnh sát tổng hợp từ lời kể của nhân chứng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: Đối tượng là một người đàn ông trung niên, có làn da nhợt nhạt, tóc đen, dáng người mảnh khảnh và chỉ mặc một chiếc quần.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Một số báo cáo còn cho biết, đối tượng đôi khi cũng khoác lên mình bộ da của một người khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Tuy nhiên, thông tin này chưa được xác thực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Nếu phát hiện đối tượng, quý vị tuyệt đối đừng mở cửa, hay nói rằng quý vị đang ở một mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Hỗn loạn, kinh hoàng và thống khổ, tất cả đều do Dị Khách gây ra...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Giữa hồi nước sôi lửa bỏng, những lời cầu cứu tưởng chừng không ai nghe thấu…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: THÌ KHI ĐÓ: NHỮNG NGƯỜI HÙNG XUẤT HIỆN, DẸP TAN MỌI THẢM HỌA!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Cơ quan Phòng, chống thảm họa Liên bang luôn sẵn sàng ứng cứu, với sứ mệnh bảo vệ người dân khỏi nạn Dị Khách xâm lăng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: Tính đến thời điểm hiện tại, Cơ quan đã phát hiện hơn 27.000 đối tượng bị tình nghi là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Quý vị luôn có thể góp sức bằng cách thông báo cho Cơ quan, nếu phát hiện hành tung đáng ngờ ở gần mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Chỉ cần gửi giấy triệu tập từ CQPCTHLB cho đối tượng bị tình nghi là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: Trong trường hợp nghi ngờ bản thân là Dị Khách, hãy gọi đến đường dây nóng của chúng tôi: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Giúp chúng tôi cũng là giúp chính bạn. Hãy cùng CQPCTHLB chung tay đẩy lùi thảm họa Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: CQPCTHLB là gì? Họ có vai trò như thế nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: Cơ quan Phòng, chống thảm họa Liên bang là tổ chức chuyên biệt do chính phủ thành lập, thực hiện nhiệm vụ ứng phó các thảm họa cận kề.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Cơ quan hiện đang tích cực hỗ trợ công tác ứng phó các cuộc xâm lăng của Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Dù chưa rõ Cơ quan sẽ triển khai những biện pháp gì…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Nhưng chúng tôi vẫn tin chắc rằng, họ sẽ bảo vệ tương lai của nhân loại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: CQPCTHLB quy tụ đội ngũ chuyên gia từ đa dạng ngành nghề và lĩnh vực, bao gồm cả các nhà khoa học lỗi lạc cùng nhà nghiên cứu có tiếng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Nếu có nhân viên của Cơ quan đến nhà, quý vị hãy chủ động hợp tác và tuân thủ các chỉ dẫn từ nhân viên.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Giúp chúng tôi cũng là giúp chính bạn. Hãy cùng CQPCTHLB chung tay đẩy lùi thảm họa Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: Theo CQPCTHLB, Dị Khách có thể tiềm tàng nguy cơ lây nhiễm, hoặc ẩn chứa mối hiểm họa sinh học chưa được tiết lộ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Vì vậy, người dân cần báo ngay cho Cơ quan khi phát hiện Dị Khách để có biện pháp xử lý kịp thời.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Nếu không thể giao Dị Khách đến khu vực cách ly ngay lập tức, hãy đưa họ giấy triệu tập từ CQPCTHLB.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: Trong đợt truy bắt Dị Khách tiếp theo, nhân viên Cơ quan sẽ áp giải các đối tượng có giấy này đến khu cách ly để tiến hành khám xét.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Quý vị đang xem bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: CQPCTHLB đã ban hành các chiến lược bảo vệ mới, nhằm ứng phó tình trạng đối tượng bị tình nghi là Dị Khách tăng cao.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: Kể từ hôm nay, các khu đô thị đông dân cư sẽ bị phong tỏa hoàn toàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Chính phủ nghiêm cấm người dân ở những khu vực này di chuyển ra khỏi thành phố, hoặc đến các làng mạc lân cận.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Quý vị chú ý tuân thủ quy tắc: "ai ở đâu, ở yên đó".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Ngoài ra, Cơ quan cũng phát hiện thêm một đặc điểm mới giúp nhận dạng Dị Khách:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Hào quang trong ảnh chụp.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Đối tượng để lại các đốm đen trong ảnh chụp có khả năng cao là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Quý vị hãy hết sức bình tĩnh và ở trong nhà vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Tiếp theo sẽ là chương trình khoa học!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: Dị Khách là gì? Ma quỷ hay sinh vật độn thổ trồi lên?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: Quý vị không nhầm đâu. Đây không phải tác phẩm viễn tưởng, cũng chẳng phải chiêu trò giật tít.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: Đây là hiện thực mới mà ta phải đối mặt.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: Ngày càng xuất hiện nhiều tin đồn xoay quanh nguồn gốc của Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: Liệu chúng là người ngoài hành tinh? Xác chết sống dậy? Hay sản phẩm thí nghiệm sổng chuồng?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: Theo các cơ quan chức năng, những giả thuyết vừa rồi đều là vô căn cứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: Nghiên cứu cho thấy Dị Khách là con người biến thành, do tiếp xúc với tác nhân sinh học chưa xác định.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: Hiện vẫn chưa tìm ra phương thức lây nhiễm. Trước tình hình đó, CQPCTHLB khuyến cáo người dân đề phòng các dấu hiệu của Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: Nếu quý vị nghi ngờ mình bị lây nhiễm, hay chưa biết mình có phải Dị Khách không, hãy gọi cho Cơ quan ngay lập tức theo đường dây nóng:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Tin khẩn cấp!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: Cháy rừng đang lan rộng trên nhiều khu vực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Các chuyên gia cho rằng, hiện tượng này là do ảnh hưởng từ mặt trời tăng mạnh.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Tuy chưa xác định được quy mô, nhưng lực lượng cứu hỏa từ các thành phố lân cận đã được điều đến để kiểm soát đám cháy.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: Quý vị hãy hết sức bình tĩnh và tránh ra khỏi nhà vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Chúng tôi xin tạm ngưng chương trình để thông báo tin mới nhận.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Thông tin cho biết một thành phố lân cận đang xảy ra tình trạng mất an ninh trật tự.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Do tình hình chưa được kiểm soát, nên CQPCTHLB đã tiến hành phong tỏa khu vực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Quý vị chú ý ở yên trong nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Hãy tuân thủ quy tắc "ai ở đâu, ở yên đó" và chờ chỉ đạo từ các cấp.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: Cuối cùng, rất mong quý vị hợp tác cùng CQPCTHLB và chung tay đẩy lùi thảm họa Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Tiếp theo sẽ là vài phút quảng cáo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: "Window: Căn nhà của bác hàng xóm nằm trơ trọi giữa \ncánh đồng rơm."
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: Cửa sổ tối om, không thấy sáng đèn. Chắc nhà bác ấy đi ngủ hết rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: Vài tên nhậu say bét nhè đang nằm sõng soài ra đường. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: Họ ngủ mê mệt trên nền đất lạnh lẽo, cứng đơ. Rượu vào là thấy yêu đời lên hẳn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: Xa xa, bạn lấp thoáng thấy ngôi nhà của bác hàng xóm vừa ghé qua nhà bạn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: Ánh sáng chiếu rọi từ trong nhà, hắt ra khung cửa sổ. Có vẻ gia đình bác đang chong đèn chờ bác về. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: Bên ngoài lặng im như tờ, ám mùi chết chóc. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: Không có lấy một bóng người. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: "Window: Ngay cả các bợm nhậu cũng chẳng dám \nbước chân ra đường. "
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: Hay là họ lo sợ thứ gì đó? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: "Window: Qua cửa sổ, bạn trông thấy bác hàng xóm\ncùng đứa con gái."
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Họ chơi đùa vui vẻ, như thể cố quên đi những mối đe dọa đang rình rập ngoài kia... '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Dù chỉ trong khoảnh khắc ngắn ngủi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: Sừng sững trên con đường mòn là một gã trông nhợt nhạt như xác chết. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: Làn da của hắn đầy những nếp nhăn quái dị. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Cứ như thể da thịt hắn bị lộn từ trong ra ngoài. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Dù đứng từ đây không thấy mắt hắn đâu, bạn vẫn có cảm giác hắn đang nhìn mình chòng chọc. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: Bất thình lình bạn thấy lạnh hết cả sống lưng. Chỉ cầu mong sao cho tên Dị Khách ghê rợn kia đi khuất. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Một tốp nhân viên bên Phòng Chống Thảm Họa đang tụ tập tại nhà bác hàng xóm. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Không biết họ đang nói chuyện gì nhỉ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: Có lẽ họ đang thu thập mẫu đất? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: Hay tìm vị trí thích hợp để dựng trại? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: Bạn trông thấy một toán lính mang vũ trang đứng bên ngoài cửa sổ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Có vẻ tiểu đội này được thành phố đặc phái tới đây để bảo vệ các nhân viên Phòng Chống Thảm Họa. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: Bạn nghe phong thanh được vài thông tin về một kẻ da nhợt, thân trần. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: Phải chăng họ muốn truy lùng dấu vết của tên Dị Khách đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: Căn nhà của bác hàng xóm vừa được sơn phết trắng tinh, giờ đã bị nhuộm đen dưới lớp tro tàn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: Cảm giác như ngọn lửa còn đang cháy phừng phừng trước mắt... '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: Hay là có kẻ đã cố tình châm ngòi phóng hỏa? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: Không biết gia đình bác ấy ra sao rồi? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: Có còn ai sống sót không? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Tâm trí tràn ngập những mối lo, bạn thấy lòng mình trĩu nặng vì nỗi tuyệt vọng, bất lực, không sao hiểu nổi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Cả đội lính hôm qua vừa mới tập kết... nay đã chết sạch không còn một ai. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Trông chẳng khác gì một vụ thảm sát. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Thi thể nằm rải rác chất đầy đường, trong đó có một cái bị mất đầu. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: Lẽ nào tên da nhợt quái dị kia chính là thủ phạm? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Trước mắt bạn từng là ngôi nhà của bác hàng xóm, nay đã thành đống đổ nát tan hoang. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Mới đây thôi, một gia đình đầm ấm còn sinh sống ở nơi đó. Vậy mà bây giờ, chỉ còn sót lại những mảng vụn vỡ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Bỗng dưng, một cảm giác khó tả xâm chiếm cõi lòng bạn. Cứ như thể bạn đã thấy trước kết cục này... '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: "Window: ...Rằng chẳng bao lâu sau, cái chết rồi sẽ gõ cửa \ncăn nhà ấy. "
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Bạn trông thấy một cái đầu lâu còn đội mũ bảo hiểm, được treo trên giàn như vật trưng bày. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: Da thịt nó đã cháy thành tro, còn hàm răng thì như bị kẻ nào giật ra mất. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: Hẳn là cái đầu được treo ở đó cả ngày rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Bạn rùng mình lo sợ rằng tác phẩm gớm ghiếc này chính là lời cảnh báo, do tên Dị Khách da tái nhợt kia cố tình để lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Lực lượng Phòng Chống Thảm Họa đang tiến hành điều tra hiện trường vụ thảm sát vừa rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Họ đang thu thập toàn bộ trang thiết bị và vũ khí của những người lính đã chết, để không ai thừa cơ lấy trộm. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Chắc họ cũng không ngờ rằng, một mình tên Dị Khách da nhợt lại đủ cân hết cả đội lính với trang bị đầy đủ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Bây giờ lại xuất hiện thêm vài túi xác nữa. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Bạn lặng nhìn cảnh một người phụ nữ than khóc vì chồng mình bị thương nặng. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: Không rõ anh ta còn sống hay đã chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Chị ấy gồng mình kéo lê thân chồng ra chỗ khác để tránh đạn, khuôn mặt đầm đìa nước mắt. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: Lúc này, trong đầu bạn chỉ dấy lên một suy nghĩ: tình hình sẽ ngày càng khốn đốn hơn thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: Con đường xuyên qua cánh đồng giờ đây đầy rẫy xác người tháo chạy. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Kẻ đứng gần đó chính là thủ phạm: một sĩ quan bên Phòng Chống Thảm Họa. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: Trên tay hắn cầm một khẩu súng trường, làn khói bốc lên xì xèo từ họng súng. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: Người dân chạy bán sống bán chết tới những căn nhà xung quanh. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: "Window: Họ đập cửa rầm rầm, cầu xin chủ nhà cho \ntá túc nương thân. "
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Nhưng không ai muốn mở cửa đón họ vào. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Một nhóm người bị đuổi ra đường đứng tụ tập quanh căn nhà cháy rụi của bác hàng xóm. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Họ bàng hoàng đến thất thần, khẽ xì xào bàn tán với nhau. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Chắc họ đang muốn trú chân ở đó. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: Nhưng thử hỏi còn nơi nào để ẩn náu quanh đây... hay trên cõi đời này nữa không? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: Trên con đường mòn là một người đàn ông đang ôm khẩu súng trường xung kích. Trông gã điên máu lắm rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: Áo khoác gã dính đầy răng, mắt bị móc ra, rồi còn mấy thứ trời ơi đất hỡi gì đó. Nhìn từ đây khó mà thấy rõ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: Lẽ nào đó là "chiến lợi phẩm"? Phải chăng gã giết người không phải vì tự vệ, mà chỉ để mua vui? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Dù gì đi nữa, bạn vẫn thầm mong mình không phải trở thành kẻ thù của gã.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: Xác một người đàn ông treo lủng lẳng trên cột điện, kèm theo cái bảng ghi dòng chữ: "Chúng mày cướp hết của tao". '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: Anh ta bị cướp tài sản ư? Hay bị bên Phòng Chống Thảm Họa bắt mất người thân họ hàng? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: Hàng loạt câu hỏi nảy sinh trong đầu bạn, nhưng không một câu trả lời. Bạn chỉ biết suy đoán mà thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Một nhóm người bị bên Phòng Chống Thảm Họa cưỡng chế di dời đã bắt đầu cư trú ở chỗ bác hàng xóm. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Tuy hầu hết ngôi nhà đã cháy thành tro, nhưng ít ra căn hầm vẫn còn nguyên vẹn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Một góc nhỏ an toàn, bình yên. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Nhưng liệu họ còn trốn chui trốn nhủi được tới khi nào? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: Lũ chó hoang đang chạy rông ngoài đường. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Thân thể chúng gầy xọp đi vì đói khát, hiện lên vài vết cháy sạm. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: Nếu cứ ở yên trong nhà thì chẳng việc gì phải sợ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Nhưng linh tính mách bảo bạn rằng, lúc này đừng nên bước ra đường thì hơn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: Vài tốp nhỏ mang hành lý tụ tập lại gần đây. Họ thì thầm với nhau để không bị bên Phòng Chống Thảm Họa nghe thấy. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Có vẻ họ đến từ vùng cách ly và đang chuyển tới các khu nhà không còn người ở. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Lúc này, hình ảnh người đàn ông treo cổ trông như tấm bảng chào mừng chết chóc. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Một thợ săn Dị Khách đang chĩa súng hăm dọa một nhóm người sống sót. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Có lẽ gã chỉ tình cờ bắt gặp họ thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Bạn nghe thấy tiếng la hét hòa lẫn tiếng kẻ nào đó điên cuồng quát tháo. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: Trong thế giới mới này, liệu ai là kẻ đủ mạnh để sinh tồn? ...Chắc chắn không phải đám người đó rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Các sĩ quan Phòng Chống Thảm Họa đứng vây quanh xác lũ chó. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Một người đang tập trung ghi chép gì đó lên tập giấy. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Liệu chỉ vỏn vẹn vài người có đủ sức ngăn chặn cả đàn chó đói ăn không? Khó đấy... '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Hai sĩ quan Phòng Chống Thảm Họa đứng cạnh cột đèn, ngước nhìn đăm đăm lên người đàn ông treo cổ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Cuối cùng họ cũng bắt đầu điều tra "tâm điểm hút khách" của khu này rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Trông họ cứ đực mặt ra như thám tử mù mờ. Chắc đang tự hỏi không có thang thì anh ta leo lên đó bằng cách nào. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: Cả một nhóm người chết sạch. Đàn chó háu ăn thi nhau cấu xé xác thịt của những kẻ xấu số. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Đầu đạn nằm vương vãi xung quanh đám thi thể. Gã thợ săn hẳn đã bắn chết họ rồi thu về chiến lợi phẩm. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: Thế giới này đảo điên quá rồi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Bọn tà giáo đang chất củi khô thành đống cao. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: Họ định châm lửa đốt gì à? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Mưu đồ cuồng loạn của họ rồi sẽ sớm lộ diện thôi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: Chẳng biết từ giờ tới lúc đó, bao nhiêu sinh mạng vô tội sẽ phải hy sinh vì chữ "đạo" đây? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: Một người đàn ông loạn trí đang đứng ngoài đường. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: Trên tay gã thủ sẵn một can xăng và bom chai. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: Chẳng lẽ gã định thiêu rụi cả ngôi làng này? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: Bộ gã không biết dân ở đây đang cách ly sao? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Xác những người trú ẩn trong căn hầm của bác hàng xóm bị thiêu đốt dưới ánh mặt trời ban trưa. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Lũ chó cấu rỉa xác thịt họ đã cong giò chạy mất hút. Chắc là chúng cũng biết sợ. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: Lẽ nào chúng chạy không phải vì sợ bọn Phòng Chống Thảm Họa, mà vì một thế lực nào đó còn kinh hãi hơn?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: Bọn tà giáo đã bị trói chặt vào đống lửa trại. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: Lẽ nào họ định hiến tế chính mình ư? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: Ý nghĩ đó len lỏi, vặn xoắn trong tâm trí bạn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: Nỗi sợ cái chết thực khiến con người ta mê muội, mù quáng, dám làm cả chuyện tày trời. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: Chỉ sau vài tuần mà sự điên loạn đã trầm trọng đến mức này, ai biết được về sau còn thế nào nữa. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Hàng loạt ngôi nhà cháy rực. Xa xa vang vọng tiếng người gào thét... '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Bạn biết chắc gã tâm thần kia là kẻ đứng sau mọi chuyện. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: Tiếp theo sẽ đến lượt nhà bạn ư? Liệu hắn sẽ gõ cửa vào ngày mai, hay tuần sau đây? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: Rất có thể bạn sẽ phải chạm trán tên điên đó. Không sớm thì muộn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: Những thi thể cháy rụi, chẳng chừa lại thứ gì. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Chỉ còn một đống bùi nhùi, vô hình vô dạng, trông như bùn đặc quánh.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: Chẳng lẽ có thứ gì đã làm tan chảy xác thịt và xương cốt, sau đó ăn tươi nuốt sống phần còn lại? '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Nếu thần linh nghe thấu lời bạn, con quái vật đó sẽ tiếp tục ẩn mình. E rằng tâm trí bạn sẽ không chịu nổi cú sốc khi nhìn thấy nó. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Các sĩ quan Phòng Chống Thảm Họa đứng vây quanh đống xác chết bị thiêu rụi. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Họ đang ghi chép và lập hồ sơ về cái chết của bọn tà giáo. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: Khuôn mặt những người ấy còn in hằn vẻ đau đớn và khiếp sợ, như thể trước khi chết đã trông thấy điều gì khủng khiếp lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Tất cả những căn nhà xung quanh đều đã thành đống hoang tàn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: Chỉ mỗi căn của bạn là còn vẹn nguyên.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Chẳng còn một ai khác đứng ra chịu trận thay bạn trước cơn thịnh nộ của kẻ loạn trí.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Bất kể chuyện gì xảy ra, tiếp theo sẽ đến lượt bạn. '
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Thông báo các đồng chí. Hãy kiểm tra tình trạng khu cách ly. Mã 51. Ghi nhận nhiều vụ nổ lúc 3 giờ sáng.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Đơn vị 32-8 báo cáo. Mã 60: hàng loạt dân thường bị thương vong, sĩ quan bị hạ... Hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: Đơn vị 28-8 báo cáo. Mã 451. Yêu cầu đội đốt xác hỗ trợ thiêu hủy thi thể. Hết.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: Rõ. Triển khai Mã 984. Hiện đang phong tỏa thành phố để chờ điều tra. Đồng chí giữ nguyên vị trí chờ tiếp viện.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Ai nhận được tin nhắn này thì hãy nghe lời tôi, tránh xa vùng ngoại ô bằng mọi giá.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Bọn sĩ quan Thảm Họa đang dí theo bắn chết bất kỳ ai dám bỏ trốn.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: TÔI KHÔNG HIỂU CHUYỆN GÌ ĐANG XẢY RA NỮA. TÔI MUỐN ĐI, TÔI MUỐN TRỐN QUÁCH KHỎI CHỖ NÀY.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: CÓ AI KHÔNG, CỨ–
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Kẻ tấn công khu cách ly không phải bọn đó đâu.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Tôi biết mà. Chính mắt tôi đã chứng kiến.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Thứ đó... không phải... con người...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Xin chào bà con... Tôi là một cư dân bị cưỡng chế di dời đây ạ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Nếu bà con cũng bị đám Thảm Hại kia tống ra đường, thì chúng tôi đang tạm trú ở căn hầm của một ngôi nhà cháy rụi.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Chỗ này gần nhà của thanh niên sống cô lập đó ạ.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: Chúng tôi sắp cạn lương thực rồi. Nếu không được tiếp tế thêm thì sẽ chết đói sớm.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Bà con nào có dư chút đồ ăn thì thương tình san sẻ cho chúng tôi với. Chúng tôi cần lắm ạ.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: A lô a lô... Cô chú anh chị nghe rõ không...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: Bọn Thảm Họa đang tìm cách chặn hết sóng vô tuyến và tín hiệu để "kiểm soát tình hình" đấy.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Lũ chúng nó cố tình che đậy thực trạng đang diễn ra tại thành thị.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Chúng nó định đổ hết tội lên đầu thằng điên giết sạch người dân ở khu cách ly ấy.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Anh chị nào còn ở trong thành phố thì hãy – s...ơ tá...n ngay. Ng...uy h...iểm lắm.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: Nhớ trá...nh xa lũ t...ần tra Thả... Họa. Chú... nó giết ...ông tha đâu.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: C...ÒN C...ẠY ĐƯỢ... T...Ì CHẠY MA... Đ–
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: Lẽ ra khô... nên ...iêu hủy xác ch...t. Làm ...ậy sẽ thu hú...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Phải ch... họ ....... sạch đố...g th... thể... thì nó đã khôn... tớ–
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Toàn b... đơn vị Ph... ...ống Thảm H... chú ý.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'Th... hiện ...hỉ thị mới: bá... bỏ Mã 451, ...ay bằng Mã 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: Không đ...c thiê... ...ủy thi thể, mà hãy bó... vôi.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: 'Nh... lại: B... bỏ Mã 451. Ngh...m cấm ...êu hủy xác ch... nhằm kiểm ...át mức độ ng...y hiểm của đối tượn–'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: Đ... vị 18-8 báo cáo. Chún... tôi kh...ng thể kiểm ...át được.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: Đối t...ng đã ra khỏi địa b... thành ...hố. Yêu cầ... t...p viện ...ay lập tức.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: Xin nh...c lại, yêu ...ầu tiếp vi...n ngay. Một mình ...úng tôi kh...g thể kiểm s... được đối ...ượng.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Chào anh bạn hàng xóm. Nghe giọng con mà bác mừng ghê.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Vậy... con có cho ai vào nhà chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Nếu mà chưa thì lo tính tới vụ đó được rồi á con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: Có gì muốn hỏi bác hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: Bác cũng cho người lạ vào nhà ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: Cần bao nhiêu dấu hiệu để biết được ai là Dị Khách thế bác?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: Bác giải quyết chuyện lương thực kiểu gì?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Thôi chào bác (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Ừa, phải vậy thôi con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: Con gái bác ghét vụ này lắm. Nhưng biết làm sao được? Còn cách nào nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Nó cứ năn nỉ bác dẫn ra ngoài, chỉ để né mấy người lạ trong nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: Sáng thì đi đâu được nữa, chỉ có ra đường vào buổi tối thôi. Ừa thì nguy hiểm thiệt... nhưng đành chịu thôi chứ biết sao giờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Bác biết thì đã hay...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Hổng ai biết được là phải kiểm tra bao nhiêu mới chắc chắn đâu con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Nhưng mà theo bác, tốt nhất là cứ từ từ tỉnh táo, đừng vội hồ đồ kết luận này kia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Kiểu, lỡ như người ta mới đi làm răng ngay trước tận thế thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Kể ra bác cũng hên, tích trữ sẵn từ trước rồi. Bác nhớ là con cũng có tích mà ha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Còn nếu con muốn mua đồ đặc biệt gì đó, thì mình có dịch vụ giao hàng For Rest nè.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: Bác hông có số của chỗ đó, nhưng con cứ xem TV đài báo người ta quảng cáo là có.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Giữ sức khỏe nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Chào anh bạn hàng xóm.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: Con thấy chuyện ngoài kia chưa? Mấy đứa thiếu niên bị giết...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Vậy mà cứ tưởng ngoài đường hông tới nỗi nào... Trời ơi bác lầm to.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Bữa trước con bác lại đòi ra đường chơi tiếp. Chuyện cũng không có gì... cho tới khi bác đụng phải mấy cái xác.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Từ nay về sau bác thề, không đưa con mình tới chỗ nguy hiểm như vậy nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Trời, con nhỏ là cả thế giới của bác. Nó mà có chuyện gì, chắc bác hận mình tới chết luôn quá.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: Con bác có sao không ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: Ai giết mấy đứa thiếu niên vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Bác nhớ cẩn thận ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: Bác cũng hổng biết nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Chỗ đó cỏ dại mọc tùm lum hết, nên bác cứ đinh ninh là nó chưa thấy gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Vậy mà lúc về tới nhà, nó lại kêu là nó thấy có khuôn mặt trong bụi cỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Bác cũng ráng thuyết phục là do nó tưởng tượng thôi, nhưng mà... con nhỏ vẫn bán tín bán nghi lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Là cái thứ da tái nhợt, cao ngồng làm đó. Vậy mà tưởng đâu nó chỉ giết mấy người ở trong nhà...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Cũng tại bác chủ quan quá. Cứ chắc mẩm là hổng có gì phải lo, lỡ thấy bóng dáng thằng đó thì phi thẳng về nhà là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Nhưng mà bác quên nghĩ tới chuyện, lỡ con gái bác đụng phải cảnh tượng gì khác thì sao...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Cám ơn, con cũng cẩn thận nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Chào anh bạn hàng xóm, con gọi hỏi thăm bác hả. Cám ơn nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Nói thiệt với con, giờ nghĩ lại bác vẫn còn run cầm cập.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Hết mấy vụ giết người, lính tráng, rồi tụi Phòng Chống Thảm Họa nữa chớ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Tối qua bên đó còn gõ cửa nhà bác cơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Hỏi đủ thứ về mấy người trong nhà, hí hoáy ghi ghi gì đó vô sổ, rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Bắt người trong nhà bác đi luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: Bọn nó bắt đi đâu thế bác?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Ơn trời chúng nó không bắt con bác
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: Phòng Chống Thảm Họa là bên nào thế ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Bác nhớ cẩn thận ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Có trời mới biết con ơi. Họ kêu là dẫn đi "kiểm tra" gì đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Vậy mà cứ tưởng đám lính với cơ quan nhà nước sẽ khắc phục được thảm họa chớ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Bác dốt quá, đời nào tụi đó chịu giúp mình hay kiếm chỗ an toàn cho mình ở.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: Còn khuya bác mới để nó làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Nó phải bước qua xác bác đã.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Lũ tụi nó mà dám động tay vào con nhỏ coi, bác chặt nó ra thành từng khúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: Bác cũng mơ hồ lắm con. Hổng ai biết gì nhiều về tụi đó cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Hổng hiểu từ đâu chui ra, rồi làm như kiểu ta đây kiểm soát được hết tình hình rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: Mà sao tụi đó phát hiện được mấy dấu hiệu vậy ta? Toàn là đặc điểm ngoại hình bình thường, con người ai cũng có mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Bác thấy tụi này đáng nghi sao á. Nó đang giấu giấu giếm giếm gì đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Cám ơn con nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Ai ngờ mình lại sống đúng cái thời này kia chớ... Gặp toàn chuyện lạ có thiệt...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: Hết mặt trời, Dị Khách, rồi tới cả tụi Phòng Chống Thảm Họa...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Câu hỏi thì nhiều vô số, mà hổng có lấy một câu trả lời.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Hàng xóm à, bác muốn nhờ con một chuyện...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Lỡ bác mà có chuyện gì, con hứa hãy chăm sóc con gái bác nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Con hứa ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: Con không hứa trước được gì đâu
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Cám ơn con. Hàng xóm thì phải tối lửa tắt đèn có nhau chớ. Bác biết là nhờ cậy con được mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Thôi, bác phải cúp máy đây. Ráng lên nha con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Bác...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: Con hổng giúp nó được thiệt hả? Nó còn nhỏ lắm. Bác không muốn để nó chịu cảnh một thân một mình đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Chết, bác phải đi đây...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Tạm biệt con nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Xin chào quý khách. Vui lòng giữ máy trong khi chúng tôi kết nối quý khách với một Thầy Trừ Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: A lô. Con là ai đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: Hỏi vậy là sao ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: Sao bên đó lại cần biết tôi là ai?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Thầy hiểu... Con hông muốn trả lời... Có vẻ như Hồn Dị Khách đã bắt đầu len lỏi vào tâm trí con rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Giờ nghe cho kỹ đây, con không còn nhiều thời gian nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Cho thầy biết xem, con có bao giờ để lát bánh mì trên bàn bếp hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: Không có. Để làm gì cơ ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: Một lát bánh mì á?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Để thầy có thể thanh trừng Hồn Dị Khách ra khỏi người con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: ...Thôi được rồi, cái đó hông quan trọng. Nghe cho kỹ đây, con không còn nhiều thời gian nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Cho thầy biết xem, con có bao giờ để lát bánh mì trên bàn bếp hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: Không có. Để làm gì cơ ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: Một lát bánh mì á?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: À... Hèn chi. Hồn Thổ Công đang kỵ rơ với con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: Bởi vậy nên Hồn Dị Khách mới xuất hiện đó. Nhưng không sao, chúng ta có thể chữa cháy bằng cách này.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: Nhà con có sẵn cái máy tính cá nhân hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: Không ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: Máy gì cơ ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: Ủa, chứ con hổng bày đồ cúng Thổ Công à?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Hèn chi Hồn Dị Khách tìm đến là phải rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: Nhà con có sẵn cái máy tính cá nhân hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: Không ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: Máy gì cơ ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Chậc. Vậy phương án Alt+F4 là thôi bỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Hừm... Vậy cho thầy hỏi, con có ăn hay uống nấm gì hông?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Chỉ có kombucha, mà lâu lâu mới uống ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: Không ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: Bộ con hông biết máy tính là gì thiệt luôn hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Thôi được rồi. Bỏ qua vậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Chỉ có kombucha, mà lâu lâu mới uống ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: Không ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: Chết rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Con phải dẹp liền cho thầy! Kombucha là cái bọn ma quỷ nổi tiếng từ thời xa xưa đó...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Nó làm sợi nấm sinh sôi nảy nở trong người con, rồi để đám linh hồn điều khiển như con rối vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: Con mà để nó mon men lan tới phần ký ức của mình là hậu quả khôn lường đó!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Có thể con sẽ quên hết tất cả... Không thì cũng rơi vào vòng lặp, mỗi lần quyết định lại đổi khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: Mà kinh hãi hơn hết là, chính con còn hổng nhận ra mình đang bị kiểm soát nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Giờ thầy hỏi con một câu cuối cùng: Nhà con đã bao giờ có máu đổ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Rồi ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: Chưa ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Vậy đừng bao giờ đụng vào! Kombucha cũng né xa! Con mà uống là tụi linh hồn nó dễ bề chiếm đoạt cơ thể con đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Chỉ cần một ngụm là mấy sợi nấm đó sinh sôi nảy nở, biến cơ thể con thành con rối luôn cho coi!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Cha chả... Ca này khó... Khó ghê luôn ta ơi...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Rồi ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: Chưa ạ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: À, thầy hiểu rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: Hóa ra không phải Hồn Dị Khách, mà là Hồn Ma. Hồn của người chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Tiếc là bọn ma quỷ thì... nằm ngoài chuyên môn của thầy.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Vụ này phải nhờ tới mấy thầy trừ tà thôi con. Người ta giúp được con đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: Thôi, chắc thầy cũng bó tay rồi, hổng làm được gì cho con nữa. Chào con nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: Buổi Trừ Dị Khách đến đây là kết thúc. Cảm ơn quý khách đã tin dùng dịch vụ của chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Quý khách sẽ được tính phí tư vấn vào tài khoản liên kết. Vui lòng chờ trong giây lát.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: Cái gì, tính phí nữa á?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Tưởng gọi như này là không tính tiền?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ây chà, tiếc quá. Hồn này là hồn loại gì, thầy cũng hông xác định được... Nên thôi thầy đành bó tay.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: Xin lỗi con, thầy phải kết thúc buổi tư vấn này tại đây vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Cầu thần linh tứ phương độ trì cho con.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: Buổi Trừ Dị Khách đến đây là kết thúc. Cảm ơn quý khách đã tin dùng dịch vụ của chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Quý khách sẽ được tính phí tư vấn vào tài khoản liên kết. Vui lòng chờ trong giây lát.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: Cái gì, tính phí nữa á?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Tưởng gọi như này là không tính tiền?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Đúng rồi, thưa quý khách. Thầy Trừ Dị Khách của chúng tôi cũng cần kiếm cơm mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: Quý khách đánh giá trải nghiệm vừa rồi thế nào ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: Chuẩn 5 sao!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Chấm mấy người hẳn 1 trên 10
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Như lồn ấy, địt mẹ chúng mày
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Quý khách xem kỹ quảng cáo sẽ thấy, bên dưới có dòng chữ nhỏ ghi là lần gọi đầu có chút phí tư vấn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: Quý khách đánh giá trải nghiệm vừa rồi thế nào ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: Chuẩn 5 sao!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Chấm mấy người hẳn 1 trên 10
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Như lồn ấy, địt mẹ chúng mày
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Chân thành cảm ơn quý khách. Chúng tôi rất trân trọng mọi phản hồi của quý khách. Xin chào tạm biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: Cậu có tin vào Tử Thần không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: Chồng chị nhờ tôi gọi cho chị
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Thôi khỏi giảng đạo. Chồng chị nhờ tôi gọi cho chị
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: Hả? Chồng tôi á?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Chẳng có gì để nói hết. Sau những chuyện nó đã làm... tôi không muốn nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Ảnh muốn gửi lời xin lỗi vì chuyện đã qua
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Ảnh bảo chị hãy cút xuống địa ngục đi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: Chồng tôi á?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Chẳng có gì để nói hết. Sau những chuyện nó đã làm... tôi không muốn nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Ảnh muốn gửi lời xin lỗi vì chuyện đã qua
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Ảnh bảo chị hãy cút xuống địa ngục đi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Hờ. Xin lỗi á hả?!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: Lại nữa à? Thật luôn?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Trước giờ nó vẫn hay nhờ người khác xin lỗi giùm đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: Cậu có biết tại sao thằng đó lại không dám gọi thẳng cho tôi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Vì nó làm gì có gan mà đối mặt với tội lỗi của chính mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Nó cứ tưởng chuộc lỗi là xong, đâu lại hoàn đấy. Nhưng đời làm gì được như mơ, chẳng có ly vỡ nào lại lành cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Giờ tôi đang sống khỏe, ổn hơn bao giờ hết. Tôi được ở bên những người thấu hiểu mình.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: Chị tưởng cái lũ tâm thần đấy hiểu chị thật à?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: Sao chị lại đi theo hội tà giáo vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Chị nói vậy thì thôi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Cậu thích gọi sao thì tùy, nhưng giờ họ là gia đình của tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Chúng tôi hướng đến cùng một đức tin, rằng Tử Thần sẽ sớm giáng thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: Chẳng phải khổ đau, Ngài sẽ mang sự an nghỉ đến với nhân loại.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Bảo trọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Chúng tôi đồng lòng hướng niềm tin về một ngày mai, khi Tử Thần giáng thế.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Nghe có vẻ hơi ngược đời, nhưng Tử Thần không gieo rắc tai ương, mà sẽ mang hạnh phúc đến cho nhân loại.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Hạnh phúc trong sự an nghỉ, và chấm dứt mọi thống khổ. Cậu cũng đã phải trải qua rất nhiều, đúng không nào?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Rồi một ngày kia cậu sẽ giác ngộ, sẽ thấy những gì mà chúng tôi thấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Bảo trọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Cảm ơn cậu đã hiểu cho tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Bảo trọng.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: A lô? Vâng ai gọi vậy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Chào chị. Em trai chị đưa tôi số này
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Tôi gọi thay cho em trai chị ấy ạ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: Em trai gì? Tôi làm gì có...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: À, là con trai riêng của bố tôi ấy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Ủa từ từ... Vậy anh là ai? Sao nó lại ở với anh?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Chuyện là ba mẹ cậu ấy đang mất tích
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Cậu ấy qua chỗ tôi để ở nhờ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: Mất tích á? Sao tự dưng lại mất tích được?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: Đừng nói là hai người họ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: Tôi không biết nữa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: Có thể lắm
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: Qua ở nhờ chỗ anh á? Không phải nó đang sống chung với bố mẹ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: ...Khoan, đừng nói là hai người họ đã...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: Tôi không biết nữa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: Có thể lắm
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Anh cứ nói với nó là tôi nhận nó về được. Địa chỉ nhà tôi thì nó cũng biết rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: Với cả... cảm ơn anh vì đã giúp nó nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: Chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Cấu trúc của một quả táo gồm: vỏ táo, xứ nấm và giấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Đồng xanh... phiêu diêu...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Lệ sầu, chia cắt, mãi bơ vơ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: Sao cậu không trả lời? Ước gì tôi ngỏm cho rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Họ cúp máy rồi. Quái lạ... Chả hiểu kiểu gì)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: "Cửa sổ dẫn sang phòng khác. Ngày trước người ta\nxây kiểu này để tiết kiệm điện, bật đèn bên đây là\nsáng luôn bên kia."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Rồi sau đó họ lấp cửa lại, nhưng chỉ chặn một bên thôi.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: Thôi nhé. Đã lâu rồi mình không nhìn ra đó nữa.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: "Mình chẳng thích ngủ cạnh tủ đầu giường tí nào.\nToàn là ký ức ám ảnh..."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: "Sao lại treo cái này ở giữa tường mà không phải\ntrong góc nhỉ. Tưởng theo quy tắc là vậy."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: "Mà nghĩ lại thì... luật lệ phép tắc có là cái đinh gì\ntrong mắt bố mình đâu."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: "Con Toto. Hồi bé mình chỉ có đúng\nmột món đồ chơi này."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: À... đấy là nếu không tính mấy que gỗ dùng để nghịch cỏ.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: "Hờ. Nhớ hồi xưa bà hay để chén đĩa chất đầy \nmọi góc tủ luôn."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: "Còn bộ chén quý là phải đợi mấy dịp lễ lộc\nmới dám lôi ra dùng. Mà bây giờ thì... cần quái gì nữa."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Thực tình mà nói... mình cứ ở một mình vẫn tốt hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Tự nói tự trả lời vẫn ổn chán.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: Nghe phiền chết. Mấy người để tôi yên đi được không...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: "Xưa bố từng bảo: \"Khi bố mất rồi, mày hãy tự quyết xem\ncó muốn mở cái hộp này ra không\"."
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: "Đắn đo suốt cả 15 năm trời rồi.\nMà vẫn chưa thể quyết được."
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: Bạn đang cô đơn một mình?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: Hay bồn chồn, lo lắng vì không có ai bầu bạn?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Hãy gọi ngay số 891-533, chúng tôi sẽ nối máy bạn với người trò chuyện lý tưởng.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: Con bác có sao không ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: Ai giết mấy đứa thiếu niên vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Bác nhớ cẩn thận ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: Con bác có sao không ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: Ai giết mấy đứa thiếu niên vậy bác?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Bác nhớ cẩn thận ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: Bọn nó bắt đi đâu thế bác?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Ơn trời chúng nó không bắt con bác
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: Phòng Chống Thảm Họa là bên nào thế ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Bác giữ gìn sức khỏe ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: Bọn nó bắt đi đâu thế bác?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Ơn trời chúng nó không bắt con bác
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: Phòng Chống Thảm Họa là bên nào thế ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Bác giữ gìn sức khỏe ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: Bọn nó bắt đi đâu thế bác?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Ơn trời chúng nó không bắt con bác
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: Phòng Chống Thảm Họa là bên nào thế ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Bác giữ gìn sức khỏe ạ (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Được, vậy nói cho thầy biết: Con có ăn hay uống nấm gì không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Giờ thầy hỏi con một câu cuối cùng: Nhà con đã bao giờ có máu đổ chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: A lô
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: A lô?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: A lô
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Chắc không có ai bên kia rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Số là tôi... tôi rất cần người để tâm sự. Dạo này gặp phải bao nhiêu là chuyện...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: Tôi cũng có gọi thử bạn bè người quen rồi, mà... chẳng ai trả lời trả vốn gì hết.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Rồi tôi tình cờ tìm thấy dịch vụ Quay Số Tâm Tình này.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Ừm...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: À, rồi. Xin lỗi vì đã làm phiền anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Chào anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: Chị đang sống ở đâu vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Tôi đang ở xa nhà lắm. Khổ vậy đó anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: Vậy chị có nhớ quê nhà không?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: Sao chị lại đi một mình?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: Vậy chị có nhớ quê nhà không?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: Thực tình tôi có muốn đâu. Số là...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: Bạn thân tôi cũng muốn đi chung lắm ấy, nhưng ngặt một nỗi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: Ông ý đâu có giấy thông hành hay hộ chiếu gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: Rồi thảm họa ập đến, giờ có muốn lấy cũng chẳng được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Bố tôi... tôi ghét ổng lắm
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: Rồi tới một ngày, tôi từ mặt ổng luôn
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: A lô?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Chào chị, cho tôi nói chuyện với con gái chị được không ạ?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: Hả? Bộ có chuyện gì à?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: À, bạn của con chị muốn rủ qua nhà chơi thôi ạ
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: Đừng... Đừng nói bố con bé cũng là Dị Khách luôn nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: Ơ, "cũng" là sao hả chị?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: Không ạ, tại có lũ điên nào tự dưng thiêu sống bác ấy
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: ...Làm gì có ai khi không lại đi thiêu sống người khác chứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Hóa ra bác ta cũng là Dị Khách... y như cháu nhà tôi vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Người ta cũng thiêu chết con bé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Ngay trong trường mầm non của nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Mới đầu tôi còn khóc tức tưởi, chỉ muốn chết đi cho xong. Mất con rồi, thiết tha gì cuộc đời nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Nhờ có chồng bên cạnh an ủi, tôi mới vượt qua được.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: Nên tôi tin, dần dần cậu sẽ vơi đi nỗi đau mà sống tiếp thôi... cả cô bé cũng vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Cậu hiểu ý tôi không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Trên đời này không có gì là ngẫu nhiên cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Người ta thiêu bố con bé là có lý do hết... Ý trời đã sắp đặt vậy rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: Có khóc lóc cũng chẳng thay đổi được gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Cậu làm ơn... nói vậy với đứa nhỏ hộ tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Thôi, tạm biệt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Cháu nhà tôi... Nó...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Nó chết rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Vợ chồng tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: ...đã phải giết nó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: Hả?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Cúp máy)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: Bọn tôi giết con bé rồi. Không còn cách nào khác cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: Chị... tự tay đi giết con mình á?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: Cậu đừng có mà giở giọng phán xét tôi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Vãi lồn...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Vâng, tôi hiểu mà
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Nghe rõ chưa, con bé là Dị Khách!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Tôi soi từng dấu hiệu rồi, không lệch đi đâu được!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Con tôi tôi còn không biết thì ai biết nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Nên tôi mới nhận ra ngay mấy chỗ bất thường, hiểu chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Mọi dấu hiệu đều khớp cả.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Tôi vừa kể với chồng xong là...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Anh ta xử lý nó luôn. Không chút do dự...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Ban đầu tôi giận điên lên. Chỉ muốn giết quách thằng chồng cho rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Nhưng khi bình tĩnh lại, tôi nhận ra... ngay từ đầu cái thứ đấy có phải con mình đâu chứ. Xót làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Nhờ ơn chồng mà tôi mới vỡ lẽ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Tôi xin lỗi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: Đừng có gọi lại nữa...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Xin cậu đấy...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: Việc quái gì tôi phải trình bày lý lẽ cho cậu hiểu nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: Cút mẹ xuống lỗ đi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Tôi vẫn nhớ con day dứt...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: Nắng nóng làm bạn mệt mỏi, kiệt sức?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: Uống EnerJeka, tỉnh táo tức thì!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: Chỉ cần một lon là tràn trề năng lượng, sảng khoái ngày dài, đập tan cơn khát nhanh hơn cả nước lọc thông thường!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Hiện đã có tại ForRest. Đặt hàng ngay hôm nay qua số: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: 'TV: Ngày xửa ngày xưa, có hai anh em sống gần con đập.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: 'TV: Nước bắn tung tóe khiến dòng sông sủi bọt, như một thức uống mát lạnh ngày hè…'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: 'TV: Nhiều năm sau, lấy cảm hứng từ tuổi thơ dậy sóng, hai anh em đã cùng nhau thành lập nhà bia Con Hải Ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: Đến nay, Hắc Hải Ly đã trở thành thương hiệu bia được nhiều gia đình và cả quán bar ưa chuộng.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'TV: Bia Hắc Hải Ly. Vị ngon không thể chối từ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: Tiếp theo sẽ là tin tức về thời tiết. Nhưng trước hết, chúng tôi xin dành vài phút cho nhà tài trợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: Nắng nóng làm bạn mệt mỏi, kiệt sức?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: Uống EnerJeka, tỉnh táo tức thì!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Chỉ cần một lon là tràn trề năng lượng, sảng khoái ngày dài, đập tan cơn khát nhanh hơn cả nước lọc thông thường!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Hiện đã có tại ForRest. Đặt hàng ngay hôm nay qua số: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Hẹn gặp lại quý vị sau ít phút.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: Dị Khách ngày càng khó phát hiện?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Dù đã biết các dấu hiệu... nhưng bạn vẫn cần một phương pháp bách phát, bách trúng?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: Vậy hãy thử ngay sản phẩm đột phá của chúng tôi: phim thu hào quang mới ra lò!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Loại phim này nhìn thấu được năng lượng linh hồn, giúp bạn phát hiện những kẻ Dị Khách hung ác ngay tại nhà.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Chỉ cần bấm một nút… nếu ảnh xuất hiện các mảng màu đen thì xin chúc mừng, bạn đã tìm ra Dị Khách!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Liên hệ ngay để nhận bộ sản phẩm cơ bản, hoàn toàn miễn phí: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: ...Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: Tiếp theo sẽ là quảng cáo từ nhà tài trợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Ngày xửa ngày xưa, có hai anh em sống gần con đập.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: Nước bắn tung tóe khiến dòng sông sủi bọt, như một thức uống mát lạnh ngày hè…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: Nhiều năm sau, lấy cảm hứng từ tuổi thơ dậy sóng, hai anh em đã cùng nhau thành lập nhà bia Con Hải Ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: Đến nay, Hắc Hải Ly đã trở thành thương hiệu bia được nhiều gia đình và cả quán bar ưa chuộng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: "TV: Bia Hắc Hải Ly.\nVị ngon không thể chối từ."
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Ngay cả người siêng năng, chăm làm nhất cũng cần được nghỉ ngơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: Thuốc lá Margoro là lựa chọn tuyệt vời khi bạn cần hít một hơi thật sâu, thả mình theo dòng khói.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Margoro. Thuốc cho đàn ông đích thực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Lưu ý: Công ty không chịu trách nhiệm nếu khách hàng gặp vấn đề về hô hấp hoặc suy giảm tuổi thọ. Vui lòng cân nhắc trước khi sử dụng).'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Chúng tôi vừa nhận được thông tin quan trọng...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: ...liên quan đến vụ việc xảy ra gần đây trong thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Theo tin báo, một đối tượng mang vũ khí đã tấn công vào một trong các khu cách ly tại thành phố này.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Động cơ của nghi phạm, cũng như việc đối tượng có đồng phạm hay không vẫn đang được làm rõ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Đáng chú ý, một số đối tượng chưa rõ lai lịch đã bỏ trốn khỏi khu cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: Im lặng là điềm báo của chết chóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Sự tĩnh lặng tà ác rút cạn linh hồn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Nhưng đáng sợ hơn cả thinh không... là tiếng chuông tang tóc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: Một hồi chuông báo tử từ xa vọng lại, lớn dần, lớn dần.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Âm chuông ngân vang nguyện hồn mọi sinh linh, lấp đầy tai ta bằng tiếng ồn bất tận.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Những suy nghĩ nhơ nhuốc sa vào màng ráy chằng chịt.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: Một cõi âm trì địa ngục, nơi Dị Khách sinh sôi nảy nở.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: "TV: Bò sâu nhung nhúc trong đống \nnhớp nháp."
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Nam mô rá da tai tích tụ na. Nam mô rá da tai tích tụ na. Nam mô rá da tai tích tụ na.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: Vụ việc hôm nay cũng làm dấy lên nhiều giả thuyết.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Có ý kiến cho rằng đối tượng chỉ có một mình, trong khi một số khác lại nói đây là một băng nhóm có vũ trang, mặc đồ trùm đầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Tuy nhiên, thách thức lớn nhất của thành phố vẫn còn đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Do lệnh phong tỏa, hoạt động xử lý xác chết tại các khu vực lân cận đã bị tạm ngưng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: Tin đáng mừng là, việc kiểm tra các hộ dân vẫn sẽ tiếp tục theo dự kiến.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Quý vị hãy thực hiện hỏa táng thi thể nạn nhân ngay lập tức nếu có thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: Nếu điều kiện không cho phép, vui lòng đợi đến khi tình hình được giải quyết, sau đó hãy giao nộp hài cốt còn sót lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Hẹn gặp lại quý vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: CQPCTHLB hiện đang hỗ trợ những nạn nhân của cuộc tấn công nhắm vào khu cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: Do tình trạng quá tải tại các cơ sở hiện có, Cơ quan đã ra quyết định:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Người dân sẽ được bố trí sơ tán đến các khu nhà ở tại vùng ngoại ô thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: Rất may mắn là các chủ hộ gia đình đang tích cực hợp tác với Cơ quan để sắp xếp tạm trú.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: Thông tin đến nay cho biết, chỉ mới xác định được vị trí của một vài đối tượng bỏ trốn khỏi khu cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: Nhưng tin đáng mừng là, các chuyên gia đã phát hiện thêm một dấu hiệu nhận biết Dị Khách:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Nướu chảy máu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Nếu bắt gặp đối tượng có dấu hiệu này trong khu vực của mình, quý vị tuyệt đối không tiếp cận.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: Hãy chờ nhân viên Cơ quan đến kiểm tra theo lịch và báo cáo cho họ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: Quý vị lưu ý tuân thủ quy tắc "ai ở đâu, ở yên đó" và chờ chỉ đạo từ các cấp.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: Tiếp theo sẽ là thông báo đặc biệt liên quan đến sự xuất hiện của một tổ chức tà giáo nguy hiểm.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Dị Khách không chỉ là thực thể trà trộn giữa con người, mà còn đang thâm nhập vào suy nghĩ, trí óc của chúng ta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: Hoạt động tà giáo có tổ chức đang bùng phát tại nhiều thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: Theo cáo buộc, các hội nhóm này đã:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Thực hiện nghi lễ hiến tế, tôn thờ thần vô danh và có khả năng dính líu đến Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: Cũng theo báo cáo, tổ chức này đã công khai chống lại CQPCTHLB.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: Ban đầu chỉ là hoạt động tuyên truyền vô hại, hội nhóm này nay ngày càng trở nên cực đoan và dẫn đến kích động vũ trang.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Một số chuyên gia còn cho rằng, chính tổ chức này là nguyên nhân gây ra các cuộc bạo động tại thành phố trong thời gian gần đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Quý vị hãy hết sức đề phòng, tránh tiếp xúc với các phần tử tự xưng là "tân tín đồ" này.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: Bất cứ ai có hành vi tiếp tay hay ủng hộ các phần tử này sẽ bị bắt giữ và xử lý hình sự.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Hẹn gặp lại quý vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: Tình hình trong thành phố đang dần ổn định. Tuy nhiên, vẫn chưa bắt giữ được các đối tượng bỏ trốn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Trong khi đó, nỗ lực dọn dẹp xác chết lại tiếp tục trước bối cảnh nảy sinh những thách thức mới.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: Theo báo cáo mới nhất, gần đây xuất hiện nhiều đàn chó hoang chạy rong khắp đường phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: Hiện tại, CQPCTHLB đã điều động một đội ngũ tiến hành xử lý vụ việc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: Đồng thời, phía Cơ quan cũng công bố thêm một dấu hiệu nhận biết Dị Khách:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Da bị kích ứng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: Cơ quan vẫn đang tích cực điều tra và làm rõ cuộc tấn công.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: Hiện vẫn chưa thể xác định đối tượng có phối hợp cùng đồng bọn hay không.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: Tuy nhiên, phía CQPCTHLB cam kết sẽ xử lý tất cả êm đẹp, dù là vụ việc này hay vấn đề Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Nếu có thắc mắc về cách nhận biết Dị Khách, vui lòng liên hệ với CQPCTHLB qua đường dây nóng:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: Quý vị hãy tiếp tục tuân thủ quy tắc "ai ở đâu, ở yên đấy" và chờ chỉ thị từ các cấp.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: ...Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: Tiếp theo sẽ là tin tức về diễn biến ở vùng xích đạo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Các quốc gia nằm gần đường xích đạo đang phải đối mặt với tình hình đáng lo ngại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Cháy rừng diện rộng, nắng nóng đỉnh điểm và hạn hán đang tàn phá không ít quốc gia trong khu vực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Theo báo cáo gần đây, nhiệt độ tại khu vực này rất cao, đủ để gây bỏng cấp độ ba lên da người khi tiếp xúc với mặt đất.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: Hiện tại, vẫn chưa thể xác định số người thiệt mạng hay thực hiện sơ tán người dân.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: Chính phủ nước ta vẫn chưa thể nối lại liên lạc với các vùng bị ảnh hưởng.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: Tuy nhiên, phía CQPCTHLB sẽ cử người đến hỗ trợ công tác cứu trợ ngay khi điều kiện cho phép.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Hẹn gặp lại quý vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: Tình hình bất ổn trong thành phố vẫn chưa có dấu hiệu lắng xuống. Các lệnh phong tỏa tiếp tục được triển khai.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: Tuy nhiên, một mối đe dọa mới lại xuất hiện. Đã phát hiện các thành viên của tổ chức tà giáo tụ tập ở vùng ngoại ô thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: Một số người cho rằng các đối tượng này có thể đang chuẩn bị một nghi thức có đốt lửa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: CQPCTHLB cho rằng tổ chức này có thể liên quan trực tiếp đến các cuộc tấn công nhắm vào khu cách ly.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Tuy nhiên, do tình hình diễn biến phức tạp, Cơ quan và quân đội vẫn chưa thể điều phối lực lượng chuyên trách xử lý.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Nếu bắt gặp thành viên của tổ chức này, quý vị hãy gọi ngay cho CQPCTHLB qua đường dây nóng: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: Ngoài ra, nhằm hỗ trợ người dân, Cơ quan cũng công bố thêm một dấu hiệu của Dị Khách:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Vùng dưới cánh tay có mọc nấm.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: Quý vị hãy tiếp tục tuân thủ quy tắc "ai ở đâu, ở yên đấy" và chờ chỉ thị từ các cấp.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: …Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: Tiếp theo sẽ là diễn biến ở các vùng địa cực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: Nơi đây cũng không tránh khỏi cái nóng gay gắt từ mặt trời.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Các nhà khoa học vừa đưa ra dự báo mới đáng lo ngại về khí hậu toàn cầu.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Nếu nhiệt độ tiếp tục tăng, băng tan từ hai cực sẽ kéo theo lũ lụt trầm trọng trên khắp các khu vực.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Các nhà nghiên cứu đang tích cực điều tra nguyên nhân dẫn đến hiện tượng thời tiết cực đoan này. Hiện vẫn chưa có câu trả lời.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây. Hẹn gặp lại quý vị.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: Tin mới nhận.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: Tình hình trong thành phố tiếp tục diễn biến phức tạp, và thảm họa cũng trở nên trầm trọng hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Băng tan đang làm mực nước biển dâng cao với tốc độ báo động.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Các vùng ven biển trên toàn cầu, trong đó có nhiều thành phố lớn, đang phải đối mặt với nguy cơ lũ lụt nặng nề.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Một số hồ nước bị ô nhiễm phóng xạ cũng bắt đầu bốc hơi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: "TV: Các nhà khoa học cảnh báo rằng, điều này có thể dẫn đến hiện tượng \nmưa độc."
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Khi nghe thấy tiếng sấm, quý vị hãy tìm chỗ trú ngay lập tức và tránh tiếp xúc trực tiếp với nước mưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: "TV: Thành phố vẫn sẽ tiếp tục bị \nphong tỏa."
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: Hiện tại, CQPCTHLB vẫn chưa thể bắt giữ toàn bộ các đối tượng bỏ trốn, nhưng đã phát hiện thêm một dấu hiệu mới:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Đồng tử chuyển động liên tục.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: TIN KHẨN CẤP'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Chúng tôi xin tạm dừng bản tin do nguy cơ trường quay bị tấn công.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Nếu có thắc mắc về cách nhận biết Dị Khách, vui lòng liên hệ qua đường dây nóng: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Bản tin kết thúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Tin mới nhận.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: CQPCTHLB vừa bắt giữ một loạt các quan chức chính phủ.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: Theo báo cáo, một số quan chức này đã được xác định là Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: Do không đủ số quan chức để duy trì bộ máy, CQPCTHLB sẽ đảm nhận vai trò chính phủ lâm thời.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: Ngoài ra…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Xin chờ một chút…'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Tin mới nhận từ CQPCTHLB:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Những đối tượng bỏ trốn đã vượt qua hàng rào phong tỏa toàn thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Xin nhắc lại, những đối tượng bỏ trốn đã vượt qua hàng rào và tràn vào thành phố.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Quý vị hãy lập tức chặn cửa sổ và khóa cửa ra vào.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Ở yên trong nhà và chờ lệnh của các cấp.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Bản tin kết thúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Dịch vụ giao đồ ăn ForRest xin nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: Quý khách muốn đặt hàng gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: Cho tôi hai lon EnerJeka, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: Cho một lon cà phê nhé, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: À thôi, tôi đổi ý rồi, không có gì
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: Xin lỗi quý khách, chúng tôi không thể ghi nhận đơn hàng mới vì quý khách đã đặt một đơn rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Do nhu cầu tăng cao, chúng tôi buộc phải giới hạn số đơn mà khách hàng có thể đặt mỗi ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Nếu quý khách vẫn muốn đặt hàng, xin vui lòng thử lại sau.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Cảm ơn quý khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Cảm ơn quý khách đã đặt hàng. Dự kiến hàng sẽ giao tới vào tối mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Cảm ơn quý khách đã đặt hàng. Dự kiến hàng sẽ giao tới vào tối mai.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Anh chị đang gọi đến Bộ phận Y tế trực thuộc Cơ quan Phòng, chống thảm họa Liên bang.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Chúng tôi hiện đang nhận hỗ trợ tư vấn về quy trình kiểm tra chính thức đối với Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: Anh chị có thắc mắc gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: Tôi nên kiểm tra dấu hiệu ở răng như thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: Tôi nên kiểm tra dấu hiệu ở móng tay như thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: Tôi nên kiểm tra dấu hiệu ở mắt như thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Tôi hỏi xong rồi, cảm ơn đã hỗ trợ
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Để đảm bảo kết quả kiểm tra chính xác, chúng tôi khuyến cáo không nên sử dụng thuốc lá các loại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Hút thuốc có thể làm thay đổi tình trạng răng, dẫn đến kết quả sai lệch.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Để đảm bảo nhận được đúng kết quả, vui lòng tránh rửa tay trước khi tiến hành kiểm tra.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: Nước có thể loại bỏ chất bẩn trên bề mặt, dẫn đến sai số hoặc kết quả không chính xác.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Để kết quả sàng lọc được chính xác, vui lòng tránh uống cà phê cũng như các loại thức uống có chứa caffeine.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: Caffeine là tác nhân gây nên chứng mất ngủ và lo âu, dễ dẫn đến căng thẳng thần kinh và tình trạng đỏ mắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Cảm ơn anh chị đã hợp tác với Cơ quan Phòng, chống thảm họa Liên bang.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: Chúng tôi đánh giá cao sự đóng góp của anh chị trong nỗ lực kiểm soát tình hình hiện tại.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Giúp chúng tôi cũng là giúp anh chị! Tuân thủ quy trình kiểm tra là hành động góp phần bảo vệ tương lai nhân loại.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: Bản tin xin được kết thúc tại đây.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Hiện đã có tại ForRest. Đặt hàng ngay hôm nay qua số: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Chào mừng quý vị đến với bản tin buổi chiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: "TV: Nạn cháy rừng tiếp tục lan rộng, và Dị Khách vẫn đang hoành hành \nkhắp cả nước."
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: CQPCTHLB cũng vừa phát hiện thêm một dấu hiệu mới giúp phát hiện Dị Khách...'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: Tiếp theo sẽ là thông báo đặc biệt nói về bản chất của Dị Khách.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: A lô? Ai đó?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: 'Vợ của anh đưa tôi số này '
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Vợ anh đang cần anh giúp
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: À rồi, sao nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Chị ấy để lạc hết mấy đứa con rồi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: Đám nhỏ có đang ở chỗ anh không?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: Lại nữa à? Con mẹ đó lúc nào cũng gây chuyện, để tôi phải dọn dẹp hậu quả.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Mẻ cứ quen thói ngồi không chễm chệ rồi ca bài "Em mệt lắm".'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Chuyện cơm bữa rồi đấy cậu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Chị ấy để lạc hết mấy đứa con rồi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: Đám nhỏ có đang ở chỗ anh không?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Thế à, lại chả thèm để ý con cái của mình nữa rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: Xong cứ để thằng chồng này suốt ngày đi theo dọn hậu quả, còn lạ gì nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: Cậu điện thử cho nhà mẹ vợ tôi chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: Chưa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: Anh tới đón chị ấy được không?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: Ủa, không phải tụi nhỏ đi theo mẻ à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: Lại cái tật nữa rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: Cậu điện thử cho nhà mẹ vợ tôi chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: Chưa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: Anh tới đón chị ấy được không?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Chưa hả.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Có khi tụi nhỏ đang ở đó đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: Để mẻ tự đi mà đón.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Tôi không rảnh mà đi hộ đâu. Nhắn với mẻ câu này: Làm mẹ kiểu gì mà để lạc mất con vậy hả?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Tôi để hai người tự giải quyết đấy
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: Thôi thì, để tôi báo chị ấy biết là anh còn sống
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Để con mẻ tự đi đi. Có phải tiểu thư đài các đâu mà cần đưa với chả đón?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Còn chân còn cẳng thì mắc quái gì không đi được? '
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Tôi để hai người tự giải quyết đấy
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: Thôi thì, để tôi báo chị ấy biết là anh còn sống
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: …'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: Thế cậu gọi làm quái gì? Thấy nữ nhi tội nghiệp nên muốn ra tay nghĩa hiệp à? '
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Thích làm gì thì làm. Con mẹ đó cũng đéo quan tâm đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Đừng có làm phiền bố mày nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: Thôi thì, để tôi báo chị ấy biết là anh còn sống
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Thôi khỏi, báo làm gì chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: Hai người bọn tôi có còn đếch gì với nhau nữa đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: Chả hiểu sao cậu lại xía vào làm gì.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: Thôi… chúc hai người sống hạnh phúc.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Khốn khổ khốn nạn... Thật luôn hả... Họ chết rồi à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Khốn khổ khốn nạn... Thật luôn hả... Họ chết rồi à?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Trời đất ơi... Sao lại ra nông nỗi này...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: A lô? Ai đấy?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Vợ anh và em gái chị ấy đang ở chỗ tôi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Vợ anh đưa tôi số này
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Cậu gọi để đòi tiền chuộc hay gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Tôi không còn thứ gì để mà cống nạp đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: Ít lâu nữa cũng chẳng còn một ai.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: Ý anh là sao? Có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: Vợ anh vẫn khỏe
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Nói tôi biết đi cậu, cô ấy vẫn bình an chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Cổ mạnh mẽ lắm, khó khăn biết mấy cũng vượt qua. Dù vất vả đến đâu, cổ vẫn sẵn lòng cứu giúp mọi người!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Nhưng còn tôi thì... hết cứu nổi rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: Tôi chẳng còn sống được bao lâu nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: Ý anh là sao? Có chuyện gì vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: Vợ anh vẫn khỏe
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Tôi... Tôi chịu hết nổi rồi. Hết mặt trời, rồi tới Dị Khách... toàn những chuyện quá kinh khủng. Tôi thấy thân mình như tê dại.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Tôi chỉ... chỉ muốn mọi chuyện qua đi. Còn mỗi một cách mà thôi... Cậu hiểu chứ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Nhờ cậu chuyển lời giúp tôi rằng... tôi yêu cô ấy lắm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: Mà thôi... đừng nói gì thì hơn. Đừng để cô ấy mất công tìm tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: Tôi không muốn vợ biết rằng tôi không chờ được cô ấy đi cùng...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Cảm ơn cậu đã gọi... và lắng nghe.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Vĩnh biệt...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Chắc vợ tôi vẫn còn khư khư giữ lấy đứa em. Chẳng bao giờ học được cách buông bỏ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Cái số hẩm gì đâu ấy, cổ toàn dính phải mấy kẻ ốm yếu què quặt thôi. Bởi vậy nên tôi mới bỏ đi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Bộ phận tiếp nhận trực thuộc CQPCTHLB xin nghe. Chúng tôi giúp được gì cho anh chị?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: Có vợ của một anh cán bộ Thảm Họa đang ở nhà tôi
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: Tôi muốn giới thiệu một nhân tố rất tiềm năng
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Thế anh cần gì? Tôi đang chưa rõ câu hỏi của anh.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Chắc anh không có ý đe dọa chúng tôi đâu nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: ...Ừ, dọa thật đấy
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Chị này từng là cán bộ vùng biên, giờ đang muốn tìm việc bên mấy vị
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Bạn nghe tiếng đầu dây bên kia thở dài thườn thượt)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Anh thuộc mấy phần tử kích động đấy chứ gì? Lúc nào cũng càm ràm đủ thứ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: Còn biết bao người đang cần được hỗ trợ kia kìa. Đừng làm phí thời gian của chúng tôi nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Bọn Dị Khách đang hoành hành ngoài kia kìa. Anh mà còn dây dưa ở đây thì sẽ có người chết đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Thôi chào.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Hừm. Tôi nói trước nhé, công việc này... không dễ đâu. Anh nghĩ chị ấy đã đủ bản lĩnh chưa?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Nếu đã chắc chắn rồi thì nhắn chị ấy điền vào Tờ Khai 31-G, rồi nộp ba bản cho chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Tiếp theo, chị ấy phải kiểm tra sức khỏe để đảm bảo đủ tiêu chuẩn. Sau đó điền vào...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Bạn cúp máy luôn. Sao phải phí thời gian gọi điện nói hộ bà chị này cơ chứ?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: Người đó muốn ứng tuyển vị trí nào? Miễn đừng đòi chức Giám đốc là được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Lần này là lần thứ ba rồi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Giám đốc nhé
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Bộ phận truy vết, hay trinh sát gì đó
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Địt mẹ lại gọi cù nhây nữa à. Mệt lắm rồi đấy nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Mấy người cứ làm trò khỉ này thì sao mà tôi giúp người được. Rồi đến lúc người ta bị Dị Khách giết ra đấy thì ai chịu trách nhiệm?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Anh chịu đi nhé! Ai bảo đùa đã ngu lại còn vô duyên.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Họ cúp máy ngang luôn. Thật hả trời?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: Chúng tôi không có nhu cầu tuyển các vị trí này. Chúng tôi đang cần các chuyên gia dịch tễ và nhà khoa học có trình độ kìa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: Có vẻ bạn của anh không phù hợp rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: Nhưng thôi ai mà biết được. Tình hình bây giờ cứ thay đổi xoành xoạch ấy. Tầm một tuần nữa anh gọi lại thử xem.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Khéo khi đấy lại có chỗ cho "nhân tố tiềm năng" của anh thì sao.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Xứ nấm... chớ sa...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Cẩn thận... lầm lỡ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Kiểm tra nhịp thở của cô bé.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Xin lưu ý, hiện tại không còn cách nào để đến nước chúng tôi bằng đường hàng không hay đường sắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: Anh chị cần hỗ trợ gì ạ?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Tôi cần trả một du khách về nước
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: Sao lại không đi tàu được vậy?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Tốt nhất là anh nên đợi đến khi đường bay được mở lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Các chuyến phà vẫn hoạt động, nhưng không đảm bảo an toàn đâu ạ. Nguyên nhân là do buổi tối thường có bão.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Thêm nữa, mặt nước sẽ phản chiếu ánh mặt trời lên phà. Vì vậy, các thuyền viên không thể làm việc quá lâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: Vậy không còn cách nào đưa anh này về à? Khổ thân
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Giờ ảnh đang trú tại nhà tôi. Bên đó bảo hộ ảnh về được không?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Đường ray hiện bị giãn nở do nhiệt độ tăng cao. Vì quá rủi ro nên các đoàn tàu không thể di chuyển vào ban ngày.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Ngoài ra, tàu chỉ hoạt động về đêm, nên khó mà đi xa được.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Tàu sẽ phải trung chuyển liên tục. Tốt nhất là anh nên đợi đường bay mở lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: Vậy không còn cách nào đưa anh này về à? Khổ thân
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Giờ ảnh đang trú tại nhà tôi. Bên đó cưu mang ảnh được không?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Rất tiếc, e là chúng tôi cũng không giúp được gì hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: Anh phải kiên nhẫn chờ đợi thôi ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Ảnh còn không nói được tiếng nước tôi nữa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: Má, thật luôn? Chả được cái tích sự gì
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: Chúng tôi không có khách sạn nào cho anh ấy lưu trú.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: Chúng tôi cũng không thể hỗ trợ thêm. Chúng tôi đang cố xử lý, nhưng anh ấy không phải trường hợp duy nhất gặp nạn.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Ảnh còn không nói được tiếng nước tôi nữa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: Má, thật luôn? Chả được cái tích sự gì
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Anh thông cảm, nhân viên của chúng tôi đang thực sự quá tải. Chắc anh cũng nghe tin là ngân sách của đại sứ quán bị cắt giảm nặng rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Chúng tôi đang làm hết sức có thể rồi ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Ối giời, mấy người cao cả quá nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Lười thì nhận mẹ đi, còn bày đặt văn vở
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: Này, anh không cần phải nói nặng như vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: Chúng tôi đâu thể nào vác anh ta lên lưng mà phi về nước. Nếu anh muốn giúp đến vậy thì tự đi mà giúp.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Anh thông cảm. Do ngân sách rất eo hẹp, nên giờ chúng tôi làm việc bằng cơm và đam mê thôi đấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Ối giời, mấy người cao cả quá nhỉ
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Lười thì nhận mẹ đi, còn bày đặt văn vở
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: Anh không thích cách bọn tôi làm việc chứ gì? Thì tự đi mà làm.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Chúc anh may mắn qua được cửa khẩu với đống thủ tục kiểm tra Dị Khách và cái nóng cháy đầu giữa trưa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Biết rồi, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Địt mẹ mấy người
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Vậy anh thì siêng quá nhỉ? Thế sao không đi làm đi, lại ngồi lì ở nhà làm gì?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: Hay là anh muốn tới đây rồi cầm tay chỉ việc cho bọn tôi?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Chúng tôi rất mong được anh chỉ giáo, vì anh giỏi quá, cái gì cũng biết hết luôn mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Biết rồi, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Địt mẹ mấy người
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: ...Xin lỗi anh, tôi hơi quá lời.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: Chúng tôi cũng nhận được nhiều cuộc gọi từ những người... gắt gỏng như anh rồi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Chúc anh một ngày tốt lành.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Chúc anh thượng lộ bình an.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: Nếu sau này anh có ý định du lịch đâu đó, xin vui lòng gọi cho chúng tôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: Chúng tôi luôn sẵn sàng hỗ trợ.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: "Tạp chí kiểu này hay có cái trò\ntìm người ẩn mình giữa đám đông..."
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Dịch vụ Quay Số Tâm Tình chính là giải pháp dành cho bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Tổng đài CQPCTHLB xin nghe. Chúng tôi có thể hỗ trợ gì cho anh chị?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: CQPCTHLB? Là cái gì thế?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: Chị nói gì tôi không hiểu?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Cô nhân viên chưa kịp đáp lời thì một giọng nam hét ầm lên qua điện thoại)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: MÀY BỊ NGÁO ĐÁ HẢ?! CÚP MÁY ĐI, MAU!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: Tôi nên kiểm tra dấu hiệu ở nách như thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: Tôi nên kiểm tra dấu hiệu ở tai như thế nào?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Để đảm bảo kết quả kiểm tra vùng dưới tay được chính xác, vui lòng tránh tiếp xúc với nước.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Kể cả tắm rửa hay vệ sinh cá nhân.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: Tai ư? Xin đợi chút...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Tôi cần trao đổi với quản lý để xác nhận. Khi nào có câu trả lời, tôi sẽ liên hệ lại.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Xin chào, bạn đang gọi đến Quay Số Tâm Tình. Bên mình sẽ sớm nối máy cho bạn với người trò chuyện lý tưởng. Vui lòng giữ máy ạ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Dạ a lô.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Có thể chỗ này không thích hợp để tôi trải lòng cho lắm, nhưng thôi có còn hơn không.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Tôi cũng chẳng muốn kể lể phiền muộn của mình rồi bắt người khác phải nghe đâu, nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: Chỉ cần có người trò chuyện là tôi đã thấy đỡ hơn nhiều rồi. Lòng tôi sẽ nhẹ đi hẳn ấy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: Anh chịu khó nghe tôi chia sẻ nhé?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Được thôi
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: Nghe có vẻ dài dòng nhỉ. Thôi tôi chưa chuẩn bị tinh thần
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Cảm ơn anh! Xin chân thành cảm ơn!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: À, trước hết để tôi giới thiệu đôi chút về mình đi. Như vậy chắc sẽ dễ nói chuyện hơn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: Có điểm nào anh tò mò muốn biết không?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: Chị bảo bạn bè chị không chịu nghe máy à?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Chẳng là tôi muốn tìm chỗ tránh nóng, nên mới đi tới nơi lạnh nhất có thể.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Bây giờ tôi đang ở giữa nơi đồng không mông quạnh, lạnh muốn thấu xương. Ở đây trơ trọi đìu hiu lắm, tới ngọn cỏ còn không mọc nổi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Được cái cũng tương đối an toàn, vì ở xa tít mù khơi, cách biệt hẳn với mấy khu khác.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Mà so với cái lạnh dưới chín tầng địa ngục thì... ở đây đã nhằm nhò gì đâu.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Lạ quá ha, hồi trước tôi chúa ghét bị lạnh luôn. Thế mà giờ... cái lạnh cứ như là lộc trời ban vậy.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Thưc sự tôi cũng muốn tin lắm chứ. Tin rằng mặt trời sẽ hạ nhiệt, thảm họa rồi sẽ chấm dứt mà thôi.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Nhưng niềm tin của tôi gần cạn đáy rồi. Kết thúc có hậu ngày càng xa vời vợi. Cứ cho là mặt trời ngưng cháy rừng rực đi, thì sao nữa?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Dị Khách vẫn cứ nhan nhản đấy, chẳng biến đi đâu. Chúng nó sẽ dần thế chỗ những người mình thương yêu, mà mình không hề hay biết...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: Sao chị lại đi một mình?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Thật ra tôi cũng muốn thử gọi lại lắm, nhưng mà... không biết gọi như nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: Thảm họa vừa mới bùng phát là tôi quyết chí rời bỏ quê mình luôn. Tôi bay đi thật xa, càng xa khỏi cái nóng này càng tốt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Tôi cũng có hứa hẹn là sẽ thường xuyên gọi điện, hỏi thăm từng người một xem có ổn không, đang như nào...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Nhưng khi tới nơi rồi, tôi lại không liên lạc được nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Sau đó tôi mới phát hiện ra lý do: tại đường dây điện thoại bên đó bị cắt.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: Nguyên cả một thành phố bị cắt đứt liên lạc với thế giới luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Rốt cuộc giờ chỉ có mình tôi ở đây là an toàn, còn đám bạn thì...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: Cứ nghĩ tới việc mình sẽ chẳng bao giờ gặp lại những người thân yêu nữa... là tôi lo sợ khủng khiếp.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Giờ tôi nhớ lắm những tháng ngày bình yên, khi đời còn giản dị và tương lai còn đáng mong chờ.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Ông ý bàng hoàng lắm... Hối hận vì không chịu lấy sớm hơn. Tôi cũng muốn giúp ổng mà chẳng biết giúp như nào.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Nhớ chứ anh. Nhưng nhớ thành phố thì ít, mà nhớ người thân bạn bè ở lại thì nhiều.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: Nhớ hơn hết thảy là bạn chí cốt của tôi...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: Ông ý cũng muốn theo tôi mà không được. Rồi tôi hứa là sẽ giữ liên lạc, sẽ gọi cho ổng. Nhưng mà...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Biết sao không, hình như ông ý thương thầm tôi đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Ổng quan tâm tôi lắm. Luôn bên cạnh ủng hộ, sẵn sàng lắng nghe mỗi khi tôi cần.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: Từ từ tôi cũng nhận ra rằng, cả tôi với ổng đều thương nhau.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Tôi thì muốn ổng tỏ tình trước, nhưng mà chắc ông ý chưa tìm được cơ hội chăng?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: Rồi thế giới ra nông nỗi này đây... Nên là bọn tôi chẳng còn thời gian cho chuyện đó nữa.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Giá như mà tôi thổ lộ trước...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Vậy là anh biết một tí về tôi rồi ha. Giờ tới lượt anh chia sẻ đó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: Tôi không quen nói về bản thân mình lắm...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Tôi còn chẳng biết nên kể cái gì đây...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: Gì đâu mà phải ngại. Tôi nghe mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Ừ thì tôi... cũng không có ai thân thiết
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Tôi... cô đơn lắm
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: Không sao đâu mà. Cứ thoải mái đi, nói về bản thân đâu có gì sai.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Ừ thì tôi... cũng không có ai thân thiết
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Tôi... cô đơn lắm
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: Tôi với bố tôi... không được hòa thuận
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Tôi chẳng còn là thành viên của cái nhà đó nữa
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: Giờ tôi chỉ còn mỗi căn nhà chó chết này
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Giờ họ đi hết rồi, chỉ còn lại mỗi căn nhà này thôi
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Khổ thân anh quá... Mà hình như anh chẳng ham được quyền sở hữu căn nhà đó lắm nhỉ?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: Ừ, kiểu vậy
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Phải chi nó cháy rụi luôn thì tốt biết bao
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: Tôi... Tôi không tưởng tượng nổi anh đã phải chịu khổ tới mức nào luôn.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: Tôi không tưởng tượng nổi anh ghét cha mình tới cỡ nào, mà muốn đốt trụi cả căn nhà như vậy...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Nè, cảm ơn lần nữa vì đã tâm sự với tôi nha.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: Thôi chào anh. Cố lên, mạnh mẽ lên anh nhé.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Chào chị, cho con gái chị qua nhà tôi chơi với bạn được không?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: Chuyện là ở đây có đứa nhỏ... mà ba con bé chết rồi
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Những dấu hiệu bọn tôi nghe kể đều trúng hết... Chính chồng tôi đã khẳng định vậy mà.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: Nó là Dị Khách đấy! Dấu hiệu nào cũng trúng cả, rõ rành rành như vậy rồi!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Giờ tôi chỉ hối hận duy nhất một điều, sao lúc đó không hỏi con ký sinh đấy đã làm gì đứa nhỏ nhà tôi rồi...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: Tiếp theo sẽ là thông báo đặc biệt về lệnh tạm dừng xử lý xác chết.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: Cho tôi hai hộp thức ăn mèo, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: Cho tôi một bao thuốc lá, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: Cho tôi một lọ kombucha, cảm ơn
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Hiện đã có tại ForRest. Đặt hàng ngay hôm nay qua số: {0}.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
