%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_uk
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: uk
  m_SharedData: {fileID: 11400000, guid: 1290f85681bd44940af0abf2b1b05504, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: Кхе-кхе… Та будь ласка, друже. Мені приховувати нема чого. Все вже давно вигоріло.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: Дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: Кхе-кхе… Ти вже пробач. Дим — це, знаєш, не зубний лікар.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: Ось, дивись. Кхе-кхе…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: Як два обгорілі поліна. Натомість нігті чисті. Іронічно, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: Без проблем.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: Бачиш, кхе-кхе… Червоні, як два вуглика. Це від диму, друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: Ти певен? Там видовище не з приємних.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: Все обгоріло… шкіра потріскалася, немов стара кора дерева. Я зайвий раз рук не піднімаю — боляче.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: Так, звісно. Зараз вийде обвуглений труп, воно так завжди.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: Що, подобається, кхе-кхе?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: Тут все просто — обгоріли до хрящів.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: Скоро слух пропаде… може, це й на краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: Та стріляй вже, друже. Тільки в зуби не цілься — вони вже й так останні днини доживають.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: Та мені вже нічого не страшно. Стріляй, якщо так легше стане.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: Може, так буде навіть краще…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: Ти хоч розумієш, через що ці руки пройшли?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: Якщо ця світлина — вирок, кхе-кхе, давай закінчимо. Мене вже нічого не тримає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: Все горить… то може, й моя черга настала.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: Знаєш, кхе-кхе, ніяк не зміг привчити дітей зуби щодня чистити. А тепер… Тепер нема кому нагадувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: Цими руками, кхе-кхе, я колись рятував людей. А тепер навіть кухоль нормально не втримаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: Ось воно як…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: Що ж, час вже спочити…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: Коли ліс горить, кхе-кхе… Ти просто дивишся, як він перетворюється на попіл. І розумієш, що нічого не можеш вдіяти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: Іноді прокидаюся вночі та відчуваю, як шкіра буквально лопається. Намагаюся її намастити чимось, але користі мало. Все вогонь забрав…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: Тільки пам''ять у вогні не горить, а тіло — справа часу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: Коли вогонь реве навколо, ти розумієш, наскільки дорога ця тиша. Кхе-кхе, вухам тепер все одно, а ось душі — ще ні.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: Ага, давай сюди свої тести, зараз все пройдемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: Ось, дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: Такі зуби — справжня знахідка.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: Не зуби, а золото! Не всі, звичайно, але все ще попереду.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: Знаєш, як легко відкривати передніми зубами банки пива?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: І навіщо ці відкривачки?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: Добре вже те, що руки взагалі залишилися.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: Хіба я зміг би всюди ганяти без рук?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: Почекай.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: Пальці спиздили!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: Вчора не вистачало лише одного, решта де?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: А, грець з ними, відростуть, тільки пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: Палець спиздили.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: Дрібниця, а неприємно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: АЛЕ НІГОТЬ ВЖЕ ВІДРОСТАЄ ТРОХИ, БАЧИШ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: Значить, ноги теж відростуть, тільки пізніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: Куди дивитися? Прямо на тебе?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: Бачиш, як сіпаються? Це звичка лишилася.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: Ще з часів, коли я газував на повну, не встигав поглядом зачепитися за… хоч за щось.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: Мабуть, не готовий забути про швидку їзду.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: Га?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: Ну давай, АХАХАХАХАХА, давай, а що?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: Ох і гуморист ти. Просто вищий клас.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: Будемо, значить, під пахви один одному заглядати. Очманіти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: За вікном справжнє пекло, космос буквально хоче розмазати всю планету.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: Та ще й Гості скрізь блукають, щоб вже точно всіх добити.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: А ти такий: «Пахви мені показуй»!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: АААААХАХАХАХА.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: Хочеш мене сфоткати?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: Не дуже я це полюбляю, але гаразд.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: Бляха, я моргнув.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: АХАХАХАААХ, оце клааас!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: Теж підхопив цю хвилю, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: Ну так, так. А що, чи не так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: Почекай, ти не жартуєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: Та це… пиздець.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: Та не буду я більше твоє пиво брати, що ти відразу ображаєшся?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: Знаєш, що у нас робили з ображеними?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: На ображених візки возять.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: Будеш ображатись — повезеш мене кататись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: І що?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: Мені це не допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: Тобі, мабуть, теж. Тоді навіщо рушниця?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: За кулею я, мабуть, не встежу. Але ухилитися спробую.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: Не розумію, навіщо голити волосся? Це природний захист організму.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: Бачиш червоний висип? Я там пальці собі вирощую. Запасні.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: А, бачу, комедія навіть ще не почалася.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: Де ж ми в цьому житті завернули не туди?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: Які ще фотографії? Перед смертю на них все одно не надивишся.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: Що я сказати хотів…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: Може, я просто піду?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: Ось і догралися, виходить.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: Брудом люди в чорних робах просять йти до ешафоту.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: Вічно буду я незгодний.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: Це все біологія нашого м''яса, розумієш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: Чому раніше ми з цього всього сміялися, а тепер готові голови один одному проломити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: Треба готуватися вмирати, ось що.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: Руки зараз — мій єдиний двигун.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: І зчеплення спиздили.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: Чесно кажучи, страшно, що одного дня я можу залишитись без рук. Що ж тоді?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: Це ж я більше не зможу пересуватися. Застрягну назавжди.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: Навіть смерть так не лякає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: Як очима не бігай, за часом більше не встигаєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: Помітив, як із віком час почав розганятися?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: От у дитинстві ми не поспішали жити. Тоді все було спокійно, без відповідальності чи серйозних рішень.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: А зараз, як не поспішай, вже, схоже, не встигнемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: Ні, знаєш, щось мені раптом навіть не весело.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: Оці маячні перевірки, гасіння пожеж.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: Усі так хочуть врятувати світ, та тільки не домовляться, як саме.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: А який сенс? Може, просто час вже розслабитись і не паритися?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: Слухай…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: Ти не вважаєш, що ми всі вже приїхали?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: Зараз буде кінцева, скоро виходити.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: У віконце дивимося, а зупинку вже видно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: Ти до цього готовий?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: Я ось замислився. Ти не ображайся.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: Якщо… якщо ти не довіряєш цій ознаці, то як я можу їм довіряти?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: Може, всі вони однаково вказують на Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: Людям, звичайно, властиво помилятися.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: Але ці помилки призводять до дуже страшних наслідків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: Якщо… якщо ти покладаєшся на цю ознаку, то як я можу довіряти попереднім?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: Може, вони всі теж хрінь якась?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: Ми, звичайно, люди. Помилятися можемо, все таке інше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: Але ці помилки призводять до дуже страшних наслідків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: Ти ж… один хибний рух, щось пішло не так, і ось ти загубив чиєсь життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: Якщо ти впевнений у своєму виборі, то… я заздрю ​​твоїй впевненості.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: Ох, перевіряйте. Мені нема чого приховувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: Прошу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: Знаєте, раніше я не звертала на них уваги. Часу якось не було. А тепер… Тепер шкодую.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: Ось, дивіться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: Лопати, а не долоні. Все для дітей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: Ну, дивіться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: Бачите, які мішки? Це від недосипання…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: Ну, дивіться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: Дезик давно скінчився, прошу вибачити.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: Можна мені сісти? Ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: Розпатлана та зла, як завжди.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: Давно їх не чистила. Може, вже пробки утворилися.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: Я вже напівглуха через дитячю верескотню.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: Та у мене вже тиждень кров іде, коли зуби чищу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: А зуби все одно жовті. З такими дітьми як не закурити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: У мене від побутової хімії вже щось висипало. Не встигла до лікаря сходити.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: Я вам цими руками суп зварю, якщо доживу! А ви своїми одразу рушницю хапаєте…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: Та хоч гранату дістаньте. Виспатись мені це не допоможе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: Ви що, через запах вирішили мене пристрелити? Сміхота.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: Що, невже настільки погано вийшла?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: Ви точно хворий, якщо через вуха стріляти зібрались. Чим вони не сподобалися? Можу їх хусткою прикрити!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: Нарешті ніхто мені не допікатиме…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: Сумно…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: Знаєте, у одного з моїх дітей зуби ідеальні. А він ніколи не посміхається. Може, справа взагалі не в зубах?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: Руки… Я ними дітей обіймала, все робила по дому і чоловіка пестила. І знаєте що? Все одно ніхто мене не цінує.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: Коли дитина хворіє, ти цілу добу не спиш. А потім звикаєш. І просто живеш у цьому кошмарі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: Одного разу так замоталась, що тиждень не милася. Діти навіть не помітили.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: Знаєте, одного разу я знайшла світлину, де всі діти посміхаються. Дивилася на неї всю ніч, доки не заснула.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: Іноді хочеться нічого не чути. Зовсім. Але коли діти засинають, настає така тиша… Заради цього й живеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: Ти серйозно? Блять… Ну давай, тільки швидше!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: Та посрати. Дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: Жовті? Та хуй з ними.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: Білі? А якими їм ще бути? Це ж звичайна гігієна!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: Я колись думав, якщо зуби все одно зіпсуються, то нехай хоч один буде золотим. Ну знаєш, як в кіно у крутих мужиків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: Та як хочеш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: Бачиш, які лаписька!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: Ха. Бабуся в дитинстві казала, що з такими руками мені дрова колоти, а не… займатися тим, чим я займався…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: Але дров я тут не бачу, а злість кудись виплеснути треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: Хочеш — розглядай, мені начхати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: Що, гарний колір? Сині. Завжди такі були. Мені, крім них, нічого й не треба було, щоб дівчат клеїти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: Взагалі похуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: Так, голю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: Мене бісить, коли залишають під пахвами волосінь, ніби срані кущі там вирощують.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: Валяй.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: Що? Ти що на мене витріщився? Що ти там побачив?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: Блять…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: Чого ти витріщився? Чогось не вистачає?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: Ти що, їбанувся? Я тобі просто зуби показав.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: Ти, сука, що, вважаєш, я з такими лапами не зможу тобі їбальник натовкти швидше, ніж ти вистрілиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: Ти на що, блять, натякаєш? Заздриш чи що?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: Воно свербить постійно, ніби навмисно провокує.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: Коли розчісую до крові — свербіж затихає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: Повірити не можу. Та ти просто сказився!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: Ти, падло, хочеш мене застрелити через срану фотку?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: Ти обережніше своєю бум-бумкою маши.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: Ще через вуха мене випадково застрелиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: Та ти, блять, хворий на всю голову. Ану йди сюди, падло!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: Який же ти мудак бездушний.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: Срав я на тебе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: У моєї бабусі був золотий зуб. Скільки себе пам''ятаю, мені завжди хотілося такий самий.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: Він блищав так, ніби в роті сонце застрягло.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: Бабуся казала, що його поставили, коли старий згнив.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: Я тоді навіть радів, думав: «Оце круто, мені теж такий зроблять, коли час прийде».'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: А потім… Ну, час прийшов. Тільки ніхто мені нічого не поставив.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: І ось тепер у мене не сонце в роті, а просто обісцяні жовті зуби.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: Бачиш руки? Бруд, кров — все що хочеш. Але це не чуже. Своє.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: Руки іноді сверблять так, що хочеться роздерти всю шкіру. Або уїбати в стіну. Або і те, й інше одразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: Стриматись у мене не виходить. А інших бити не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: Бачиш нігті? Бруд, кров — все що хочеш. Але це не чуже. Своє.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: Руки іноді сверблять так, що хочеться роздерти всю шкіру. Або уїбати в стіну. Або і те, й інше одразу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: Напевно, якби я був іншою людиною, мені б стало страшно від того, що я з собою роблю. Але мені посрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: Мене бабуся називала «янголятком» через колір очей. Ага, янгол, блять.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: І ось тепер я стою, дивлюся в ці дзеркала душі і думаю: ну який з мене, до сраки, янгол?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: Я так і бачу, як вона на мене дивиться. І розчаровується.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: Знаєш, бритви досить гострі, щоб… щось зробити. Якби це було так просто…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: Все, що в мене вийшло — руку собі подряпати. Тепер, коли голюся, здається, ніби лезо ріже не волосся, а мене самого.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: Але голюся все одно. Бо ненавиджу, блять, ці кущі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: У мене навіть фото бабусі не збереглося. Вона не любила цю хрінь.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: Говорила, якщо сфоткають — душу у фотокартці запечатають, і вона вже не вибереться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: Я тоді реготав, казав їй: «Ну бабусь, ну дурниці це».'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: А вона мені: «Ось як помру, подивишся на мою фотокартку і будеш гадати, чи я на небесах».'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: Ну і ось, блять. Нема ні фотки, ні бабки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: Буває, помічаю, що смикаю мочку вуха, але тільки коли вона вже горить як скажена.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: Раніше думав, що ця срань через нерви.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: А потім зрозумів, що я просто хочу відірвати від себе шматок, ніби він мені заважає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: Але ж я не довбанутий, щоб себе різати, правда?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: Правда чи ні???'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: Ох, рідненький, я знала, що твоя енергія чинитиме опір. Що ж, перевіряй — я все одно бачу тебе наскрізь.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: Гаразд, дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: Наш космос відображається в очах, а не в зубах. Хочеш у моїх зубах побачити свою долю?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: Наш космос відображається в очах, а не в зубах. Навіщо їх так роздивлятись?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: Ну, будь ласка, дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: Тільки обережно — скабки від ловця снів ще не витягла.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: Йой, очі мої? Карі, звісно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: Ну, ще є окремі червоні цятки — це Місяць винен.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: Ох… що тільки Всесвіт не залишає на моєму шляху… Гаразд, дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: У тутешніх умовах, знаєш, складно себе доглядати…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: Будь обережнішим. Моя аура може й засліпити!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: Ну як?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: Ну, дивись, тільки обережно — вони все чують, навіть твої думки.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: Ну що? Знайшов відповіді?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: Ти що, через зуби у мене стріляти хочеш? Ти ж розумієш, що я тут ні до чого? Це Марс образився на Венеру.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: Ти що, серйозно? За те, що руки зі скабками, стріляти будеш? Вони в мене через роботу з ловцями снів!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: Ти що? Це ж просто Місяць пустує, розумієш, так? За його рухами не так просто встежити!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: Ти що? Це ж просто Місяць пустує, розумієш, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: Це вже не астрологія, а якесь безглуздя! Давай ти прибереш рушницю, а я ще тобі розповім своїх таємниць. Безкоштовно!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: Гей! Я ж не винна, що ти до такого не готовий, голубоньку!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: Може, опустиш цю штуку? Ну що ти з вух зрозумієш? Вони потрібні, щоб слухати мудрих людей!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: Вб''єш мене — будеш приречений на…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: Вічний пронос!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: Знаєш, одного разу до мене прийшла людина з ідеальними зубами.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: Я їй сказала: «Все добре, але ж душа твоя прогнила!» От і думай після цього, що важливіше. Розумієш, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: Якось після обряду я всю ніч витягала скабки. Боляче було, але знаєш що? Кожна скабка — це як урок від Всесвіту. Розумієш, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: Очі — це ворота до іншого світу. Якось у одного чоловіка вони світились, як ліхтарі. Він сказав, що це від кохання, але я думаю, що від Марса.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: Ти знаєш, одного разу я три тижні жила аскетично та думала лише про свою мрію.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: Думки матеріальні, і так я наближаюся до здійснення свого бажання. Потрібно лише правильно його загадати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: Напевно, мій нинішній стан може зрівнятися з тамтешнім.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: Знаєш, колись мені зробили таку світлину, що я подумала: це знак від зірок! А потім зрозуміла: просто світло неправильно впало.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: Одного разу я почула у вухах шум, ніби Всесвіт мені щось сказав. Але я думаю, це було щось набагато сильніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: Одного разу я почула у вухах шум, ніби Всесвіт мені щось сказав. Виявилося, це просто протяг. Але знаєш, мені все одно сподобалося.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: Що ти хочеш перевірити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: Мої зуби тобі показати?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: ЦІ ЗУБИ СТОЯЛИ ЗА ПРАВДУ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: …Та полягли за неї. Мученики.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: Та ти дивись сам, що це я тут…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: Я чищу зуби пивним розчином, він корисний для емалі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: А без цього давно б вже їх втратив.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: Звісно, тебе можна зрозуміти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: Стільки всього на нас звалилося, але ми живемо.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: Живемо далі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: Ти що, в тіні пересидів?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: Приляж-но та відпочинь, друже.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: Як забажаєш, мій друже!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: Дивися мої нігті, скільки тобі влізе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: Я натренувався вбирати ними корисне сонячне світло.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: І відчиняю пляшки з пивом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: То ти лише перевірити хотів?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: ЗАГЛЯНЬ МЕНІ В ОЧІ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: Вони сповнені люті та злості.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: ЗАГЛЯНЬ В МОЇ ТЕМНІ ОЧІ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: Я вбираю ними всі блага праведних променів, перетворюючи їх в енергію.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: Всі мої сили я отримую з ОЧЕЙ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: ТИ ПОБАЧИВ В МОЇХ ОЧАХ ПРАВЕДНУ СИЛУ СОНЦЯ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: Якщо ні, ти просто сліпий. Спробуй довше подивитися на Сонце, ЯК Я.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: Сфоткатись?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: Хм-хм-хм-хм.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: Тобі хтось розповідав, що я вітався з самим СОНЯЧНИМ ЛІДЕРОМ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: Так, я вчив його дивитись на сонце, але якось потім вже розповім.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: Ну ж бо, ФОТКАЙ МЕНЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: (Ви фотографуєте неохайного чоловіка)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: (Як і в житті, на фотографії він недоглянутий та брудний)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: (Ви не помічаєте нічого спотвореного)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: СЛАВА ТОБІ! ЯК ПРЕКРАСНО ВСЕ ВИЙШЛО!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: Заходь ще до мене, розповідатиму своє життя-буття.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: А ти мені за це даси трохи грошей.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: ЯКІ Я ВИТРАЧУ НА ЗБІР ЕНЕРГІЇ СОНЦЯ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: А ти спробуй стрільнути! Правда захистить мене!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: Ти рушничку прибереш чи ні?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: Ох тяжко-о-о-о без пива в руках.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: Тяжко-о-о-о-о.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: Гей, людино, от навіщо це потрібно?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: ЧИ ТИ ЗНАВІСНІВ, ДУРБИЛО?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: За очі вже не лише обговорюють, а й стріляють…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: Так, ну ось це вже явно зайве!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: Нічого тут тицяти цією штукою.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: Стій. Тобі мої руки не подобаються?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: ЧОМУ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: Оце нечемний скупендра. А мені пива хочеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: Кажуть, в очах правди немає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: То й що? Стрілятися тепер?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: А, ні, почекай…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: Чи якось не так кажуть?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: Зараз, зажди…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: А, посрати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: Оце правильно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: Ти ж не застрелиш Сонце!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: А про мене не турбуйся, я на дурість не ображаюся.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: У тебе щедрий запас цілющої холодної рідини!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: Що, любиш витівки?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: Ну а що, понюхай, якщо хочеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: Ось результат догляду за собою.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: Що, любиш витівки?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: Ну а що, ну понюхай, якщо хочеться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: Ось результат цілющих променів Сонця!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: Через них ми виділяємо життєво необхідну вологу!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: Що ви хочете перевірити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: Хах, це що ж, ви по зубах будете вирішувати? Ох-ооох.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: Я нещодавно виправляла зуби.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: Хоча, якщо чесно…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: Я не можу згадати, коли була у стоматолога. Чи взагалі не була?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: Господи, від страху не можу згадати навіть, що вчора їла.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: То що ж… Я підходжу під опис?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: Виходить, я Гість? Як? ЯЯЯЯЯК? Не треба!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: Ой-ой-ой, з дому вигнали, з роботи звільнили, тепер ще й мізки виб''ють…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: Показати нігті? Це якась дивна ознака…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: Що ж, давайте подивимось.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: Що це на них? Невже земля?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: Я-я-я навіть не пам''ятаю, щоб колупалася в землі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: Як у мене з''явився цей бруд?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: Я ж не могла не митися всі ці кілька днів. Так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: Як… дивно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: Уявляєте, я не можу згадати, звідки цей бруд. Я ж тільки тут у вас і сиджу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: Мене… Мене обмазали? Кому це взагалі треба?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: Хочете перевірити очі?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: Я здогадуюсь, який буде результат.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: А що буде, якщо я підійду за ознакою?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: Ну ще б пак. Чи могло бути інакше?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: Я правда Гість? Як гадаєте?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: А чому я не знаю про це? Може, так ними і стають?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: Може, досить подумати, що ти не такий, як усі… Що тебе ненавидять.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: Страшно вмирати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: Почекайте, можна мені пов''язку якусь?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: Або ще хоча б трохи…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: Якщо виявиться, що я Гість, я почну вбивати людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: Я стану небезпечною? Чи завжди такою була?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: Може, я справді вбиваю людей?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: (Ви фотографуєте її)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: (Коли фотографія проявляється, ви бачите розмите тіло та чітке тло)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: (Ніби в момент фотографії людина різко сіпнулась)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: Хахаха, уявляєш? Я чогось смикнулася.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: Що тепер буде?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: Мені можна жити? Чи краще вбити? Що ви зробите?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: Чому?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: Може, мене простіше вже пристрелити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: Я б пішла, але надто страшно.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: Може…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: Не знаю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: А якщо ви вистрілите, і я взагалі стану чимось ще жахливішим?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: Може, мені втекти?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: Навіть не знаю. А що як я все ж таки людина?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: Що мені робити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: Прямо як ті Гості вдома…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: Вибачте, просто моторошна історія. Зараз покажу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: Я людина? Так? Скажіть, що людина, будь ласка!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: Навіщо ж просили показати, якщо все одно хапаєте рушницю?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: Навіщо принижувати інших?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: А взагалі це кошмар. Ніде не можна почуватись у безпеці.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: Гості можуть увірватися в будинок. Безумець може вбити, бо подумає, що ти якась не така.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: ЯК СТРАШНО, ХОЧ БИ ХТО МІГ СКАЗАТИ, ЩО ВСЕ БУДЕ ДОБРЕ!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: І цього достатньо, щоб тебе назвали Гостем? Чому?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: Знову мені не пощастило з тілом…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: Я вся скарлючена. Мене боялися на роботі, я бачила.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: Так, минулого тижня я ходила до лікарні через спину… начебто.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: І в цей же час… я ходила до стоматолога?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: Скільки ж я витратила…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: Що ти хочеш перевірити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: Тобі показати мої зуби?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: Ну дивись. На них ще залишився присмак нещастя і диму.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: Жовтуваті, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: Ну ось і відчепись зі своїми перевірками.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: Я не Гість.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: Звідки ці ознаки взагалі беруться?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: Якщо під нігтями земля — це ознака?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: Вони можуть руки помити! І все!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: А якийсь садівник що, відразу ж стає Гостем?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: Маячня тупа.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: Ну дивись нігті.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: Ну що, я Гість?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: Ну ще б пак.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: З кожним днем ​​все більше безглуздя.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: А якщо я не виспався? Чи плакав?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: Я перестаю розуміти, як це взагалі працює.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: А що ти робитимеш, якщо одна ознака підтвердиться? Чи кілька?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: Тепер піду стану вночі Гостем.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: Поплачу, згадаю спокійні часи.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: Усі ці перевірки, типи у жовтих комбезах…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: Все це… якось…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: Якийсь капець.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: Нема в тебе відчуття, що все йде до якогось страшного пекла?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: Все нібито під контролем, але довкола повний хаос.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: Ну давай, фоткай.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: (Ви фотографуєте його)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: (Він сидить спокійно, цілком у кадр не вміщується, але нічого незвичайного ви не бачите)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: Мені просто страшно уявити, чого ще очікувати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: Що нахуй? Ти здурів?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: КНС всі мізки проїли тобі?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: Чи ти надрався? Я думав, все міцне вже випив.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: Ні, ну якщо ти просиш, я тобі покажу!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: Ну що, задоволений?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: Нанюхався досхочу?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: Дякую, що хочь у сраку мені не поліз!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: Тільки давай швидше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: Що?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: Ну… добре.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: Все?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: Я можу побути спокійно одна?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: Руки… зараз, почекай.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: Вони втомились нести того, кому відмовили у порятунку.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: Слухай, можеш не чіплятись до мене з цим дебілізмом?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: Якщо захочеш пристрелити — просто стріляй.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: У мене немає сил більше…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: Що ти хочеш перевірити? Почервоніння?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: Спробуй.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: Якщо я показую емоції, то я Гість?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: Чи можна нам зараз бути відвертими?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: Радіти не виходить, плакати не можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: Говорити не завжди можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: Залишається тільки сидіти та закривати обличчя руками.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: І все так легко закінчиться?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: Більше жодних страждань?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: Але я так і не зберегла тебе, мій…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: Тобі це не здається знущанням?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: Ніхто не допоміг мені врятувати чоловіка, а тепер…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: ТИ ХОЧЕШ УВІЧНИТИ ЙОГО СМЕРТЬ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: У мене немає слів.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: Роби що хочеш і не чіпай мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: (Ви робите фотографію жінки)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: (Нічого незвичайного ви не бачите)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: (Небіжчик опинився у кадрі, це змушує вас задуматись)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: Іди вже.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: Йому подобалися мої зуби.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: Хоча мені хотілося поставити брекети.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: Дійсно, чому б ще й мене не застрелити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: Чи можна людині у цьому новому світі плакати? Сміятися вже точно не можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: Ти йобнувся?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: Ні, скажи, ТИ ЇБАНУТИЙ?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: А якщо ці чорти скажуть на сковороді танцювати, ти перший побіжиш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: Ти… блять… нема слів.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: То що? Рушницю ще дістань.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: Здуріти можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: Ну, натисни на курок. КНС вбили в мені душу, ти добий тіло.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: Більше я не думаю про брекети.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: Доки ти не попросив показати зуби, я навіть не згадувала про ці минулі примхи.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: Ні, вибач, я просто дуже втомилася.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: Зриваюся на всіх навколо. Але…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: Ніхто не винен. Окрім певних виродків.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: Не можу тебе зрозуміти. І не хочу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: Принизити людину, яка тільки нещодавно втратила…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: Секунду…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: Уууф. Потім наставив рушницю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: Але чомусь все одно не вбив.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: Що це було? Твоя невпевненість? Не треба проявляти її так.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: Що ти хочеш перевірити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: Хоба, зуби — це я можу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: У мене кореш був дантистом.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: Так йому, прикинь, якось вибили всі зуби нахуй ХАХАХА!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: А, показати треба. Зараз.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: Норм, га?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: Та ти що? Історія як історія.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: А через зуби мене гандошити якось… не по-пацанськи це.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: Може, не треба?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: Ти очманів?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: Смокчи мого х…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: Та ти що, я нормальний.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: Нічого такого з нігтями не роблю, глянь.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: Ні, ти не подумай.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: Я миюся, просто монетку побачив на дорозі, підняв.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: А так вони чисті. Сьогодні помию руки, що ти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: Я миюся, просто якось часу не було сьогодні руки сполоснути.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: Взагалі наче норм.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: Ти ж не вб''єш людину просто за брудні нігті?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: Та годі. Не думав, що так тупо помру.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: Мені здається, якось дивно по руках визначати цих монстрів.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: По руках можна побачити довбойобів і терпил. Гості тут до чого?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: Це ж треба вставати о дев''ятій ранку і працювати хоча б по 4 години. До біса це.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: У мене очі останнім часом сверблять.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: Як гадаєш, це від сонця? Чи чому?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: Та блять.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: Це болячка якась.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: Слухай, я вигадав схемку.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: Давай з інших гроші брати, щоб не стріляти їм в обличчя?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: Що? Треба подумати?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: Гаразд, якщо тобі темка не зайшла — розумію. Але в мене реально болячка на оці.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: Якби в тебе краплі були…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: Хоча я б все одно не купив. Ну, з власних причин.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: Сфоткатись зі мною хочеш? Ну, погнали.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: Хоча я чутливий дуже до світла. Можу смикнутись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: (Ви фотографуєте його)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: (Фотографія начебто нормальна, але обличчя…)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: (Воно вийшло дуже розмазаним)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: Ось про це я й казав.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: Перефоткаєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: Ти мене не розводь, ти цих лохів прогрівай.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: Нехай у тонусі тримаються.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: А то розслабляться, забудуть, кому мають бути вдячні, та не заплатять.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: Почекай!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: Нахуй тебе і твій дім, я пішов.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: Прямо під сонце піду. Залишаю це на твоїй совісті.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: Та срати твоїй матері…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: Щось ти не тою темою зайнявся.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: Але ти бос, тобі відніше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: Так що скажеш? Норм?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: Облишити його
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: Та стій ти! Ну одного разу, бля, спробував поголитись, вирішив і далі так робити.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: Тільки не кажи нікому. Ти ж не трепло, так?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: Та стій ти! Ти б ще труси попросив зняти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: Ну ти ж знаєш, у нормального пацана не можуть бути палені пахви.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: Я знав, що ти путящий. Не станеш серйозно на нормальних наїжджати, хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: Давай краще чмошників напружимо?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: Ні? Ну гаразд. Потім.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: Я розумію, звичайно, напрягають всякі там Гості та інша хрінь.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: Та й заради нас все ж таки це робиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: Тобто, я до тебе зла не маю. Від душі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: Що ви хочете перевірити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: Зуби? Показати вам зуби?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: Навіщо? У мене ще молочні зубки. Тато казав…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: Я не плакатиму більше.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: Ось які у мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: Це що означає?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: Все добре?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: А я вже вмію сама стригти нігті.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: Поки що не дуже виходить у мене…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: Дивіться.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: Ось які нігтики.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: Це я сама постригла. Змогла. Сама.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: Я піду, хочу посидіти одна.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: А ви можете зазирнути в очі?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: Ви побачите там все, про що я думаю?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: Я тоді обережно думатиму, не хвилюйтесь.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: Ви чого так дивитесь?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: Ви там по-побачили…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: Ви… уааааа…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: Я-я-я пи-ити хочу-уууу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: То що мені треба зробити?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: (Ви дивитеся на неї і розумієте, що це вже занадто)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: Просто хочете дізнатись, як у мене справи?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: Я дуже втомилася, можна постою тут одна?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: Фото?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: А мене мало фотографували.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: Покажете мені потім?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: (Ви фотографуєте дівчинку)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: (Фотографія вийшла трохи розмитою)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: (Дівчинка, не дочекавшись кінця зйомки, підбігла до вас)'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: Мммм.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: Дякую.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: Мені не подобається. Більше не просіть мене про фото.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NoTrue: Хех. Ну давай, переконайся, голубе. Все одно нічого нового для себе не побачиш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: Зуби?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NoTrue: А-а-а.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: Взагалі, зуби ці… Ох, вони мені свого часу так набридли. Думала все вирвати до чортів собачих.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: Бачиш? Цими пальцями не порахувати, не відкласти, не відміряти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: Саме стільки, скільки треба. Саме стільки, скільки бракує.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: Ой, голубе… а ти впевнений, що хочеш цього?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: Очі — це як вікна. У будинках — для світла, а у людей — для правди.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: Але у мене вони запилені… скло тріснуте… штори давно міль поточила.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: Не заглядай, голубе. Там пусто.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: Ой, змушуєш стару піднімати руки. І не соромно тобі? Я ж ледве на ногах тримаюсь!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: Що ж з тобою поробиш… Ти тут господар.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: То що?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: Що-що? Та нащо на мене плівку марнувати. Вона ж точно дефіцитна… Наполягаєш? Що ж, мені приємно!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: То що скажеш тепер, голубе?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NoTrue: Хах, голубе, оце ти вигадав.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: Звичайнісінькі. Як чула, так і чую. Хоча, знаєш… Іноді здається, що мене наче й нема.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: Наче мене просвічувати треба, щоб побачити. Та й тоді, може, не вийде.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: Ой, та що ти мені цим тицяєш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: Ніби немає нічого гіршого, ніж беззуба стара баба.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: Ти думаєш, мені страшно? Думаєш, я за них тримаюся?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: Я стільки разів хапалася за повітря, що пальці вже самі знають — нічого не втримаєш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: Он воно як…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: Ти не віриш? Перевірити хочеш? Ну дивись, дивись…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: Адже я теж колись дивилася. А тепер лише згадую, як це було.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: Та це ж, голубе, як відбиток старості — всі, хто свій вік доживає, отримують ось такий подаруночок. А ти не знав?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: Грибок — він не болить, жерти не просить, просто є собі та є. Живе та живе. Зовсім як я, хе-хе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: Що, з цього теж клацати будеш?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: Чого це ти, голубе? Що ж по вухах можна зрозуміти?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: От воно що. Та я ж навіть не проти. Мені що, голубе? Я вже давно хочу до Господа.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: Ось тільки…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: Платила лікарю тому, щоб всі вирвав, та виявилось, що відразу не можна.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: Ходила до нього, виривала по одному-два за раз… та до кінця так і не дійшла. Лікарям зараз не до того.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: Так і живу, голубе, з цією недоробленою справою в роті.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: Руки для тих, хто тримає. Я вже давно перестала цим займатися.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: Простягати руку? Навіщо? Ти ж сам тягнешся.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: «До брехні шестипалої в дім…» До мене, голубе. Ну, заходь.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: Ваажаєш, ти уникнеш цієї долі? Ну, хіба що молодим загинеш. Але ти краще бережи себе!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: А то он який красень! Гріх було б такого занапастити!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: У мій час всі ці апарати були тільки у багатих. А зараз, он, у всяких рукатих є!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: Нема чого тобі сказати. Дурнею якоюсь займаєшся. Людей добрих дарма турбуєш…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: Ти тільки не муч сестру.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: Наша родина завжди мала міцні зуби.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: Я, коли була підлітком, намагалася відкрити пиво зубами.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: Закінчилося невдало. Але це навчило мене за ними доглядати.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: Моя сестра не в змозі зараз піклуватись про себе. Тому я єдина, хто щось робить руками.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: А як ще мають виглядати руки, якщо на мені відповідальність за два життя одразу?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: Так, сестра часто плаче, але очі у нас досі дуже схожі. Тільки погляд у неї спокійніший.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: І мене це турбує.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: Так, сестра часто плаче, але очі у нас досі дуже схожі. Не червоні, я маю на увазі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: Може, вже відплакала своє.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: Я покажу. Але, прошу, не чіпляйся до сестри, добре? Вона й так надто втомилася.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: Взагалі я там голю, намагаюся доглядати себе.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: Навіть у такий божевільний час.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: Зазвичай я за собою стежу, але зараз не взяла з собою бритву.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: Та й загалом не до цього.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: Ми з сестрою і без того натерпілися. Будь ласка, не треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: Я нещодавно почала курити. Через таких, як ти.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: Думаєш, тобі одному важко?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: Думаєш, можеш тицяти рушницею будь-кому в обличчя?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: У чому річ? Тобі погляд здався надто швидким чи порожнім?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: У чому річ? Тобі погляд здався надто порожнім?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: Думаєш, ти виглядаєш інакше?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: Краще заспокойся та не приймай емоційних рішень. Я часто так говорю сестрі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: Жаль, що тобі теж треба.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: Почекай, хіба у новинах казали, що ТАКІ пахви — ознака Гостя?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: Подумай ще, не роби дурниць.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: Ось чим закінчилася пісня життя.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: Гіркотою…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: Життя завжди перевіряло нас на міцність. Завжди було дуже тяжко.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: Сестра не витримала, здалася.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: Я все розумію. Ти опинився у дуже непростій ситуації.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: Але якщо піддаватися паніці, чим ти відрізнятимешся від Гостей?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: Що буде, якщо ти так і залишишся відокремленим від решти?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: Знаєш, мене все задовбало.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: Я так хочу, щоб можна було вже видихнути і не жити у постійному страху.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: Але це все триває і кінчатись найближчим часом наче й не думає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: Якщо чесно, я й сама страшенно налякана.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: Що далі? Гості зникнуть, чи ми тепер завжди будемо з ними ділити наші міста?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: Давай вже.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: Зуби
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: Руки
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: Очі
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: Пахви
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: Фото
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: Вуха
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: Дивись.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: Виб''єш їх мені?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: Сестра мені допомагає.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: Але це безглуздо.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: Краще б…'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: Дала мені померти ще тоді.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: Тут ми з сестрою схожі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: Але у неї немає порожнечі в очах.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: Сестра мені голить пахви. Доглядає мене.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: Схоже, не дарма це робила.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: Облишити її
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: Дістати рушницю
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: Так навіть краще.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: Вибий з мене дух.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: Не треба цього.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: Смерть все одно вже поряд.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: Краще дозволь мені.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: Дай рушницю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: Я сама все зроблю.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: Коли я заплющу очі, порожнеча не зникне.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: Вона просто передасться тобі.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: Тобі цього хочеться?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: То що?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: Натиснеш заповітну кнопку?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: Вистрілити
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: Вислухати
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: Не вистачило духу?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: …'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: Все одно помреш.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: Шкода.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: Може, наступного разу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: Шкода.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: Не підійшла за ознаками.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: Може, наступного разу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: А що як ми просто готуємось до чорної діри, яка поглине нас?'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: Нас дуже довго затягуватиме до обрію подій.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: І ми ніколи не побачимо своєї кончини.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: Вічна агонія та передчуття смерті.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: Не має значення.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: Значить, дочекаюся свого часу.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: Моя пісня.'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: Але вона призначалася тобі!'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: Яка вона прекрасна!'
    m_Metadata:
      m_Items: []
  - m_Id: 23214752326733824
    m_Localized: 'Firefighter: …'
    m_Metadata:
      m_Items: []
