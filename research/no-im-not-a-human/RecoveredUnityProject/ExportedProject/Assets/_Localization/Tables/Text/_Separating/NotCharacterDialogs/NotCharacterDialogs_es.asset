%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NotCharacterDialogs_es
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: e5ff4525f54b4b14096a51f9eb9cf8ce, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21953783779328
    m_Localized: 'TV: ¡Alerta de última hora!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556544
    m_Localized: 'TV: Hoy, a las 6:28 de la mañana, se registró una intensa emisión de energía proveniente del sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556545
    m_Localized: 'TV: Esta ráfaga fue mucho mayor de lo que los científicos habían predicho.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556546
    m_Localized: 'TV: La temperatura exterior ha alcanzado niveles críticos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556547
    m_Localized: 'TV: Debido a esto, el gobierno ha declarado estado de emergencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556548
    m_Localized: 'TV: Pedimos a toda la población que se abstenga de salir de sus casas durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556549
    m_Localized: 'TV: Y ahora, pasamos a—'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556550
    m_Localized: 'TV: Un momento...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556551
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556552
    m_Localized: 'TV: Acabamos de recibir una transmisión urgente relacionada al  fenómeno de las criaturas que hemos denominado "Visitantes".'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556553
    m_Localized: 'TV: Los testigos los han descrito como criaturas capaces de imitar la apariencia física y el comportamiento de los humanos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556554
    m_Localized: 'TV: Por favor, evitad cualquier tipo de contacto con estas criaturas. Recientemente, se descubrió un rasgo para identificar a estos Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556555
    m_Localized: 'TV: Dientes blancos perfectos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556556
    m_Localized: 'TV: Esto se puede corroborar gracias a reportes anteriores.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556557
    m_Localized: 'TV: Nuestras fuentes afirman que, tras encontrarse con un indigente con dientes blancos y perfectos, el sujeto resultó ser un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556558
    m_Localized: 'TV: Eso es todo por ahora. Mantened la calma y no salgáis de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556559
    m_Localized: 'TV: A continuación: un programa de entretenimiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556560
    m_Localized: 'TV: Buenas tardes. Aquí tenéis el pronóstico del tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556561
    m_Localized: 'TV: Se acerca un frente cálido a nuestra región. Subirán mucho las temperaturas, superando el récord anterior.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556562
    m_Localized: 'TV: Los meteorólogos nos dicen que podemos esperar temperaturas aún más altas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556563
    m_Localized: 'TV: Con la creciente actividad solar, también podemos esperar rayos UV más fuertes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556564
    m_Localized: 'TV: Por vuestra seguridad, por favor, evitad tomar el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556565
    m_Localized: 'TV: Las altas temperaturas podrían causar insolación.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556566
    m_Localized: 'TV: No se sabe con certeza si estar al sol puede afectar negativamente a nuestra salud...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556567
    m_Localized: 'TV: Pero para prevenir quemaduras de tercer grado, no salgáis fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556568
    m_Localized: 'TV: Desafortunadamente, la crema solar no podrá protegeros en estas circunstancias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556569
    m_Localized: 'TV: De momento, eso es todo. A continuación, Bailando con los Cisnes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556570
    m_Localized: 'TV: Ves bailarinas danzando con gracia. Cruzan el escenario con saltos enérgicos, pero delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556571
    m_Localized: 'TV: A pesar de la elegancia del baile, te sientes ansioso con tus pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556572
    m_Localized: 'TV: Sientes como si intentaran distraerte de los acontecimientos actuales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556573
    m_Localized: 'TV: Ojalá alguien pudiera explicarte lo qué está ocurriendo con el sol...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556574
    m_Localized: 'TV: Buenas tardes. Aquí tenéis las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556575
    m_Localized: 'TV: La actividad solar se está elevando y al igual que el nivel del crimen.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556576
    m_Localized: 'TV: Según los últimos datos, el número de asesinatos durante las últimas noches ha superado las cifras habituales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556577
    m_Localized: 'TV: Expertos sospechan que esto se relaciona con la ansiedad provocada por el temor a los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556578
    m_Localized: 'TV: Por suerte, también hemos recibido nuevas indicaciones sobre como identificar a estos doppelgangers...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556579
    m_Localized: 'TV: Tierra debajo de las uñas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556580
    m_Localized: 'TV: Dicen los expertos que esta señal ayuda a identificar a Visitantes que han salido arrastrándose de debajo de la tierra.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556581
    m_Localized: 'TV: Eso es todo por ahora. Mantened la calma y no salgáis de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556582
    m_Localized: 'TV: A continuación, un reportaje sobre un maníaco pálido. Pero antes, una pausa publicitaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556583
    m_Localized: 'TV: Antes, hacer las compras significaba echarse una caminata hasta la tienda.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556584
    m_Localized: 'TV: Pero con For Rest, puedes comprar lo que quieras con solo tomar el teléfono y hacer un pedido.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556585
    m_Localized: 'TV: Llama al XXX-XXX-XXXX y tus compras llegarán a tu puerta en un día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556586
    m_Localized: 'TV: For Rest: Para que disfrutes y te relajes en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556587
    m_Localized: 'TV: Reportes señalan que un maníaco pálido ha aparecido en las calles de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556588
    m_Localized: 'TV: Gracias a varios testimonios la policía ha determinado que todas las víctimas tenían algo en común: estaban solas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556589
    m_Localized: 'TV: Además, el maníaco habla con la víctima antes asesinarlas violentamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556590
    m_Localized: 'TV: La policía ha hecho un boceto del asesino a partir de diversos testimonios.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556591
    m_Localized: 'TV: El sospechoso es un hombre de mediana edad muy pálido con pelo negro. Es de complexión delgada y solo viste pantalones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556592
    m_Localized: 'TV: Otros reportes han añadido que lleva la piel de otra persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556593
    m_Localized: 'TV: Esta información no ha sido confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556594
    m_Localized: 'TV: Si ven a este hombre, no abráis la puerta y díganle que no estáis solos en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556595
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556596
    m_Localized: 'TV: Buenas tardes. Aquí tenéis las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953800556597
    m_Localized: 'TV: El calor anómalo sigue aumentando y la invasión de los Visitantes no ha dado señales de disminuir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750848
    m_Localized: 'TV: Debido a esto el gobierno ha puesto en marcha un servicio especial para abordar la situación emergente.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750849
    m_Localized: 'TV: La Agencia Federal de Administración de Emergencias, abreviada como AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750850
    m_Localized: 'TV: Los empleados de la AFAE pueden identificarse por sus trajes amarillos de materiales peligrosos y máscaras de gas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750851
    m_Localized: 'TV: Aunque comenzaron su trabajo recientemente, la agencia ya descubrió una nueva señal que delata a los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750852
    m_Localized: 'TV: Ojos rojo sangre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750853
    m_Localized: 'TV: De acuerdo a nuestros datos, la AFAE informó de esta señal tras observar a los Visitantes detenidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750854
    m_Localized: 'TV: Las criaturas tienen un aumento de la fotosensibilidad, lo que provoca inflamación y enrojecimiento en sus ojos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750855
    m_Localized: 'TV: Eso es todo por ahora. Mantened la calma y no salgáis de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750856
    m_Localized: 'TV: A continuación, un reportaje sobre la AFAE. Pero antes, una breve pausa publicitaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750857
    m_Localized: 'TV: Caos, terror y sufrimiento. Y todo por culpa de los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750858
    m_Localized: 'TV: Pero en la hora más oscura, cuando nuestras lágrimas comenzaban a fluir como un río...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750859
    m_Localized: 'TV: ¡LOS EMPLEADOS DE LA AFAE HAN VENIDO EN NUESTRA AYUDA!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750860
    m_Localized: 'TV: Estos valientes héroes de la AFAE nos protegen de la invasión de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750861
    m_Localized: 'TV: Hasta ahora, la agencia ha identificado 27.000 criaturas peligrosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750862
    m_Localized: 'TV: :Recuerda: Puedes ayudar a la agencia informando sobre cualquier actividad sospechosa a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750863
    m_Localized: 'TV: Para ello, pueden utilizar la invitación para visitar la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750864
    m_Localized: 'TV: Y si llega a sospechar que podría ser uno de esos Visitantes, llame a nuestra línea directa: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750865
    m_Localized: 'TV: Ayúdanos a ayudarte. Apoya a la AFAE y únete a la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750866
    m_Localized: 'TV: AFAE: ¿Qué es? ¿Y por qué se formó?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750867
    m_Localized: 'TV: La Agencia Federal de Administración de Emergencias es un servicio gubernamental especial creado para aliviar la crisis.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750868
    m_Localized: 'TV: Están ayudando a abordar los problemas causados por la invasión de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750869
    m_Localized: 'TV: No se sabe con certeza en qué está trabajando exactamente la agencia...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750870
    m_Localized: 'TV: Pero podemos afirmar con seguridad que nuestro destino está en manos fiables...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750871
    m_Localized: 'TV: La agencia está compuesta por expertos en varios campos, incluyendo a científicos distinguidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750872
    m_Localized: 'TV: Si un empleado de la AFAE aparece en tu puerta, te aconsejamos que cooperes con él y sigas sus instrucciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750873
    m_Localized: 'TV: Recuerda: Ayúdanos a ayudarte. Apoya a la AFAE y únete a la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750874
    m_Localized: 'TV: Buenas tardes. Aquí tenéis las noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750875
    m_Localized: 'TV: La AFAE ha tomado nuevas medidas para abordar la situación con los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750876
    m_Localized: 'TV: Han organizado zonas de cuarentena para contener a potenciales sospechosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750877
    m_Localized: 'TV: Después de experimentar con los detenidos, la AFAE ha encontrado una nueva forma de identificar Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750878
    m_Localized: 'TV: Axilas sin vello.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750879
    m_Localized: 'TV: La AFAE ha reportado que los Visitantes no tienen vello visible en las axilas, característica útil para identificarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750880
    m_Localized: 'TV: La agencia pide a los ciudadanos que tengan paciencia con las pruebas y los traslados a las zonas de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750881
    m_Localized: 'TV: Eso es todo por ahora. Mantened la calma y no salgáis de casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750882
    m_Localized: 'TV: A continuación, un informe sobre qué hacer si te encuentras con un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750883
    m_Localized: 'TV: Según la AFAE, el fenómeno Visitante podría ser contagioso o suponer alguna otra amenaza biológica.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750884
    m_Localized: 'TV: Por esta razón, es importante reportar a cualquier persona sospechosa y aislarla de inmediato.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750885
    m_Localized: 'TV: Si no puedes enviar a un Visitante a una zona de cuarentena de inmediato, dales una petición para presentarse en la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750886
    m_Localized: 'TV: Durante la siguiente ronda, un empleado llevará a cualquiera que tenga este documento para ser examinado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750887
    m_Localized: 'TV: Eso es todo por ahora. A continuación, una pausa publicitaria.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750888
    m_Localized: 'TV: ¡Que el calor no te detenga! ¡Siente el impulso!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750889
    m_Localized: 'TV: ¡Con EnerJeka, te sientes vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750890
    m_Localized: 'TV: ¡Sorprendente! ¿¡Una bebida energética vigorizante que sacia tu sed más rápido y con mayor eficacia que el agua!?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750891
    m_Localized: 'TV: Disponible en For Rest delivery ahora mismo. Pídela al: XXX-XXX-XXXX.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750892
    m_Localized: 'Window: La casa de tu vecino se alza sobre el campo de heno.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750893
    m_Localized: 'Window: No hay luz saliendo de las ventanas. Parece que su familia duerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750894
    m_Localized: 'Window: Un perro flaco está de pie en la senda que cruza el campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750895
    m_Localized: 'Window: Mira a su alrededor con tristeza, tal vez intentando encontrar algo de comida.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750896
    m_Localized: 'Window: Unos cuantos borrachos yacen tirados en la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750897
    m_Localized: 'Window: Pese a estar en el suelo helado, aparentan dormir profundamente. Las cosas parecen estar bien para ellos ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750898
    m_Localized: 'Window: A la distancia se ve la casa de tu vecino, quien te está visitando ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750899
    m_Localized: 'Window: Una luz intensa brilla por la ventana y parece que su familia espera que vuelva a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750900
    m_Localized: 'Window: Ves a unos cuantos adolescentes pasando el rato en el patio.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750901
    m_Localized: 'Window: Están sentados despreocupadamente, charlando sobre algo y no te prestan atención.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750902
    m_Localized: 'Window: Reina un silencio sepulcral fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750903
    m_Localized: 'Window: No hay absolutamente nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750904
    m_Localized: 'Window: Incluso los borrachos han decidido no salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750905
    m_Localized: 'Window: ¿A qué le tendrán todos tanto miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750906
    m_Localized: 'Window: Ves a tu vecino y a su hija a través de la ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750907
    m_Localized: 'Window: Están jugando alegremente, intentando olvidarse del horror que están viviendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750908
    m_Localized: 'Window: Aunque solo sea por un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750909
    m_Localized: 'Window: Los cadáveres de los adolescentes están tirados en el suelo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750910
    m_Localized: 'Window: Alguien los mató.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750911
    m_Localized: 'Window: Parece reciente. La sangre aún no se ha secado.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750912
    m_Localized: 'Window: Un hombre pálido como la misma muerte está parado afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750913
    m_Localized: 'Window: Tiene extraños pliegues en su piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750914
    m_Localized: 'Window: Parece como si su piel fuera una talla incorrecta para su cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750915
    m_Localized: 'Window: Desde aquí no distingues sus ojos, pero sientes su mirada clavada en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750916
    m_Localized: 'Window: El miedo te envuelve, así que le rezas a Dios para que el terrorífico Visitante no se detenga en tu puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750917
    m_Localized: 'Window: Hay un pequeño grupo de empleados de la AFAE junto a la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750918
    m_Localized: 'Window: Te preguntas de qué estarán hablando.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750919
    m_Localized: 'Window: ¿Quizás estén tomando muestras de tierra?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750920
    m_Localized: 'Window: ¿O buscando algún sitio donde establecer una base?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750921
    m_Localized: 'Window: En el suelo yacen los restos calcinados de los adolescentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750922
    m_Localized: 'Window: Da la impresión de que llevan todo el día ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750923
    m_Localized: 'Window: Hay dos empleados de la AFAE junto a los cuerpos, anotando algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750924
    m_Localized: 'Window: Menos mal que aparecieron para llevarse los cuerpos.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750925
    m_Localized: 'Window: Te da mal rollo pensar en la infección que podría surgir si esos cuerpos se quedan pudriéndose fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750926
    m_Localized: 'Window: Ves a un grupo de soldados armados a través de la ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750927
    m_Localized: 'Window: Aparentemente, es un pequeño escuadrón enviado desde la ciudad para proteger a los empleados de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750928
    m_Localized: 'Window: Escuchas algunos fragmentos de información sobre un hombre pálido con el torso desnudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750929
    m_Localized: 'Window: ¿Quizás quieren rastrear a ese Visitante espeluznante?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750930
    m_Localized: 'Window: La casa de tu vecino, recién pintada de blanco, se ha quemado por completo, ahora está más negra que el carbón.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750931
    m_Localized: 'Window: Da la impresión de que el fuego se extinguió hace muy poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750932
    m_Localized: 'Window: ¿Podría alguien haberle prendido fuego a propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750933
    m_Localized: 'Window: ¿Qué le habrá pasado a la familia del vecino?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750934
    m_Localized: 'Window: ¿Quedará alguien con vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750935
    m_Localized: 'Window: Las preocupaciones te dan vueltas en la cabeza y te invade una sensación de incomprensión e impotencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750936
    m_Localized: 'Window: El hombre pálido y espeluznante está parado en la calle, sonriendo.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750937
    m_Localized: 'Window: Está sosteniendo la cabeza decapitada de alguien dentro de un casco.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750938
    m_Localized: 'Window: Es la cabeza de un soldado que tiene el rostro congelado en una mueca de terror.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750939
    m_Localized: 'Window: No estás seguro de qué le asustó más: el Visitante pálido o su inminente muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750940
    m_Localized: 'Window: Todo el escuadrón de soldados que estuvo aquí ayer está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750941
    m_Localized: 'Window: Parece que aquí hubo una masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750942
    m_Localized: 'Window: Hay cuerpos esparcidos por toda la calle y a uno de ellos le falta la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750943
    m_Localized: 'Window: ¿Acaso ese extraño pálido y espeluznante los mató a todos?'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750944
    m_Localized: "\"Hola, habla la operadora de emergencias. ¿En qué puedo ayudarle?\"\n\"Las personas... se están quemando...\""
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750945
    m_Localized: "\"¿Podría describir lo que está viendo? ¿Hay un incendio?\"\n\"N-no. Es el sol. El... ¡El sol los está quemando!\""
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750946
    m_Localized: "\"No salga de casa hasta que oscurezca\".\n\"¡No! ¡Que hay un tío que anda merodeando por la noche! Es todo pálido y delgado... N-no es humano\"."
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750947
    m_Localized: Y ahora, nuestro nuevo programa, "Sí, Soy Humano".
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750948
    m_Localized: 'Es simple: Envíe sus fotos y nosotros comprobaremos qué es usted en realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750949
    m_Localized: 'Envíenos sus fotos a este correo: yesiamhuman@gmail.com, y nosotros nos encargaremos del resto.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750950
    m_Localized: Pero, por favor, absténgase de enviar cualquier otra cosa que no sean ojos, dientes y uñas. No aceptaremos otra cosa.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750951
    m_Localized: ¿Sus ojos se han puesto rojos? ¿Sus dientes blancos? ¿Ha aparecido tierra debajo de sus uñas?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750952
    m_Localized: ¡Un espíritu maligno le ha poseído! ¡Es usted un Visitante!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750953
    m_Localized: ¡No deje que esta plaga se apodere de su cuerpo! Llame a nuestros especialistas inmediatamente al 777-460.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750954
    m_Localized: Expulsarán el espíritu maligno, limpiarán su cuerpo de esa aura perniciosa y le proporcionarán una protección reforzada.
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750955
    m_Localized: 'Sean bienvenidos. Es hora de "Quiero Creer": un programa donde desvelaremos misterios y conspiraciones gubernamentales.'
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750956
    m_Localized: Hoy discutiremos la verdad sobre los Visitantes con un invitado especial, un doctor en ciencias y respetado empleado de...
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750957
    m_Localized: ¡¿Espera, qué?! ¿No va a venir?
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750958
    m_Localized: ¿Cómo coño han podido robarle todos los documentos? ¡Tenía UNA BARBARIDAD información ahí!
    m_Metadata:
      m_Items: []
  - m_Id: 21953804750959
    m_Localized: ¡Joder! Me lo veía venir; no nos iban a permitir revelar la verdad. Hijos de puta...
    m_Metadata:
      m_Items: []
  - m_Id: 17738415503822848
    m_Localized: Érase una vez, dos hermanos que vivían cerca de una presa.
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182976
    m_Localized: El chapoteo del agua hacía que la espuma del río se les pareciera a una gaseosa en un día de verano.
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182977
    m_Localized: Años después, con esa bella imagen en mente, los hermanos ya crecidos, abrieron la cervecería Bober Černý.
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182978
    m_Localized: 'TV: Desde entonces, Bober Černý se ha convertido en una de las bebidas alcohólicas más solicitadas en los bares y en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182979
    m_Localized: 'Cerveza Bober Černý: Bebe calidad y bebe sin límites.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182980
    m_Localized: 'Window: Miras las ruinas de la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182981
    m_Localized: 'Window: Solo queda un cascarón fantasmal, a pesar de que una familia feliz vivía allí hasta hace poco...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182982
    m_Localized: 'Window: Un sentimiento extraño te invade, como si hubieras sabido que esto iba a suceder...'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182983
    m_Localized: 'Window: ...Como si hubieras sentido que la muerte andaba rondando por esa casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182984
    m_Localized: 'Window: Ves un cráneo humano clavado en una estaca, con un casco aún puesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182985
    m_Localized: 'Window: La calavera tiene la piel quemada, y parece que alguien le arrancó los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182986
    m_Localized: 'Window: La cabeza lleva ahí todo el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182987
    m_Localized: 'Window: No puedes evitar creer que esta macabra exhibición es una amenaza, probablemente de parte de aquel Visitante pálido.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182988
    m_Localized: 'Window: Los oficiales de la AFAE están inspeccionando el lugar de la reciente masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182989
    m_Localized: 'Window: Se llevan todo el equipo y las armas de los soldados muertos para que no caigan en manos de los saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182990
    m_Localized: 'Window: Probablemente no esperaban que el Visitante pálido sobreviviera a un encuentro contra soldados armados.'
    m_Metadata:
      m_Items: []
  - m_Id: 17738415533182991
    m_Localized: 'Window: Ahora hay más bolsas para cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576140324864
    m_Localized: 'TV: Buenas tardes. Aquí tenéis el pronóstico del tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102080
    m_Localized: 'TV: Una ola de calor ha llegado a nuestra región, rompiendo los récords de temperatura anteriores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102081
    m_Localized: 'TV: Los meteorólogos esperan que las temperaturas aumenten.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102082
    m_Localized: 'TV: Además, el incremento de actividad solar provocará niveles peligrosos de radiación ultravioleta durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102083
    m_Localized: 'TV: Por vuestra seguridad, por favor, evitad tomar el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102084
    m_Localized: 'TV: Las altas temperaturas podrían causar insolación.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102085
    m_Localized: 'TV: No se sabe con certeza si estar al Sol puede afectar negativamente a nuestra salud...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102086
    m_Localized: 'TV: Pero para prevenir quemaduras de tercer grado, no salgáis fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102087
    m_Localized: 'TV: Desafortunadamente, la crema solar no sirve de nada en esta situación.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102089
    m_Localized: 'TV: Ves bailarinas danzando con gracia. Cruzan el escenario con saltos enérgicos, pero delicados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102090
    m_Localized: 'TV: A pesar de la elegancia, el baile evoca pensamientos inquietantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102091
    m_Localized: 'TV: Sientes como si intentaran distraerte de los acontecimientos actuales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102092
    m_Localized: 'TV: Si tan solo alguien pudiera explicar qué está pasando...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102093
    m_Localized: 'TV: Antes, hacer las compras del súper significaba echarse una caminata pesada hasta la tienda.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102094
    m_Localized: 'TV: Pero a partir de ahora bastará con que digas: "Hola, quisiera hacer un pedido".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102095
    m_Localized: 'TV: For Rest, comida a domicilio. Llama al {0} y tu comida llegará la noche siguente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102096
    m_Localized: 'TV: For Rest: Para que disfrutes y te relajes en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102097
    m_Localized: 'TV: Un maníaco pálido ha aparecido en las calles de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102098
    m_Localized: 'TV: Según diversos testimonios, todas sus víctimas tenían algo en común: todas estaban solas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102099
    m_Localized: 'TV: Se ha reportado que el sospechoso siempre le habla a las víctimas y ataca después.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102100
    m_Localized: 'TV: La policía ha hecho un boceto del sospechoso a partir de los testimonios de los testigos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102101
    m_Localized: 'TV: El sospechoso es un hombre de mediana edad, alto, pálido y de pelo negro. Es de complexión muy delgada y solo lleva pantalones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102102
    m_Localized: 'TV: Varios testigos aseguran que lleva la piel de otra persona.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102103
    m_Localized: 'TV: Esta información no ha sido confirmada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102104
    m_Localized: 'TV: Si ven a este hombre, no abran la puerta y díganle que no están solos en casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102106
    m_Localized: 'TV: Caos, terror y sufrimiento. Y todo por culpa de los Visitantes...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102107
    m_Localized: 'TV: Pero en la hora más oscura, cuando nuestras lágrimas comenzaban a fluir como un río...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102108
    m_Localized: 'TV: ¡LOS FUNCIONARIOS DE LA AFAE HAN VENIDO EN NUESTRA AYUDA!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102109
    m_Localized: 'TV: Estos valientes héroes de la AFAE nos protegen de la invasión de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102110
    m_Localized: 'TV: Hasta ahora, la agencia ha identificado 27.000 criaturas peligrosas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102111
    m_Localized: 'TV: Recuerda: Puedes ayudar a la agencia informando sobre cualquier actividad sospechosa a tu alrededor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102112
    m_Localized: 'TV: Para ello, pueden utilizar la invitación de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102113
    m_Localized: 'TV: Si alguna vez sospechas que eres un Visitante, llama al: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102114
    m_Localized: 'TV: Al ayudar a la AFAE ayudas a proteger el planeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102115
    m_Localized: 'TV: AFAE: ¿Qué es? ¿Y por qué se formó?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102116
    m_Localized: 'TV: La Agencia Federal de Administración de Emergencias es un servicio creado recientemente para aliviar la crisis.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102117
    m_Localized: 'TV: Su misión es frenar a los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102118
    m_Localized: 'TV: Los detalles de sus planes son confidenciales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102119
    m_Localized: 'TV: Pero podemos afirmar con seguridad que nuestro destino está en manos fiables.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102120
    m_Localized: 'TV: La AFAE reune los profesionales más calificados de la nación, incluyendo a científicos de talla mundial.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102121
    m_Localized: 'TV: Si un oficial de la AFAE aparece en su puerta le aconsejamos cooperación total.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102122
    m_Localized: 'TV: Recuerde: apoyando a la AFAE, ayuda a proteger al planera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102123
    m_Localized: 'TV: Según la AFAE, el fenómeno Visitante podría ser contagioso o suponer alguna otra amenaza biológica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102124
    m_Localized: 'TV: Por esta razón, es importante reportar y aislar a cualquier persona con comportamientos sospechosos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102125
    m_Localized: 'TV: Si no puede trasladar a un posible Visitante a una zona de cuarentena de inmediato, dele una petición para presentarse ante la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102126
    m_Localized: 'TV: Un oficial de la AFAE recogerá al individuo durante la siguiente inspección.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102128
    m_Localized: 'TV: ¡Que el calor no te detenga! ¡Siente el impulso!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102129
    m_Localized: 'TV: ¡Con EnerJeka, estás vivo!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102130
    m_Localized: 'TV: Una bebida energética vigorizante que sacia tu sed más rápido y con mayor eficacia que el agua.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102131
    m_Localized: 'TV: Pídela en For Rest delivery ahora mismo marcando al {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296387
    m_Localized: 'TV: Érase una vez, dos hermanos que vivían cerca de una represa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296388
    m_Localized: 'TV: El chapoteo del agua los hacía pensar en bebidas frías y espumosas...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296389
    m_Localized: 'TV: Y cuando los dos hermanos crecieron, fundaron Cervecería Bober juntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296390
    m_Localized: 'TV: La cerveza Bober Černý se ha convertido en una de las cervezas más socilitadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296391
    m_Localized: 'TV: Bober Černý: Bebe en grande. Bebe lo mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296517
    m_Localized: 'Window: La casa de tu vecino se alza en el campo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296518
    m_Localized: 'Window: No hay luz saliendo de las ventanas. Parece que su familia duerme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296519
    m_Localized: 'Window: Unos cuantos borrachos están tirados en la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296520
    m_Localized: 'Window: Pese a estar en el suelo helado, aparentan dormir profundamente. Las cosa marcha bien para ellos por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296521
    m_Localized: 'Window: A la distancia se ve la casa de tu vecino, quien te está visitando ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296522
    m_Localized: 'Window: Una luz intensa brilla por la ventana y parece que su familia espera que vuelva a casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296523
    m_Localized: 'Window: Reina un silencio sepulcral fuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296524
    m_Localized: 'Window: No hay absolutamente nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296525
    m_Localized: 'Window: Hasta los borrachos decidieron no salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296526
    m_Localized: 'Window: ¿A qué le tendrán todos tanto miedo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296527
    m_Localized: 'Window: El vecino y su hija juegan afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296528
    m_Localized: 'Window: Están jugando alegremente, intentando olvidarse del horror que están viviendo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296529
    m_Localized: 'Window: Aunque solo sea por un momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296530
    m_Localized: 'Window: Un hombre pálido como la misma muerte está de pie en la acera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296531
    m_Localized: 'Window: Tiene extraños pliegues en su piel.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296532
    m_Localized: 'Window: Parece como si su piel fuera una talla incorrecta para su cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296533
    m_Localized: 'Window: Desde aquí no distingues sus ojos, pero sientes su mirada clavada en ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296534
    m_Localized: 'Window: El miedo te invade el cuerpo entero. Le rezas a Dios para que el terrorífico Visitante no se detenga en tu puerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296535
    m_Localized: 'Window: Hay un pequeño grupo de empleados de la AFAE junto a la casa de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296536
    m_Localized: 'Window: Te preguntas de qué estarán hablando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296537
    m_Localized: 'Window: ¿Quizás estén tomando muestras de tierra?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296538
    m_Localized: 'Window: ¿O buscando algún sitio donde establecer una base?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296539
    m_Localized: 'Window: Ves a un grupo de soldados armados a través de la ventana.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296540
    m_Localized: 'Window: Un pequeño pelotón protege al equipo de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296541
    m_Localized: 'Window: Escuchas algunos fragmentos su charla; algo sobre tío pálido con el torso desnudo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296542
    m_Localized: 'Window: ¿Quizás quieren rastrear a ese Visitante aterrador?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296543
    m_Localized: 'Window: La casa de tu vecino, recién pintada de blanco, se ha quemado por completo, ahora está más negra que el carbón.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296544
    m_Localized: 'Window: El fuego debe haberse apagado hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296545
    m_Localized: 'Window: ¿Podría alguien haberle prendido fuego a propósito?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296546
    m_Localized: 'Window: ¿Qué le habrá pasado a la familia del vecino?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296547
    m_Localized: 'Window: ¿Quedará alguien con vida?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296548
    m_Localized: 'Window: Las preocupaciones te dan vueltas en la cabeza y te invade una sensación de incomprensión e impotencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296549
    m_Localized: 'Window: Todo el pelotón de soldados que estuvo aquí ayer está muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296550
    m_Localized: 'Window: Parece que aquí hubo una masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296551
    m_Localized: 'Window: Hay cuerpos esparcidos por toda la calle y a uno de ellos le falta la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296552
    m_Localized: 'Window: ¿Acaso ese tío espeluznante los mató a todos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296553
    m_Localized: 'Window: Miras al fantasma de lo que alguna vez fue el hogar de tu vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296554
    m_Localized: 'Window: Hace no tanto tiempo, una familia feliz vivía en ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296555
    m_Localized: 'Window: Una sensación extraña te abruma, como si supieras que esto iba a pasar...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296556
    m_Localized: 'Window: Como si hubiese sabido que la Parca estaba al acecho.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296557
    m_Localized: 'Window: Ves una estaca enterrada en un cráneo. Aún lleva el casco puesto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296558
    m_Localized: 'Window: Aún hay algo de piel negra aferrada al hueso. Parece que alguien le arrancó los dientes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296559
    m_Localized: 'Window: La cabeza lleva ahí todo el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296560
    m_Localized: 'Window: Toda esta macabra exhibición parece una amenaza. Seguramente fue cosa de ese aterrador Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296561
    m_Localized: 'Window: Los oficiales de la AFAE están inspeccionando el lugar de la reciente masacre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296562
    m_Localized: 'Window: Se llevan todo el equipo y las armas de los soldados muertos para que no caigan en manos de los saqueadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296563
    m_Localized: 'Window: Probablemente esperaban que el Visitante pálido no sobreviviera a su encuentro con una multitud de gente armada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296564
    m_Localized: 'Window: Ahora hay más bolsas para cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296409
    m_Localized: 'TV: El silencio es un presagio de la muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296410
    m_Localized: 'TV: Un silencio que drena el alma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296411
    m_Localized: 'TV: Pero si hay algo peor que el vacío... es el zumbido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296412
    m_Localized: 'TV: El repicar de las campanas funerarias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296413
    m_Localized: 'TV: Algo crece en los oídos cuando suenan las campanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296414
    m_Localized: 'TV: Todo lo que queda es cerumen. Pensamientos sucios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296415
    m_Localized: 'TV: De eso se alimentan los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296416
    m_Localized: 'TV: Los Visitantes se enredan en las telarañas del pensamiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296417
    m_Localized: 'TV: Para ellos, las campanas son más ruidosas; es por ello que tienen más cerumen.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102088
    m_Localized: 'TV: A continuación: más información del tiempo. Pero antes, un mensaje de nuestros patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102105
    m_Localized: 'TV: Estas fueron las últimas noticias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102127
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102132
    m_Localized: 'TV: Buenas tardes. Bienvenidos al noticiario.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102133
    m_Localized: 'TV: Debido a un drástico aumento de personas que muestran señales de ser un Visitante, la AFAE está implementando nuevas medidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102134
    m_Localized: 'TV: De forma inmediata, se hará cumplir una cuarentena total en las grandes ciudades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102135
    m_Localized: 'TV: Los viajes fuera de vuestra ciudad o asentamientos cercanos están estrictamente prohibidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102136
    m_Localized: 'TV: Os pedimos que no salgáis del área que se os ha asignado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102137
    m_Localized: 'TV: Además, la AFAE ha dado a conocer un nuevo signo de identificación:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102138
    m_Localized: 'TV: Fotografías de aura.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102139
    m_Localized: 'TV: Las manchas oscuras en la fotografía son un fuerte indicador de que el sujeto en la foto sea un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102140
    m_Localized: 'TV: Eso es todo por ahora. Mantened la calma y permaneced en casa durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102141
    m_Localized: 'TV: Y ahora, un mensaje de nuestros patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102142
    m_Localized: 'TV: ¿Qué son los Visitantes? ¿Fantasmas? ¿Criaturas del subsuelo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102143
    m_Localized: 'TV: No, esto no es una novela de ciencia ficción, ni un encabezado sensacionalista.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102144
    m_Localized: 'TV: Esta es nuestra nueva realidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102145
    m_Localized: 'TV: Los rumores sobre el verdadero origen de los Visitantes no dejan de circular.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102146
    m_Localized: 'TV: ¿Alienígenas? ¿Muertos vivientes? ¿Un experimento de laboratorio que salió mal?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102147
    m_Localized: 'TV: Según las autoridades, estas son solo teorías sin fundamento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102148
    m_Localized: 'TV: Estudios muestran que los Visitantes son humanos que se han expuesto a un agente biológico sin identificar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102149
    m_Localized: 'TV: La forma de contagio es desconocida, pero la AFAE pide a todos permanecer atentos a las señales de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102150
    m_Localized: 'TV: Si cree haber estado expuesto, o si sospecha que podría ser un Visitante, comuníquese con la AFAE marcando al:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102151
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102152
    m_Localized: 'TV: Eso es todo por ahora. Seguid atentos después de la pausa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102153
    m_Localized: 'TV: Distinguir a un Visitante es cada día más difícil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102154
    m_Localized: 'TV: Las señales pueden ayudar, pero ¿y si queréis un método infalible?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102155
    m_Localized: 'TV: ¡Presentamos el carrete fotográfico detecta auras que lo cambia todo!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102156
    m_Localized: 'TV: Revela la esencia del alma, para que puedas diferenciar a un humano de un Visitante hostil.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102157
    m_Localized: 'TV: Saca una foto y si ves manchas oscuras, has descubierto a un Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102158
    m_Localized: 'TV: Llama ahora y consigue tu kit de inicio gratuito: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102159
    m_Localized: 'TV: Última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102160
    m_Localized: 'TV: El Sol arremete de nuevo: incendios forestales se extienden por las regiones arboladas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102161
    m_Localized: 'TV: Los expertos opinan que el nivel de actividad solar elevada es responsable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576157102162
    m_Localized: 'TV: Aunque la magnitud total del desastre aún no está clara, se han desplegado brigadas de bomberos para contener los incendios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296384
    m_Localized: 'TV: Eso es todo por ahora. Mantened la calma y permaneced dentro durante el día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296385
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296386
    m_Localized: 'TV: A continuación: un mensaje de nuestros patrocinadores.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296392
    m_Localized: 'TV: Interrumpimos este programa con una alerta de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296393
    m_Localized: 'TV: Hay noticias de disturbios civiles en una ciudad cercana.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296394
    m_Localized: 'TV: Por motivos aún no aclarados, las fuerzas de la AFAE han sellado la zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296395
    m_Localized: 'TV: Por favor, permanezcan en sus hogares.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296396
    m_Localized: 'TV: Quédense donde están y esperen indicaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296397
    m_Localized: 'TV: Y recuerden... apoyen a la AFAE y únanse a la lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296398
    m_Localized: 'TV: Eso es todo por los momentos. Ahora algunos anuncios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296399
    m_Localized: 'TV: Hasta los trabajadores más tenaces también necesitan un descanso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296400
    m_Localized: 'TV: Con cigarrillos Margoro, puedes tomarte una bocanada profunda y desconectar de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296401
    m_Localized: 'TV: Margoro. Tabaco para hombres de verdad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296402
    m_Localized: 'TV: (Aviso legal: la compañía no se responsabiliza de ningún perjuicio para la vida o la salud)'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296403
    m_Localized: 'TV: Buenas tardes. Bienvenidos al noticiario.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296404
    m_Localized: 'TV: Un aviso de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296405
    m_Localized: 'TV: Han surgido nuevos detalles sobre el incidente reciente en la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296406
    m_Localized: 'TV: Parece que una de las zonas en cuarentena ha sido atacada por un individuo armado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296407
    m_Localized: 'TV: Todavía no se sabe el motivo y se desconoce si el perpetrador tenía cómplices.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296408
    m_Localized: 'TV: Varias personas con estatus no verificado han escapado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296418
    m_Localized: 'TV: El incidente de hoy ha suscitado numerosas teorías.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296419
    m_Localized: 'TV: Algunos informes describen a un único tirador, mientras que otros hacen referencia a un grupo armado ataviado con capuchas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296420
    m_Localized: 'TV: Pero el mayor desafío quizá esté por venir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296421
    m_Localized: 'TV: Debido a la cuarentena, el traslado de cuerpos en las áreas circundantes ha sido temporalmente suspendido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296422
    m_Localized: 'TV: No obstante, las inspecciones residenciales continuarán según lo previsto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296423
    m_Localized: 'TV: Si podéis incinerar a los fallecidos, háganlo de inmediato.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296424
    m_Localized: 'TV: De lo contrario, por favor aguarden a que la situación se normalice antes de entregar restos mortales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296425
    m_Localized: 'TV: Eso es todo por ahora. Sigan sintonizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296426
    m_Localized: 'TV: Buenas tardes. Bienvenidos al noticiario.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296427
    m_Localized: 'TV: La AFAE está asistiendo a las víctimas del ataque en la zona de cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296428
    m_Localized: 'TV: Debido a la falta de espacio en las instalaciones existentes, la agencia ha tomado la siguiente decisión:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296429
    m_Localized: 'TV: Los residentes evacuados serán alojados temporalmente en edificios de las afueras de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296430
    m_Localized: 'TV: Afortunadamente, los propietarios locales han cooperado con la AFAE y han ofrecido refugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296431
    m_Localized: 'TV: No obstante, solo una parte de los individuos que escaparon han sido localizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296432
    m_Localized: 'TV: Se ha anunciado una nueva señal de identificación:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296433
    m_Localized: 'TV: Encías sangrantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296434
    m_Localized: 'TV: Si un individuo con esta condición se presenta en su puerta, no interactúe.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296435
    m_Localized: 'TV: Espere a la patrulla asignada de la AFAE y reporte el individuo a las autoridades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296436
    m_Localized: 'TV: Recuerde permanecer en casa y espere nuevas indicaciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296437
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296438
    m_Localized: 'TV: A continuación: un informe especial sobre un nuevo y peligroso culto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296439
    m_Localized: 'TV: Los Visitantes no solo se esconden entre nosotros. Puede que estén infiltrando nuestros propios pensamientos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296440
    m_Localized: 'TV: Diversas ciudades están comunicando brotes de actividad de cultos organizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296441
    m_Localized: 'TV: Los cargos contra ellos incluyen:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296442
    m_Localized: 'TV: Rituales de sacrificio, adoración de una deidad desconocida y posibles vínculos con los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296443
    m_Localized: 'TV: Según informes, este grupo ha tomado una postura pública contra la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296444
    m_Localized: 'TV: Lo que empezó como una nueva fe ha escalado y se ha convertido en acciones directas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296445
    m_Localized: 'TV: Algunos expertos creen que este nuevo culto podría ser responsable de los sucesos violentos ocurridos recientemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296446
    m_Localized: 'TV: Recomenados evitar el contacto con estos supuestos "nuevos creyentes".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296447
    m_Localized: 'TV: Asistirles o simpatizar con ellos podría resultar en una detención.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296448
    m_Localized: 'TV: Eso es todo por ahora. Permanezcan sintonizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296449
    m_Localized: 'TV: Buenas tardes. Bienvenidos al noticiario.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296450
    m_Localized: 'TV: La situación en la ciudad se está estabilizando gradualmente, pero algunos fugitivos siguen en libertad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296451
    m_Localized: 'TV: Mientras tanto, las operaciones de retirada de cadáveres se han reanudado,  aunque han surgido nuevos desafíos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296452
    m_Localized: 'TV: Según los últimos informes, manadas de perros agresivos están vagando por las calles.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296453
    m_Localized: 'TV: La AFAE ha desplegado un equipo para lidiar con la amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296454
    m_Localized: 'TV: La agencia también ha anunciado una nueva señal para identificar a individuos potencialmente peligrosos:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296455
    m_Localized: 'TV: Irritación cutánea.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296456
    m_Localized: 'TV: La investigación sobre el ataque en la ciudad todavía está en curso.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296457
    m_Localized: 'TV: Aún no está claro si el atacante actuó por su cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296458
    m_Localized: 'TV: No obstante, no hay duda de que la AFAE resolverá esto y también la amenaza de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296459
    m_Localized: 'TV: Si tiene dudas sobre cómo reconocer a los Visitantes, puede llamar a la línea de emergencia de la AFAE marcando al:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296460
    m_Localized: 'TV: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296461
    m_Localized: 'TV: Como siempre, quédese donde está y espere nuevas instrucciones'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296462
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296463
    m_Localized: 'TV: A continuación: un informe de la situación en los países del ecuador terrestre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296464
    m_Localized: 'TV: Noticias preocupantes desde las regiones ecuatoriales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296465
    m_Localized: 'TV: Incendios forestales extendidos, calor extremo y sequía devastan varias naciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296466
    m_Localized: 'TV: Informes recientes indican que las temperaturas son tan altas que el contacto con el suelo puede causar quemaduras de tercer grado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296467
    m_Localized: 'TV: El número de fallecidos sigue siendo desconocido y la evacuación esimposible actualmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296468
    m_Localized: 'TV: Nuestro gobierno no ha podido establecer comunicación con las autoridades de las zonas afectadas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296469
    m_Localized: 'TV: No obstante, una vez que las condiciones lo permitan, oficiales de la AFAE se desplegarán para asistir en las operaciones de socorro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296470
    m_Localized: 'TV: Eso es todo por ahora. Permanezcan sintonizados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296471
    m_Localized: 'TV: Buenas tardes. Bienvenidos al noticiario.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296472
    m_Localized: 'TV: La situación en la ciudad sigue siendo inestable y el acordonamiento sigue intacto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296473
    m_Localized: 'TV: No obstante, ha emergido una nueva amenaza. Los miembros de un culto han sido vistos en las afueras de la ciudad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296474
    m_Localized: 'TV: De acuerdo con los informes recientes, es posible que estén preparando un ritual que implica encender algo en llamas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296475
    m_Localized: 'TV: La AFAE cree que este grupo pudo haber estado involucrado con los ataques a las zonas en cuarentena.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296476
    m_Localized: 'TV: Desafortunadamente, dada la situación actual en la ciudad, ni la AFAE ni el ejército pueden destinar un grupo especializado en este momento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296477
    m_Localized: 'TV: Si los miembros del culto se aproximan a su domicilio, llame inmediatamente a la línea directa de la AFAE: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296478
    m_Localized: 'TV: La agencia anunció una nueva señal de identificación:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296479
    m_Localized: 'TV: Hongos en la zona de las axilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296480
    m_Localized: 'TV: Como siempre, quédese donde está y espere nuevas instrucciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296481
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296482
    m_Localized: 'TV: A continuación: un informe de las condiciones en los polos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296483
    m_Localized: 'TV: El sol ataca de nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296484
    m_Localized: 'TV: Los científicos han publicado nuevas y preocupantes previsiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296485
    m_Localized: 'TV: Si la actual ola de calor no remite, los casquetes polares podrían derretirse por completo, provocando inundaciones catastróficas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296486
    m_Localized: 'TV: Los investigadores continúan buscando la causa de la anomalía climática, pero hasta la fecha, no hay respuestas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296487
    m_Localized: 'TV: Eso es todo por ahora. Permanezcan sintonizados para más información.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296488
    m_Localized: 'TV: ¡Alerta de última hora!'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296489
    m_Localized: 'TV: Las condiciones en la ciudad no muestran signos de estabilizarse. El desastre sigue empeorando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296490
    m_Localized: 'TV: Con el deshielo de los glaciares, el nivel del mar está subiendo rápidamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296491
    m_Localized: 'TV: Esto amenaza con inundar gravemente las zonas costeras en todo el mundo, incluyendo grandes ciudades.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296492
    m_Localized: 'TV: Varios lagos contaminados con radiación han empezado a evaporarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296493
    m_Localized: 'TV: Los científicos advierten que esto podría provocar lluvias ácidas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296494
    m_Localized: 'TV: Si escucha truenos, busque refugio de inmediato para protegerse de la exposición.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296495
    m_Localized: 'TV: Y, por desgracia, la ciudad sigue acordonada.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296496
    m_Localized: 'TV: La AFAE todavía no ha capturado a todos los fugitivos y ahora anunció una nueva señal para identificar a los Visitantes:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296497
    m_Localized: 'TV: Movimiento rápido de las pupilas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296498
    m_Localized: 'TV: TRANSMISIÓN DE EMERGENCIA.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296499
    m_Localized: 'TV: Debemos interrumpir este informe por el riesgo de un ataque a nuestro estudio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296500
    m_Localized: 'TV: Si tiene dudas sobre cómo reconocer a los Visitantes, llame a la línea de emergencia: {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296501
    m_Localized: 'TV: Fin de la emisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296502
    m_Localized: 'TV: Aviso de última hora.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296503
    m_Localized: 'TV: La AFAE acaba de arrestar a la mayoría de los funcionarios del gobierno.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296504
    m_Localized: 'TV: La agencia informa de que algunos de ellos han sido identificados como Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296505
    m_Localized: 'TV: Dado que el Parlamento ya no puede funcionar, la AFAE asumirá el rol de gobierno interino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296506
    m_Localized: 'TV: Además...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296507
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296508
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296509
    m_Localized: 'TV: Un momento, por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296510
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296511
    m_Localized: 'TV: Aviso de la AFAE:'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296512
    m_Localized: 'TV: Los fugitivos han violado el protocolo de aislamiento.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296513
    m_Localized: 'TV: Repetimos, los atacantes están libres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296514
    m_Localized: 'TV: Pongan barricadas en las ventanas. Cierren las puertas con llave.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296515
    m_Localized: 'TV: Esperen a más instrucciones y permanezcan dentro de casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296516
    m_Localized: 'TV: Fin de la emisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296565
    m_Localized: 'Window: Puedes ver a una mujer llorando junto a su esposo herido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296566
    m_Localized: 'Window: No sabes si sigue con vida o si ha muerto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296567
    m_Localized: 'Window: Con la cara surcada de lágrimas, ella arrastra su pesado cuerpo lejos del tiroteo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296568
    m_Localized: 'Window: Un pensamiento te llega a la cabeza: todo va a ponerse peor.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296569
    m_Localized: 'Window: El camino está repleto de los cadáveres de quienes intentaron huir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296570
    m_Localized: 'Window: Cerca de ahí, el responsable, un agente de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296571
    m_Localized: 'Window: El rifle que sostiene aún suelta humo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296572
    m_Localized: 'Window: Personas presas del pánico se precipitan a las casas cercanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296573
    m_Localized: 'Window: Golpean las puertas, con la esperanza de ser acogidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296574
    m_Localized: 'Window: Pero parece que nadie está dispuesto a dejarles cobijo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296575
    m_Localized: 'Window: Un grupo de personas desahuciadas está junto a la casa arruinada del vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296576
    m_Localized: 'Window: Están conmocionados, susurrando entre ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296577
    m_Localized: 'Window: Probablemente querrán resguardarse allí.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296578
    m_Localized: 'Window: ¿Pero queda en el planeta un lugar apartado de este desastre?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296579
    m_Localized: 'Window: En el camino hay un hombre con un rifle de asalto. Se ve como un completo demente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296580
    m_Localized: 'Window: Su chaqueta está cubierta de dientes, ojos y quién sabe qué más. Es difícil de distinguir desde aquí.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296581
    m_Localized: 'Window: ¿Y si mata no para protegerse, sino por deporte y para coleccionar trofeos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296582
    m_Localized: 'Window: Sea como sea, esperas que no te considere su enemigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296583
    m_Localized: 'Window: De un poste cuelga un hombre con un cartel que dice "Me lo quitasteis todo."'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296584
    m_Localized: 'Window: ¿Le han robado? ¿O la AFAE se llevó a su familia?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296585
    m_Localized: 'Window: Tu mente va a mil, pero no te llegan respuestas, solo suposiciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296586
    m_Localized: 'Window: Un grupo desplazado por la AFAE se ha asentado en las ruinas del vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296587
    m_Localized: 'Window: Aunque queda poco, el sótano parece haber sobrevivido.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296588
    m_Localized: 'Window: Un pequeño refugio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296589
    m_Localized: 'Window: Pero, ¿por cuánto tiempo podrán seguir escondiéndose?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296590
    m_Localized: 'Window: Perros salvajes deambulan por la calle.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296591
    m_Localized: 'Window: Sus cuerpos tienen quemaduras leves, el hambre los consume.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296592
    m_Localized: 'Window: Desde dentro de tu casa, no les temes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296593
    m_Localized: 'Window: Pero ahora no puedes quitarte la sensación de que es mejor no salir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296594
    m_Localized: 'Window: Pequeños grupos con sus pertenencias se reúnen cerca de las casas. Susurran, con cuidado de no ser oídos por los oficiales de la AFAE.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296595
    m_Localized: 'Window: Al parecer son de zonas de cuarentena y se están instalando en los hogares de los antiguos residentes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296596
    m_Localized: 'Window: Ahora, el hombre colgado parece un tenebroso letrero de "Bienvenidos".'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296597
    m_Localized: 'Window: Un cazador de Visitantes con un arma de fuego tiene a un grupo de sobrevivientes a punta de escopeta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296598
    m_Localized: 'Window: Es probable que se los haya topado por pura coincidencia.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296599
    m_Localized: 'Window: Se oyen gritos; hay una voz enloquecida que resalta más que las otras.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296600
    m_Localized: 'Window: ¿Quiénes podrían sobrevivir en este nuevo mundo? No parece que esos tíos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296601
    m_Localized: 'Window: Unos agentes de la AFAE están de pie sobre los perros muertos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296602
    m_Localized: 'Window: Uno de ellos toma notas en una tableta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296603
    m_Localized: 'Window: Pero, ¿pueden un puñado de personas detener a una horda de animales hambrientos? Es muy poco probable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296604
    m_Localized: 'Window: Dos oficiales de la AFAE están de pie junto a una farola, mirando al hombre ahorcado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296605
    m_Localized: 'Window: Parece que al fin han prestado atención a la principal atracción de la zona.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296606
    m_Localized: 'Window: Parecen detectives despistados, preguntándose cómo llegó allí sin una escalera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296607
    m_Localized: 'Window: El grupo entero ha muerto. Perros hambrientos desgarran sus restos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296608
    m_Localized: 'Window: Casquillos gastados se esparcen cerca de los cuerpos. Parece que ese cazador los mató y muy seguramente se llevó trofeos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296609
    m_Localized: 'Window: La locura de este mundo ha ido demasiado lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296610
    m_Localized: 'Window: Los sectarios están apilando leña en un gran montón para encender una hogera.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296611
    m_Localized: 'Window: ¿Tienen pensado quemar a alguien?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296612
    m_Localized: 'Window: Su plan descabellado pronto se revelará.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296613
    m_Localized: 'Window: ¿Pero cuántas vidas inocentes se perderán por su causa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296614
    m_Localized: 'Window: En el camino hay un demente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296615
    m_Localized: 'Window: Lleva una garrafa de gasolina y un cóctel molotov.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296616
    m_Localized: 'Window: ¿Será que pretende quemar todo el pueblo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296617
    m_Localized: 'Window: ¿Le habrán dicho que esa gente viene de las zonas de cuarentena?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296618
    m_Localized: 'Window: Los cuerpos de los que se escondían en las ruinas del vecino se quemaron bajo el sol.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296619
    m_Localized: 'Window: Los perros que se alimentaban de ellos han huido. ¿Quizás temen a algo más?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296620
    m_Localized: 'Window: ¿Y si no huyeron de la AFAE, sino de algo peor?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296621
    m_Localized: 'Window: En el lugar de la hoguera, hay sectarios atados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296622
    m_Localized: 'Window: ¿Han decidido sacrificarse a sí mismos?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296623
    m_Localized: 'Window: La idea te da vueltas en la cabeza.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296624
    m_Localized: 'Window: El miedo a la muerte ha nublado la razón. La gente está dispuesta a hacer lo impensable.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296625
    m_Localized: 'Window: Da miedo imaginar lo que vendrá, cuando este tipo de locura está ocurriendo después de solo unas semanas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296626
    m_Localized: 'Window: Casas ardiendo resplandecen intensamente. Los gritos resuenan a lo lejos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576161296627
    m_Localized: 'Window: Sabes que la mano detrás de este caos es la del demente que intenta aniquilar a los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490688
    m_Localized: 'Window: ¿Será tu casa la siguiente? ¿Lo será mañana? ¿La próxima semana?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490689
    m_Localized: 'Window: Lo más probable es que te enfrentes a ese lunático cara a cara. Es solo cuestión de tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490690
    m_Localized: 'Window: No queda nada de los cuerpos calcinados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490691
    m_Localized: 'Window: Solo una extraña masa sin forma. Parece lodo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490692
    m_Localized: 'Window: Te preguntas si algo derritió la carne y los huesos antes de engullir los restos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490693
    m_Localized: 'Window: Rezas para que esta criatura se quede en las sombras. Temes que tu mente no sobreviva a ver ese monstruo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490694
    m_Localized: 'Window: Los oficiales de la AFAE rodean los cuerpos quemados.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490695
    m_Localized: 'Window: Registran las muertes de los cultistas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490696
    m_Localized: 'Window: Caras congeladas por el terror y la agonía, como si hubiesen visto algo horrible antes de morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490697
    m_Localized: 'Window: Todas las casas de alrededor están en ruinas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490698
    m_Localized: 'Window: Tu casa es la última que queda en pie.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490699
    m_Localized: 'Window: Ya no queda nada más que distraiga a ese demente.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490700
    m_Localized: 'Window: Lo que sea que pase después, te sucederá a ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490701
    m_Localized: Aquí Central. Comprobad el estado de la zona de cuarentena. Código 51. Informes de explosiones a las 3 AM.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490702
    m_Localized: 'Unidad 32-8, informando. Código 60: numerosas bajas civiles, agentes caídos...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490703
    m_Localized: Habla 28-8. Código 451. Solicitamos equipo de incineración para deshacernos de los cuerpos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490704
    m_Localized: Entendido. Iniciando Código 984. La ciudad está acordonada a la espera de una investigación. Esperad refuerzos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490705
    m_Localized: Si podéis oír esto, manteneos lejos de las afueras.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490706
    m_Localized: Los oficiales de la AFAE le están disparando a cualquiera que intente salir.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490707
    m_Localized: ¡NO SÉ QUÉ ESTÁ PASANDO! ¡SOLO QUIERO SALIR DE AQUÍ!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490708
    m_Localized: ALGUIEN, POR FAVOR, AYU—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490709
    m_Localized: Esos no fueron los que atacaron la zona de cuarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490710
    m_Localized: Yo lo vi. Vi lo que había allí.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490711
    m_Localized: Eso... Eso no era humano...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490712
    m_Localized: Habla un recién desalojado.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490713
    m_Localized: Si la AFAE os ha echado como a nosotros, nos refugiamos en el sótano de una casa incendiada.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490714
    m_Localized: Está cerca de donde vive el ermitaño.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490715
    m_Localized: No nos queda mucha comida. Pronto empezaremos a morir de hambre.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490716
    m_Localized: Si alguien tiene comida de sobra, por favor, ayudadnos. En serio la necesitamos.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490717
    m_Localized: Para todos los que me escucháis...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490718
    m_Localized: La AFAE está intentando bloquear todas las señales de la ciudad para ocultar la verdad.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490719
    m_Localized: Quieren ocultar todo lo que está sucediendo en la ciudad.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490720
    m_Localized: Están intentando culpar de todo a ese psicópata que mató a todos en la zona de cuarentena.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490721
    m_Localized: Si seguís en la ciudad... s...alid. N...o es seguro.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490722
    m_Localized: E...vitad las patrullas de la AFAE. I...ntentarán mataros.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490723
    m_Localized: C...ORRED MI...NTRAS PODÁ—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490724
    m_Localized: No tuv...ieron que ha...er quem...ado los cu...erpos. E...so l...os a...trae...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490725
    m_Localized: Si hu...bieran... si hu...bieran... r...esistido... no se hu...biera co—
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490726
    m_Localized: Ce...tral a...... todas las u...nidades de la A...AE...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490727
    m_Localized: 'New d...r...tive: N...ueva d...ir...ectiva: El Código 451 se r...empla...za por el Código 955.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490728
    m_Localized: No que...éis cuerp...s. Usad cal e... su lug...r.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490729
    m_Localized: 'Re...ito: el Código 451 está canc...do... Quem...r los restos... r...sulta... p...ligroso para c...ntener la am...naza del sujet—'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490730
    m_Localized: H...bla el 18-8. No p...dimos conten...rlo.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490731
    m_Localized: El suj...to ha salido del per...met...o de la ci...udad. Se ne...sitan refu...rzos de in...mediato.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490732
    m_Localized: 'Re...ito: nece...tamos ref...erzos a...hora. No p...demos c...ntener al s...jeto solos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490733
    m_Localized: 'Phone: Hola, vecino. Es bueno oír de ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490734
    m_Localized: 'Phone: Entonces... ¿Ya has dejado entrar a algunas personas?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490735
    m_Localized: 'Phone: Si no lo has hecho te aviso que no debes seguir atrasándolo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490736
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490737
    m_Localized: 'Phone: ¿Tienes preguntas?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490738
    m_Localized: ¿Tú también estás recibiendo gente?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490739
    m_Localized: ¿Cuantas señas toma para saber si alguien es un Visitante?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490740
    m_Localized: ¿Cómo resolverías el problema de la comida?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490741
    m_Localized: Hasta luego (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490742
    m_Localized: 'Phone: Sí, tengo que hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490743
    m_Localized: 'Phone: A mi chiquilla no le fascina. ¿Pero qué se le va a hacer? No hay otra opción.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490744
    m_Localized: 'Phone: Sigue pidiendo que la lleve fuera, solo para poder alejarse de esa muchedumbre.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490745
    m_Localized: 'Phone: En realidad no se puede caminar por el día, así que vamos de noche. Sé que es peligroso... Pero ella no deja de rogar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490746
    m_Localized: 'Phone: Ojalá lo supiera...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490747
    m_Localized: 'Phone: Nadie sabe cuantas señales toma para estar realmente seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490748
    m_Localized: 'Phone: Yo te diría que no te precipites si solo ves una.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490749
    m_Localized: 'Phone: Tal vez no sea nada. Posiblemente solo fueron al dentista antes de que todo esto se fuera a la mierda.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490750
    m_Localized: 'Phone: Tuve suerte. Conseguí provisiones a tiempo. Si la memoria no me falla, tú tambien lo hiciste.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490751
    m_Localized: 'Phone: Pero si quieres algo especial, existe ese servicio a domicilio, For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490752
    m_Localized: 'Phone: No sé su número, pero puedes encontrarlo en los anuncios de la  televisión o la radio.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490753
    m_Localized: 'Phone: Cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490754
    m_Localized: 'Phone: Hola, vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490755
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490756
    m_Localized: 'Phone: ¿Viste lo que ha pasado? Asesinaron a unos chavales.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490757
    m_Localized: 'Phone: Pensaba que las calles no eran tan peligrosas. Parece que me he equivocado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490758
    m_Localized: 'Phone: Mi hija me convenció de salir a jugar. Todo estaba bien... Hasta que vi los cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490759
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490760
    m_Localized: 'Phone: Creo que esa será la última vez que arriesgo la vida de esa forma.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490761
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490762
    m_Localized: 'Phone: Dios, jamás me lo perdonaría si algo le pasara a ella. Es todo mi mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490763
    m_Localized: ¿Tu hija está bien?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490764
    m_Localized: ¿Quién los mató?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490765
    m_Localized: Ten cuidado (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490766
    m_Localized: 'Phone: ¿Quién los mató?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490767
    m_Localized: 'Phone: Con toda esa hierba alta no debió haberlo notado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490768
    m_Localized: 'Phone: Pero cuando estábamos en casa dijo que vio un rostro en el cesped.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490769
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490770
    m_Localized: 'Phone: Trato de convencerla de que fue su imaginación. Pero ella no lo compra.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490771
    m_Localized: 'Phone: Era esa cosa alta y pálida. Creí que solo mataba a quienes se quedaban adentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490772
    m_Localized: 'Phone: Pensé que lo tenía bajo control. Mi plan siempre fue volver de inmediato a casa si llegábamos a ver esa silueta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490773
    m_Localized: 'Phone: Pero no pensé que ella acabaría viendo cadáveres.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490774
    m_Localized: 'Phone: Gracias. Tú también cuídate.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490775
    m_Localized: 'Phone: Hola, vecino. Gracias por llamar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490776
    m_Localized: 'Phone: Francamente, sigo acojonado por todo este asunto.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490777
    m_Localized: 'Phone: Los asesinatos, los soldados, la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490778
    m_Localized: 'Phone: Incluso se asomaron a mi puerta anoche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490779
    m_Localized: 'Phone: Preguntaron por la gente que se quedaba aquí, anotaron algo en una tableta y entonces...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490780
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490781
    m_Localized: 'Phone: Uno de ellos sacó a alguien de mi casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490782
    m_Localized: ¿Por qué se lo llevaron?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490783
    m_Localized: Es bueno que no se llevaran a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490784
    m_Localized: ¿Y qué es la AFAE en realidad?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490785
    m_Localized: Cuídate (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490786
    m_Localized: 'Phone: Si tan solo supiera, joder. Ellos dijeron que solo era una revisión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490787
    m_Localized: 'Phone: Pensé que los soldados y la Agencia de Gesión de Emergencias pondrían las cosas en su lugar.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490788
    m_Localized: 'Phone: Debí saber que se interesarían por cosas aparte de ayudarnos a llegar a un lugar seguro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490789
    m_Localized: 'Phone: No dejaré que nos lleven.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490790
    m_Localized: 'Phone: Sobre mi cadáver.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490791
    m_Localized: 'Phone: Si esos cabrones le ponen un dedo encima los haré trizas.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490792
    m_Localized: 'Phone: No lo sé. Nadie sabe mucho acerca de ellos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490793
    m_Localized: 'Phone: Salieron de la nada actuando como si lo tuvieran todo bajo control.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490794
    m_Localized: 'Phone: ¿Pero cómo son capaces de dar con las señales? ¿Y por qué son cosas que cualquier humano podría tener?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490795
    m_Localized: 'Phone: Se siente como si ocultaran algo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490796
    m_Localized: 'Phone: Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490797
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490798
    m_Localized: 'Phone: Jamás pensé que acabaríamos viviendo en completo caos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490799
    m_Localized: 'Phone: El Sol, los Visitantes, la AFAE...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490800
    m_Localized: 'Phone: Tantas preguntas y ni una jodida respuesta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490801
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490802
    m_Localized: 'Phone: Vecino, necesito pedirte algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490803
    m_Localized: 'Phone: Si algo me llegase a suceder, promete que cuidarás de mi hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490804
    m_Localized: Lo prometo
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490805
    m_Localized: No puedo prometerte nada
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490806
    m_Localized: 'Phone: Gracias, colega. Sabía que podía contar contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490807
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490808
    m_Localized: 'Phone: Bien, debo irme. Mantente firme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490809
    m_Localized: 'Phone: Yo...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490810
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490811
    m_Localized: 'Phone: ¿En serio no la ayudarías? Es solo una chiquilla. No quiero dejarla sola.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490812
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490813
    m_Localized: 'Phone: Joder, debo irme.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490814
    m_Localized: 'Phone: Adiós, vecino.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490815
    m_Localized: 'Phone: Saludos, este es el servicio de entregas de For Rest.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490816
    m_Localized: 'Phone: ¿Qué le gustaría ordenar?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490817
    m_Localized: Una lata de EnerJeka, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490818
    m_Localized: Una lata de café, por favor
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490819
    m_Localized: Cambié de opinión. No haré ningún pedido
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490820
    m_Localized: 'Phone: Lo siento, no podemos aceptar tu orden debido a que hiciste una hace poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490821
    m_Localized: 'Phone: Debido a la alta demanda nos vemos obligados a aceptar pedidos con interrupciones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490822
    m_Localized: 'Phone: Si desea realizar un pedido, por favor, intente llamar de nuevo otro día.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490823
    m_Localized: 'Phone: Adiós. Gracias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490824
    m_Localized: 'Phone: Muy bien. Su orden se está procesando. Por favor, espere su pedido hasta mañana por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490825
    m_Localized: 'Phone: Muy bien. Su orden se está procesando. Por favor, espere su pedido hasta mañana por la noche.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490826
    m_Localized: 'Phone: Saludos, se ha comunicado con la Agencia Federal de Administración de Emergencias, división médica.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490827
    m_Localized: 'Phone: Estamos preparados para proveer consultorías sobre procedimientos para la identificación de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490829
    m_Localized: 'Phone: ¿Tiene alguna pregunta?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490830
    m_Localized: ¿Qué debería hacer respecto a los dientes?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490831
    m_Localized: ¿Qué debería hacer respecto a las uñas?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490832
    m_Localized: ¿Qué debería hacer respecto a los ojos?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490833
    m_Localized: Gracias. Me ha sido de ayuda
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490834
    m_Localized: 'Phone: Para resultados precisos, recomendamos evitar el tabaco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490835
    m_Localized: 'Phone: Fumar puede afectar la condición de los dientes, provocando resultados poco fiables.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490836
    m_Localized: 'Phone: Para asegurar una lectura apropiada de su condición, por favor absténgase de lavarse las manos antes de ser examinado.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490837
    m_Localized: 'Phone: El agua puede eliminar residuos de la tierra, lo que podría causar errores y resultados incorrectos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490838
    m_Localized: 'Phone: Para una revisión confiable, por favor evite tomar café o bebidas con cafeína.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490839
    m_Localized: 'Phone: La cafeína podría causarle nervios e insomnio, pero también ojos enrojecidos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490840
    m_Localized: 'Phone: Gracias por cooperar con la Agencia Federal de Administración de Emergencias.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490841
    m_Localized: 'Phone: Su cooperación no pasará desapercibida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490842
    m_Localized: 'Phone: Cuando favorece la fiabilidad de las inspecciones, no solo se ayuda a usted mismo; también ayuda a toda la humanidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490843
    m_Localized: 'Phone: Hola. Por favor espere mientras lo conectamos con un especialista de exorcismo de Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490844
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490845
    m_Localized: 'Phone: ¿Aló? ¿Con quién hablo?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490846
    m_Localized: ¿A qué te refieres?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490847
    m_Localized: ¿Por qué necesitas saber quién soy?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490848
    m_Localized: 'Phone: Vale, ya veo. Evadiste mi pregunta... El espíritu del Visitante ya ha comenzado a arraigarse en tu interior.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490849
    m_Localized: 'Phone: Ahora escucha con cuidado, no te queda mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490850
    m_Localized: 'Phone: Dime, ¿sueles dejar una rebanada de pan en la cocina?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490851
    m_Localized: ¿No? ¿Por qué iba a hacerlo?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490852
    m_Localized: ¿Una rebanada de pan?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490853
    m_Localized: 'Phone: Para ayudarme a expulsar el espíritu del Visitante que tienes dentro.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490854
    m_Localized: 'Phone: Vale, olvídalo. Escucha con cuidado, no te queda mucho tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490855
    m_Localized: 'Phone: Dime, ¿sueles dejar una rebanada de pan en la cocina?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490856
    m_Localized: ¿No? ¿Por qué iba a hacerlo?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490857
    m_Localized: ¿Una rebanada de pan?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490858
    m_Localized: 'Phone: Ah... Eso explica muchas cosas. No te llevas bien con el espíritu de tu casa.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490859
    m_Localized: 'Phone: Por eso vino el espíritu del Visitante. Pero no te preocupes. Podemos trabajar en ello.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490860
    m_Localized: 'Phone: ¿Tienes un ordenador personal en casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490861
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490862
    m_Localized: ¿Un qué personal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490863
    m_Localized: 'Phone: ¿No dejas ofrendas para el espíritu de la casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490864
    m_Localized: 'Phone: Con razón el espíritu Visitante se ha interesado por ti.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490865
    m_Localized: 'Phone: ¿Tienes un ordenador personal en casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490866
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490867
    m_Localized: ¿Un qué personal?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490868
    m_Localized: 'Phone: Así que usar Alt+F4 está descartado...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490869
    m_Localized: 'Phone: Vale, vale, cuéntame: ¿consumes setas?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490870
    m_Localized: Solo bebo un poco de kombucha ocasional.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490871
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490872
    m_Localized: 'Phone: ¿En serio no sabes lo que es un ordenador?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490873
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490874
    m_Localized: 'Phone: Vale, da igual. Sigamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490875
    m_Localized: Solo bebo un poco de kombucha ocasional
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490876
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490877
    m_Localized: 'Phone: Oh, no...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490878
    m_Localized: 'Phone: Tienes que dejar de tomar eso inmediatamente. El kombucha es un mal ancestral.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490879
    m_Localized: 'Phone: Hace que el micelio crezca en tu interior. Es por eso que el espíritu puede controlarte como a un muñeco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490880
    m_Localized: 'Phone: No te imaginas lo que hará si accede a tus recuerdos.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490881
    m_Localized: 'Phone: Puede borrarlos por completo... o leerlos una y otra vez, alterando tus decisiones.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490882
    m_Localized: 'Phone: ¿Y lo peor de todo? Ni siquiera te darás cuenta de que te están controlando.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490883
    m_Localized: 'Phone: Bien, una última pregunta: ¿se ha derramado sangre en tu casa?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490884
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490885
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490886
    m_Localized: 'Phone: Bueno. Entonces no lo bebas más. De lo contrario, al espíritu de un Visitante le resultará más fácil entrar a tu cuerpo.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490887
    m_Localized: 'Phone: Cuídate de beber kombucha, el micelio empieza a crecer en tu interior, tomando el control, como si fueras un muñeco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490888
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490889
    m_Localized: 'Phone: Fiu... no es fácil, no es nada fácil...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490890
    m_Localized: Sí
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490891
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490892
    m_Localized: 'Phone: Ah, con razón...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490893
    m_Localized: 'Phone: No es un Espíritu Visitante. Es un Espíritu Espectral. El alma de una persona muerta.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490894
    m_Localized: 'Phone: Me temo que la expulsión de espectros no es realmente mi especialidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490895
    m_Localized: 'Phone: Para eso, necesitarás a un exorcista. Ellos te ayudarán.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490896
    m_Localized: 'Phone: Me temo que no puedo hacer nada más. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490897
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490898
    m_Localized: 'Phone: Tu sesión de expulsión de Visitantes ha terminado. Gracias por usar nuestros servicios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490899
    m_Localized: 'Phone: Se cargará un coste por la consulta dentro de poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490900
    m_Localized: ¿Un coste?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490901
    m_Localized: Pensé que esta llamada era gratuita
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490903
    m_Localized: 'Phone: Ah, qué lástima. Me temo que no puedo identificar este tipo de espíritu entonces. Y si no sé qué tipo de espíritu es, no hay nada que pueda hacer para ayudarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490904
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490905
    m_Localized: 'Phone: Lamentablemente, debemos dar por terminada esta sesión.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490906
    m_Localized: 'Phone: Mantente fuerte y... adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490907
    m_Localized: 'Phone: Tu sesión de expulsión de Visitantes ha terminado. Gracias por usar nuestros servicios.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490908
    m_Localized: 'Phone: Se cargará un coste por la consulta dentro de poco.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490909
    m_Localized: ¿Un coste?
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490910
    m_Localized: Pensé que esta llamada era gratuita
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490911
    m_Localized: 'Phone: Así es. Nuestros especialistas en extracción de Visitantes también necesitan ganarse la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490912
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490913
    m_Localized: 'Phone: ¿Cómo calificarías tu experiencia de hoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576165490914
    m_Localized: ¡Le doy cinco estrelleas!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684992
    m_Localized: Un buen uno de diez
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684993
    m_Localized: Que os den, estafadores de mierda.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684994
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684995
    m_Localized: 'Phone: Si miró el anuncio con detenimiento se habrá percatado de que la letra chica menciona que la primera llamada incluye un coste.'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684996
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684997
    m_Localized: 'Phone: ¿Cómo calificarías tu experiencia de hoy?'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684998
    m_Localized: ¡Le doy cinco estrelleas!
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169684999
    m_Localized: Un buen uno de diez
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685000
    m_Localized: Que os den, estafadores de mierda.
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685001
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685002
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 40147576169685003
    m_Localized: 'Phone: Gracias. Tu opinión es muy importante para nosotros. Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610048
    m_Localized: 'TV: Eso es todo por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610049
    m_Localized: 'TV: Consigue tu comida a domicilio con For Rest. Llama ya al {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610050
    m_Localized: 'TV: Buenas tardes. Bienvenidos al noticiario.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610051
    m_Localized: 'TV: A pesar de los incendios, los Visitantes siguen aterrorizando a la nación.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610052
    m_Localized: 'TV: La AFAE ha anunciado una nueva señal para asistir al público en su lucha contra los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 41583254820610053
    m_Localized: 'TV: A continuación: un informe especial sobre la naturaleza de los Visitantes.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113249218560
    m_Localized: 'Phone: ¿Eh? Sí, ¿diga?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995776
    m_Localized: Tu mujer me ha dado este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995777
    m_Localized: Tu mujer necesita ayuda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995778
    m_Localized: 'Phone: Ajá. ¿Y?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995779
    m_Localized: Ha perdido a todos los niños
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995780
    m_Localized: ¿Están contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995781
    m_Localized: 'Phone: Lo de siempre, vaya. Y siempre soy yo el que tiene que limpiar el desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995782
    m_Localized: 'Phone: Se queda ahí sentada y suelta, "Ay, estoy tan cansada."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995783
    m_Localized: 'Phone: Nada nuevo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995784
    m_Localized: Ha perdido a todos los niños
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995785
    m_Localized: ¿Están contigo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995786
    m_Localized: 'Phone: Ahhh, claro. Sus propios hijos le dan igual.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995787
    m_Localized: 'Phone: Y ahora soy yo el que tiene que limpiar el desastre.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995788
    m_Localized: 'Phone: ¿Habéis mirado en casa de su madre?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995789
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995790
    m_Localized: 'Phone: ¿Tal vez podrías venir a por ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995791
    m_Localized: 'Phone: No. ¿No están con ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995792
    m_Localized: 'Phone: No me sorprende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995793
    m_Localized: 'Phone: ¿Habéis mirado en casa de su madre?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995794
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995795
    m_Localized: ¿Tal vez podrías venir a por ella?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995796
    m_Localized: 'Phone: Ajá.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995797
    m_Localized: 'Phone: Bueno, puede que estén ahí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995798
    m_Localized: 'Phone: No voy a ir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995799
    m_Localized: 'Phone: Que ella se apañe. Pregúntale qué clase de madre pierde a sus propios hijos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995800
    m_Localized: Apañaos vosotros dos
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995801
    m_Localized: En cualquier caso, le diré que sigues vivo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995802
    m_Localized: 'Phone: Déjala que vaya sola, que no es ninguna princesita.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995803
    m_Localized: 'Phone: Tiene dos piernas, ¿no? ¿Entonces, cuál es el problema?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995804
    m_Localized: Apañaos vosotros dos
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995805
    m_Localized: En cualquier caso, le diré que sigues vivo
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995806
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995807
    m_Localized: 'Phone: ¿Y por qué has llamado, entonces? ¿Para salvar a una pobre damisela en apuros?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995808
    m_Localized: 'Phone: Haced lo que os dé la gana por ahí. A esa zorra le da lo mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995809
    m_Localized: 'Phone: Déjame en paz de una puñetera vez, coño.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995810
    m_Localized: 'Phone: En cualquier caso, le diré que sigues vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995811
    m_Localized: 'Phone: Ni te molestes. ¿Qué sentido tiene?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995812
    m_Localized: 'Phone: Nos importamos una mierda el uno al otro.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995813
    m_Localized: 'Phone: No tengo ni idea de por qué te involucras.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995814
    m_Localized: 'Phone: En fin... cuidaos, vosotros dos. Espero que tengáis una vida maravillosa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995815
    m_Localized: 'Phone: ¿Crees en la Muerte?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995816
    m_Localized: Tu marido me ha pedido que te llame
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995817
    m_Localized: Vayamos al grano. Esto es sobre tu marido
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995818
    m_Localized: 'Phone: ¿Qué? ¿Mi marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995819
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995820
    m_Localized: 'Phone: Después de todo lo que ha hecho... no quiero oír ni una palabra sobre él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995821
    m_Localized: Quería que te dijera que lamenta lo que pasó
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995822
    m_Localized: Quería que te dijera que te fueras a la mierda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995823
    m_Localized: 'Phone: ¿Mi marido?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995824
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995825
    m_Localized: 'Phone: Después de todo lo que ha hecho... no quiero oír ni una palabra sobre él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995826
    m_Localized: Quería que te dijera que lamenta lo que pasó
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995827
    m_Localized: Quería que te dijera que te fueras a la mierda
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995828
    m_Localized: 'Phone: Já. ¿Lo lamenta?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995829
    m_Localized: 'Phone: ¿En serio? ¿Otra vez?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995830
    m_Localized: 'Phone: Ya le ha pedido a otros que se disculpen por él.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995831
    m_Localized: 'Phone: ¿Quieres saber por qué no me puede llamar él mismo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995832
    m_Localized: 'Phone: Porque le faltan los huevos para enfrentar lo que hizo. Para aceptarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995833
    m_Localized: 'Phone: Todavía espera poder arreglarlo todo, de volver a lo de antes. Pero así no es la vida. Nadie puede dar marcha atrás al tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995834
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995835
    m_Localized: 'Phone: Estoy mejor ahora. Estoy con gente que me entiende.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995836
    m_Localized: ¿De verdad crees que un grupo de fanáticos locos te entiende?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995837
    m_Localized: ¿Por qué te uniste a un culto?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995838
    m_Localized: Si tú lo dices
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995839
    m_Localized: 'Phone: Llámales como quieras. Ellos son mi familia ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995840
    m_Localized: 'Phone: Compartimos la misma creencia. Sabemos que la Muerte llegará muy pronto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995841
    m_Localized: 'Phone: Y que no traerá dolor, sino paz.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995842
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995843
    m_Localized: 'Phone: Cuídate'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995844
    m_Localized: 'Phone: Compartimos la misma creencia sobre lo que está por venir: la llegada de la Muerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995845
    m_Localized: 'Phone: Quizá te suene extraño, pero la Muerte no trae pena, sino felicidad.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995846
    m_Localized: 'Phone: Es la felicidad en la paz y el fin del sufrimiento. Estoy segura de que tú también has pasado por tus propias dificultades.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995847
    m_Localized: 'Phone: Tal vez un día llegues a comprender y veas las cosas como nosotros.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995848
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995849
    m_Localized: 'Phone: Cuídate'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995850
    m_Localized: 'Phone: Gracias por entender.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995851
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995852
    m_Localized: 'Phone: Cuídate'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995853
    m_Localized: 'Phone: ¿Hola? ¿Quién es?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995854
    m_Localized: Hola. Tu hermano me ha dado tu número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995855
    m_Localized: Llamo de parte de hermano
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995856
    m_Localized: 'Phone: ¿Qué hermano? Si yo ni...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995857
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995858
    m_Localized: 'Phone: Ah, te refieres al hijo de mi padre, ¿verdad?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995859
    m_Localized: 'Phone: Pero, un momento... ¿Quién eres tú? ¿Y por qué está contigo?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995860
    m_Localized: Sus padres han desaparecido
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995861
    m_Localized: Ha venido a mi casa buscando refugio
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995862
    m_Localized: 'Phone: ¿Han desaparecido? ¿Cómo ha pasado eso?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995863
    m_Localized: 'Phone: No querrás decir que ellos...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995864
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995865
    m_Localized: 'Phone: Joder... Esto no puede ser verdad... ¿Están muertos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995866
    m_Localized: No lo sé
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995867
    m_Localized: Es lo más seguro
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995868
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995869
    m_Localized: 'Phone: ¿Buscando refugio? Pero él vive con sus padres, ¿no?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995870
    m_Localized: 'Phone: No... No me digas... ¿Podría ser que ellos...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995871
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995872
    m_Localized: 'Phone: Joder... Esto no puede ser verdad... ¿Están muertos?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995873
    m_Localized: No lo sé
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995874
    m_Localized: Es lo más seguro
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995875
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995876
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995877
    m_Localized: 'Phone: Dios... ¿Cómo ha pasado esto...?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995878
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995879
    m_Localized: 'Phone: Puedo recibirle en mi casa. Díselo. Sabe dónde vivo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995880
    m_Localized: 'Phone: Y... gracias por ayudarle.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995881
    m_Localized: 'Phone: Hasta luego.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995882
    m_Localized: 'Phone: ¿Sí? ¿Quién es?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995883
    m_Localized: Tu esposa y su hermana están en mi casa
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995884
    m_Localized: Tu mujer me dio este número
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995885
    m_Localized: 'Phone: Suenas como si estuvieras pidiendo un rescate.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995886
    m_Localized: 'Phone: Me temo que no me queda nada más que ofrecer.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995887
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995888
    m_Localized: 'Phone: Y pronto no quedará nadie tampoco.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995889
    m_Localized: ¿Qué quieres decir? ¿Qué te ocurre?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995890
    m_Localized: Tu mujer está bien
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995891
    m_Localized: 'Phone: Por favor, dime que se encuentra bien.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995892
    m_Localized: 'Phone: Es fuerte, se las apañará para superar cualquier cosa. ¡Incluso ayudará a quien pueda por el camino!'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995893
    m_Localized: 'Phone: Pero creo que ya no hay nada que hacer por mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995894
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995895
    m_Localized: 'Phone: No estaré por aquí mucho más tiempo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995896
    m_Localized: ¿Qué quieres decir? ¿Qué te ocurre?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995897
    m_Localized: Tu mujer está bien
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995898
    m_Localized: 'Phone: Yo... ya no puedo más. El sol, los Visitantes, la gente ha perdido la cabeza. Es demasiado aterrador. Me siento paralizado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995899
    m_Localized: 'Phone: Yo... solo quiero que esto se acabe y me queda una única salida... ¿entiendes?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995900
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995901
    m_Localized: 'Phone: Por favor, dile que la amo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995902
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995903
    m_Localized: 'Phone: De hecho... no le digas nada. Solo asegúrate de que no me venga a buscar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995904
    m_Localized: 'Phone: No quiero que sepa que no me la llevé conmigo...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995905
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995906
    m_Localized: 'Phone: Gracias por llamar. Y por escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995907
    m_Localized: 'Phone: Adiós...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995908
    m_Localized: 'Phone: Seguramente se está aferrando a su hermana. Nunca supo cómo dejarla ir...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995909
    m_Localized: 'Phone: Qué desafortunada es, rodeada solo de gente débil. Por eso elegí dejarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995910
    m_Localized: 'Phone: Se ha comunicado con Admisiones de la AFAE. ¿En qué puedo ayudarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995911
    m_Localized: Aquí hay una tía, la esposa de un oficial de la AFAE
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995912
    m_Localized: Una altruista que quiere unirse a vuestras filas
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995913
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995914
    m_Localized: 'Phone: Vale, ¿cuál es tu pregunta? Aún no tengo claro cómo ayudarte.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995915
    m_Localized: 'Phone: Siempre y cuando esto no sea una amenaza.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995916
    m_Localized: Sí... es una amenaza
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995917
    m_Localized: Quiere trabajar para vosotros. Antes trabajaba en la frontera
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995918
    m_Localized: 'Phone: (Escuchas a la otra persona suspirar con fuerza)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995919
    m_Localized: 'Phone: Eres de esos activistas, ¿no? Que siempre os quejáis de algo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995920
    m_Localized: 'Phone: No nos hagas perder el tiempo. Alguien que de verdad necesita ayuda estará intentando contactar ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995921
    m_Localized: 'Phone: Podría haber Visitantes entrando en algún lugar. O algo peor. Podría haber gente muriendo por tu culpa.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995922
    m_Localized: 'Phone: Adiós'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995923
    m_Localized: 'Phone: Mmm. Ella debería saber que el trabajo... no es fácil. ¿Realmente está lista para ello?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995924
    m_Localized: 'Phone: Si es así, dile que rellene el Formulario 31-G por triplicado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995925
    m_Localized: 'Phone: Después tiene que pasar la revisión médica... Luego, rellenar...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995926
    m_Localized: 'Phone: (Cuelgas. ¿Para qué te has molestado en llamar por esta mujer?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995927
    m_Localized: 'Phone: ¿Qué puesto está solicitando? No me digas que quiere ser directora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995928
    m_Localized: 'Phone: Con esta, ya van tres hoy.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995929
    m_Localized: Para directora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995930
    m_Localized: Rastreadora. O algún tipo de exploradora
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995931
    m_Localized: 'Phone: Estoy hasta los cojones de estas llamadas de broma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995932
    m_Localized: 'Phone: Cuando llaman para estas gilipolleces hay alguien más que no puede contactar. Tal vez alguien esté muriendo a manos de los Visitantes ahora mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995933
    m_Localized: 'Phone: Asume la responsabilidad de tu estúpida e inapropiada broma.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995934
    m_Localized: 'Phone: (Han colgado. ¿En serio?)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995935
    m_Localized: 'Phone: No tenemos vacantes así. Lo que de verdad necesitamos son expertos en epidemias y científicos cualificados.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995936
    m_Localized: 'Phone: Tu amiga no parece una buena candidata.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995937
    m_Localized: 'Phone: ¿Pero sabes qué? Las cosas están cambiando muy rápido. Intenta de nuevo en una semana.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995938
    m_Localized: 'Phone: Seguro habrá un puesto para... ¿cómo la has llamado? Una altruista.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995939
    m_Localized: 'Phone: Estructura de una manzana: la supermanzana, la tierra de las setas y el papel.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995940
    m_Localized: 'Phone: Teme la... tie... de las set...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995941
    m_Localized: 'Phone: Aunque son tan... encanta la...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995942
    m_Localized: 'Phone: Ahí...  encontra...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995943
    m_Localized: 'Phone: Solo lágrimas y la condena del adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995944
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995945
    m_Localized: 'Phone: Comprueba su respiración.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995946
    m_Localized: 'Phone: ¿Por qué no me contestas? Deseo morir.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995947
    m_Localized: 'Phone: (Cuelgan. Eso no era... exactamente lo que esperabas)'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995948
    m_Localized: 'Phone: Por favor, tenga en cuenta que ahora mismo no se puede llegar a nuestro país en avión ni en tren.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995949
    m_Localized: 'Phone: ¿En qué puedo ayudarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995950
    m_Localized: Necesito enviar a un turista de vuelta a su país
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995951
    m_Localized: ¿Por qué no puede coger el tren?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995952
    m_Localized: 'Phone: Lo más conveniente es esperar a que los vuelos se reanuden.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995953
    m_Localized: 'Phone: Los ferris sí están funcionando, pero no es seguro, el riesgo de tifones nocturnos es demasiado alto.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995954
    m_Localized: 'Phone: Además, el agua refleja el sol en las embarcaciones por lo que una tripulación no podría aguantar mucho tiempo allá afuera.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995955
    m_Localized: ¿Cómo se supone que envíe a este pobre tío a su país?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995956
    m_Localized: Está viviendo conmigo ahora. ¿Quizás podríais recibirlo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995957
    m_Localized: 'Phone: Los raíles se han dilatado por el calor, es demasiado peligroso que los trenes circulen de día.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995958
    m_Localized: 'Phone: Los trenes solo circulan por la noche, así que no puede llegar muy lejos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995959
    m_Localized: 'Phone: Demasiados transbordos. Lo mejor es mejor esperar a que se reanuden los viajes en avión.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995960
    m_Localized: ¿Cómo se supone que envíe a este pobre tío a su país?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995961
    m_Localized: Está viviendo conmigo ahora. ¿Quizás podríais recibirlo?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995962
    m_Localized: 'Phone: Simplemente espere.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995963
    m_Localized: 'Phone: No hay nada más que podamos hacer por ahora.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995964
    m_Localized: Ni siquiera habla mi idioma...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995965
    m_Localized: ¿Para qué coño servís si no podéis hacer nada?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995966
    m_Localized: 'Phone: No contamos con ningún hotel en el que pueda quedarse.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995967
    m_Localized: 'Phone: No hay nada que podamos hacer. Estamos tratando de solucionar el problema, él no es el único atrapado así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995968
    m_Localized: Ni siquiera habla mi idioma...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995969
    m_Localized: ¿Para qué coño servís si no podéis hacer nada?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995970
    m_Localized: 'Phone: Todo nuestro personal está a tope. Quizá ya lo haya oído, pero los gastos de las embajadas se han ajustado mucho.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995971
    m_Localized: 'Phone: Estamos haciendo todo lo que podemos.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995972
    m_Localized: Oh, vaya, sí que sois unos héroes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995973
    m_Localized: Holgazanes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995974
    m_Localized: 'Phone: No hace falta que hable así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995975
    m_Localized: 'Phone: No podemos llevarlo a cuestas hasta su casa. Si quieres ayudar, tienes que hacerlo tú mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995976
    m_Localized: 'Phone: Los presupuestos se redujeron tanto que, en esencia, solo trabajamos por las ganas.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995977
    m_Localized: Oh, vaya, sí que sois unos héroes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995978
    m_Localized: Holgazanes
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995979
    m_Localized: 'Phone: ¿No te gusta cómo gestionamos las cosas? Ocúpate tú mismo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995980
    m_Localized: 'Phone: Buena suerte cruzando la frontera con esos chequeos de Visitantes y el calor de mediodía.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995981
    m_Localized: Vale, gracias
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995982
    m_Localized: Que te den
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995983
    m_Localized: 'Phone: Entonces, ¿por qué te quedas en casa en vez de ir a trabajar?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995984
    m_Localized: 'Phone: O, mejor aún, ¿por qué no vienes y nos muestras cómo se hace?'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995985
    m_Localized: 'Phone: Nos encantaría la ayuda de alguien que lo sabe todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995986
    m_Localized: Vale, gracias
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995987
    m_Localized: Que te den
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995988
    m_Localized: 'Phone: Perdona por haber reaccionado así.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995989
    m_Localized: 'Phone: No eres el primero en... llamar tan cabreado.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995990
    m_Localized: 'Phone: Que tengas un buen día.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995991
    m_Localized: 'Phone: Buen viaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995992
    m_Localized: 'Phone: De verdad, espero que algún día te dé el gusanillo de viajar.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995993
    m_Localized: 'Phone: En ese caso, te ayudaré sin falta.'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995994
    m_Localized: Una ventana a otra habitación. La gente solía hacer eso para ahorrar electricidad y que la luz de una habitación se filtrara a la otra.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995995
    m_Localized: Luego la sellaron... pero solo por ese lado.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995996
    m_Localized: No, ya no miro para allá. No desde aquello.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995997
    m_Localized: Odio dormir junto a la mesilla de noche. Demasiados malos recuerdos...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995998
    m_Localized: No sé por qué no la han puesto en la esquina. Pensé que esa era la norma.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265995999
    m_Localized: Aunque, pensándolo bien... A mi padre las reglas le daban igual.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996000
    m_Localized: Toto. El único juguete que tuve de niño.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996001
    m_Localized: Bueno... salvo los palos con los que golpeábamos la hierba.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996002
    m_Localized: Je. La abuela atiborraba todos los armarios con puros platos.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996003
    m_Localized: Solo sacaba la vajilla de gala para las fiestas. Ahora... ¿quién cojones la necesita?
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996004
    m_Localized: Sinceramente, estoy mejor solo en casa.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996005
    m_Localized: Incluso puedes hablar en voz alta contigo mismo.
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996006
    m_Localized: Una de esas revistas en las tienes que encontrar a alguien en oculto entre la multitud...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996007
    m_Localized: ¿Y eso para qué coño? Me gustaría que me dejaran tranquilo de una vez...
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996008
    m_Localized: 'Él me dijo por aquel entonces: "Cuando yo no esté, tú decides si quieres abrir o no esa caja."'
    m_Metadata:
      m_Items: []
  - m_Id: 43887113265996009
    m_Localized: Llevo quince años decidiendo si hacerlo o no. Todavía no lo tengo claro.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295719612416
    m_Localized: ¿Te sientes solo?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583936
    m_Localized: ¿No tienes nadie con quien hablar? ¿Estás ansioso?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583937
    m_Localized: Phone Roulette es justo lo que necesitas.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583938
    m_Localized: Llama ahora al 891-533, y te conectaremos con el compañero de conversación ideal para ti.
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583939
    m_Localized: ¿Está bien tu hija?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583940
    m_Localized: ¿Quién los ha matado?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583941
    m_Localized: Ten cuidado (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583942
    m_Localized: ¿Está bien tu hija?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583943
    m_Localized: ¿Quién los ha matado?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583944
    m_Localized: Ten cuidado (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583945
    m_Localized: ¿A dónde se llevaron a tu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583946
    m_Localized: Es bueno que no se llevaran a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583947
    m_Localized: ¿Y qué es la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583948
    m_Localized: Cuídate (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583949
    m_Localized: ¿A dónde se llevaron a tu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583950
    m_Localized: Es bueno que no se llevaran a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583951
    m_Localized: ¿Y qué es la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583952
    m_Localized: Cuídate (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583953
    m_Localized: ¿A dónde se llevaron a tu inquilino?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583954
    m_Localized: Es bueno que no se llevaran a tu hija
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583955
    m_Localized: ¿Y qué es la AFAE?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583956
    m_Localized: Cuídate (Termina la llamada)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583957
    m_Localized: 'Phone: Saludos, se ha comunicado con la línea directa de la AFAE. ¿Cómo puedo ayudarle?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583958
    m_Localized: ¿Eh? ¿La AFAE? ¿Qué es eso?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583959
    m_Localized: ¿De qué habla?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583960
    m_Localized: 'Phone: (Antes de que ella pueda terminar, un grito masculino se cuela en la llamada)'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583961
    m_Localized: 'Phone: ¿¡ACASO ERES GILIPOLLAS!? ¡CUELGA LA LLAMADA INMEDIATAMENTE!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583962
    m_Localized: ¿Qué debo hacer con las axilas?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583963
    m_Localized: ¿Qué debo hacer con los oídos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583964
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583965
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583966
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583967
    m_Localized: 'Phone: Para asegurar que la inspección bajo las axilas sea fiable, debe evitar el contacto con agua.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583968
    m_Localized: 'Phone: Absténgase de ducharse y lavarse las manos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583969
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583970
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583971
    m_Localized: 'Phone: ¿Oídos? Espere...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583972
    m_Localized: 'Phone: Le hablaremos a nuestra directiva y le llamaremos después.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583973
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583974
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583975
    m_Localized: 'Phone: Ahora por favor responda: ¿consume usted setas?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583976
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583977
    m_Localized: 'Phone: Bien, una última pregunta: ¿se ha derramado sangre su hogar?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583978
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295740583979
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778240
    m_Localized: 'Phone: Hola. te has comunicado con Phone Roulette. Te conectaremos con un compañero de coversación perfecto para ti lo antes posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778241
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778242
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778243
    m_Localized: 'Phone: Eh, hola.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778244
    m_Localized: Hola
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778245
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778246
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778247
    m_Localized: 'Phone: ¿Hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778248
    m_Localized: Hola
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778249
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778250
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778251
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778252
    m_Localized: 'Phone: Me parece que no hay nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778253
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778254
    m_Localized: 'Phone: Yo... Tengo que hablar con alguien. Ha pasado tanto estos días...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778255
    m_Localized: 'Phone: He tratado de hablar con amigos y gente que conozco, pero nadie atiende mis llamadas...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778256
    m_Localized: 'Phone: Pero entonces descubrí Phone Roulette.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778257
    m_Localized: 'Phone: Quizás no sea el mejor lugar para desahogarte, pero es mejor que no tener nada.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778258
    m_Localized: 'Phone: Sé que no está bien cargar a un desconocido con mis problemas, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778259
    m_Localized: 'Phone: No tienes idea de cuánto me ayudaría conversar con alguien más. Me sentiría mucho... mejor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778260
    m_Localized: 'Phone: ¿Es mucho problema si te cuento?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778261
    m_Localized: Vale
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778262
    m_Localized: No estoy como para una conversación muy larga
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778263
    m_Localized: 'Phone: Oh...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778264
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778265
    m_Localized: 'Phone: De acuerdo, discupa que te haya molestado.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778266
    m_Localized: 'Phone: Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778267
    m_Localized: 'Phone: Te agradezco mucho. ¡Gracias!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778268
    m_Localized: 'Phone: Creo que será más fácil de entender si te cuento un poco acerca de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778269
    m_Localized: 'Phone: ¿Qué te gustaría saber?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778270
    m_Localized: ¿Dónde vives?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778271
    m_Localized: ¿Por qué decidiste hablar por aquí en lugar de llamar a tus amigos?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778272
    m_Localized: 'Phone: Lejos de casa, tristemente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778273
    m_Localized: 'Phone: Trataba de escapar de casa, así que busqué el lugar más frío posible.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778274
    m_Localized: 'Phone: Estoy en medio de la nada. Hace tanto frío que se te mete en los huesos. No crece casi nada, ni siquiera hierba.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778275
    m_Localized: 'Phone: Un sitio relativamente seguro, lejos de todo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778276
    m_Localized: 'Phone: Pero si el noveno círculo del infierno es frío, entonces quizás este lugar no sea tan malo en comparación.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778277
    m_Localized: 'Phone: Es irónico, antes odiaba el frío, pero ahora... hasta se siente como una bendición.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778278
    m_Localized: 'Phone: Quiero pensar que el sol disminuirá su calor y esta pesadilla llegará a su fin.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778279
    m_Localized: 'Phone: Pero estoy perdiendo la fe en que todo esto acabe. ¿Qué sucederá cuando el sol regrese a la normalidad?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778280
    m_Localized: 'Phone: Es probable que los Visitantes no desaparezcan. Podrían reemplazar a nuestros seres queridos y no nos daríamos cuenta.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778281
    m_Localized: ¿Por qué te fuiste sola?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778282
    m_Localized: ¿Extrañas tu ciudad?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778283
    m_Localized: 'Phone: Adoraría llamarles, pero... No sé como localizarlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778284
    m_Localized: 'Phone: La cosa es, que cuando el cataclismo comenzó, yo decidí dejar mi ciudad. Me alejé tanto como pude del calor.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778285
    m_Localized: 'Phone: Prometí que les llamaría con regularidad, que preguntaría qué tal está cada uno...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778286
    m_Localized: 'Phone: Pero cuando llegué no pude contactar a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778287
    m_Localized: 'Phone: Después supe la razón: a todos les habían cortado sus teléfonos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778288
    m_Localized: 'Phone: Esa ciudad fue excluida del resto del mundo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778289
    m_Localized: 'Phone: Ahora me encuentró aquí, en un sitio seguro, pero mis seres queridos...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778290
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778291
    m_Localized: 'Phone: Pensar en no volver a ver a mis seres queridos me aterra.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778292
    m_Localized: 'Phone: Extraño los días en paz, cuando la vida era sencilla y sabías que siempre habría un mañana.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778293
    m_Localized: ¿Por qué fuiste sola?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778294
    m_Localized: ¿Extrañas tu ciudad?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778295
    m_Localized: 'Phone: No quería hacerlo, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778296
    m_Localized: 'Phone: En realidad, mi mejor amigo quería venir conmigo, pero no pudo...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778297
    m_Localized: 'Phone: No tenía sus documentos necesarios para viajar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778298
    m_Localized: 'Phone: Y cuando el cataclismo comenzó, no le fue posible conseguirlos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778299
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778300
    m_Localized: 'Phone: Él se puso muy mal... Lamentaba no haberlos conseguido antes. Quería ayudarle pero no supe qué hacer.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778301
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778302
    m_Localized: 'Phone: Los extraño. No tanto a la ciudad como a la gente que vivía en ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778303
    m_Localized: 'Phone: A mi mejor amigo más que a nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778304
    m_Localized: 'Phone: El quería acompañarme, pero no fue posible. Y yo prometer mantener el contacto, pero...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778305
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778306
    m_Localized: 'Phone: Creo que estaba enamorado de mí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778307
    m_Localized: 'Phone: Se preocupaba mucho por mí. Siempre me apoyó, y me escuchó.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778308
    m_Localized: 'Phone: Y entonces noté que los dos nos gustábamos.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778309
    m_Localized: 'Phone: Esperé que me confesara sus sentimientos. Quería que él diera el primer paso. Pero no lo hizo. Supongo que no pudo encontrar el momento indicado para hacerlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778310
    m_Localized: 'Phone: Y entonces, esta pesadilla comenzó y no hubo el tiempo para eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778311
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778312
    m_Localized: 'Phone: Lamento no haberle dicho primero.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778313
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778314
    m_Localized: 'Phone: Bueno, ya sabes algo de mí. Es tu turno.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778315
    m_Localized: No acostumbro hablar de mí mismo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778316
    m_Localized: Ni idea de lo que podría decir...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778317
    m_Localized: 'Phone: No sientas pena. Estoy lista para escuchar.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778318
    m_Localized: Pues... No tengo a nadie cercano
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778319
    m_Localized: Me siento... solo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295744778320
    m_Localized: 'Phone: No te cortes. No es malo que hables de tí.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972544
    m_Localized: Pues... No tengo a nadie cercano
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972545
    m_Localized: Me siento... solo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972546
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972547
    m_Localized: La... relación con mi padre era complicada
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972548
    m_Localized: Es que... odiaba a mi padre
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972549
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972550
    m_Localized: Ya no formo parte de la familia
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972551
    m_Localized: Y un día, ya no fui más su hijo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972555
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972556
    m_Localized: Lo único que tengo es esta maldita casa
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972557
    m_Localized: Ahora todo lo que queda de ellos es esta casa
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972558
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972559
    m_Localized: 'Phone: Lo siento... No suenas muy contento con que la casa terminase contigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972560
    m_Localized: Es verdad
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972561
    m_Localized: Habría sido mejor que se quemara
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972562
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972563
    m_Localized: 'Phone: No... No alcanzo a imaginar lo que has vivido.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972564
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972565
    m_Localized: 'Phone: No imagino cuanto odias a tu padre si quieres que la casa se queme.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972566
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972567
    m_Localized: 'Phone: Gracias de nuevo por conversar conmigo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972568
    m_Localized: 'Phone: Adiós. Mantente fuerte.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972569
    m_Localized: 'Phone: ¿Hola?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972570
    m_Localized: Hola, ¿me permites hablar con tu hija?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972571
    m_Localized: Hola, ¿está bien si tu hija viene a jugar con su amiga?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972572
    m_Localized: 'Phone: ¿Qué? ¿Por qué quieres hablar con ella?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972573
    m_Localized: Aquí, su amiga preguntó si podía venir
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972574
    m_Localized: Hay una chiquilla aquí... su padre murió
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972575
    m_Localized: 'Phone: ¿Acaso era él... un... Visitante también?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972576
    m_Localized: ¿A qué te refieres con "también"?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972577
    m_Localized: No, unos capullos lo quemaron vivo sin motivo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972578
    m_Localized: 'Phone: Nadie quema personas sin razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972579
    m_Localized: 'Phone: Así que era un visitante... Justo como uestra chiquilla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972580
    m_Localized: 'Phone: Ellos también la quemaron.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972581
    m_Localized: 'Phone: Justo ahí, en el kínder.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972582
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972583
    m_Localized: 'Phone: Al principio lloré. Quería quitarme la vida. No podía vivir sin ella.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972584
    m_Localized: 'Phone: Pero mi esposo me ayudó a superarlo.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972585
    m_Localized: 'Phone: Y tú también vas a superarlo... y también esa nena.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972586
    m_Localized: 'Phone: Tú entiendes...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972587
    m_Localized: 'Phone: Nada pasa sin razón.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972588
    m_Localized: 'Phone: Si quemaron a su padre, tenía que suceder.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972589
    m_Localized: 'Phone: Y llorar por eso no eso no será de ayuda.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972590
    m_Localized: 'Phone: Por favor... dile eso.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972591
    m_Localized: 'Phone: Adiós.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972592
    m_Localized: 'Phone: Nuestra niña... Ella...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972593
    m_Localized: 'Phone: Ha muerto...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972594
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972595
    m_Localized: 'Phone: Tuvimos que...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972596
    m_Localized: 'Phone: Tuvimos que matarla.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972597
    m_Localized: ¿Qué?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972598
    m_Localized: (Cuelga)
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972599
    m_Localized: 'Phone: Tuvimos que matarla. Créeme. Fue necesario.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972600
    m_Localized: 'Phone: Tenía todas las señales... y mi esposo insistió.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972601
    m_Localized: ¿Decidieron... matar a su propia hija?
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972602
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972603
    m_Localized: 'Phone: ¡No me juzgues!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972604
    m_Localized: 'Phone: ¡Era una Visitante! ¡Tenía todas las señales!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972605
    m_Localized: Joder...
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972606
    m_Localized: Entiendo
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972607
    m_Localized: 'Phone: Era una Visitante.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972608
    m_Localized: 'Phone: Tenía todas las características.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972609
    m_Localized: 'Phone: Yo la conocía mejor que nadie.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972610
    m_Localized: 'Phone: Por eso lo noté inmediatamente.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972611
    m_Localized: 'Phone: Todo coincidía.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972612
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972613
    m_Localized: 'Phone: Tan pronto como le dije a mis esposo, él...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972614
    m_Localized: 'Phone: Se encargó del Visitante de una vez por todas.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972615
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972616
    m_Localized: 'Phone: Al principio quería quitarme la vida.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972617
    m_Localized: 'Phone: Pero luego entendí... que en realidad no era nuestra hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972618
    m_Localized: 'Phone: Me esposo me ayudó a comprender.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972619
    m_Localized: 'Phone: Ahora solo lamento que no le preguntáramos a la Visitante lo que le hizo a nuestra hija.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972620
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972621
    m_Localized: 'Phone: Lo siento.'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972622
    m_Localized: 'Phone: No vuelvas a llamar...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972623
    m_Localized: 'Phone: Por favor...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972624
    m_Localized: 'Phone: ¿Qué hago dándo dándole explicaciones?'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972625
    m_Localized: 'Phone: ¡Que te den!'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972626
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972627
    m_Localized: 'Phone: Todavía la extraño...'
    m_Metadata:
      m_Items: []
  - m_Id: 48219295748972628
    m_Localized: 'Phone: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096192
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096193
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096194
    m_Localized: 'TV: ...'
    m_Metadata:
      m_Items: []
  - m_Id: 53574325721096195
    m_Localized: 'TV: Ahora: un reportaje sobre la suspensión temporal de entierros y cremaciones de difuntos.'
    m_Metadata:
      m_Items: []
  - m_Id: 58690054376120320
    m_Localized: 'TV: Consigue tu comida a domicilio con For Rest. Llama ya al {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 58231803335401472
    m_Localized: Dos latas de comida para gatos, por favor.
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790080
    m_Localized: Un paquete de cigarrillos, por favor.
    m_Metadata:
      m_Items: []
  - m_Id: 58231803343790081
    m_Localized: Un tarro de kombucha, por favor.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
