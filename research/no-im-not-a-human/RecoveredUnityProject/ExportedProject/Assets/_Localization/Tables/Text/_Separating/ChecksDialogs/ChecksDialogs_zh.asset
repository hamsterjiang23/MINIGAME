%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: ChecksDialogs_zh
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: zh
  m_SharedData: {fileID: 11400000, guid: 1290f85681bd44940af0abf2b1b05504, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 21377490604032
    m_Localized: 'Firefighter: *咳*没问题。我也没什么好藏的，身上能烧的零件早就烧得差不多了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769856
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769857
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769858
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769859
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769860
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769861
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769862
    m_Localized: 'Firefighter: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769863
    m_Localized: 'Firefighter: 你别*咳*别太苛刻，烟雾可不是什么好牙医。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769864
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769865
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769866
    m_Localized: 'Firefighter: 来，看吧……*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769867
    m_Localized: 'Firefighter: 跟两根烧焦的木头似的，不过指甲倒是干净。挺讽刺的，是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769868
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769869
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769870
    m_Localized: 'Firefighter: 没问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769871
    m_Localized: 'Firefighter: 看见了没？*咳*红得像点着的炭块。都是烟熏出来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769872
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769873
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769874
    m_Localized: 'Firefighter: 确定要看？看了可能会让人不太舒服。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769875
    m_Localized: 'Firefighter: 身上能烧的都烧得差不多了……我身上的皮都裂开了，跟老树的树皮一样。我没必要都尽量不抬胳膊。太疼了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769876
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769877
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769878
    m_Localized: 'Firefighter: 没问题，拍吧，拍出来的准是一具林子里的焦尸。拍几次都是这样。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769879
    m_Localized: 'Firefighter: 你喜欢吗？*咳*'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769880
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769881
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769882
    m_Localized: 'Firefighter: 简单的很，看吧。都烧到软骨了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769883
    m_Localized: 'Firefighter: 我这听力也快完蛋了，可能也算是件好事吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769884
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769885
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769886
    m_Localized: 'Firefighter: 开枪吧。别照着牙齿开就行，我这一嘴的牙本来也没几天活头了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769887
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769888
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769889
    m_Localized: 'Firefighter: 我什么都不怕。杀了我你能轻松点，那就开枪吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769890
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769891
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769892
    m_Localized: 'Firefighter: 说不定……这样要轻松得多……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769893
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769894
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769895
    m_Localized: 'Firefighter: 你知道我这双手经历过什么吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769896
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769897
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377515769898
    m_Localized: 'Firefighter: 这张照片就是判决书的话，那就*咳*来吧。我已经没什么可留恋的了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964160
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964161
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964162
    m_Localized: 'Firefighter: 浑身上下都烧得差不多了……我看我也该上路了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964163
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964164
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964165
    m_Localized: 'Firefighter: 跟你说，*咳*我想让家里的孩子每天刷牙，可我就没成功过……这下没人能叫他们按时刷牙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964166
    m_Localized: 'Firefighter: 我以前用这双手救过人，可现在，连个杯子都拿不稳。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964167
    m_Localized: 'Firefighter: 就是这样了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964168
    m_Localized: 'Firefighter: 我该上路了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964169
    m_Localized: 'Firefighter: 林子烧起来*咳*……你只能眼睁睁看着它这么烧成灰烬，然后意识到自己什么都做不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964170
    m_Localized: 'Firefighter: 我偶尔半夜醒过来，真觉得皮肤跟撕开了一样，一点不夸张。做什么都缓解不了。火焰夺走了一切……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964171
    m_Localized: 'Firefighter: 只有记忆能躲得过火焰。至于身体，彻底倒下也只是时间问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964172
    m_Localized: 'Firefighter: 大火在你周围熊熊燃烧，你才会明白这份宁静有多宝贵。你的耳朵说不定还能用，可你的灵魂呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964173
    m_Localized: 'Wheelchair: 唔，想检查什么就检查什么吧。我会全部通过的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964174
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964175
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964176
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964177
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964178
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964179
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964180
    m_Localized: 'Wheelchair: 来，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964181
    m_Localized: 'Wheelchair: 这一嘴的牙可是真正的宝藏。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964182
    m_Localized: 'Wheelchair: 这都不是普通的牙齿，是金的！当然了，也不是全都是金的，不过以后会越来越多。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964183
    m_Localized: 'Wheelchair: 你都想象不到，用牙开啤酒罐有多轻松。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964184
    m_Localized: 'Wheelchair: 对，就只用牙。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964185
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964186
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964187
    m_Localized: 'Wheelchair: 好歹我还有手，我感激还来不及。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964188
    m_Localized: 'Wheelchair: 没有手，我比赛都比不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964189
    m_Localized: 'Wheelchair: 等一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964190
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964191
    m_Localized: 'Wheelchair: 我手指没了！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964192
    m_Localized: 'Wheelchair: 昨天才少了一根，其他的去哪儿了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964193
    m_Localized: 'Wheelchair: 嗯……会长回来的。再等一阵就好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964194
    m_Localized: 'Wheelchair: 我手指没了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964195
    m_Localized: 'Wheelchair: 小事情，但还是挺难受的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964196
    m_Localized: 'Wheelchair: 不过我指甲长出来一点了，看见没？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964197
    m_Localized: 'Wheelchair: 说明腿也会长回来的。再等会儿就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964198
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964199
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964200
    m_Localized: 'Wheelchair: 我该看哪儿？直接看你？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964201
    m_Localized: 'Wheelchair: 我抽了一下，发现没？习惯了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964202
    m_Localized: 'Wheelchair: 我以前还能让引擎响起来那会儿起，眼睛就看不清东西了……什么都看不清。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964203
    m_Localized: 'Wheelchair: 我看我是还没准备好慢下来。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964204
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964205
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964206
    m_Localized: 'Wheelchair: 啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964207
    m_Localized: 'Wheelchair: 行，来吧。哈哈哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964208
    m_Localized: 'Wheelchair: 喜剧的巅峰就在这儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964209
    m_Localized: 'Wheelchair: 你让我给你看腋下，我就真给你看了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964210
    m_Localized: 'Wheelchair: 外面地狱烈火在燃烧，宇宙正想抹除这个星球。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964211
    m_Localized: 'Wheelchair: 伪人想把我们全都抹掉。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964212
    m_Localized: 'Wheelchair: 你却来一句“给我看看你的腋下！”'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964213
    m_Localized: 'Wheelchair: 哈哈哈哈哈。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964214
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964215
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964216
    m_Localized: 'Wheelchair: 拍照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964217
    m_Localized: 'Wheelchair: 我不怎么喜欢，不过……行吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964218
    m_Localized: 'Wheelchair: 靠，我眼睛眨了一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964219
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964220
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964221
    m_Localized: 'Wheelchair: 哈哈哈哈哈！好吧好吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964222
    m_Localized: 'Wheelchair: 你也收到那个广播了，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964223
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964224
    m_Localized: 'Wheelchair: 对。嗯？是收到了吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964225
    m_Localized: 'Wheelchair: 等等，你认真的？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964226
    m_Localized: 'Wheelchair: 这也……太他妈离谱了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964227
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964228
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964229
    m_Localized: 'Wheelchair: 那什么，我不拿你的啤酒了，别往心里去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964230
    m_Localized: 'Wheelchair: 有人生气了，你知道该怎么办么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964231
    m_Localized: 'Wheelchair: 拿婴儿车碾过去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964232
    m_Localized: 'Wheelchair: 你要真不爽，那带我兜一圈。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964233
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964234
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964235
    m_Localized: 'Wheelchair: 为什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964236
    m_Localized: 'Wheelchair: 这样帮不了我什么忙啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964237
    m_Localized: 'Wheelchair: 对你来说大概也没什么用。那你掏枪是为了什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964238
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964239
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964240
    m_Localized: 'Wheelchair: 我大概跟不上子弹的速度，但是可以试着躲一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964241
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964242
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964243
    m_Localized: 'Wheelchair: 我一直不明白人为什么要刮毛。毛发是人体的天然屏障。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964244
    m_Localized: 'Wheelchair: 有块儿地方红了，看到没？我的备用手指要长出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964245
    m_Localized: 'Wheelchair: 啊，真正的喜剧还没开始呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964246
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964247
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964248
    m_Localized: 'Wheelchair: 我们到底是在哪一步走错了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964249
    m_Localized: 'Wheelchair: 为什么要拍照片？有句老话不知道你听说过没，叫“深呼吸不能延缓死亡”？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964250
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964251
    m_Localized: 'Wheelchair: 我本来有话要说的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964252
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964253
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964254
    m_Localized: 'Wheelchair: 我能走了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964255
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964256
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964257
    m_Localized: 'Wheelchair: 嗯，我猜大家都有这么一天。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964258
    m_Localized: 'Wheelchair: 上帝早晚会来清算你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964259
    m_Localized: 'Wheelchair: 我要走也不会安安静静地走。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964260
    m_Localized: 'Wheelchair: 这都是人体的生理结构问题而已，明白吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964261
    m_Localized: 'Wheelchair: 为什么我们以前对着这一切能放声大笑，如今却只想着把对方脑袋轰掉？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964262
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964263
    m_Localized: 'Wheelchair: 我得做好去死的准备了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964264
    m_Localized: 'Wheelchair: 我现在唯一的引擎就是这双手。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964265
    m_Localized: 'Wheelchair: 可我连离合器都没了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964266
    m_Localized: 'Wheelchair: 说实话，我最害怕的就是哪天连这双手都没了。没了手，以后怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964267
    m_Localized: 'Wheelchair: 我不想动弹不得，永远被困在原地。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964268
    m_Localized: 'Wheelchair: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964269
    m_Localized: 'Wheelchair: 相比之下，死亡对我来说都没那么可怕。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964270
    m_Localized: 'Wheelchair: 不管从哪个角度看，你都追不上时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964271
    m_Localized: 'Wheelchair: 你有没有发现，人越老，时间就过得越快？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964272
    m_Localized: 'Wheelchair: 我们小时候不急着长大，一切都是那么简单。没有责任要担，也没有难做的选择要做。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964273
    m_Localized: 'Wheelchair: 可现在，无论有多拼命，好像永远都追不上时间。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964274
    m_Localized: 'Wheelchair: 不知道怎么回事，我忽然笑不出来了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964275
    m_Localized: 'Wheelchair: 你那检查也好，灭火也罢，都很荒唐。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964276
    m_Localized: 'Wheelchair: 每个人都想拯救世界，可没有人能就“怎么拯救”达成共识。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964277
    m_Localized: 'Wheelchair: 既然如此，那还有意义吗？我们说不定只要放轻松点儿，别太在意这事就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964278
    m_Localized: 'Wheelchair: 你看……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964279
    m_Localized: 'Wheelchair: 你不觉得旅程已经结束了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964280
    m_Localized: 'Wheelchair: 终点站到了。我们很快就要下车了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964281
    m_Localized: 'Wheelchair: 都能透过窗户看到最后一站了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964282
    m_Localized: 'Wheelchair: 你准备好了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964283
    m_Localized: 'Wheelchair: 反正我就是这么想的。别难过。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964284
    m_Localized: 'Wheelchair: 你……你自己都没法确定这个特征能不能分得出谁是伪人，那叫我怎么信？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964285
    m_Localized: 'Wheelchair: 说不定特征都是对的，靠这个能判断出谁是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964286
    m_Localized: 'Wheelchair: 但人是会犯错的，你知道吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964287
    m_Localized: 'Wheelchair: 只不过有的错误，付出的代价太惨重了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964288
    m_Localized: 'Wheelchair: 你……你要用这个特征来判断人是不是伪人，那我怎么能相信你之前的判断没错？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964289
    m_Localized: 'Wheelchair: 说不定其他的特征都不靠谱。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964290
    m_Localized: 'Wheelchair: 我们是人类，当然会犯错，仅此而已。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964291
    m_Localized: 'Wheelchair: 只不过有的错误，付出的代价太惨重了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964292
    m_Localized: 'Wheelchair: 你啊……只要一步走错，就有可能结束一个人的生命。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964293
    m_Localized: 'Wheelchair: 你要对自己的判断真那么有信心……那我只能羡慕你的自信了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964294
    m_Localized: 'Mother: 来，想检查就检查吧，我没什么好隐瞒的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964295
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964296
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964297
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964298
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964299
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964300
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964301
    m_Localized: 'Mother: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964302
    m_Localized: 'Mother: 我以前从来不把牙齿的事放心上，没那个时间去管它，可我现在……后悔了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964303
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964304
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964305
    m_Localized: 'Mother: 来，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964306
    m_Localized: 'Mother: 这哪还是手，就是两把铲子。都是带孩子磨成这样的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964307
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964308
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964309
    m_Localized: 'Mother: 来，看清楚了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964310
    m_Localized: 'Mother: 眼袋怎么这么大？还不都是长期缺眠少觉……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964311
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964312
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964313
    m_Localized: 'Mother: 来，看清楚了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964314
    m_Localized: 'Mother: 除臭剂早用完了，有味道也别怪我啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964315
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964316
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964317
    m_Localized: 'Mother: 能坐下说吗？不行？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964318
    m_Localized: 'Mother: 蓬头垢面脾气差，老样子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964319
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964320
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964321
    m_Localized: 'Mother: 耳朵很久没掏了，估计都让耳屎给堵住了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964322
    m_Localized: 'Mother: 孩子尖叫起来，那声音差点把我耳朵震个半聋。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964323
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964324
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964325
    m_Localized: 'Mother: 刷牙刷得牙龈出血，都一个礼拜了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964326
    m_Localized: 'Mother: 牙齿还是这么黄。日子都这样了，不抽烟怎么熬？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964327
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964328
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964329
    m_Localized: 'Mother: 用清洁剂用得我身上起疹子，一直没空去看医生。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964330
    m_Localized: 'Mother: 我要多活几天，这双手本来可以给你煲个汤什么的，你却非得掏枪……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964331
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964332
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964333
    m_Localized: 'Mother: 你就算是掏手雷，我晚上也照样睡不好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964334
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964335
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964336
    m_Localized: 'Mother: 怎么？嫌难闻就要枪毙我？荒唐。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964337
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964338
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964339
    m_Localized: 'Mother: 凭张照片就能决定我是死是活？可笑至极。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964340
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964341
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964342
    m_Localized: 'Mother: 嫌耳朵脏就想开枪？你才有病！不满意哪儿？我裹上头巾就是了！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964343
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964344
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964345
    m_Localized: 'Mother: 总算没人烦我了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964346
    m_Localized: 'Mother: 唉，可悲呀……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964347
    m_Localized: 'Mother: 有个孩子牙齿长得特别好，但是从没笑过。说不定这就跟牙齿长得好不好没有关系？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964348
    m_Localized: 'Mother: 这双手……抱过孩子，做过家务，摸过丈夫，可结果呢？没人珍惜，没人在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964349
    m_Localized: 'Mother: 孩子一生病，就连着好几天不能睡个安生觉。后来就习惯了，就这么过着噩梦一样的日子。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964350
    m_Localized: 'Mother: 有次累得我一礼拜没洗澡，孩子也没发觉。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964351
    m_Localized: 'Mother: 我以前找出来张照片，照片上孩子都在笑，我盯着看了好久，一直看到自己睡着。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964352
    m_Localized: 'Mother: 我有时候真希望自己是个聋子。可孩子都睡着以后，那种幸福的沉默……又让你觉得你活着就是为了这个。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964353
    m_Localized: 'Anger: 认真的吗？我靠了……行吧……动作快点！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964354
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964355
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964356
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964357
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964358
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964359
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964360
    m_Localized: 'Anger: 无所谓，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964361
    m_Localized: 'Anger: 黄的？靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964362
    m_Localized: 'Anger: 白的？不是白的还能是什么颜色？我好好爱护牙齿，它自然就白啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964363
    m_Localized: 'Anger: 我以前还想着，牙齿都黄成这样了，那不如镶颗金的，就跟电影里那种硬汉似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964364
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964365
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964366
    m_Localized: 'Anger: 行啊，随便看。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964367
    m_Localized: 'Anger: 嚯，可真够大的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964368
    m_Localized: 'Anger: 哈，我奶奶总说长这种手就该去劈柴，而不是……干我现在这行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964369
    m_Localized: 'Anger: 但这儿没柴可劈，总得找个事做，泄泄火。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964370
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964371
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964372
    m_Localized: 'Anger: 关你屁事，老子不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964373
    m_Localized: 'Anger: 怎么，喜欢这颜色？天生的蓝眼睛，招女人喜欢，靠这双眼睛就够。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964374
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964375
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964376
    m_Localized: 'Anger: 老子才懒得管你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964377
    m_Localized: 'Anger: 是啊，腋毛我刮了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964378
    m_Localized: 'Anger: 最烦腋下长毛，跟他妈专门长那儿的灌木丛似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964379
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964380
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964381
    m_Localized: 'Anger: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964382
    m_Localized: 'Anger: 怎么？老瞪着你那眼睛看我干嘛？看见什么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964383
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964384
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964385
    m_Localized: 'Anger: 妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964386
    m_Localized: 'Anger: 你他妈盯着我看什么？少零件了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964387
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964388
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964389
    m_Localized: 'Anger: 你脑子进水了？刚不是看过牙了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964390
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964391
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964392
    m_Localized: 'Anger: 信不信老子这双手掐断你喉咙，比你扣扳机还快？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964393
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964394
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964395
    m_Localized: 'Anger: 你他妈什么意思？嫉妒啊？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964396
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964397
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964398
    m_Localized: 'Anger: 时不时给挠一下，痒起来要命，跟专门对着我痒的地方挠似的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964399
    m_Localized: 'Anger: 腋下一痒，挠出血才舒服点。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964400
    m_Localized: 'Anger: 我才不信！你根本就是个疯子！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964401
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964402
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964403
    m_Localized: 'Anger: 为张破照片就要毙了我？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964404
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964405
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964406
    m_Localized: 'Anger: 手里有枪得当心点，别乱动。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964407
    m_Localized: 'Anger: 你可能会因为我这对耳朵，不小心开枪打到我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964408
    m_Localized: 'Anger: 你他妈彻底疯了！来啊杂种！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964409
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964410
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964411
    m_Localized: 'Anger: 你他妈就是个彻头彻尾的冷血杂种。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964412
    m_Localized: 'Anger: 去死吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964413
    m_Localized: 'Anger: 我奶奶有颗金牙。小时候我就想要那样的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964414
    m_Localized: 'Anger: 那颗金牙就跟太阳似的，镶在她嘴里闪闪发亮。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964415
    m_Localized: 'Anger: 奶奶说那是旧牙烂光后镶的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964416
    m_Localized: 'Anger: 我当时可高兴了，想着“太棒了！我牙烂了也能镶一颗”。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964417
    m_Localized: 'Anger: 结果呢……牙真不行了，根本没人管我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964418
    m_Localized: 'Anger: 我嘴里现在没有太阳，只有尿黄色的烂牙。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964419
    m_Localized: 'Anger: 看见这双手了吗？有泥巴，还有血，你觉得该有的全都有，但这不是别人的，是我自己的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964420
    m_Localized: 'Anger: 有时候痒得想撕掉整层皮，或者拿手砸墙，不然就是又撕又砸。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964421
    m_Localized: 'Anger: 我控制不住，但不想伤害别人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964422
    m_Localized: 'Anger: 看见指甲盖了吗？有泥巴，还有血，你觉得该有的全都有，但这不是别人的，是我自己的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964423
    m_Localized: 'Anger: 有时候痒得想撕掉整层皮，或者拿手砸墙，不然就是又撕又砸。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964424
    m_Localized: 'Anger: 换个人早该担心这种自残行为了吧？可我他妈根本不在乎。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964425
    m_Localized: 'Anger: 奶奶总叫我“天使宝宝”，就因为眼睛是蓝的。去他妈的天使。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964426
    m_Localized: 'Anger: 照照镜子，看看这双心灵的窗户，我只想问“我他妈哪里像天使？”'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964427
    m_Localized: 'Anger: 我都能想象得出来她看着我会是什么表情，八成很失望。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964428
    m_Localized: 'Anger: 剃须刀可锋利了，锋利到能……干点什么。唉，要真那么容易就好了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964429
    m_Localized: 'Anger: 我最后也就划伤了胳膊。每次刮腋毛，都觉得那不是在刮胡子，是在刮我自己的肉。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964430
    m_Localized: 'Anger: 可我照刮不误，因为恨透了那丛灌木。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964431
    m_Localized: 'Anger: 我连奶奶的照片都没有。她讨厌拍照。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964432
    m_Localized: 'Anger: 说拍照会把灵魂粘在相纸上，永远困在里面。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964433
    m_Localized: 'Anger: 我当时还笑她“得了吧奶奶，净胡说八道”。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964434
    m_Localized: 'Anger: 她说“等我死了，你看着照片就会想我到底在不在天堂”。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964435
    m_Localized: 'Anger: 呵，他妈的，既没照片也没奶奶了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964436
    m_Localized: 'Anger: 我有时候会下意识去揪耳垂，揪到火辣辣地疼才反应过来。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964437
    m_Localized: 'Anger: 以前以为是太紧张了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964438
    m_Localized: 'Anger: 后来发现只是想撕掉碍事的身体零件。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964439
    m_Localized: 'Anger: 但还没疯到自残的地步，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964440
    m_Localized: 'Anger: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964441
    m_Localized: 'Anger: 对吧？？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964442
    m_Localized: 'FortuneTeller: 亲爱的，我早知道你的能量会有所抵抗。不过没关系，要检查就检查吧。反正我早已把你看透。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964443
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964444
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964445
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377519964446
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158464
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158465
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158466
    m_Localized: 'FortuneTeller: 行吧，看仔细了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158467
    m_Localized: 'FortuneTeller: 眼睛才是内在宇宙的映射，不是牙齿。难道你想从牙缝里窥见命运？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158468
    m_Localized: 'FortuneTeller: 眼睛才是内在宇宙的映射，牙齿算什么？你想从牙缝里看见什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158469
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158470
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158471
    m_Localized: 'FortuneTeller: 要看就看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158472
    m_Localized: 'FortuneTeller: 不过小心点，我弄捕梦网不小心扎了几根木刺，还没来得及拔出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158473
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158474
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158475
    m_Localized: 'FortuneTeller: 我的眼睛？不是棕色还能是什么颜色。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158476
    m_Localized: 'FortuneTeller: 好吧，前提是不看那堆红血丝……没办法，要怪就怪月亮吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158477
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158478
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158479
    m_Localized: 'FortuneTeller: 唉……宇宙给我安排的考验啊……要看就看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158480
    m_Localized: 'FortuneTeller: 眼下这种环境，还想保持体面可不容易，你懂的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158481
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158482
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158483
    m_Localized: 'FortuneTeller: 当心点，我的能量场会闪到你！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158484
    m_Localized: 'FortuneTeller: 怎么样？看出什么了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158485
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158486
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158487
    m_Localized: 'FortuneTeller: 随便看，不过小心点儿，这双耳朵什么都能听得见，包括你心里想的什么。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158488
    m_Localized: 'FortuneTeller: 怎么样？找到答案了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158489
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158490
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158491
    m_Localized: 'FortuneTeller: 为了副牙齿你就要冲我开枪？你该明白问题不在我，而是火星对金星犯冲对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158492
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158493
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158494
    m_Localized: 'FortuneTeller: 真的假的？为了手上的木刺就要开枪杀我？我那都是做捕梦网弄的！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158495
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158496
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158497
    m_Localized: 'FortuneTeller: 你疯了吗？！这都是月亮的恶作剧，追踪月相哪有那么容易！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158498
    m_Localized: 'FortuneTeller: 你疯了吗？！这都是月亮的恶作剧，一看就知道吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158499
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158500
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158501
    m_Localized: 'FortuneTeller: 你这不是占星术，是野蛮行径！不如放下枪，我免费告诉你几个秘密？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158502
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158503
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158504
    m_Localized: 'FortuneTeller: 喂！你自己承受不住能量可别怪在我身上，亲爱的！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158505
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158506
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158507
    m_Localized: 'FortuneTeller: 能把那玩意儿放下吗？耳朵能看出什么？耳朵是用来聆听智者之言的！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158508
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158509
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158510
    m_Localized: 'FortuneTeller: 杀了我你会遭报应的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158511
    m_Localized: 'FortuneTeller: 你会拉一辈子肚子！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158512
    m_Localized: 'FortuneTeller: 有个长着一口好牙的人来找过我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158513
    m_Localized: 'FortuneTeller: 我说“看着都很好，但灵魂早已腐朽！”想想到底什么比较重要。你懂我什么意思，对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158514
    m_Localized: 'FortuneTeller: 我有次做完仪式，拔手里的刺拔了一晚上。每根刺都像宇宙的教诲，痛是痛，但让人铭记在心。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158515
    m_Localized: 'FortuneTeller: 眼睛是通往异界的门。我见过一个人，他的眼睛亮得跟壁灯似的。他说那是爱，实际上是火星。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158516
    m_Localized: 'FortuneTeller: 我有次苦修三个礼拜，终日冥想。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158517
    m_Localized: 'FortuneTeller: 思想就是物质，我也是借此实现自己的愿望。只要许对了愿，就能愿望成真。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158518
    m_Localized: 'FortuneTeller: 我现在的状态大概就像那次一样。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158519
    m_Localized: 'FortuneTeller: 有次拍照看着照片有闪光，我心想“这就是星辰的启示！”后来发现只是打光问题。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158520
    m_Localized: 'FortuneTeller: 我有次听到了宇宙的低语，不过我觉得应该是比宇宙的低语还要响的东西。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158521
    m_Localized: 'FortuneTeller: 我有次听到了宇宙的低语，后来发现就是阵穿堂风。不过我还是觉得挺好听的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158522
    m_Localized: 'Fanatic: 你想检查什么地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158523
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158524
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158525
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158526
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158527
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158528
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158529
    m_Localized: 'Fanatic: 想看我牙齿？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158530
    m_Localized: 'Fanatic: 这两排牙齿是我捍卫真理的武器！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158531
    m_Localized: 'Fanatic: 是不是上当么……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158532
    m_Localized: 'Fanatic: 你自己看了就知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158533
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158534
    m_Localized: 'Fanatic: 啤酒能补钙，我靠喝酒补钙保护牙齿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158535
    m_Localized: 'Fanatic: 缺钙牙齿早都掉光了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158536
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158537
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158538
    m_Localized: 'Fanatic: 完全理解。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158539
    m_Localized: 'Fanatic: 发生了太多事，不过日子还得过。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158540
    m_Localized: 'Fanatic: 该活就活着呗。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158541
    m_Localized: 'Fanatic: 你是不是在黑暗的角落里待太久了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158542
    m_Localized: 'Fanatic: 好好歇会儿吧，朋友。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158543
    m_Localized: 'Fanatic: 指甲？想看就看！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158544
    m_Localized: 'Fanatic: 爱看多久就看多久。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158545
    m_Localized: 'Fanatic: 我专门练过，用指甲来获取有用的阳光。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158546
    m_Localized: 'Fanatic: 哦对，还有开啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158547
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158548
    m_Localized: 'Fanatic: 你就，呃，就想看一眼？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158549
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158550
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158551
    m_Localized: 'Fanatic: 看看我的眼睛！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158552
    m_Localized: 'Fanatic: 眼睛里燃烧着熊熊怒火！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158553
    m_Localized: 'Fanatic: 直视我漆黑的双眼！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158554
    m_Localized: 'Fanatic: 我用它们汲取光的恩赐，将之转化为能量。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158555
    m_Localized: 'Fanatic: 我的力量全都来自这双眼睛！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158556
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158557
    m_Localized: 'Fanatic: 看见我眼中太阳的正义威能了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158558
    m_Localized: 'Fanatic: 看不见，那说明你就是个瞎子，应该像我一样多看看太阳。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158559
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158560
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158561
    m_Localized: 'Fanatic: 拍照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158562
    m_Localized: 'Fanatic: 呵……呵呵呵……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158563
    m_Localized: 'Fanatic: 有没有人告诉过你……我曾面见过太阳领袖本人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158564
    m_Localized: 'Fanatic: 没错，是我教会他直视太阳。这事回头跟你细说。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158565
    m_Localized: 'Fanatic: 来吧，给我拍照！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158566
    m_Localized: 'Fanatic: （你给这个邋遢的男人拍了一张照）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158567
    m_Localized: 'Fanatic: （照片里的他和现实中一样蓬头垢面）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158568
    m_Localized: 'Fanatic: （没有发现任何异常）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158569
    m_Localized: 'Fanatic: 拍得多完美啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158570
    m_Localized: 'Fanatic: 来找我，我把我这辈子的故事都告诉你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158571
    m_Localized: 'Fanatic: 不过，你得掏点儿小钱。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158572
    m_Localized: 'Fanatic: 这笔钱，我会全部用来拯救太阳的能量！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158573
    m_Localized: 'Fanatic: 开枪试试啊！真理会保护我！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158574
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158575
    m_Localized: 'Fanatic: 能把枪收起来吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158576
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158577
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158578
    m_Localized: 'Fanatic: 手里没啤酒，实在是太，难受了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158579
    m_Localized: 'Fanatic: 实在太，难受。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158580
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158581
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158582
    m_Localized: 'Fanatic: 人类，你为什么要这样？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158583
    m_Localized: 'Fanatic: 你们这群无知的疯子！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158584
    m_Localized: 'Fanatic: 不光背后说人闲话，还要开枪打人……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158585
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158586
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158587
    m_Localized: 'Fanatic: 这就过分了啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158588
    m_Localized: 'Fanatic: 又不能提升我们的活力。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158589
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158590
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158591
    m_Localized: 'Fanatic: 等等，你不喜欢我的手？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158592
    m_Localized: 'Fanatic: 凭什么？！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158593
    m_Localized: 'Fanatic: 吝啬鬼，无知愚昧！我就想喝点儿啤酒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158594
    m_Localized: 'Fanatic: 坐下吧。他们老说光看是没意义的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158595
    m_Localized: 'Fanatic: 那我该怎么办？一辈子都别看了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158596
    m_Localized: 'Fanatic: 啊等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158597
    m_Localized: 'Fanatic: 还是说站着……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158598
    m_Localized: 'Fanatic: 等一下……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158599
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158600
    m_Localized: 'Fanatic: 管他呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158601
    m_Localized: 'Fanatic: 这就对了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158602
    m_Localized: 'Fanatic: 你总不会对太阳开枪吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158603
    m_Localized: 'Fanatic: 不过别在意，我没生气。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158604
    m_Localized: 'Fanatic: 你体内流淌着清凉的生命之泉！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158605
    m_Localized: 'Fanatic: 啊，喜欢恶作剧是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158606
    m_Localized: 'Fanatic: 想闻就闻吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158607
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158608
    m_Localized: 'Fanatic: 都是我自己保养出来的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158609
    m_Localized: 'Fanatic: 啊，喜欢恶作剧是吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158610
    m_Localized: 'Fanatic: 想闻就闻吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158611
    m_Localized: 'Fanatic: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158612
    m_Localized: 'Fanatic: 这都是太阳的杰作。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158613
    m_Localized: 'Fanatic: 我们释放出充足的水分，才能让自己保持活力！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158614
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158615
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158616
    m_Localized: 'Anxiety: 你想检查什么地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158617
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158618
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158619
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158620
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158621
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158622
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158623
    m_Localized: 'Anxiety: 哈，什么？看一眼牙齿就能做决定？啧啧……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158624
    m_Localized: 'Anxiety: 我刚补过牙。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158625
    m_Localized: 'Anxiety: 不过说实话……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158626
    m_Localized: 'Anxiety: 根本不记得自己去看过牙医。我真去整过牙吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158627
    m_Localized: 'Anxiety: 天啊太可怕了，我连昨天吃没吃饭都记不得。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158628
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158629
    m_Localized: 'Anxiety: 那……我符合伪人的特征吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158630
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158631
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158632
    m_Localized: 'Anxiety: 我是伪人？怎么可能！？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158633
    m_Localized: 'Anxiety: 完蛋了，工作没了，家没了，现在连这颗脑子也要没了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158634
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158635
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158636
    m_Localized: 'Anxiety: 要看我指甲？这什么特征，真奇怪……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158637
    m_Localized: 'Anxiety: 行吧……看仔细了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158638
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158639
    m_Localized: 'Anxiety: 指甲缝里是什么？怎么可能是泥巴？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158640
    m_Localized: 'Anxiety: 我……我根本不记得自己挖过泥巴。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158641
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158642
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158643
    m_Localized: 'Anxiety: 手上这泥巴哪儿来的？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158644
    m_Localized: 'Anxiety: 我不可能好几天不洗手，就这么走来走去……对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158645
    m_Localized: 'Anxiety: 真……奇怪。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158646
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158647
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158648
    m_Localized: 'Anxiety: 想想看！我想不起来手指甲为什么这么脏，可我人又一直待在你家里。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158649
    m_Localized: 'Anxiety: 该不会……有人故意往我指甲里塞泥巴吧？谁会这么干？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158650
    m_Localized: 'Anxiety: 要检查眼睛？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158651
    m_Localized: 'Anxiety: 结果我一猜都能猜出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158652
    m_Localized: 'Anxiety: 特征真对上了会怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158653
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158654
    m_Localized: 'Anxiety: 是啊，只能是这样，不会有别的结局。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158655
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158656
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158657
    m_Localized: 'Anxiety: 我真是伪人？你觉得呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158658
    m_Localized: 'Anxiety: 为什么我是伪人我自己都不知道？说不定人就是这么不知不觉中变成伪人的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158659
    m_Localized: 'Anxiety: 也许，仅仅是觉得自己和别人不一样，觉得自己是社会上最烂的那种人，就已经能让好好的人变成伪人了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158660
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158661
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158662
    m_Localized: 'Anxiety: 我怕死。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158663
    m_Localized: 'Anxiety: 等等，能给我条绷带什么的吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158664
    m_Localized: 'Anxiety: 或者起码让我多站会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158665
    m_Localized: 'Anxiety: 我要真是伪人……那我会不会杀人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158666
    m_Localized: 'Anxiety: 我会不会变成危险人物？还是早就是了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158667
    m_Localized: 'Anxiety: 说不定已经杀过人了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158668
    m_Localized: 'Anxiety: （你给她拍了张照。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158669
    m_Localized: 'Anxiety: （照片显影后背景清晰，人像却模糊扭曲。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158670
    m_Localized: 'Anxiety: （就好像照片上的人在按下快门的一瞬间，猛地缩了一下。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158671
    m_Localized: 'Anxiety: 哈哈哈，你想都想不到，我刚刚缩了一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158672
    m_Localized: 'Anxiety: 现在怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158673
    m_Localized: 'Anxiety: 是放我一条生路，还是杀了我？你打算怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158674
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158675
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158676
    m_Localized: 'Anxiety: 为什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158677
    m_Localized: 'Anxiety: 直接开枪不是更简单？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158678
    m_Localized: 'Anxiety: 我也想跑，可我吓坏了，动不了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158679
    m_Localized: 'Anxiety: 也许……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158680
    m_Localized: 'Anxiety: 我不知道。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158681
    m_Localized: 'Anxiety: 开了枪，我会不会变成更可怕的东西？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158682
    m_Localized: 'Anxiety: 我说不定应该逃跑。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158683
    m_Localized: 'Anxiety: 可我已经不确定自己是不是人类了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158684
    m_Localized: 'Anxiety: 我该怎么办？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158685
    m_Localized: 'Anxiety: 就跟跑到我家里的那帮伪人一样……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158686
    m_Localized: 'Anxiety: 抱歉，太可怕了……我给你看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158687
    m_Localized: 'Anxiety: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158688
    m_Localized: 'Anxiety: 我是人类吗？求你说我是人类！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158689
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158690
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158691
    m_Localized: 'Anxiety: 反正都要掏枪，干嘛还要让人配合做什么检查？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158692
    m_Localized: 'Anxiety: 羞辱别人很有趣？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158693
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158694
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158695
    m_Localized: 'Anxiety: 真是噩梦，到哪儿都不安全。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158696
    m_Localized: 'Anxiety: 伪人会跑进你家里去，疯子觉得你哪哪不对劲，就会忽然掏枪杀人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158697
    m_Localized: 'Anxiety: 太可怕了！至少该有人说句“会好起来的”吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158698
    m_Localized: 'Anxiety: 我怎么就因为一个特征对上了，就成伪人了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158699
    m_Localized: 'Anxiety: 我长成这个样子，本来就够倒霉的了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158700
    m_Localized: 'Anxiety: 去上个班，大家见了我都害怕，我自己也知道人家怕什么。身子长得这么扭曲，谁见了不怕？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158701
    m_Localized: 'Anxiety: 我上礼拜背痛，就去了医院……应该是。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158702
    m_Localized: 'Anxiety: 牙也是那时候补的吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158703
    m_Localized: 'Anxiety: 我到底花了多少钱……？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158704
    m_Localized: 'Esenin: 你想检查什么地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158705
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158706
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158707
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158708
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158709
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158710
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158711
    m_Localized: 'Esenin: 想看我牙齿？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158712
    m_Localized: 'Esenin: 行啊，看吧，上面还沾着悲伤的痕迹和烟垢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158713
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158714
    m_Localized: 'Esenin: 够黄吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158715
    m_Localized: 'Esenin: 带上你那什么检查滚蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158716
    m_Localized: 'Esenin: 我才不是伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158717
    m_Localized: 'Esenin: 那帮玩意儿到底从哪儿来的？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158718
    m_Localized: 'Esenin: 指甲缝有泥就算伪人了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158719
    m_Localized: 'Esenin: 指甲脏了，洗个手不就行了！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158720
    m_Localized: 'Esenin: 而且照这么说，园丁都该变伪人了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158721
    m_Localized: 'Esenin: 狗屁不通！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158722
    m_Localized: 'Esenin: 指甲，看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158723
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158724
    m_Localized: 'Esenin: 怎么样？我是不是伪人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158725
    m_Localized: 'Esenin: 我看不是。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158726
    m_Localized: 'Esenin: 一天比一天荒唐。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158727
    m_Localized: 'Esenin: 万一我没睡觉呢？万一刚哭过呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158728
    m_Localized: 'Esenin: 完全搞不懂这标准了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158729
    m_Localized: 'Esenin: 就算有一个，或者好几个特征吻合，你又打算怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158730
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158731
    m_Localized: 'Esenin: 我今晚就去当个伪人。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158732
    m_Localized: 'Esenin: 回忆一下平静祥和的时光，让自己好好哭一哭。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158733
    m_Localized: 'Esenin: 什么伪人特征，还有那帮穿黄色制服的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158734
    m_Localized: 'Esenin: 全都……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158735
    m_Localized: 'Esenin: 乱了套了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158736
    m_Localized: 'Esenin: 你不觉得我们在往恐怖地狱里走么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158737
    m_Localized: 'Esenin: 说是一切井然有序，都控制住了，但身边没有一个地方是不乱的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158738
    m_Localized: 'Esenin: 行，拍你的破照片吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158739
    m_Localized: 'Esenin: （你给他拍了照。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158740
    m_Localized: 'Esenin: （他安静地坐在椅子上，只是人没有完全拍进框里。总的来说没什么异常。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158741
    m_Localized: 'Esenin: 我就是害怕接下来会发生的事。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158742
    m_Localized: 'Esenin: 认真的？你脑子进水了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158743
    m_Localized: 'Esenin: 你脑子让应急中心的吃了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158744
    m_Localized: 'Esenin: 还是嗑药了？我以为那种劲儿大的早找不着了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158745
    m_Localized: 'Esenin: 你都诚心问了，那就给你看看吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158746
    m_Localized: 'Esenin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158747
    m_Localized: 'Esenin: 满意了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158748
    m_Localized: 'Esenin: 闻够了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158749
    m_Localized: 'Esenin: 多谢你没打算这么仔细检查我的屁股！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158750
    m_Localized: 'Widow: 快点看。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158751
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158752
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158753
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158754
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377524158755
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352768
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352769
    m_Localized: 'Widow: 什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352770
    m_Localized: 'Widow: 呃……行吧……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352771
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352772
    m_Localized: 'Widow: 完事了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352773
    m_Localized: 'Widow: 能让我静静吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352774
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352775
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352776
    m_Localized: 'Widow: 手……等一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352777
    m_Localized: 'Widow: 我一直背着我丈夫，手又酸又累。没办法，没人肯救他。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352778
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352779
    m_Localized: 'Widow: 能不能别让我干这种蠢事了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352780
    m_Localized: 'Widow: 真想开枪就痛快点儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352781
    m_Localized: 'Widow: 我没力气挣扎了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352782
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352783
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352784
    m_Localized: 'Widow: 找什么？红血丝？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352785
    m_Localized: 'Widow: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352786
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352787
    m_Localized: 'Widow: 我有情绪我就是伪人吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352788
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352789
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352790
    m_Localized: 'Widow: 我们现在能打开天窗说亮话了么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352791
    m_Localized: 'Widow: 笑不能笑，哭也不能哭。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352792
    m_Localized: 'Widow: 有时候连话都不能说。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352793
    m_Localized: 'Widow: 那还能干什么？只能坐这儿，捂着脸发呆。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352794
    m_Localized: 'Widow: 这一切真能这么简单就结束吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352795
    m_Localized: 'Widow: 真的再也不会痛苦了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352796
    m_Localized: 'Widow: 可我没能救下你……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352797
    m_Localized: 'Widow: 你不觉得羞耻吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352798
    m_Localized: 'Widow: 我丈夫还活着那会儿，没人肯搭把手，可现在……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352799
    m_Localized: 'Widow: 你却想纪念他的死亡？！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352800
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352801
    m_Localized: 'Widow: 我无话可说。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352802
    m_Localized: 'Widow: 随你便，别烦我就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352803
    m_Localized: 'Widow: （你给她拍了张照。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352804
    m_Localized: 'Widow: （没发现什么异常。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352805
    m_Localized: 'Widow: （你不小心把死者也拍了进去，这一举动迫使你思考起生命来。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352806
    m_Localized: 'Widow: 滚吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352807
    m_Localized: 'Widow: 他喜欢我的牙齿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352808
    m_Localized: 'Widow: 不过我一直想戴牙套。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352809
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352810
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352811
    m_Localized: 'Widow: 是啊……怎么不开枪呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352812
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352813
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352814
    m_Localized: 'Widow: 如今这世道，笑是肯定不准笑了，那还能哭么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352815
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352816
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352817
    m_Localized: 'Widow: 你疯了吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352818
    m_Localized: 'Widow: 回答我……你他妈疯了吗？！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352819
    m_Localized: 'Widow: 恶魔让你往油锅里跳，你是不是第一个蹦进去？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352820
    m_Localized: 'Widow: 你……挨千刀的……我无话可说了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352821
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352822
    m_Localized: 'Widow: 还等什么？掏枪啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352823
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352824
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352825
    m_Localized: 'Widow: 靠。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352826
    m_Localized: 'Widow: 扣动扳机吧。应急中心早就杀死了我的灵魂，肉体就交给你来解决吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352827
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352828
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352829
    m_Localized: 'Widow: 早不想牙套的事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352830
    m_Localized: 'Widow: 你要不是提出来看我牙齿，我早就忘了这事了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352831
    m_Localized: 'Widow: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352832
    m_Localized: 'Widow: 天呐……我真的累坏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352833
    m_Localized: 'Widow: 我见谁冲谁发脾气，但是……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352834
    m_Localized: 'Widow: 谁都没做错。除了那几个杂种。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352835
    m_Localized: 'Widow: 我不明白，也不想明白。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352836
    m_Localized: 'Widow: 羞辱刚刚去世的人，究竟能得到什么……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352837
    m_Localized: 'Widow: 等等……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352838
    m_Localized: 'Widow: 呵……你掏枪了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352839
    m_Localized: 'Widow: 但没杀我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352840
    m_Localized: 'Widow: 什么意思？心虚了？没必要跟我这么证明。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352841
    m_Localized: 'Scammer: 你想检查什么地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352842
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352843
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352844
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352845
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352846
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352847
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352848
    m_Localized: 'Scammer: 牙齿的事我在行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352849
    m_Localized: 'Scammer: 我兄弟以前就是个牙医。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352850
    m_Localized: 'Scammer: 你猜怎么着？他满口的牙都让人打掉了！哈哈哈！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352851
    m_Localized: 'Scammer: 哦，想看看是吗？行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352852
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352853
    m_Localized: 'Scammer: 不错吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352854
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352855
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352856
    m_Localized: 'Scammer: 搞什么鬼？我说的故事哪儿有问题了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352857
    m_Localized: 'Scammer: 就因为牙齿的事要爆我的头？为什么？搞不懂……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352858
    m_Localized: 'Scammer: 求你了，饶命啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352859
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352860
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352861
    m_Localized: 'Scammer: 你脑子有病吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352862
    m_Localized: 'Scammer: 妈的，去你妈的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352863
    m_Localized: 'Scammer: 什么情况？我就是个普通人啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352864
    m_Localized: 'Scammer: 我指甲上啥怪东西都没有，你看看？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352865
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352866
    m_Localized: 'Scammer: 别误会。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352867
    m_Localized: 'Scammer: 我平时都洗手的，就是刚才捡了个地上的硬币。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352868
    m_Localized: 'Scammer: 干净着呢！我今天会洗手的，真的……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352869
    m_Localized: 'Scammer: 兄弟我平时都洗的，就今天没来得及。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352870
    m_Localized: 'Scammer: 平时基本上都挺干净的，真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352871
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352872
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352873
    m_Localized: 'Scammer: 因为指甲脏就要杀人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352874
    m_Localized: 'Scammer: 行吧，我从来没想过我会死得这么荒唐。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352875
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352876
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352877
    m_Localized: 'Scammer: 用这种方式看谁是怪物，谁不是，这也太奇怪了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352878
    m_Localized: 'Scammer: 看手只能找出蠢货和软蛋，怎么看得出来谁是伪人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352879
    m_Localized: 'Scammer: 早上9点就得起床，至少干4个钟头的活……真他妈操蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352880
    m_Localized: 'Scammer: 我眼睛最近老发痒。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352881
    m_Localized: 'Scammer: 你说这是不是太阳闹的？还是咋回事？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352882
    m_Localized: 'Scammer: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352883
    m_Localized: 'Scammer: 靠，兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352884
    m_Localized: 'Scammer: 我这是得病了闹的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352885
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352886
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352887
    m_Localized: 'Scammer: 那什么，我有个主意。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352888
    m_Localized: 'Scammer: 你这不是有枪么？咱们拿枪去吓唬人，搞点钱吧，这样就不用爆别人的头了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352889
    m_Localized: 'Scammer: 啥？这还要考虑？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352890
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352891
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352892
    m_Localized: 'Scammer: 行吧，你要是不想干这票我也理解。但我眼睛真是得病了闹的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352893
    m_Localized: 'Scammer: 你就是有眼药水……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352894
    m_Localized: 'Scammer: 我也不会买。我有我的理由。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352895
    m_Localized: 'Scammer: 想拍照？拍吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352896
    m_Localized: 'Scammer: 我怕光，身子可能会缩一下。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352897
    m_Localized: 'Scammer: （你给他拍了照。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352898
    m_Localized: 'Scammer: （照片看着挺正常，不过他的脸……）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352899
    m_Localized: 'Scammer: （拍出来特别模糊。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352900
    m_Localized: 'Scammer: 早跟你说过了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352901
    m_Localized: 'Scammer: 要不要重拍一张？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352902
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352903
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352904
    m_Localized: 'Scammer: 要坑就坑那帮混账东西去，别坑我啊兄弟。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352905
    m_Localized: 'Scammer: 欸对，你得让那帮人时刻保持在那个状态。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352906
    m_Localized: 'Scammer: 不然他们一放松，忘了在谁地盘上，就不肯交钱了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352907
    m_Localized: 'Scammer: 等等！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352908
    m_Localized: 'Scammer: 妈的，你这破房子老子不待了，我走行了吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352909
    m_Localized: 'Scammer: 我要去大太阳底下晒成人干了，都赖你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352910
    m_Localized: 'Scammer: 操蛋。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352911
    m_Localized: 'Scammer: 你选错路子了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352912
    m_Localized: 'Scammer: 这儿你说了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352913
    m_Localized: 'Scammer: 怎么说？都没问题吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352914
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352915
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352916
    m_Localized: 'Scammer: 等等！好吧，靠，我有次试了一下刮腋毛，后来就养成了习惯，经常刮。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352917
    m_Localized: 'Scammer: 别说出去。你不是大嘴巴对吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352918
    m_Localized: 'Scammer: 等等！这跟要看我内裤有啥区别。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352919
    m_Localized: 'Scammer: 文明人怎么能留个烧焦的胳肢窝呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352920
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352921
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352922
    m_Localized: 'Scammer: 早知道你靠得住。你不会真冲着正常人动手的，呵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352923
    m_Localized: 'Scammer: 要不咱们去找那帮怂包的麻烦？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352924
    m_Localized: 'Scammer: 不行？那改天吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352925
    m_Localized: 'Scammer: 我知道那些伪人什么的让你压力特别大。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352926
    m_Localized: 'Scammer: 你做这些都是为了大伙。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352927
    m_Localized: 'Scammer: 总之别往心里去。真的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352928
    m_Localized: 'Daughter: 你想检查什么地方？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352929
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352930
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352931
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352932
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352933
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352934
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352935
    m_Localized: 'Daughter: 想看我的牙？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352936
    m_Localized: 'Daughter: 为什么啊？我还有几颗乳牙没换。爸爸说过……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352937
    m_Localized: 'Daughter: 唔，我不会再哭了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352938
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352939
    m_Localized: 'Daughter: 喏，给你看。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352940
    m_Localized: 'Daughter: 这样是怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352941
    m_Localized: 'Daughter: 没问题吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352942
    m_Localized: 'Daughter: 我已经会自己剪指甲了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352943
    m_Localized: 'Daughter: 虽然还剪不太好……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352944
    m_Localized: 'Daughter: 你看……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352945
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352946
    m_Localized: 'Daughter: 挺整齐的吧？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352947
    m_Localized: 'Daughter: 都是我自己修的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352948
    m_Localized: 'Daughter: 我想走了。让我一个人待会儿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352949
    m_Localized: 'Daughter: 你能看到我眼睛里面吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352950
    m_Localized: 'Daughter: 能不能看得出来我在想什么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352951
    m_Localized: 'Daughter: 能的话，我绝对不会胡思乱想的，你放心。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352952
    m_Localized: 'Daughter: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352953
    m_Localized: 'Daughter: 你怎么这样看着我？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377528352954
    m_Localized: 'Daughter: 是不是看……看……看见……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547072
    m_Localized: 'Daughter: 你……呜哇哇哇，'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547073
    m_Localized: 'Daughter: 我……我……想喝……喝水……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547074
    m_Localized: 'Daughter: 要我怎么做才行？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547075
    m_Localized: 'Daughter: （你看着她，意识到自己这样太过分了。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547076
    m_Localized: 'Daughter: 你只是想知道我怎么样了？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547077
    m_Localized: 'Daughter: 我好累，能让我一个人待着吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547078
    m_Localized: 'Daughter: 拍照？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547079
    m_Localized: 'Daughter: 我不怎么拍照。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547080
    m_Localized: 'Daughter: 拍完能给我看看吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547081
    m_Localized: 'Daughter: （你给她拍了张照。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547082
    m_Localized: 'Daughter: （照片有点模糊。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547083
    m_Localized: 'Daughter: （还没等你按下快门，她就朝你跑了过来。）'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547084
    m_Localized: 'Daughter: 嗯……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547085
    m_Localized: 'Daughter: 谢谢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547086
    m_Localized: 'Daughter: 但我不喜欢。别再给我拍照了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547087
    m_Localized: 'NotTrue: 来，宝贝，看吧。就是我这儿没什么新鲜的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547088
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547089
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547090
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547091
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547092
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547093
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547094
    m_Localized: 'NotTrue: 牙？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547095
    m_Localized: 'NotTrue: 啊啊啊。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547096
    m_Localized: 'NotTrue: 唉……我以前可讨厌这一嘴的牙了，恨不得全拔光。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547097
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547098
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547099
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547100
    m_Localized: 'NotTrue: 瞧瞧我这几根手指头，数不清数，码不齐东西，量不准尺寸。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547101
    m_Localized: 'NotTrue: 也就能凑合用用，不至于缺了手指，办不成事。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547102
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547103
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547104
    m_Localized: 'NotTrue: 宝贝……你真要看？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547105
    m_Localized: 'NotTrue: 眼睛就像窗户。房子的窗户是透光用的，心灵的窗户是透真相用的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547106
    m_Localized: 'NotTrue: 可我的积了灰……玻璃裂了……窗帘早让蛾子啃光了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547107
    m_Localized: 'NotTrue: 别看了宝贝，里面啥也没有。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547108
    m_Localized: 'NotTrue: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547109
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547110
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547111
    m_Localized: 'NotTrue: 呸！让老太婆抬手……害不害臊？我站都站不稳！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547112
    m_Localized: 'NotTrue: 唉，可有什么办法？主人家说了算。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547113
    m_Localized: 'NotTrue: 嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547114
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547115
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547116
    m_Localized: 'NotTrue: 什么？给我这老骨头浪费胶卷？明明都不够用了……非要拍？那老婆子我还挺乐意的！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547117
    m_Localized: 'NotTrue: 怎么样啊宝贝？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547118
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547119
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547120
    m_Localized: 'NotTrue: 哈！亏你想得出来。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547121
    m_Localized: 'NotTrue: 普通得很，听力也没什么变化。不过啊……有时候觉着自己早就不在这儿了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547122
    m_Localized: 'NotTrue: 就好像人家只能通过天窗瞧见我，还不一定每回都能瞧得见。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547123
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547124
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547125
    m_Localized: 'NotTrue: 欸，拿那玩意儿指着我干啥？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547126
    m_Localized: 'NotTrue: 世上还有什么东西比没牙老太婆可怕？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547127
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547128
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547129
    m_Localized: 'NotTrue: 以为我害怕？以为我还在抓着什么不放？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547130
    m_Localized: 'NotTrue: 早抓空太多次，连手指头都知道什么都攥不住。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547131
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547132
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547133
    m_Localized: 'NotTrue: 就是这样了……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547134
    m_Localized: 'NotTrue: 不信？要检查？来，看个够……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547135
    m_Localized: 'NotTrue: 我以前也爱看人眼睛。现在想起来那会儿看人家眼睛的场景了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547136
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547137
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547138
    m_Localized: 'NotTrue: 唉，宝贝，这就跟个印记似的，人老了就会有。活到我这把岁数的人，都会得这么个礼物。你难道不知道吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547139
    m_Localized: 'NotTrue: 这霉菌不会痛，也不吵着要吃喝，它就那么存在着，为活而活。跟我一样呢，呵呵。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547140
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547141
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547142
    m_Localized: 'NotTrue: 怎么，这都能让你发火？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547143
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547144
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547145
    m_Localized: 'NotTrue: 这是什么说法，宝贝？看耳朵能看出名堂？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547146
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547147
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547148
    m_Localized: 'NotTrue: 好啊。我无所谓。想开就开吧，宝贝，我早想见见上帝了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547149
    m_Localized: 'NotTrue: 就是……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547150
    m_Localized: 'NotTrue: 我花钱请医生把我的牙全拔了，可他没法一次拔光。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547151
    m_Localized: 'NotTrue: 每次去就给我拔一两颗……眼下世界变成了这模样，医生可没空再给人拔牙了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547152
    m_Localized: 'NotTrue: 我嘴里就还剩这个没弄完。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547153
    m_Localized: 'NotTrue: 手是给人抓东西用的，我老早就抓不住东西了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547154
    m_Localized: 'NotTrue: 要我伸出手？为什么？你自己不能伸么。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547155
    m_Localized: 'NotTrue: “乘着风儿的背脊顺流而下……”到我的小屋里来吧，宝贝。进来坐坐。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547156
    m_Localized: 'NotTrue: 你以为能逃得过这种命运？除非早死！可你呀，还是好好保重自己吧！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547157
    m_Localized: 'NotTrue: 多俊的小伙子！毁了这副好皮囊可是罪过。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547158
    m_Localized: 'NotTrue: 我年轻那会儿，只有有钱人才有这种玩意儿。现在呢，随便哪个懂拍照的都能用！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547159
    m_Localized: 'NotTrue: 我跟你没话说。净干蠢事。无缘无故打扰老实人……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547160
    m_Localized: 'Alkonost: 别折磨我妹妹。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547161
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547162
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547163
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547164
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547165
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547166
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547167
    m_Localized: 'Alkonost: 我们家的人向来牙口结实。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547168
    m_Localized: 'Alkonost: 我十几岁那会儿，试过用牙开啤酒瓶。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547169
    m_Localized: 'Alkonost: 结果不太妙。不过倒是教会了我爱护牙齿。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547170
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547171
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547172
    m_Localized: 'Alkonost: 我妹妹没法自理，大事小事都只能由我这双手料理。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547173
    m_Localized: 'Alkonost: 一双手要养活两个人，你说这双手该是个什么样子？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547174
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547175
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547176
    m_Localized: 'Alkonost: 是啊，我妹妹总哭，可我们的眼睛还是很像。只不过她的眼神更黯淡些。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547177
    m_Localized: 'Alkonost: 我挺担心的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547178
    m_Localized: 'Alkonost: 是啊，我妹妹总哭，可我们的眼睛还是很像。我是说她的眼睛没发红。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547179
    m_Localized: 'Alkonost: 也许她的眼泪早就流干了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547180
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547181
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547182
    m_Localized: 'Alkonost: 我给你看。不过你别去打搅我妹妹，行吗？她累坏了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547183
    m_Localized: 'Alkonost: 我平时都会刮一下腋毛，不让自己失了体面。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547184
    m_Localized: 'Alkonost: 哪怕眼下这世道早就没什么体面可言了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547185
    m_Localized: 'Alkonost: 我平时都会刮一下腋毛，不过这次忘带剃刀了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547186
    m_Localized: 'Alkonost: 再说现在也没这个闲工夫。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547187
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547188
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547189
    m_Localized: 'Alkonost: 我们姐妹遇到的事够多了。把枪收起来吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547190
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547191
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547192
    m_Localized: 'Alkonost: 我最近开始抽烟了。就是被你们这种人逼的。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547193
    m_Localized: 'Alkonost: 你以为就你日子难熬？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547194
    m_Localized: 'Alkonost: 以为拿把枪就能随便指人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547195
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547196
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547197
    m_Localized: 'Alkonost: 哪儿不对劲了？是我眼神飘得太快还是太空洞？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547198
    m_Localized: 'Alkonost: 哪儿不对劲了？我眼神太空洞？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547199
    m_Localized: 'Alkonost: 你以为自己又好到哪去？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547200
    m_Localized: 'Alkonost: 你该冷静点，别感情用事。我常这么劝我妹妹。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547201
    m_Localized: 'Alkonost: 可惜现在还得来劝你。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547202
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547203
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547204
    m_Localized: 'Alkonost: 等等。新闻真说看看胳肢窝能分得出谁是伪人？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547205
    m_Localized: 'Alkonost: 动动脑子。别犯蠢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547206
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547207
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547208
    m_Localized: 'Alkonost: 看来我人生的歌谣就要在这儿迎来最后一段了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547209
    m_Localized: 'Alkonost: 这一段还带着点儿苦涩。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547210
    m_Localized: 'Alkonost: 生活总是在考验我们的韧性，日子就没好过过。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547211
    m_Localized: 'Alkonost: 我妹妹撑不下去了，放弃了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547212
    m_Localized: 'Alkonost: 我明白，你的处境也好不到哪儿去。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547213
    m_Localized: 'Alkonost: 可你要是任由恐惧支配自己，那跟那些伪人又有什么区别？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547214
    m_Localized: 'Alkonost: 你继续这么跟他人隔绝下去，会怎么样？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547215
    m_Localized: 'Alkonost: 说实话，我受够了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547216
    m_Localized: 'Alkonost: 多希望能在这儿喘口气，不用时刻提心吊胆。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547217
    m_Localized: 'Alkonost: 可这儿的日子还跟以前一样，而且一眼望不到头。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547218
    m_Localized: 'Alkonost: 坦白说，我自己也怕得很。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547219
    m_Localized: 'Alkonost: 接下来呢？伪人会消失，还是我们得给他们划几个地方让他们住着，然后大家就这么永远隔离下去？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547220
    m_Localized: 'Sirin: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547221
    m_Localized: 牙齿
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547222
    m_Localized: 手
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547223
    m_Localized: 眼睛
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547224
    m_Localized: 腋下
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547225
    m_Localized: 拍照
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547226
    m_Localized: 耳朵
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547227
    m_Localized: 'Sirin: 看吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547228
    m_Localized: 'Sirin: 你要把牙都敲掉么？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547229
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547230
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547231
    m_Localized: 'Sirin: 平时都是我姐姐打理。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547232
    m_Localized: 'Sirin: 但是这有什么意义呢。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547233
    m_Localized: 'Sirin: 她当初就该……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547234
    m_Localized: 'Sirin: 就该让我死了算了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547235
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547236
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547237
    m_Localized: 'Sirin: 我的眼睛跟我姐姐的很像。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547238
    m_Localized: 'Sirin: 但她的没那么空洞。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547239
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547240
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547241
    m_Localized: 'Sirin: 腋毛我姐姐给我刮的，平时都是她在照顾我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547242
    m_Localized: 'Sirin: 看来这些功夫没白费。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547243
    m_Localized: 放过
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547244
    m_Localized: 拔枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547245
    m_Localized: 'Sirin: 这样更好。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547246
    m_Localized: 'Sirin: 带走我的灵魂吧。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547247
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547248
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547249
    m_Localized: 'Sirin: 不用你动手。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547250
    m_Localized: 'Sirin: 反正死亡已经临近。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547251
    m_Localized: 'Sirin: 交给我就行。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547252
    m_Localized: 'Sirin: 把枪给我。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547253
    m_Localized: 'Sirin: 我自己来。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547254
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547255
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547256
    m_Localized: 'Sirin: 我就算闭上了眼，这份空虚也不会消失。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547257
    m_Localized: 'Sirin: 只会转移到你身上。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547258
    m_Localized: 'Sirin: 喜欢这样吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547259
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547260
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547261
    m_Localized: 'Sirin: 嗯？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547262
    m_Localized: 'Sirin: 要按那个红色按钮吗？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547263
    m_Localized: 开枪
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547264
    m_Localized: 听对方说完
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547265
    m_Localized: 'Sirin: 没这个胆量？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547266
    m_Localized: 'Sirin: ……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547267
    m_Localized: 'Sirin: 反正你迟早会死。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547268
    m_Localized: 'Sirin: 真可惜。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547269
    m_Localized: 'Sirin: 说不定下次就扣动扳机了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547270
    m_Localized: 'Sirin: 真可惜。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547271
    m_Localized: 'Sirin: 我不符合伪人的特征。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547272
    m_Localized: 'Sirin: 说不定下次就扣动扳机了。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547273
    m_Localized: 'Sirin: 万一大家现在都在黑洞里，等着被吞噬呢？'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547274
    m_Localized: 'Sirin: 我们会在黑洞表面挣扎很久。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547275
    m_Localized: 'Sirin: 永远看不到自己的死亡。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547276
    m_Localized: 'Sirin: 只有永恒的折磨与对死亡的等待。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547277
    m_Localized: 'Sirin: 无所谓。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547278
    m_Localized: 'Sirin: 我就等着，时间到了就上路。'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547279
    m_Localized: 'Sirin: 我的歌……'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547280
    m_Localized: 'Sirin: 本来是为你准备的啊！'
    m_Metadata:
      m_Items: []
  - m_Id: 21377532547281
    m_Localized: 'Sirin: 本该有个美好结局的！'
    m_Metadata:
      m_Items: []
