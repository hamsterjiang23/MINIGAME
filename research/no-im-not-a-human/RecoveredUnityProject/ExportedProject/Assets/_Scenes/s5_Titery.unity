  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\n\r\n\r\n\r\n<align=center>\r\n<line-height=50%><size=30>Nikita Veter</size>\r\nGame Director, Scriptwriter, Game Designer</line-height>\r\n\r\n<line-height=50%><size=30>Olga Shkirando</size>\r\nArtist, Author of the Idea</line-height>\r\n\r\n<line-height=50%><size=30>Viktor 'thesecondleft' Klimenkov</size>\r\nProgrammer, Tech Lead</line-height>\r\n\r\n<line-height=50%><size=30>Roman Kozubchenko</size>\r\nGame Designer, Scriptwriter</line-height>\r\n\r\n<line-height=50%><size=30>Max 'Specter' Fedoriv</size>\r\nComposer, Sound Designer, VFX Artist, Cutscenes Director</line-height>\r\n\r\n<line-height=50%><size=30>Mnim Amatarata</size>\r\nSound Designer, Scriptwriter</line-height>\r\n\r\n<line-height=50%><size=30>Svetlana Chibichik</size>\r\nConcept Artist</line-height>\r\n</align>\r\n\r\n\r\n\r\n\r\n\r\n\r\n<align=center>Rita Lebedeva</align>\r\nAnna Tsykhanevich                  Julie 'Hawke' Ogurtsova               Andrey 'Ando' Nemec\r\nDavid Claesson                   Lana ‘lanalynx’ Stepanova         Pavel 'Dulberth' Korovkin\r\nColorfiction      \t\t\t\t\t\t                  Yaroslav 'Pangolin' Kadyshev\r\n\r\nArtemis Leonov                            Andrei Ponomarev                    Alexey Trostin\r\nEvgenia Semenova                       Abbey ‘Scruncho’ Smith                Daria Kovalenko\r\nEugene Belov                           Alexandra Chigrinskaya                   Gleb Bratzev\r\nFedor Solovyov                           Aleksandr Svyazhin                       Ian Marvin\r\nHürcan ‘horrorvisuals’ Köse                Anna Lobanova             Ivan 'C4PT41N' Gorbunov\r\nKate ‘Yoshi’ Misko                         Anna Mironova             Maxim ‘Ustal’ Gorbachev\r\nLeonor 'Leo' Afonso                       Ariuna Chimitova                    Mayya Sidorova\r\nNikita Goncharov                                 Daria Arzhanova             Vanya ‘bblvaet’ Rakcheev \r\nPavel Toropov                            Yaroslav Rumyantsev                    Timofei Kozlov\r\nVictoria 'VikkiMikk' Bovshovskaya         Valentin Moldovanov               Vladislava Balashova\r\n             <align=center> Kseniia ‘Seni’ Rastorgueva</align>\r\n\r\n<align=center><size=40pt>Arcus Key</size></align>\r\n<line-height=50%>Logan Liu                    David Clark                          Allen Wang\r\nFounder & CEO                       Global Client Director           Asia BD and Physical Event Expert</line-height>\r\n\r\n<line-height=50%>Fiona Fu                      Zoe Zang                            LadyZanc\r\nAccount Manager                PR and Event Manager               Simplified Chinese translator</line-height>\r\n\r\n<line-height=50%>Cindy Cai                   Stella Ma\r\nInfluencers Manager      \t                Community & Social Media Manager</line-height></align>\r\n\r\n<align=center><size=40pt>Allcorrect Games</size></align>\r\n<line-height=50%>Olga Bodiak                      Kirill Dudnik                    Dmitrii Antonov\r\nProject Manager                      Team Lead                        Account Manager</line-height>\r\n\r\n<line-height=50%>Thomas Bayer                   Joanne Stephan                     Celia Gonzalez\r\nGerman localization                  German localization              English localization (demo)</line-height>\r\n\r\n<line-height=50%><align=center>Olga Bagina\r\nEnglish localization (demo)</align></line-height>\r\n\r\n<align=center><size=40pt>Dragonbaby</size></align>\r\n<line-height=50%>Sam Burton                         Joe Dart                         Jeremy Blaustein\r\nHead of Localization            Project Manager                   Linguistic Support</line-height>\r\n\r\n<line-height=50%>Sam Burton                     Andrew Echeverria                  Andrew Taro Kiya\r\nLead English Editor             English Editing                   English Editing</line-height>\r\n\r\n<line-height=50%>Carrick Lomas                  Sasha Kisina                       João Guevara\r\nEnglish Editing                  Russian Language Advisor         Portuguese (EU) Translation\r\n.                                                                                  LQA Support</line-height>\r\n\r\n<align=center><line-height=50%>Mariana Pereira                                                  \t                \t                                    Raquel Espada          \r\nPortuguese (EU) Review                                                  \t\t               Portuguese (EU) LQA</line-height></align>\r\n\r\n<align=center>Special Thanks (Dragonbaby)</align>\r\n<line-height=50%>Amélie Geeraert                     Tobias Gut                    Aleksandra Lubinska\r\nFrench Support                  German Support                    Polish Support</line-height>\r\n\r\n<line-height=50%>Bohdana Vozniuk             Burak Onur Yıldız                     Karin Zhang\r\nUkrainian Support                     Turkish Support             Chinese (Traditional) Support</line-height>\r\n\r\n<line-height=50%>John Silva                                                          Asuka Soeda \r\nPortuguese (Brazil) Support                                                        Japanese Support</line-height> \r\n\r\n<align=center><size=40pt>JF Games</size></align>\r\n<line-height=50%>Jesús Fabre                  Regis Antonioli Junior              Joao Pedro Fernandes\r\nProject coordinator          Brazilian Portuguese translator     Brazilian Portuguese translator</line-height>\r\n\r\n<align=center><size=40pt>The First Place</size></align>\r\n<line-height=50%>Ivan Fulco                  Massimiliano Marino              Antonio Pizzo\r\nItalian editing          Italian localization     Italian localization</line-height>\r\n<line-height=50%>Micol Pennese                  Alessandro De Vita              Gianluigi Villecco\r\nItalian localization/LQA       Italian localization/LQA        Italian localization</line-height>\r\n\r\n<align=center><size=40pt>Locpick Game Localization & Audio</size></align>\r\n<line-height=50%>Ali Barutçuoğlu               Ebru Yılmaz Akca              Türkü Şentürk\r\nFounder & CEO           Project Manager          Project Manager</line-height>\r\n<line-height=50%>Uğur Söyleyici                     Abbas Barış Bingöl                 Barışcan Yılmaz\r\nProject Manager           Turkish localization        Turkish localization</line-height>\r\n<line-height=50%>Melisa Pancar                Burak Onur Yıldız               Ahmed Fouad\r\nTurkish localization        Turkish LQA        Arabic localization</line-height>\r\n<line-height=50%>Eman Abdo                                                                                                                  Abdallah Karem       \r\nArabic localization                                                                                       Arabic LQA</line-height>  \r\n\r\n<align=center><size=40pt>Ace Localizer Vietnam</size></align>\r\n<line-height=50%>Hồng Liên                    Vũ Hải Đăng             Custard (Vi)\r\nProject Manager & Chief Editor           Assistant PM & Technical Support          Editor & Translator</line-height>\r\n<line-height=50%>Lâm Thiên Thanh (KT)                     DeeDeeEn                 Nguyễn Việt Thanh\r\nEditor & Translator           Editor & Translator        Editor & Translator</line-height>\r\n<line-height=50%>Khương                Sophora               NQATien\r\nEditor           Editor         Translator</line-height> \r\n<line-height=50%>Trần Quang Huy (Gwyn)           Leee (Chaolong)                    Dạ Ling\r\nTranslator          Translator         Translator</line-height> \r\n\r\n\r\n<align=center><line-height=50%>Atom Maria Osipova                                                                                                      Kakihara MasO                            \r\nEnglish localization (full game)                                                        Simplified Chinese localization\r\n\r\n이정범 (Jeong-beom Lee)                                                                                        CatUp Localization\r\nKorean localization \t\t\t\t\t                              Traditional Chinese localization\r\nLead Translator, Language-Games</align></line-height>                                                                            .\t\r\n<align=center><line-height=50%>nicolith                                                                                                                            Marianna Alzuro       \r\nJapanese localization                                                                                                    Spanish (Spain)\r\n                                             \t                                                   Spanish (Latin America) localization</align></line-height>\r\n<line-height=50%>Eugene Glovak                                                                                                           Krzysztof Sagola       \r\nUkrainian localization                                                                                        Polish localization</line-height>                          \r\n<align=center>\r\n<line-height=50%>Elodie Bourry\r\nFrench localization</line-height>\r\n</align> \r\n<align=center>Special thanks (JF Games)</align>\r\n<line-height=50%><align=center>Alexey Trostin, Anna Shapovalova                              \r\nRussian support\r\n\r\n1jem\r\nUkrainian support\r\n\r\nMatteo Benatti\r\n<align=center>Italian support</align></line-height>\r\n\r\n<align=center><size=40pt>Special thanks</size></align>\r\n<line-height=50%><size=30>Tatyana Klimkina</size>                                                                                                 <size=30>Daniel Lyozov</size>\r\nFor everything                                                                                                          Bizdev, Support</line-height>\r\n\r\n<line-height=50%><size=30>Anastasia Kuleshova</size>                                                                                <size=30>Bart Solevoinichkin</size>\r\nProofreader original text                                                                         Discord server moderator</line-height>\r\n\r\n<line-height=50%><size=30>Sergey Anikin</size>                                                                                                      <size=30>Anna Arkhipova</size>\r\nConsultation on Religious Studies                                               Help with art and moral support</line-height>\r\n\r\n<line-height=50%><size=30>Eva Avocado x Pumpky</size>                                                                                  <size=30>Adeline Offstern</size>\r\nFor the Cat                                                                                                    Help with 3D animations</line-height>\r\n\r\n<line-height=50%><align=center><size=30>Islam Abdurashidov</size>                                                                                                       <size=30>Eugene Bo</size>\r\nHelp with 3D animations</align>                                                                                                         Tech help</align></line-height>\r\n\r\n<line-height=50%><align=center><size=30>Sharkker Dude</size>                                                                                                                          <size=30>GMD13</size>\r\nFor photo of the Widow in happy days</align>                                                                   Help with finding bugs</align></line-height>\r\n\r\n<line-height=50%><align=center><size=30>Rostislav Shurupkin</size>                                                                                                                <size=30>MA3AII</size>\r\nHelp with finding bugs</align>                                                                               Help with finding bugs</align></line-height>\r\n\r\n<line-height=50%><align=center><size=30>Michael Realperson</size>\r\nKnowledge of Forest immortality</align></line-height>\r\n\r\n<align=center><size=32pt>Thanks for saving our stories</size></align>\r\nMichael                                            Damir Khusnutdinov\r\nUrLocalCarpet                                            Gameroker337\r\nelka687                                           Sean Bao-Han Rogers\r\nBart Solevoinichkin                               Dmitryi Oganezov\r\nmrazarix                                                   Aleksey Morozov\r\nMaslinch                                                         Ilya Varlakov\r\nKoT_pa                                                                        Mazer\r\nAnira Naeg                                                                nayasy\r\nTimur Kovalyov                                               lemonkanada\r\n<align=center>Udobnyi</align>                                                                              Eldar Kaimarazov\r\n\r\n<align=center><size=32pt>Thanks for supporting us</size></align>\r\nIldan Zamaletdinov                        Difo 1                              Black Caster\r\nDima Reznikov                       ???? ????                 Marco ALESSANDRO\r\nDmitryi Mickevich                       Larrinho                               KowaFuwa\r\nmusta__krakish                       Buggymelly                         Black Caster\r\nKolakid                               Dark Buddhist                  GamingMaster360\r\nDaria Bulatova                        ScarabianNight                               Rustleq\r\n《 Ω 》                                         Zotoru                                   Ira Shturman\r\nCody Sweetsir                        Adam Satori                         Its_Not_Bluey\r\n\r\n\r\n                \r\n                     \r\n              \r\n            \r\n\r\n\r\n\r\n"
