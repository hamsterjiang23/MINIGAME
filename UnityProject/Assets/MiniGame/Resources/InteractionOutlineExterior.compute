#pragma kernel Initialize
#pragma kernel Connect
#pragma kernel Exterior

Texture2D<float4> _Silhouette;
globallycoherent RWStructuredBuffer<uint> _Parents;
RWTexture2D<float> _Exterior;
uint _Width, _Height;
static const uint Solid = 0xffffffff;

uint Root(uint node)
{
    uint parent = _Parents[node];
    [allow_uav_condition]
    while (parent != node)
    {
        node = parent;
        parent = _Parents[node];
    }
    return node;
}

void Join(uint a, uint b)
{
    [allow_uav_condition]
    while (true)
    {
        a = Root(a);
        b = Root(b);
        if (a == b) return;
        uint high = max(a, b), low = min(a, b), previous;
        // Parents only decrease, so concurrent unions cannot create cycles.
        InterlockedMin(_Parents[high], low, previous);
        if (previous == high) return;
    }
}

[numthreads(8, 8, 1)]
void Initialize(uint3 pixel : SV_DispatchThreadID)
{
    if (pixel.x >= _Width || pixel.y >= _Height) return;
    uint index = pixel.y * _Width + pixel.x;
    // The padded border is one exterior component, including cropped objects.
    bool border = pixel.x == 0 || pixel.y == 0 || pixel.x == _Width - 1 || pixel.y == _Height - 1;
    _Parents[index] = border ? 0 : _Silhouette[pixel.xy].r > .5 ? Solid : index;
}

[numthreads(8, 8, 1)]
void Connect(uint3 pixel : SV_DispatchThreadID)
{
    if (pixel.x >= _Width || pixel.y >= _Height) return;
    uint index = pixel.y * _Width + pixel.x;
    if (_Parents[index] == Solid) return;
    if (pixel.x + 1 < _Width && _Parents[index + 1] != Solid) Join(index, index + 1);
    if (pixel.y + 1 < _Height && _Parents[index + _Width] != Solid) Join(index, index + _Width);
}

[numthreads(8, 8, 1)]
void Exterior(uint3 pixel : SV_DispatchThreadID)
{
    if (pixel.x >= _Width || pixel.y >= _Height) return;
    uint index = pixel.y * _Width + pixel.x;
    _Exterior[pixel.xy] = _Parents[index] != Solid && Root(index) == 0 ? 1 : 0;
}
